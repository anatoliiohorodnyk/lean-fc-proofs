/-!
# Tao's Optimization constant 1a / An autocorrelation constant related to Sidon sets

*References:*
- [Tao's optimization constant 1a](https://teorth.github.io/optimizationproblems/constants/1a.html)
- [M2010] Matolcsi, Máté, and Carlos Vinuesa. "Improved bounds on the supremum of autoconvolutions."
  Journal of mathematical analysis and applications 372.2 (2010): 439-447. [arXiv:0907.1379](https://arxiv.org/abs/0907.1379)
- [Y2026] Yuksekgonul, Mert et al., "Learning to Discover at Test Time," 2026, [arXiv:2601.16175](https://arxiv.org/abs/2601.16175)
- [T2026] Together AI, "EinsteinArena-new-SOTA: State-of-the-art results on open math problems,"
  2026, [GitHub](https://github.com/togethercomputer/EinsteinArena-new-SOTA)
- [PBV2026] Piterbarg, Andrei, Jai Bajaj, and Derrick Vincent. "A multi-scale arcsine lower bound
  for the Sidon autocorrelation constant $C_{1a}$," 2026,
  [GitHub](https://github.com/AndreiPiterbarg/sidon-autocorrelation)
-/

@[expose] public section

open MeasureTheory Set

namespace Constant1a

/-- **Tao's Optimization constant 1a / An autocorrelation constant related to Sidon sets**:
The largest constant $C$ such that
$$\max_{-1/2 \le t \le 1/2} \int_{\mathbb{R}} f(t - x) f(x)\,dx
  \ge C \left(\int_{-1/4}^{1/4} f(x)\,dx\right)^2$$
for all nonnegative $f \colon \mathbb{R} \to \mathbb{R}$.

The inequality is only required for square-integrable $f$. This does not change the constant
(see [M2010, §2]), and it guarantees that every autoconvolution integral exists and that the
supremum over $t$ is finite.
This number is related to the maximal size of Sidon sets in additive combinatorics. -/
noncomputable def C1a : ℝ :=
  sSup {C : ℝ | ∀ ⦃f : ℝ → ℝ⦄, 0 ≤ f → MemLp f 2 →
    C * (∫ x in (- 1 / 4)..(1 / 4), f x) ^ 2
      ≤ sSup {∫ x, f (t - x) * f x | t ∈ Icc (- 1 / 2 : ℝ) (1 / 2)}}

/-- A lower bound, proven by Matolcsi-Vinuesa in [M2010]. -/
@[category research solved, AMS 5 11 26]
theorem c1a_lower_bound : 1.2748 ≤ C1a := by
  sorry

/-- An interval integral only depends on the values on the open interval. -/
lemma ii_congr_Ioo {F F' : ℝ → ℝ} {u v : ℝ} (huv : u ≤ v) (h : ∀ z ∈ Ioo u v, F z = F' z) :
    ∫ z in u..v, F z = ∫ z in u..v, F' z := by
  rw [intervalIntegral.integral_of_le huv, intervalIntegral.integral_of_le huv,
    integral_Ioc_eq_integral_Ioo, integral_Ioc_eq_integral_Ioo]
  exact setIntegral_congr_fun measurableSet_Ioo h

/-- Integral of `g ⌊z⌋` over an interval inside one unit cell. -/
lemma ii_floor (g : ℤ → ℝ) (p : ℤ) {u v : ℝ} (hu : (p : ℝ) ≤ u) (huv : u ≤ v) (hv : v ≤ p + 1) :
    ∫ z in u..v, g ⌊z⌋ = (v - u) * g p := by
  rw [ii_congr_Ioo huv (F' := fun _ => g p)]
  · simp [intervalIntegral.integral_const]
  · intro z hz
    have hfl : ⌊z⌋ = p := Int.floor_eq_iff.mpr ⟨by linarith [hz.1], by linarith [hz.2]⟩
    simp [hfl]

lemma ii_bdd (F : ℝ → ℝ) (hm : Measurable F) (B : ℝ) (hb : ∀ z, |F z| ≤ B) (u v : ℝ) :
    IntervalIntegrable F volume u v :=
  (intervalIntegrable_const (c := B)).mono_fun' hm.aestronglyMeasurable
    (Filter.Eventually.of_forall fun z => by simpa [Real.norm_eq_abs] using hb z)

lemma meas_floor (g : ℤ → ℝ) (φ : ℝ → ℝ) (hφ : Measurable φ) :
    Measurable (fun z => g ⌊φ z⌋) :=
  (measurable_from_top : Measurable g).comp (Int.measurable_floor.comp hφ)

lemma ii_intble (g : ℤ → ℝ) (B : ℝ) (hg : ∀ i, |g i| ≤ B) (φ : ℝ → ℝ) (hφ : Measurable φ)
    (u v : ℝ) : IntervalIntegrable (fun z => g ⌊φ z⌋) volume u v :=
  ii_bdd _ (meas_floor g φ hφ) B (fun _ => hg _) u v

/-- One unit cell of the autoconvolution integral. -/
lemma ii_cell (A : ℤ → ℝ) (B : ℝ) (hB : ∀ i, |A i| ≤ B) (s : ℝ) (j : ℤ) :
    ∫ y in (j : ℝ)..(j + 1), A ⌊s - y⌋ =
      (1 - Int.fract s) * A (⌊s⌋ - 1 - j) + Int.fract s * A (⌊s⌋ - j) := by
  have h0 := Int.fract_nonneg s
  have h1 := Int.fract_lt_one s
  have hs : s = ⌊s⌋ + Int.fract s := (Int.floor_add_fract s).symm
  have e1 := intervalIntegral.integral_comp_sub_left (fun z => A ⌊z⌋) s (a := (j : ℝ)) (b := j + 1)
  rw [e1]
  have hint : ∀ u v : ℝ, IntervalIntegrable (fun z => A ⌊z⌋) volume u v :=
    fun u v => ii_intble A B hB id measurable_id u v
  rw [← intervalIntegral.integral_add_adjacent_intervals (hint _ ((⌊s⌋ - j : ℤ) : ℝ)) (hint _ _)]
  rw [ii_floor A (⌊s⌋ - 1 - j) (by push_cast; linarith) (by push_cast; linarith)
      (by push_cast; linarith),
    ii_floor A (⌊s⌋ - j) le_rfl (by push_cast; linarith) (by push_cast; linarith)]
  push_cast
  have : (⌊s⌋ : ℝ) = s - Int.fract s := by linarith
  rw [this]
  ring

lemma A_bdd (n : ℕ) (A : ℤ → ℝ) (hA : ∀ i, 0 ≤ A i)
    (hsupp : ∀ i : ℤ, (i < 0 ∨ (n : ℤ) ≤ i) → A i = 0) :
    ∀ i, |A i| ≤ ∑ j ∈ Finset.range n, A j := by
  intro i
  rw [abs_of_nonneg (hA i)]
  by_cases hi : i < 0 ∨ (n : ℤ) ≤ i
  · rw [hsupp i hi]
    exact Finset.sum_nonneg fun j _ => hA j
  · push Not at hi
    have h := Finset.single_le_sum (f := fun j : ℕ => A j) (fun j _ => hA j)
      (Finset.mem_range.mpr (by omega : i.toNat < n))
    simpa [Int.toNat_of_nonneg hi.1] using h

/-- The autoconvolution of the unscaled step function is bounded by the largest coefficient. -/
lemma conv_le (n : ℕ) (A : ℤ → ℝ) (hA : ∀ i, 0 ≤ A i)
    (hsupp : ∀ i : ℤ, (i < 0 ∨ (n : ℤ) ≤ i) → A i = 0)
    (M : ℝ) (hM : ∀ m : ℤ, ∑ j ∈ Finset.range n, A j * A (m - j) ≤ M) (s : ℝ) :
    ∫ y, A ⌊s - y⌋ * A ⌊y⌋ ≤ M := by
  obtain ⟨B, hB⟩ : ∃ B : ℝ, ∀ i, |A i| ≤ B := ⟨_, A_bdd n A hA hsupp⟩
  have hmeas : Measurable (fun y : ℝ => s - y) := measurable_const.sub measurable_id
  have step1 : ∫ y, A ⌊s - y⌋ * A ⌊y⌋ = ∫ y in (0 : ℝ)..n, A ⌊s - y⌋ * A ⌊y⌋ := by
    rw [intervalIntegral.integral_of_le (by positivity), integral_Ioc_eq_integral_Ioo,
      ← integral_Ico_eq_integral_Ioo]
    symm
    apply setIntegral_eq_integral_of_forall_compl_eq_zero
    intro y hy
    have : A ⌊y⌋ = 0 := by
      apply hsupp
      by_cases h0 : y < 0
      · left
        exact Int.floor_lt.mpr (by simpa using h0)
      · right
        push Not at h0
        have hn : (n : ℝ) ≤ y := by
          by_contra hlt
          exact hy ⟨h0, not_le.mp hlt⟩
        exact Int.le_floor.mpr (by simpa using hn)
    rw [this, mul_zero]
  have hint : ∀ k < n, IntervalIntegrable (fun y => A ⌊s - y⌋ * A ⌊y⌋) volume
      ((fun k : ℕ => (k : ℝ)) k) ((fun k : ℕ => (k : ℝ)) (k + 1)) := by
    intro k _
    refine ii_bdd _ ((meas_floor A _ hmeas).mul (meas_floor A _ measurable_id)) (B * B)
      (fun z => ?_) _ _
    simp only [Pi.mul_apply, id, abs_mul]
    exact mul_le_mul (hB _) (hB _) (abs_nonneg _) ((abs_nonneg _).trans (hB 0))
  have step2 := intervalIntegral.sum_integral_adjacent_intervals (μ := volume)
    (a := fun k : ℕ => (k : ℝ)) (n := n) hint
  simp only [Nat.cast_zero] at step2
  rw [step1, ← step2]
  have hcell : ∀ j ∈ Finset.range n,
      ∫ y in ((j : ℕ) : ℝ)..((j + 1 : ℕ) : ℝ), A ⌊s - y⌋ * A ⌊y⌋ =
        (1 - Int.fract s) * (A j * A (⌊s⌋ - 1 - j)) + Int.fract s * (A j * A (⌊s⌋ - j)) := by
    intro j _
    have hc := ii_cell A B hB s (j : ℤ)
    rw [ii_congr_Ioo (by push_cast; linarith) (F' := fun y => A ⌊s - y⌋ * A (j : ℤ))]
    · rw [intervalIntegral.integral_mul_const]
      push_cast at hc ⊢
      rw [hc]
      ring
    · intro y hy
      have hfl : ⌊y⌋ = (j : ℤ) :=
        Int.floor_eq_iff.mpr ⟨by exact_mod_cast hy.1.le, by push_cast at hy ⊢; linarith [hy.2]⟩
      simp [hfl]
  rw [Finset.sum_congr rfl hcell, Finset.sum_add_distrib, ← Finset.mul_sum, ← Finset.mul_sum]
  have h0 := Int.fract_nonneg s
  have h1 := Int.fract_lt_one s
  have hm1 := hM (⌊s⌋ - 1)
  have hm0 := hM ⌊s⌋
  nlinarith [mul_le_mul_of_nonneg_left hm1 (by linarith : (0 : ℝ) ≤ 1 - Int.fract s),
    mul_le_mul_of_nonneg_left hm0 h0]

/-- The integral of the unscaled step function. -/
lemma ii_sum (n : ℕ) (A : ℤ → ℝ) (B : ℝ) (hB : ∀ i, |A i| ≤ B) :
    ∫ y in (0 : ℝ)..n, A ⌊y⌋ = ∑ j ∈ Finset.range n, A j := by
  have hint : ∀ k < n, IntervalIntegrable (fun y => A ⌊y⌋) volume
      ((fun k : ℕ => (k : ℝ)) k) ((fun k : ℕ => (k : ℝ)) (k + 1)) :=
    fun k _ => ii_intble A B hB id measurable_id _ _
  have h := intervalIntegral.sum_integral_adjacent_intervals (μ := volume)
    (a := fun k : ℕ => (k : ℝ)) (n := n) hint
  simp only [Nat.cast_zero] at h
  rw [← h]
  refine Finset.sum_congr rfl fun j _ => ?_
  have := ii_floor A (j : ℤ) (u := (j : ℝ)) (v := ((j + 1 : ℕ) : ℝ)) (by simp) (by simp)
    (by push_cast; simp)
  rw [this]
  push_cast
  ring

/-- **Reduction to step functions.** A nonnegative sequence `A` supported on `[0, n)` defines a
step function with `n` equal steps on `[-1/4, 1/4)`; if every coefficient of the discrete
autoconvolution of `A` is at most `M`, then `C1a ≤ 2 n M / (∑ A)²`. -/
theorem C1a_le_of_coeffs (n : ℕ) (hn : 0 < n) (A : ℤ → ℝ) (hA : ∀ i, 0 ≤ A i)
    (hsupp : ∀ i : ℤ, (i < 0 ∨ (n : ℤ) ≤ i) → A i = 0) (M S : ℝ)
    (hS : ∑ j ∈ Finset.range n, A j = S) (hSpos : 0 < S)
    (hM : ∀ m : ℤ, ∑ j ∈ Finset.range n, A j * A (m - j) ≤ M) :
    C1a ≤ 2 * n * M / S ^ 2 := by
  have hB := A_bdd n A hA hsupp
  rw [hS] at hB
  have hnR : (0 : ℝ) < n := by exact_mod_cast hn
  obtain ⟨c, hc⟩ : ∃ c : ℝ, c = 2 * n := ⟨_, rfl⟩
  have hcpos : 0 < c := by rw [hc]; positivity
  rw [← hc]
  have hM0 : 0 ≤ M := (Finset.sum_nonneg fun j _ => mul_nonneg (hA _) (hA _)).trans (hM 0)
  let f : ℝ → ℝ := fun x => A ⌊c * x + c / 4⌋
  have hf0 : 0 ≤ f := fun x => hA _
  have hfm : Measurable f :=
    meas_floor A _ ((measurable_const.mul measurable_id).add measurable_const)
  have hfL2 : MemLp f 2 := by
    have hind : f = (Ico (-1 / 4 : ℝ) (1 / 4)).indicator f := by
      funext x
      by_cases hx : x ∈ Ico (-1 / 4 : ℝ) (1 / 4)
      · rw [indicator_of_mem hx]
      · rw [indicator_of_notMem hx]
        apply hsupp
        by_cases h0 : x < -1 / 4
        · left
          refine Int.floor_lt.mpr ?_
          push_cast
          nlinarith
        · right
          push Not at h0
          have h1 : (1 / 4 : ℝ) ≤ x := by
            by_contra hlt
            exact hx ⟨h0, not_le.mp hlt⟩
          refine Int.le_floor.mpr ?_
          push_cast
          nlinarith
    rw [hind]
    exact (memLp_indicator_iff_restrict measurableSet_Ico).mpr
      (MemLp.of_bound hfm.aestronglyMeasurable S
        (Filter.Eventually.of_forall fun x => by simpa [Real.norm_eq_abs] using hB _))
  have hint : ∫ x in (-1 / 4 : ℝ)..(1 / 4), f x = S / c := by
    have h := intervalIntegral.integral_comp_mul_add (fun y => A ⌊y⌋) hcpos.ne' (c / 4)
      (a := (-1 / 4 : ℝ)) (b := 1 / 4)
    have e0 : c * (-1 / 4) + c / 4 = (0 : ℝ) := by ring
    have e1 : c * (1 / 4) + c / 4 = (n : ℝ) := by rw [hc]; ring
    rw [e0, e1, ii_sum n A S hB, hS] at h
    rw [h, smul_eq_mul]
    field_simp
  have hconv : ∀ t : ℝ, ∫ x, f (t - x) * f x ≤ M / c := by
    intro t
    have e : (fun x => f (t - x) * f x) =
        fun x => (fun y => A ⌊(c * t + c / 2) - y⌋ * A ⌊y⌋) (c * x + c / 4) := by
      funext x
      simp only [f]
      congr 3
      ring
    rw [e]
    have h1 := integral_add_right_eq_self (μ := volume)
      (fun x => (fun y => A ⌊(c * t + c / 2) - y⌋ * A ⌊y⌋) (c * x)) (c / 4 / c)
    have e2 : (fun x => (fun y => A ⌊(c * t + c / 2) - y⌋ * A ⌊y⌋) (c * (x + c / 4 / c))) =
        fun x => (fun y => A ⌊(c * t + c / 2) - y⌋ * A ⌊y⌋) (c * x + c / 4) := by
      funext x
      congr 1
      field_simp
    rw [e2] at h1
    rw [h1, Measure.integral_comp_mul_left (fun y => A ⌊c * t + c / 2 - y⌋ * A ⌊y⌋) c, smul_eq_mul, abs_of_pos (inv_pos.mpr hcpos)]
    have := conv_le n A hA hsupp M hM (c * t + c / 2)
    rw [show M / c = c⁻¹ * M from div_eq_inv_mul _ _]
    exact mul_le_mul_of_nonneg_left this (inv_pos.mpr hcpos).le
  unfold C1a
  apply Real.sSup_le
  · intro C hC
    have h := hC hf0 hfL2
    have hsup : sSup {∫ x, f (t - x) * f x | t ∈ Icc (-1 / 2 : ℝ) (1 / 2)} ≤ M / c := by
      apply Real.sSup_le
      · rintro _ ⟨t, _, rfl⟩
        exact hconv t
      · positivity
    rw [hint] at h
    have h2 : C * (S / c) ^ 2 ≤ M / c := h.trans hsup
    rw [le_div_iff₀ (by positivity)]
    calc C * S ^ 2 = (C * (S / c) ^ 2) * c ^ 2 := by field_simp
      _ ≤ (M / c) * c ^ 2 := by gcongr
      _ = c * M := by field_simp
  · positivity

/-- `chk w b d P`: every one of the `2 ^ d` lowest base-`2 ^ w` digits of `P` is at most `b`,
and `P` has no further digits. Divide and conquer, so that the kernel only does `O(d)` big
operations per digit. -/
def chk (w b : ℕ) : ℕ → ℕ → Bool
  | 0, P => Nat.ble P b
  | d + 1, P => chk w b d (P % 2 ^ (w * 2 ^ d)) && chk w b d (P >>> (w * 2 ^ d))

/-- `dsum w d P`: the sum of the `2 ^ d` lowest base-`2 ^ w` digits of `P`. -/
def dsum (w : ℕ) : ℕ → ℕ → ℕ
  | 0, P => P % 2 ^ w
  | d + 1, P => dsum w d (P % 2 ^ (w * 2 ^ d)) + dsum w d (P >>> (w * 2 ^ d))

lemma dig_lo (B : ℕ) (P : ℕ) {k L : ℕ} (hk : k < L) :
    P % B ^ L / B ^ k % B = P / B ^ k % B := by
  have hL : B ^ L = B ^ k * B ^ (L - k) := by rw [← pow_add]; congr 1; omega
  rw [hL, Nat.mod_mul_right_div_self]
  exact Nat.mod_mod_of_dvd _ (dvd_pow_self B (by omega))

lemma dig_hi (B : ℕ) (P k L : ℕ) : P / B ^ L / B ^ k = P / B ^ (L + k) := by
  rw [Nat.div_div_eq_div_mul, pow_add]

lemma chk_sound (w b : ℕ) : ∀ (d P : ℕ), chk w b d P = true → ∀ k, P / (2 ^ w) ^ k % 2 ^ w ≤ b
  | 0, P, h, k => by
    have hP : P ≤ b := Nat.le_of_ble_eq_true h
    exact (Nat.mod_le _ _).trans ((Nat.div_le_self _ _).trans hP)
  | d + 1, P, h, k => by
    simp only [chk, Bool.and_eq_true] at h
    have hQ : 2 ^ (w * 2 ^ d) = (2 ^ w) ^ (2 ^ d) := pow_mul 2 w (2 ^ d)
    rw [Nat.shiftRight_eq_div_pow, hQ] at h
    by_cases hk : k < 2 ^ d
    · have := chk_sound w b d _ h.1 k
      rwa [dig_lo _ _ hk] at this
    · have := chk_sound w b d _ h.2 (k - 2 ^ d)
      rw [dig_hi] at this
      rwa [show 2 ^ d + (k - 2 ^ d) = k by omega] at this

lemma dsum_eq (w : ℕ) : ∀ (d P : ℕ),
    dsum w d P = ∑ k ∈ Finset.range (2 ^ d), P / (2 ^ w) ^ k % 2 ^ w
  | 0, P => by simp [dsum]
  | d + 1, P => by
    have hQ : 2 ^ (w * 2 ^ d) = (2 ^ w) ^ (2 ^ d) := pow_mul 2 w (2 ^ d)
    simp only [dsum]
    rw [dsum_eq w d, dsum_eq w d, Nat.shiftRight_eq_div_pow, hQ,
      show 2 ^ (d + 1) = 2 ^ d + 2 ^ d by ring, Finset.sum_range_add]
    congr 1
    · exact Finset.sum_congr rfl fun k hk => dig_lo _ _ (Finset.mem_range.mp hk)
    · exact Finset.sum_congr rfl fun k _ => by rw [dig_hi]

/-- Base-`B` expansion of a number below `B ^ n`. -/
lemma expand (B : ℕ) : ∀ (n A : ℕ), A < B ^ n → A = ∑ i ∈ Finset.range n, A / B ^ i % B * B ^ i
  | 0, A, h => by simpa using h
  | n + 1, A, h => by
    have hB : 0 < B := by
      rcases Nat.eq_zero_or_pos B with h0 | h0
      · simp [h0] at h
      · exact h0
    have hdiv : A / B < B ^ n := by
      rw [Nat.div_lt_iff_lt_mul hB]
      rwa [pow_succ] at h
    have ih := expand B n (A / B) hdiv
    rw [Finset.sum_range_succ']
    have e : ∀ i ∈ Finset.range n,
        A / B ^ (i + 1) % B * B ^ (i + 1) = B * (A / B / B ^ i % B * B ^ i) := by
      intro i _
      rw [Nat.div_div_eq_div_mul, pow_succ']
      ring
    rw [Finset.sum_congr rfl e, ← Finset.mul_sum, ← ih]
    simp only [pow_zero, Nat.div_one, mul_one]
    exact (Nat.div_add_mod A B).symm

/-- The `k`-th base-`B` digit of `∑ c i * B ^ i` is `c k` when all `c i < B`. -/
lemma dig_sum (B : ℕ) : ∀ (k N : ℕ) (c : ℕ → ℕ), (∀ i, c i < B) → k < N →
    (∑ i ∈ Finset.range N, c i * B ^ i) / B ^ k % B = c k
  | k, 0, c, _, hk => by omega
  | 0, N + 1, c, hc, _ => by
    rw [Finset.sum_range_succ']
    have e : ∀ i ∈ Finset.range N, c (i + 1) * B ^ (i + 1) = B * (c (i + 1) * B ^ i) := by
      intro i _
      rw [pow_succ']
      ring
    rw [Finset.sum_congr rfl e, ← Finset.mul_sum]
    simp only [pow_zero, Nat.div_one, mul_one]
    rw [Nat.mul_add_mod]
    exact Nat.mod_eq_of_lt (hc 0)
  | k + 1, N + 1, c, hc, hk => by
    rw [Finset.sum_range_succ']
    have e : ∀ i ∈ Finset.range N, c (i + 1) * B ^ (i + 1) = B * (c (i + 1) * B ^ i) := by
      intro i _
      rw [pow_succ']
      ring
    have hB : 0 < B := lt_of_le_of_lt (Nat.zero_le _) (hc 0)
    rw [Finset.sum_congr rfl e, ← Finset.mul_sum]
    simp only [pow_zero, mul_one]
    rw [pow_succ', ← Nat.div_div_eq_div_mul, Nat.mul_add_div hB, Nat.div_eq_of_lt (hc 0), add_zero]
    exact dig_sum B k N (fun i => c (i + 1)) (fun i => hc _) (by omega)

/-- Kronecker substitution: the digits of `A * A` are the autoconvolution coefficients of the
digits of `A`, provided these coefficients are all below the base. -/
lemma dig_sq (B n A : ℕ) (hA : A < B ^ n)
    (hlt : ∀ k, ∑ i ∈ Finset.range (k + 1), (A / B ^ i % B) * (A / B ^ (k - i) % B) < B) (k : ℕ) :
    A * A / B ^ k % B = ∑ i ∈ Finset.range (k + 1), (A / B ^ i % B) * (A / B ^ (k - i) % B) := by
  open Polynomial in
  classical
  let p : ℕ[X] := ∑ i ∈ Finset.range n, C (A / B ^ i % B) * X ^ i
  have hzero : ∀ i, n ≤ i → A / B ^ i % B = 0 := by
    intro i hi
    rw [Nat.div_eq_of_lt (lt_of_lt_of_le hA (Nat.pow_le_pow_right (by
      rcases Nat.eq_zero_or_pos B with h0 | h0
      · have := hlt 0
        simp [h0] at this
      · exact h0) hi))]
    simp
  have hcoeff : ∀ i, p.coeff i = A / B ^ i % B := by
    intro i
    simp only [p, finsetSum_coeff, coeff_C_mul, coeff_X_pow]
    by_cases hi : i < n
    · simp [Finset.sum_ite_eq, hi]
    · simp [Finset.sum_ite_eq, hi, hzero i (not_lt.mp hi)]
  have heval : p.eval B = A := by
    simp only [p, eval_finsetSum, eval_mul, eval_C, eval_pow, eval_X]
    exact (expand B n A hA).symm
  have hsq : (p * p).eval B = A * A := by rw [eval_mul, heval]
  have hc : ∀ j, (p * p).coeff j =
      ∑ i ∈ Finset.range (j + 1), (A / B ^ i % B) * (A / B ^ (j - i) % B) := by
    intro j
    rw [coeff_mul, Finset.Nat.sum_antidiagonal_eq_sum_range_succ
      (fun a b => p.coeff a * p.coeff b) j]
    exact Finset.sum_congr rfl fun i _ => by rw [hcoeff, hcoeff]
  have hrange := eval_eq_sum_range' (p := p * p) (n := (p * p).natDegree + 1 + (k + 1))
    (by omega) B
  rw [← hsq, hrange, dig_sum B k _ (fun i => (p * p).coeff i) (fun i => by rw [hc]; exact hlt i)
    (by omega), hc]

/-- **Certificate theorem.** `A` encodes the heights of a step function with `n` equal steps as
its base-`2 ^ w` digits. If the digit sum is `S`, `S ^ 2 < 2 ^ w`, and every digit of `A * A`
is at most `M`, then `C1a ≤ 2 n M / S²`. -/
theorem C1a_le_of_cert (w n D1 D2 A S M : ℕ) (hn : 0 < n) (hA : A < (2 ^ w) ^ n)
    (hn2 : n ≤ 2 ^ D1) (hS : dsum w D1 A = S) (hSpos : 0 < S) (hB : S ^ 2 < 2 ^ w)
    (hchk : chk w M D2 (A * A) = true) :
    C1a ≤ 2 * (n : ℝ) * (M : ℝ) / (S : ℝ) ^ 2 := by
  obtain ⟨B, hBdef⟩ : ∃ B : ℕ, B = 2 ^ w := ⟨_, rfl⟩
  rw [← hBdef] at hA hB
  have hBpos : 0 < B := by rw [hBdef]; positivity
  obtain ⟨d, hd⟩ : ∃ d : ℕ → ℕ, ∀ i, d i = A / B ^ i % B := ⟨_, fun _ => rfl⟩
  have hzero : ∀ i, n ≤ i → d i = 0 := by
    intro i hi
    rw [hd, Nat.div_eq_of_lt (lt_of_lt_of_le hA (Nat.pow_le_pow_right hBpos hi))]
    simp
  have hsumN : ∀ N, n ≤ N → ∑ i ∈ Finset.range N, d i = ∑ i ∈ Finset.range n, d i := by
    intro N hN
    symm
    apply Finset.sum_subset (Finset.range_mono hN)
    intro i _ hi
    exact hzero i (by simpa using hi)
  have hSn : ∑ i ∈ Finset.range n, d i = S := by
    rw [← hsumN (2 ^ D1) hn2, ← hS, dsum_eq, ← hBdef]
    exact Finset.sum_congr rfl fun i _ => hd i
  have hle_S : ∀ j, d j ≤ S := by
    intro j
    by_cases hj : j < n
    · rw [← hSn]
      exact Finset.single_le_sum (f := d) (fun _ _ => Nat.zero_le _) (Finset.mem_range.mpr hj)
    · rw [hzero j (not_lt.mp hj)]
      exact Nat.zero_le _
  have hpre : ∀ N, ∑ i ∈ Finset.range N, d i ≤ S := by
    intro N
    by_cases hN : n ≤ N
    · rw [hsumN N hN, hSn]
    · rw [← hSn]
      exact Finset.sum_le_sum_of_subset (Finset.range_mono (by omega))
  have hconv_lt : ∀ k, ∑ i ∈ Finset.range (k + 1), d i * d (k - i) < B := by
    intro k
    calc ∑ i ∈ Finset.range (k + 1), d i * d (k - i)
        ≤ ∑ i ∈ Finset.range (k + 1), d i * S :=
          Finset.sum_le_sum fun i _ => Nat.mul_le_mul_left _ (hle_S _)
      _ = (∑ i ∈ Finset.range (k + 1), d i) * S := by rw [Finset.sum_mul]
      _ ≤ S * S := Nat.mul_le_mul_right _ (hpre _)
      _ = S ^ 2 := by ring
      _ < B := hB
  have hdig := dig_sq B n A hA (fun k => by simpa only [hd] using hconv_lt k)
  have hconv_le : ∀ k, ∑ i ∈ Finset.range (k + 1), d i * d (k - i) ≤ M := by
    intro k
    have h1 := chk_sound w M D2 _ hchk k
    rw [← hBdef, hdig k] at h1
    simpa only [hd] using h1
  refine C1a_le_of_coeffs n hn (fun z : ℤ => if 0 ≤ z then (d z.toNat : ℝ) else 0)
    ?_ ?_ M S ?_ (by exact_mod_cast hSpos) ?_
  · intro i
    split_ifs
    · exact Nat.cast_nonneg _
    · exact le_rfl
  · intro i hi
    rcases hi with hi | hi
    · rw [if_neg (by omega)]
    · rw [if_pos (by omega), hzero _ (by omega)]
      simp
  · have : ∀ j ∈ Finset.range n,
        (fun z : ℤ => if 0 ≤ z then (d z.toNat : ℝ) else 0) (j : ℤ) = (d j : ℝ) := by
      intro j _
      simp
    rw [Finset.sum_congr rfl this]
    exact_mod_cast hSn
  · intro m
    by_cases hm : m < 0
    · have : ∀ j ∈ Finset.range n,
          (if (0 : ℤ) ≤ (j : ℤ) then (d (j : ℤ).toNat : ℝ) else 0) *
            (if 0 ≤ m - (j : ℤ) then (d (m - (j : ℤ)).toNat : ℝ) else 0) = 0 := by
        intro j _
        rw [if_neg (by omega : ¬ 0 ≤ m - (j : ℤ)), mul_zero]
      rw [Finset.sum_congr rfl this, Finset.sum_const_zero]
      exact Nat.cast_nonneg _
    · obtain ⟨k, rfl⟩ := Int.eq_ofNat_of_zero_le (not_lt.mp hm)
      obtain ⟨g, hg⟩ : ∃ g : ℕ → ℝ, ∀ j, g j = if j ≤ k then (d j : ℝ) * (d (k - j) : ℝ) else 0 :=
        ⟨_, fun _ => rfl⟩
      have hterm : ∀ j ∈ Finset.range n,
          (if (0 : ℤ) ≤ (j : ℤ) then (d (j : ℤ).toNat : ℝ) else 0) *
            (if 0 ≤ (k : ℤ) - (j : ℤ) then (d ((k : ℤ) - (j : ℤ)).toNat : ℝ) else 0) = g j := by
        intro j _
        rw [hg, if_pos (by omega : (0 : ℤ) ≤ (j : ℤ)), Int.toNat_natCast]
        by_cases hjk : j ≤ k
        · rw [if_pos (by omega), if_pos hjk, show ((k : ℤ) - (j : ℤ)).toNat = k - j by omega]
        · rw [if_neg (by omega), if_neg hjk, mul_zero]
      have hg0 : ∀ j, 0 ≤ g j := by
        intro j
        rw [hg]
        split_ifs
        · positivity
        · exact le_rfl
      rw [Finset.sum_congr rfl hterm]
      calc ∑ j ∈ Finset.range n, g j
          ≤ ∑ j ∈ Finset.range (n + (k + 1)), g j :=
            Finset.sum_le_sum_of_subset_of_nonneg (Finset.range_mono (by omega))
              (fun j _ _ => hg0 j)
        _ = ∑ j ∈ Finset.range (k + 1), g j := by
            symm
            apply Finset.sum_subset (Finset.range_mono (by omega))
            intro j _ hj
            rw [hg, if_neg (by simpa using hj)]
        _ = ∑ j ∈ Finset.range (k + 1), ((d j * d (k - j) : ℕ) : ℝ) := by
            apply Finset.sum_congr rfl
            intro j hj
            rw [hg, if_pos (by have := Finset.mem_range.mp hj; omega)]
            push_cast
            ring
        _ = ((∑ j ∈ Finset.range (k + 1), d j * d (k - j) : ℕ) : ℝ) := by push_cast; rfl
        _ ≤ (M : ℝ) := by exact_mod_cast hconv_le k

