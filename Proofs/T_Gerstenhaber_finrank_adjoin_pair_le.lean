    rw [hsum]
    exact hL2.trans_eq hk_sum
  have hmap : Subalgebra.map φ.toAlgHom (Algebra.adjoin K ({A, B} : Set (Module.End K V))) =
      Algebra.adjoin K ({A', B'} : Set (Module.End K (Module.AEval' A))) := by
    rw [AlgHom.map_adjoin]
    simp [A', B', Set.image_pair]
  have hfin : Module.finrank K (Subalgebra.map φ.toAlgHom (Algebra.adjoin K ({A, B} : Set (Module.End K V)))) =
      Module.finrank K (Algebra.adjoin K ({A, B} : Set (Module.End K V))) := by
    exact (LinearEquiv.finrank_eq (φ.subalgebraMap (Algebra.adjoin K ({A, B} : Set (Module.End K V)))).toLinearEquiv).symm
  rw [← hfin, hmap]
  exact hL2'
lemma core_algClosed (A B : Module.End K V) (hAB : Commute A B) :
    Module.finrank K (Algebra.adjoin K ({A, B} : Set (Module.End K V))) ≤ Module.finrank K V := by
  classical
  have hmain : ∀ n : ℕ, ∀ (W : Type u) [AddCommGroup W] [Module K W] [FiniteDimensional K W],
      Module.finrank K W = n → ∀ (A B : Module.End K W), Commute A B →
        Module.finrank K (Algebra.adjoin K ({A, B} : Set (Module.End K W))) ≤ Module.finrank K W := by
    intro n
    refine Nat.strong_induction_on n ?_
    rintro n' ih W _ _ _ hfinW A B hAB
    by_cases hn0 : Module.finrank K W = 0
    · haveI : Subsingleton W := (Module.finrank_zero_iff.mp hn0)
      have hfin0 : Module.finrank K (Algebra.adjoin K ({A, B} : Set (Module.End K W))) = 0 := by
        haveI : Subsingleton (Module.End K W) := by
          refine ⟨fun f g => ?_⟩
          ext v
          exact Subsingleton.elim (f v) (g v)
        haveI : Subsingleton (Algebra.adjoin K ({A, B} : Set (Module.End K W))) := inferInstance
        exact Module.finrank_zero_of_subsingleton
      rw [hfin0, hn0]
    · have hpos : 0 < Module.finrank K W := by omega
      haveI : Nontrivial W := (Module.finrank_pos_iff).mp hpos
      rcases Module.End.exists_eigenvalue A with ⟨μ, hμ⟩
      let f : Module.End K W := A - μ • (1 : Module.End K W)
      have hAf : Commute A f := by
        dsimp [f]
        exact (Commute.refl A).sub_right ((Commute.one_right A).smul_right μ)
      have hBf : Commute B f := by
        dsimp [f]
        exact hAB.symm.sub_right ((Commute.one_right B).smul_right μ)
      have hfit : ∀ᶠ m in Filter.atTop, IsCompl (f ^ m).ker (f ^ m).range :=
        LinearMap.eventually_isCompl_ker_pow_range_pow f
      rcases (Filter.eventually_atTop.1 hfit) with ⟨m, hm⟩
      let m0 := max m 1
      have hm0 : m ≤ m0 := le_max_left _ _
      have hm0' : 1 ≤ m0 := le_max_right _ _
      have hcomp : IsCompl (f ^ m0).ker (f ^ m0).range := hm m0 hm0
      let K0 : Submodule K W := (f ^ m0).ker
      let R0 : Submodule K W := (f ^ m0).range
      have hAK : ∀ x ∈ K0, A x ∈ K0 := by
        intro x hx
        have hAcomm : Commute A (f ^ m0) := hAf.pow_right m0
        have hA : A x ∈ (f ^ m0).ker := by
          rw [LinearMap.mem_ker] at hx ⊢
          have hcompA : (f ^ m0) (A x) = A ((f ^ m0) x) := by
            have := congrArg (fun T : Module.End K W => T x) hAcomm.eq
            simpa using this.symm
          rw [hcompA, hx, map_zero]
        simpa [K0] using hA
      have hBK : ∀ x ∈ K0, B x ∈ K0 := by
        intro x hx
        have hBcomm : Commute B (f ^ m0) := hBf.pow_right m0
        have hB : B x ∈ (f ^ m0).ker := by
          rw [LinearMap.mem_ker] at hx ⊢
          have hcompB : (f ^ m0) (B x) = B ((f ^ m0) x) := by
            have := congrArg (fun T : Module.End K W => T x) hBcomm.eq
            simpa using this.symm
          rw [hcompB, hx, map_zero]
        simpa [K0] using hB
      have hAR : ∀ x ∈ R0, A x ∈ R0 := by
        intro x hx
        rw [LinearMap.mem_range] at hx ⊢
        rcases hx with ⟨y, hy⟩
        have hAcomm : Commute A (f ^ m0) := hAf.pow_right m0
        refine ⟨A y, ?_⟩
        rw [← hy]
        have hcompA : (f ^ m0) (A y) = A ((f ^ m0) y) := by
          have := congrArg (fun T : Module.End K W => T y) hAcomm.eq
          simpa using this.symm
        exact hcompA
      have hBR : ∀ x ∈ R0, B x ∈ R0 := by
        intro x hx
        rw [LinearMap.mem_range] at hx ⊢
        rcases hx with ⟨y, hy⟩
        have hBcomm : Commute B (f ^ m0) := hBf.pow_right m0
        refine ⟨B y, ?_⟩
        rw [← hy]
        have hcompB : (f ^ m0) (B y) = B ((f ^ m0) y) := by
          have := congrArg (fun T : Module.End K W => T y) hBcomm.eq
          simpa using this.symm
        exact hcompB
      by_cases hR0 : R0 = ⊥
      · have hnil : IsNilpotent f := by
          refine ⟨m0, ?_⟩
          have : (f ^ m0).range = ⊥ := by simpa [R0] using hR0
          exact LinearMap.range_eq_bot.mp this
        have hA : A = f + μ • (1 : Module.End K W) := by simp [f]
        have hadj : Algebra.adjoin K ({A, B} : Set (Module.End K W)) =
            Algebra.adjoin K ({f, B} : Set (Module.End K W)) := by
          apply le_antisymm <;> refine Algebra.adjoin_le ?_ <;> rintro x (rfl | rfl)
          · rw [hA]; exact add_mem (Algebra.subset_adjoin (by simp)) (Subalgebra.smul_mem _ (one_mem _) _)
          · exact Algebra.subset_adjoin (by simp)
          · exact sub_mem (Algebra.subset_adjoin (by simp)) (Subalgebra.smul_mem _ (one_mem _) _)
          · exact Algebra.subset_adjoin (by simp)
        rw [hadj]
        exact nilpotent_core f B hBf.symm hnil
      · have hK0ne : K0 ≠ ⊥ := by
          have hμ' : ∃ v : W, v ≠ 0 ∧ A v = μ • v := by
            change A.eigenspace μ ≠ ⊥ at hμ
            rcases (Submodule.ne_bot_iff (A.eigenspace μ)).mp hμ with ⟨v, hv, hv0⟩
            exact ⟨v, hv0, (Module.End.mem_eigenspace_iff).mp hv⟩
          rcases hμ' with ⟨v, hv, hvμ⟩
          have hfv : f v = 0 := by
            dsimp [f]
            simp [hvμ]
          have hvK : v ∈ K0 := by
            change v ∈ (f ^ m0).ker
            rw [LinearMap.mem_ker]
            rw [show m0 = (m0 - 1) + 1 from (Nat.sub_add_cancel hm0').symm, pow_succ]
            simp [hfv]
          intro hbot
          have : v = 0 := by
            have hvbot : v ∈ (⊥ : Submodule K W) := by
              simpa [hbot] using hvK
            simpa using hvbot
          exact hv this
        have hR0pos : 0 < Module.finrank K R0 := by
          have : Module.finrank K R0 ≠ 0 := by
            intro h0
            exact hR0 (Submodule.finrank_eq_zero.mp h0)
          omega
        have hK0pos : 0 < Module.finrank K K0 := by
          have : Module.finrank K K0 ≠ 0 := by
            intro h0
            exact hK0ne (Submodule.finrank_eq_zero.mp h0)
          omega
        have hsum : Module.finrank K K0 + Module.finrank K R0 = Module.finrank K W :=
          Submodule.finrank_add_eq_of_isCompl hcomp
        have hK0lt : Module.finrank K K0 < n' := by omega
        have hR0lt : Module.finrank K R0 < n' := by omega
        let AK : Module.End K K0 := A.restrict hAK
        let BK : Module.End K K0 := B.restrict hBK
        let AR : Module.End K R0 := A.restrict hAR
        let BR : Module.End K R0 := B.restrict hBR
        have hABK : Commute AK BK := by
          ext x
          have h : A (B (x : W)) = B (A (x : W)) := by
            have := congrArg (fun T : Module.End K W => T (x : W)) hAB
            simpa using this
          simpa [AK, BK, LinearMap.restrict_apply] using h
        have hABR : Commute AR BR := by
          ext x
          have h : A (B (x : W)) = B (A (x : W)) := by
            have := congrArg (fun T : Module.End K W => T (x : W)) hAB
            simpa using this
          simpa [AR, BR, LinearMap.restrict_apply] using h
        have ihK := ih (Module.finrank K K0) hK0lt K0 rfl AK BK hABK
        have ihR := ih (Module.finrank K R0) hR0lt R0 rfl AR BR hABR
        have htwo : Module.finrank K (Algebra.adjoin K ({A, B} : Set (Module.End K W))) ≤
            Module.finrank K (Algebra.adjoin K ({AK, BK} : Set (Module.End K K0))) +
              Module.finrank K (Algebra.adjoin K ({AR, BR} : Set (Module.End K R0))) :=
          finrank_twoBlock A B hAB hcomp hAK hBK hAR hBR
        omega
  exact hmain (Module.finrank K V) V rfl A B hAB

end Core

/--
**Gerstenhaber's theorem** [Ger61]: if $A$ and $B$ are commuting $n \times n$
matrices over a field $K$, then the unital $K$-algebra $K[A, B]$ they generate
has dimension at most $n$.
-/
@[category research solved, AMS 15 16]
theorem finrank_adjoin_pair_le (A B : Matrix (Fin n) (Fin n) K) (hAB : Commute A B) :
    Module.finrank K (Algebra.adjoin K {A, B}) ≤ n := by
  let Kbar := AlgebraicClosure K
  let Abar : Matrix (Fin n) (Fin n) Kbar := A.map (algebraMap K Kbar)
  let Bbar : Matrix (Fin n) (Fin n) Kbar := B.map (algebraMap K Kbar)
  have hbc := finrank_baseChange_le (K := K) (L := Kbar) (n := n) A B
  have htr := finrank_adjoin_transfer (K := Kbar) (n := n) Abar Bbar
  have hABbar0 : Commute Abar Bbar := by
    exact Commute.map hAB (RingHom.mapMatrix (algebraMap K Kbar))
  have hABbar : Commute (linAlgEquiv Kbar n Abar) (linAlgEquiv Kbar n Bbar) := by
    exact Commute.map hABbar0 (linAlgEquiv Kbar n)
  have hcore := Core.core_algClosed (K := Kbar) (V := Fin n → Kbar)
    (linAlgEquiv Kbar n Abar) (linAlgEquiv Kbar n Bbar) hABbar
  have hfin : Module.finrank Kbar (Fin n → Kbar) = n := by
    rw [Module.finrank_pi]
    simp
  calc
    Module.finrank K (Algebra.adjoin K ({A, B} : Set (Matrix (Fin n) (Fin n) K))) ≤
        Module.finrank Kbar (Algebra.adjoin Kbar
          ({Abar, Bbar} : Set (Matrix (Fin n) (Fin n) Kbar))) := by
      simpa [Abar, Bbar] using hbc
    _ = Module.finrank Kbar (Algebra.adjoin Kbar
          ({linAlgEquiv Kbar n Abar, linAlgEquiv Kbar n Bbar} : Set (Module.End Kbar (Fin n → Kbar)))) := by
      simpa [Abar, Bbar] using htr
    _ ≤ Module.finrank Kbar (Fin n → Kbar) := hcore
    _ = n := hfin

/--
**The Gerstenhaber problem**: if $A$, $B$, and $C$ are pairwise commuting
$n \times n$ matrices over a field $K$, is the dimension of the unital
$K$-algebra $K[A, B, C]$ they generate always at most $n$?
-/
@[category research open, AMS 15 16]
theorem finrank_adjoin_triple_le :
    answer(sorry) ↔
      ∀ (K : Type*) [Field K] (n : ℕ) (A B C : Matrix (Fin n) (Fin n) K),
        ({A, B, C} : Set (Matrix (Fin n) (Fin n) K)).Pairwise Commute →
          Module.finrank K (Algebra.adjoin K {A, B, C}) ≤ n := by
  sorry

/--
The analogue of Gerstenhaber's theorem fails for four pairwise commuting matrices:
over any field there are four pairwise commuting $4 \times 4$ matrices generating a unital
algebra of dimension greater than $4$. The standard example is
$e_{13}, e_{14}, e_{23}, e_{24}$, whose pairwise products all vanish, so the algebra
they generate has dimension $5$.
-/
@[category research solved, AMS 15 16]
theorem exists_finrank_adjoin_quadruple_gt (K : Type*) [Field K] :
    ∃ A B C D : Matrix (Fin 4) (Fin 4) K,
      ({A, B, C, D} : Set (Matrix (Fin 4) (Fin 4) K)).Pairwise Commute ∧
      4 < Module.finrank K (Algebra.adjoin K {A, B, C, D}) := by
  refine ⟨Matrix.single 0 2 1, Matrix.single 0 3 1, Matrix.single 1 2 1, Matrix.single 1 3 1,
    ?_, ?_⟩
  · -- All pairwise products vanish: the column index of one factor is `2` or `3` and the row
    -- index of the other is `0` or `1`.
    intro x hx y hy _
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx hy
    rcases hx with rfl | rfl | rfl | rfl <;> rcases hy with rfl | rfl | rfl | rfl <;>
      first
      | exact Commute.refl _
      | exact (show _ * _ = _ * _ by simp (disch := decide) [Matrix.single_mul_single_of_ne])
  · -- `1, e₁₃, e₁₄, e₂₃, e₂₄` are linearly independent elements of the subalgebra.
    set S := Algebra.adjoin K ({Matrix.single 0 2 1, Matrix.single 0 3 1, Matrix.single 1 2 1,
      Matrix.single 1 3 1} : Set (Matrix (Fin 4) (Fin 4) K)) with hS
    let v : Fin 5 → Matrix (Fin 4) (Fin 4) K :=
      ![1, Matrix.single 0 2 1, Matrix.single 0 3 1, Matrix.single 1 2 1, Matrix.single 1 3 1]
    have hv : ∀ i, v i ∈ S := by
      intro i
      fin_cases i
      · exact one_mem S
      all_goals exact Algebra.subset_adjoin (by simp [v])
    have hw : LinearIndependent K fun i => (⟨v i, hv i⟩ : S) := by
      rw [Fintype.linearIndependent_iff]
      intro g hg i
      have h := congrArg Subtype.val hg
      simp only [Subalgebra.coe_zero] at h
      change ∑ j, g j • v j = 0 at h
      have e : ∀ a b : Fin 4, (∑ j, g j • v j) a b = 0 := fun a b => by rw [h]; rfl
      simp only [Matrix.sum_apply, Matrix.smul_apply, Fin.sum_univ_five, v] at e
      have e00 := e 0 0
      have e02 := e 0 2
      have e03 := e 0 3
      have e12 := e 1 2
      have e13 := e 1 3
      simp at e00 e02 e03 e12 e13
      fin_cases i <;> simp_all
    have := hw.fintype_card_le_finrank
    simp only [Fintype.card_fin] at this
    omega

end Gerstenhaber
