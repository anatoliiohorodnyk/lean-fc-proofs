/-- **Atoms of degree-2 nodes** (the claim inside the proof of Lemma 11). In a `𝒴`-maximum
decomposition of a multigraph without a core, a member `N` with a single child `C` has an atom
with at most two vertices, and with exactly one vertex if one of the two cuts has size two. -/
theorem ep_deg2_atom_card {W E : Type*} [Fintype E] (α β : E → W) (L : Finset W) (r : W)
    (𝒮 𝒴 : Finset (Finset W)) (h : EpCubicD α β L) (hb : EpBridgeless α β L)
    (hconn : EpConnected α β L) (hr : r ∈ L) (hdec : EpDecomp α β L r 𝒮)
    (href : EpRefines L r 𝒮 𝒴)
    (hmax : ∀ 𝒮', EpDecomp α β L r 𝒮' → EpRefines L r 𝒮' 𝒴 → 𝒮'.card ≤ 𝒮.card)
    (hnc : ¬EpHasCore α β L) (N C : Finset W) (hN : N ∈ 𝒮) (hch : epChildren 𝒮 N = {C}) :
    1 ≤ (N \ C).card ∧ (N \ C).card ≤ 2 ∧
      (((epCut α β N).card = 2 ∨ (epCut α β C).card = 2) → (N \ C).card = 1) := by
  have hCch : C ∈ epChildren 𝒮 N := by rw [hch]; exact Finset.mem_singleton_self C
  obtain ⟨hCS, hCN, -⟩ := (mem_epChildren 𝒮 N C).mp hCch
  obtain ⟨hNL, hNne, hrN, hNcut⟩ := hdec.2.1 N hN
  obtain ⟨hCL, ⟨c₀, hc₀⟩, -, hCcut⟩ := hdec.2.1 C hCS
  have hNneL : N ≠ L := fun h' => hrN (h' ▸ hr)
  have hatom : epAtom 𝒮 N = N \ C := by
    rw [ep_atom_children, hch, Finset.singleton_biUnion]; rfl
  have hnode := hdec.2.2 N (Finset.mem_insert_of_mem hN)
  rw [hatom, hch, Finset.card_singleton, if_neg hNneL] at hnode
  have hA1 : 1 ≤ (N \ C).card := by omega
  have hAne : (epAtom 𝒮 N).Nonempty := by rw [hatom]; exact Finset.card_pos.mp hA1
  have hAY := ep_atom_notMem_refined α β L r 𝒮 𝒴 hdec href N C hN hCch hAne
  have hge2 : ∀ Z : Finset W, Z ⊆ L → Z.Nonempty → Z ≠ L → 2 ≤ (epCut α β Z).card :=
    fun Z => ep_cut_ge_two α β L hb hconn Z
  have hlive : ∀ g, α g ≠ β g → α g ∈ L ∧ β g ∈ L := by
    intro g hg
    rcases h.1 g with h' | h'
    · exact ⟨h'.1, h'.2.1⟩
    · exact absurd h'.2.symm hg
  -- a set between `C` and `N` with a small cut cannot exist
  have noins : ∀ Z : Finset W, Z ⊆ N → C ⊆ Z → (epCut α β Z).card ≤ 3 →
      1 ≤ ((N \ C) ∩ Z).card → 1 ≤ ((N \ C) \ Z).card → False := by
    intro Z hZN hCZ hZ3 hin hout
    have hZL : Z ⊆ L := hZN.trans hNL
    have hZ2 := hge2 Z hZL ⟨c₀, hCZ hc₀⟩ (fun h' => hrN (hZN (h' ▸ hr)))
    obtain ⟨k1, k2, k3⟩ := ep_decomp_insert α β L r 𝒮 hdec hr N Z (Finset.mem_insert_of_mem hN)
      hZN (fun h' => hrN (hZN h')) (by omega)
      (fun D hD => by rw [hch, Finset.mem_singleton] at hD; rw [hD]; exact Or.inl hCZ)
      (by rw [hatom, hch, Finset.filter_singleton, if_pos hCZ, Finset.card_singleton]; omega)
      (by rw [hatom, hch, Finset.filter_singleton, if_neg hNneL]
          have : 0 ≤ (if Disjoint C Z then ({C} : Finset (Finset W)) else ∅).card :=
            Nat.zero_le _
          omega)
    have := hmax _ k2 (k3 𝒴 href hAY)
    rw [Finset.card_insert_of_notMem k1] at this
    omega
  have hAL : N \ C ⊆ L := Finset.sdiff_subset.trans hNL
  have hAneL : N \ C ≠ L := fun h' => hrN ((Finset.mem_sdiff.mp (h' ▸ hr : r ∈ N \ C)).1)
  have hdA := hge2 (N \ C) hAL (Finset.card_pos.mp hA1) hAneL
  -- the three kinds of vertices
  have htri : ∀ w, w ∈ L → w ∈ L \ N ∨ w ∈ N \ C ∨ w ∈ C := by
    intro w hw
    by_cases h1 : w ∈ N
    · by_cases h2 : w ∈ C
      · exact Or.inr (Or.inr h2)
      · exact Or.inr (Or.inl (Finset.mem_sdiff.mpr ⟨h1, h2⟩))
    · exact Or.inl (Finset.mem_sdiff.mpr ⟨hw, h1⟩)
  have hone : ((epCut α β N).card = 2 ∨ (epCut α β C).card = 2) → (N \ C).card = 1 := by
    intro h2
    by_contra hcard
    have hA2 : 2 ≤ (N \ C).card := by omega
    rcases h2 with hN2 | hC2
    · -- a vertex of the atom with an edge leaving `N`
      have hex : ∃ v ∈ N \ C, 1 ≤ (epBtw α β (L \ N) {v}).card := by
        by_contra hcon
        push_neg at hcon
        have hnoAU : ∀ g, ¬(α g ∈ N \ C ∧ β g ∈ L \ N) ∧ ¬(α g ∈ L \ N ∧ β g ∈ N \ C) := by
          intro g
          constructor
          · rintro ⟨a1, a2⟩
            have : g ∈ epBtw α β (L \ N) {α g} :=
              (mem_epBtw _ _ _ _ _).mpr (Or.inr ⟨Finset.mem_singleton_self _, a2⟩)
            have := Finset.card_pos.mpr ⟨g, this⟩
            have := hcon _ a1
            omega
          · rintro ⟨a1, a2⟩
            have : g ∈ epBtw α β (L \ N) {β g} :=
              (mem_epBtw _ _ _ _ _).mpr (Or.inl ⟨a1, Finset.mem_singleton_self _⟩)
            have := Finset.card_pos.mpr ⟨g, this⟩
            have := hcon _ a2
            omega
        have hpart := ep_three_part_cut α β L (L \ N) (N \ C) C hlive htri
          (fun w hw hw' => (Finset.mem_sdiff.mp hw).2 (Finset.mem_sdiff.mp hw').1)
          (fun w hw hw' => (Finset.mem_sdiff.mp hw).2 (hCN.1 hw'))
          (fun w hw => (Finset.mem_sdiff.mp hw).2) hnoAU
        have hcomplN : epCut α β (L \ N) = epCut α β N := by
          ext g; rw [mem_epCut, mem_epCut]
          exact epD_cross_compl α β L N (L \ N) h (fun w => Finset.mem_sdiff) g
        have hsub : epCut α β (L \ N) ∪ epCut α β (N \ C) ⊆ epCut α β C := by
          intro g hg
          rw [mem_epCut]
          rcases Finset.mem_union.mp hg with hg | hg
          · exact (hpart g).2.1 ((mem_epCut _ _ _ _).mp hg)
          · exact (hpart g).1 ((mem_epCut _ _ _ _).mp hg)
        have hdis : Disjoint (epCut α β (L \ N)) (epCut α β (N \ C)) := by
          rw [Finset.disjoint_left]
          intro g hg1 hg2
          exact (hpart g).2.2 ((mem_epCut _ _ _ _).mp hg1) ((mem_epCut _ _ _ _).mp hg2)
        have := Finset.card_le_card hsub
        rw [Finset.card_union_of_disjoint hdis, hcomplN] at this
        rcases hCcut with h' | h' <;> omega
      obtain ⟨v, hvA, hv1⟩ := hex
      obtain ⟨hvN, hvC⟩ := Finset.mem_sdiff.mp hvA
      have hdUv : Disjoint (L \ N) ({v} : Finset W) :=
        Finset.disjoint_singleton_right.mpr (fun h' => (Finset.mem_sdiff.mp h').2 hvN)
      have e1 := ep_cut_union α β (L \ N) {v} hdUv
      have hUe : L \ N ∪ {v} = L \ (N \ {v}) := by
        ext w
        simp only [Finset.mem_union, Finset.mem_sdiff, Finset.mem_singleton]
        constructor
        · rintro (⟨a1, a2⟩ | rfl)
          · exact ⟨a1, fun h' => a2 h'.1⟩
          · exact ⟨hNL hvN, fun h' => h'.2 rfl⟩
        · rintro ⟨a1, a2⟩
          by_cases hwv : w = v
          · exact Or.inr hwv
          · exact Or.inl ⟨a1, fun h' => a2 ⟨h', hwv⟩⟩
      have hcompl : ∀ Z : Finset W, epCut α β (L \ Z) = epCut α β Z := by
        intro Z; ext g; rw [mem_epCut, mem_epCut]
        exact epD_cross_compl α β L Z (L \ Z) h (fun w => Finset.mem_sdiff) g
      rw [hUe, hcompl, hcompl, hN2, h.2 v (hNL hvN)] at e1
      obtain ⟨w, hwA, hwv⟩ : ∃ w ∈ N \ C, w ≠ v := by
        by_contra hcon
        push_neg at hcon
        have : N \ C ⊆ {v} := fun w hw => Finset.mem_singleton.mpr (hcon w hw)
        have := Finset.card_le_card this
        rw [Finset.card_singleton] at this
        omega
      refine noins (N \ {v}) Finset.sdiff_subset (fun w hw => Finset.mem_sdiff.mpr
        ⟨hCN.1 hw, fun h' => hvC (Finset.mem_singleton.mp h' ▸ hw)⟩) (by omega) ?_ ?_
      · exact Finset.card_pos.mpr ⟨w, Finset.mem_inter.mpr ⟨hwA, Finset.mem_sdiff.mpr
          ⟨(Finset.mem_sdiff.mp hwA).1, fun h' => hwv (Finset.mem_singleton.mp h')⟩⟩⟩
      · exact Finset.card_pos.mpr ⟨v, Finset.mem_sdiff.mpr ⟨hvA,
          fun h' => (Finset.mem_sdiff.mp h').2 (Finset.mem_singleton_self v)⟩⟩
    · -- a vertex of the atom with an edge into `C`
      have hex : ∃ v ∈ N \ C, 1 ≤ (epBtw α β C {v}).card := by
        by_contra hcon
        push_neg at hcon
        have hnoAC : ∀ g, ¬(α g ∈ N \ C ∧ β g ∈ C) ∧ ¬(α g ∈ C ∧ β g ∈ N \ C) := by
          intro g
          constructor
          · rintro ⟨a1, a2⟩
            have : g ∈ epBtw α β C {α g} :=
              (mem_epBtw _ _ _ _ _).mpr (Or.inr ⟨Finset.mem_singleton_self _, a2⟩)
            have := Finset.card_pos.mpr ⟨g, this⟩
            have := hcon _ a1
            omega
          · rintro ⟨a1, a2⟩
            have : g ∈ epBtw α β C {β g} :=
              (mem_epBtw _ _ _ _ _).mpr (Or.inl ⟨a1, Finset.mem_singleton_self _⟩)
            have := Finset.card_pos.mpr ⟨g, this⟩
            have := hcon _ a2
            omega
        have hpart := ep_three_part_cut α β L C (N \ C) (L \ N) hlive
          (fun w hw => by rcases htri w hw with t | t | t <;> tauto)
          (fun w hw hw' => (Finset.mem_sdiff.mp hw').2 hw)
          (fun w hw hw' => (Finset.mem_sdiff.mp hw').2 (hCN.1 hw))
          (fun w hw hw' => (Finset.mem_sdiff.mp hw').2 (Finset.mem_sdiff.mp hw).1) hnoAC
        have hcomplN : epCut α β (L \ N) = epCut α β N := by
          ext g; rw [mem_epCut, mem_epCut]
          exact epD_cross_compl α β L N (L \ N) h (fun w => Finset.mem_sdiff) g
        have hsub : epCut α β C ∪ epCut α β (N \ C) ⊆ epCut α β (L \ N) := by
          intro g hg
          rw [mem_epCut]
          rcases Finset.mem_union.mp hg with hg | hg
          · exact (hpart g).2.1 ((mem_epCut _ _ _ _).mp hg)
          · exact (hpart g).1 ((mem_epCut _ _ _ _).mp hg)
        have hdis : Disjoint (epCut α β C) (epCut α β (N \ C)) := by
          rw [Finset.disjoint_left]
          intro g hg1 hg2
          exact (hpart g).2.2 ((mem_epCut _ _ _ _).mp hg1) ((mem_epCut _ _ _ _).mp hg2)
        have := Finset.card_le_card hsub
        rw [Finset.card_union_of_disjoint hdis, hcomplN] at this
        rcases hNcut with h' | h' <;> omega
      obtain ⟨v, hvA, hv1⟩ := hex
      obtain ⟨hvN, hvC⟩ := Finset.mem_sdiff.mp hvA
      have hdCv : Disjoint C ({v} : Finset W) := Finset.disjoint_singleton_right.mpr hvC
      have e1 := ep_cut_union α β C {v} hdCv
      rw [hC2, h.2 v (hNL hvN)] at e1
      obtain ⟨w, hwA, hwv⟩ : ∃ w ∈ N \ C, w ≠ v := by
        by_contra hcon
        push_neg at hcon
        have : N \ C ⊆ {v} := fun w hw => Finset.mem_singleton.mpr (hcon w hw)
        have := Finset.card_le_card this
        rw [Finset.card_singleton] at this
        omega
      refine noins (C ∪ {v}) (Finset.union_subset hCN.1 (Finset.singleton_subset_iff.mpr hvN))
        Finset.subset_union_left (by omega) ?_ ?_
      · exact Finset.card_pos.mpr ⟨v, Finset.mem_inter.mpr ⟨hvA,
          Finset.mem_union_right _ (Finset.mem_singleton_self v)⟩⟩
      · refine Finset.card_pos.mpr ⟨w, Finset.mem_sdiff.mpr ⟨hwA, fun h' => ?_⟩⟩
        rcases Finset.mem_union.mp h' with h'' | h''
        · exact (Finset.mem_sdiff.mp hwA).2 h''
        · exact hwv (Finset.mem_singleton.mp h'')
  refine ⟨hA1, ?_, hone⟩
  by_cases h2 : (epCut α β N).card = 2 ∨ (epCut α β C).card = 2
  · rw [hone h2]; omega
  · push_neg at h2
    obtain ⟨x, y, -, -, -, -, -, -, hxy, hA, -⟩ := ep_rung_node α β L r 𝒮 𝒴 h hb hconn hr hdec
      href hmax hnc N C hN hch (hNcut.resolve_left h2.1) (hCcut.resolve_left h2.2)
    rw [hA, Finset.card_pair hxy]

open Classical in
/-- A triangle of a 3-cut contraction that avoids the new vertex is a triangle of the original
multigraph, disjoint from the contracted set. -/
theorem epCon_triangle_back {W E : Type*} [Fintype E] (α β : E → W) (L X : Finset W)
    (x₀ x₁ : W) (hx₀ : x₀ ∈ X) (hx₁ : x₁ ∈ X) (p q r : W) (e1 e2 e3 : E)
    (ht : EpTriangle (epConA α β X x₀ x₁) (epConB α β X x₀ x₁) (epL' L X x₀) p q r e1 e2 e3)
    (hp : p ≠ x₀) (hq : q ≠ x₀) (hr : r ≠ x₀) :
    EpTriangle α β L p q r e1 e2 e3 ∧ p ∉ X ∧ q ∉ X ∧ r ∉ X := by
  obtain ⟨hpL, hqL, hrL, hpq, hqr, hpr, h1, h2, h3⟩ := ht
  have hout : ∀ w, w ∈ epL' L X x₀ → w ≠ x₀ → w ∈ L ∧ w ∉ X := by
    intro w hw hwp
    unfold epL' at hw
    rcases Finset.mem_insert.mp hw with h' | h'
    · exact absurd h' hwp
    · exact Finset.mem_sdiff.mp h'
  obtain ⟨hpL', hpX⟩ := hout p hpL hp
  obtain ⟨hqL', hqX⟩ := hout q hqL hq
  obtain ⟨hrL', hrX⟩ := hout r hrL hr
  have hedge : ∀ (e : E) (a b : W), a ≠ b → a ∉ X → b ∉ X →
      (∀ w, epCross (epConA α β X x₀ x₁) (epConB α β X x₀ x₁) {w} e ↔ w = a ∨ w = b) →
      ∀ w, epCross α β {w} e ↔ w = a ∨ w = b := by
    intro e a b hab ha hb he w
    apply ep_edge_cross α β a b e hab
    rcases ep_edge_ends _ _ a b e hab he with h' | h'
    · exact Or.inl (epCon_ends_out α β X x₀ x₁ hx₀ hx₁ e a b ha hb h')
    · exact Or.inr (epCon_ends_out α β X x₀ x₁ hx₀ hx₁ e b a hb ha h')
  exact ⟨⟨hpL', hqL', hrL', hpq, hqr, hpr, hedge e1 p q hpq hpX hqX h1,
    hedge e2 q r hqr hqX hrX h2, hedge e3 r p (Ne.symm hpr) hrX hpX h3⟩, hpX, hqX, hrX⟩

open Classical in
/-- An edge not inside the contracted set joins the images of its ends. -/
lemma epCon_adj {W E : Type*} (α β : E → W) (X : Finset W) (x₀ x₁ : W) (g : E) (p q : W)
    (hin : ¬(α g ∈ X ∧ β g ∈ X)) (hg : (α g = p ∧ β g = q) ∨ (α g = q ∧ β g = p)) :
    EpAdj (epConA α β X x₀ x₁) (epConB α β X x₀ x₁) (epRho X x₀ p) (epRho X x₀ q) := by
  refine ⟨g, ?_⟩
  unfold epConA epConB
  rw [if_neg hin, if_neg hin]
  rcases hg with ⟨h1, h2⟩ | ⟨h1, h2⟩
  · exact Or.inl ⟨by rw [h1], by rw [h2]⟩
  · exact Or.inr ⟨by rw [h1], by rw [h2]⟩

open Classical in
/-- A vertex of a triangle has only one edge besides the two triangle edges. -/
lemma ep_triangle_one_out {W E : Type*} [Fintype E] (α β : E → W) (L : Finset W)
    (h : EpCubicD α β L) (x y z : W) (exy eyz ezx : E)
    (ht : EpTriangle α β L x y z exy eyz ezx) (g g' : E) (hg : epCross α β {x} g)
    (hg' : epCross α β {x} g') (h1 : g ≠ exy) (h2 : g ≠ ezx) (h3 : g' ≠ exy) (h4 : g' ≠ ezx) :
    g = g' := by
  obtain ⟨hx, hy, hz, hxy, hyz, hxz, c1, c2, c3⟩ := ht
  by_contra hne
  have hee : exy ≠ ezx := by
    intro he
    have := (c1 y).mpr (Or.inr rfl)
    rw [he, c3] at this
    exact this.elim hyz (fun h' => hxy h'.symm)
  have hsub : ({exy, ezx, g, g'} : Finset E) ⊆ epCut α β {x} := by
    intro w hw
    rw [mem_epCut]
    simp only [Finset.mem_insert, Finset.mem_singleton] at hw
    rcases hw with rfl | rfl | rfl | rfl
    · exact (c1 x).mpr (Or.inl rfl)
    · exact (c3 x).mpr (Or.inr rfl)
    · exact hg
    · exact hg'
  have hcard : ({exy, ezx, g, g'} : Finset E).card = 4 := by
    rw [Finset.card_insert_of_notMem, Finset.card_insert_of_notMem, Finset.card_pair hne]
    · simp only [Finset.mem_insert, Finset.mem_singleton]
      exact fun h' => h'.elim (fun h'' => h2 h''.symm) (fun h'' => h4 h''.symm)
    · simp only [Finset.mem_insert, Finset.mem_singleton]
      rintro (h' | h' | h')
      · exact hee h'
      · exact h1 h'.symm
      · exact h3 h'.symm
  have := Finset.card_le_card hsub
  rw [hcard, h.2 x hx] at this
  omega

set_option maxHeartbeats 1600000 in
open Classical in
/-- **Relevance is preserved by contractions.** A relevant triangle disjoint from a contracted
set is relevant in the contraction. -/
theorem epCon_relevant {W E : Type*} [Fintype E] (α β : E → W) (L X : Finset W) (x₀ x₁ : W)
    (h : EpCubicD α β L) (hx₀ : x₀ ∈ X) (x y z : W) (exy eyz ezx : E)
    (ht : EpTriangle α β L x y z exy eyz ezx) (hxX : x ∉ X) (hyX : y ∉ X) (hzX : z ∉ X)
    (hrel : ¬EpIrrelevant α β x y z) :
    ¬EpIrrelevant (epConA α β X x₀ x₁) (epConB α β X x₀ x₁) x y z := by
  intro hirr'
  have hTmem : ∀ w, w ∈ ({x, y, z} : Finset W) ↔ w = x ∨ w = y ∨ w = z := by
    intro w; simp only [Finset.mem_insert, Finset.mem_singleton]
  have hTX : ∀ w, w ∈ ({x, y, z} : Finset W) → w ∉ X := by
    intro w hw
    rcases (hTmem w).mp hw with rfl | rfl | rfl <;> assumption
  have hTL : ∀ w, w ∈ ({x, y, z} : Finset W) → w ∈ L := by
    intro w hw
    rcases (hTmem w).mp hw with rfl | rfl | rfl
    · exact ht.1
    · exact ht.2.1
    · exact ht.2.2.1
  unfold EpIrrelevant at hrel
  push_neg at hrel
  obtain ⟨u, hu, v, hv, a, b, haT, hbT, ⟨g, hg⟩, ⟨g', hg'⟩, hab⟩ := hrel
  have hρT : ∀ w, w ∉ ({x, y, z} : Finset W) → epRho X x₀ w ∉ ({x, y, z} : Finset W) := by
    intro w hw
    unfold epRho
    by_cases hwX : w ∈ X
    · rw [if_pos hwX]; exact fun h' => hTX x₀ h' hx₀
    · rw [if_neg hwX]; exact hw
  have hρu : ∀ w, w ∈ ({x, y, z} : Finset W) → epRho X x₀ w = w := by
    intro w hw; unfold epRho; rw [if_neg (hTX w hw)]
  have hadj1 := epCon_adj α β X x₀ x₁ g u a
    (fun h' => by rcases hg with ⟨e1, -⟩ | ⟨-, e2⟩
                  · exact hTX u hu (e1 ▸ h'.1)
                  · exact hTX u hu (e2 ▸ h'.2)) hg
  have hadj2 := epCon_adj α β X x₀ x₁ g' v b
    (fun h' => by rcases hg' with ⟨e1, -⟩ | ⟨-, e2⟩
                  · exact hTX v hv (e1 ▸ h'.1)
                  · exact hTX v hv (e2 ▸ h'.2)) hg'
  rw [hρu u hu] at hadj1
  rw [hρu v hv] at hadj2
  obtain ⟨k1, k2⟩ := hirr' u hu v hv _ _ (hρT a haT) (hρT b hbT) hadj1 hadj2
  have hau : a ≠ u := fun h' => haT (h' ▸ hu)
  have hbv : b ≠ v := fun h' => hbT (h' ▸ hv)
  -- the two vertices of the triangle are different
  have huv : u ≠ v := by
    intro huv
    subst huv
    have hcr : ∀ (f : E) (c : W), c ≠ u → ((α f = u ∧ β f = c) ∨ (α f = c ∧ β f = u)) →
        epCross α β {u} f ∧ epCross α β {c} f := by
      intro f c hc hf
      rw [epCross_singleton, epCross_singleton]
      rcases hf with ⟨e1, e2⟩ | ⟨e1, e2⟩
      · exact ⟨Or.inl ⟨e1, fun h' => hc (e2.symm.trans h')⟩,
          Or.inr ⟨fun h' => hc (h'.symm.trans e1), e2⟩⟩
      · exact ⟨Or.inr ⟨fun h' => hc (e1.symm.trans h'), e2⟩,
          Or.inl ⟨e1, fun h' => hc (h'.symm.trans e2)⟩⟩
    obtain ⟨cg, cga⟩ := hcr g a hau hg
    obtain ⟨cg', cgb⟩ := hcr g' b hbv hg'
    -- an edge crossing `{c}` with `c` outside the triangle is not a triangle edge
    have hnot : ∀ (p q r : W) (e1 e2 e3 : E), EpTriangle α β L p q r e1 e2 e3 →
        ({p, q, r} : Finset W) = {x, y, z} → ∀ (f : E) (c : W), c ∉ ({x, y, z} : Finset W) →
        epCross α β {c} f → f ≠ e1 ∧ f ≠ e3 := by
      intro p q r e1 e2 e3 ht' hset f c hc hf
      have hcp : c ≠ p := fun h' => hc (hset ▸ h' ▸ Finset.mem_insert_self _ _)
      have hcq : c ≠ q := fun h' => hc (hset ▸ h' ▸
        Finset.mem_insert_of_mem (Finset.mem_insert_self _ _))
      have hcr' : c ≠ r := fun h' => hc (hset ▸ h' ▸ Finset.mem_insert_of_mem
        (Finset.mem_insert_of_mem (Finset.mem_singleton_self _)))
      obtain ⟨-, -, -, -, -, -, c1, -, c3⟩ := ht'
      constructor
      · intro h'; rw [h', c1] at hf; exact hf.elim hcp hcq
      · intro h'; rw [h', c3] at hf; exact hf.elim hcr' hcp
    have hgg' : g = g' := by
      rcases (hTmem u).mp hu with rfl | rfl | rfl
      · obtain ⟨n1, n2⟩ := hnot u y z exy eyz ezx ht rfl g a haT cga
        obtain ⟨n3, n4⟩ := hnot u y z exy eyz ezx ht rfl g' b hbT cgb
        exact ep_triangle_one_out α β L h u y z exy eyz ezx ht g g' cg cg' n1 n2 n3 n4
      · have hset : ({u, z, x} : Finset W) = {x, u, z} := by
          ext w; simp only [Finset.mem_insert, Finset.mem_singleton]; tauto
        obtain ⟨n1, n2⟩ := hnot u z x eyz ezx exy ht.rot hset g a haT cga
        obtain ⟨n3, n4⟩ := hnot u z x eyz ezx exy ht.rot hset g' b hbT cgb
        exact ep_triangle_one_out α β L h u z x eyz ezx exy ht.rot g g' cg cg' n1 n2 n3 n4
      · have hset : ({u, x, y} : Finset W) = {x, y, u} := by
          ext w; simp only [Finset.mem_insert, Finset.mem_singleton]; tauto
        obtain ⟨n1, n2⟩ := hnot u x y ezx exy eyz ht.rot.rot hset g a haT cga
        obtain ⟨n3, n4⟩ := hnot u x y ezx exy eyz ht.rot.rot hset g' b hbT cgb
        exact ep_triangle_one_out α β L h u x y ezx exy eyz ht.rot.rot g g' cg cg' n1 n2 n3 n4
    subst hgg'
    have hab' : a = b := by
      rcases hg with ⟨e1, e2⟩ | ⟨e1, e2⟩ <;> rcases hg' with ⟨e3, e4⟩ | ⟨e3, e4⟩
      · exact e2.symm.trans e4
      · exact absurd (e3.symm.trans e1) hbv
      · exact absurd (e1.symm.trans e3) hau
      · exact e1.symm.trans e3
    obtain ⟨g'', hg''⟩ := hab (fun h' => absurd rfl h')
    subst hab'
    have haL : a ∈ L := by
      rcases h.1 g with ⟨l1, l2, -⟩ | ⟨l1, l2⟩
      · rcases hg with ⟨e1, e2⟩ | ⟨e1, e2⟩
        · exact e2 ▸ l2
        · exact e1 ▸ l1
      · rcases hg with ⟨e1, e2⟩ | ⟨e1, e2⟩
        · exact absurd (e1 ▸ hTL u hu) l1
        · exact absurd (e2 ▸ hTL u hu) (l2 ▸ l1)
    rcases h.1 g'' with ⟨-, -, l3⟩ | ⟨l1, -⟩
    · rcases hg'' with ⟨e1, e2⟩ | ⟨e1, e2⟩ <;> exact l3 (e1.trans e2.symm)
    · rcases hg'' with ⟨e1, e2⟩ | ⟨e1, e2⟩ <;> exact l1 (e1 ▸ haL)
  have hρne := k1 huv
  have hab'' : a ≠ b := fun h' => hρne (by rw [h'])
  obtain ⟨g'', hg''⟩ := hab (fun _ => hab'')
  by_cases hin : α g'' ∈ X ∧ β g'' ∈ X
  · apply hρne
    have haX : a ∈ X := by rcases hg'' with ⟨e1, -⟩ | ⟨-, e2⟩ <;> [exact e1 ▸ hin.1; exact e2 ▸ hin.2]
    have hbX : b ∈ X := by rcases hg'' with ⟨-, e2⟩ | ⟨e1, -⟩ <;> [exact e2 ▸ hin.2; exact e1 ▸ hin.1]
    unfold epRho
    rw [if_pos haX, if_pos hbX]
  · exact k2 (epCon_adj α β X x₀ x₁ g'' a b hin hg'')

/-- Cardinality of a symmetric difference given by membership. -/
lemma ep_xor_card {E : Type*} [DecidableEq E] (A B S : Finset E)
    (hS : ∀ e, e ∈ S ↔ ¬(e ∈ A ↔ e ∈ B)) :
    S.card + 2 * (A ∩ B).card = A.card + B.card := by
  have h1 : S = (A \ B) ∪ (B \ A) := by
    ext e
    rw [hS, Finset.mem_union, Finset.mem_sdiff, Finset.mem_sdiff]
    tauto
  have hd : Disjoint (A \ B) (B \ A) := by
    rw [Finset.disjoint_left]
    intro x hx hx'
    exact (Finset.mem_sdiff.mp hx).2 (Finset.mem_sdiff.mp hx').1
  rw [h1, Finset.card_union_of_disjoint hd]
  have h2 := Finset.card_sdiff_add_card_inter A B
  have h3 := Finset.card_sdiff_add_card_inter B A
  rw [Finset.inter_comm B A] at h3
  omega


/-! ### Certificate checker for burls -/

/-- Boolean form of `epCross α β {c} e`. -/
def cInc {W E : Type*} [DecidableEq W] (α β : E → W) (c : W) (e : E) : Bool :=
  (α e == c) != (β e == c)

lemma cInc_iff {W E : Type*} [DecidableEq W] (α β : E → W) (c : W) (e : E) :
    cInc α β c e = true ↔ epCross α β {c} e := by
  unfold cInc epCross
  simp only [Finset.mem_singleton]
  by_cases h1 : α e = c <;> by_cases h2 : β e = c <;> simp [h1, h2]

/-- Boolean test "the list `S` is a local matching of the vertex list `vs`". -/
def cIsLM {W E : Type*} [DecidableEq W] (α β : E → W) (vs : List W) (S : List E) : Bool :=
  S.all (fun e => vs.contains (α e) || vs.contains (β e)) &&
    vs.all (fun c => (S.filter (cInc α β c)).length == 1)

lemma cIsLM_sound {W E : Type*} [DecidableEq W] [DecidableEq E] (α β : E → W) (vs : List W)
    (S : List E) (h : cIsLM α β vs S = true) : S.toFinset ∈ epLM α β vs.toFinset := by
  unfold cIsLM at h
  rw [Bool.and_eq_true, List.all_eq_true, List.all_eq_true] at h
  obtain ⟨h1, h2⟩ := h
  refine ⟨fun e he => ?_, fun c hc => ?_⟩
  · have := h1 e (List.mem_toFinset.mp he)
    simpa using this
  · have hlen := h2 c (List.mem_toFinset.mp hc)
    rw [beq_iff_eq, List.length_eq_one_iff] at hlen
    obtain ⟨e, he⟩ := hlen
    have hmem : ∀ g, (g ∈ S ∧ cInc α β c g = true) ↔ g = e := by
      intro g
      rw [← List.mem_filter, he, List.mem_singleton]
    refine ⟨e, ⟨List.mem_toFinset.mpr ((hmem e).mpr rfl).1,
      (cInc_iff α β c e).mp ((hmem e).mpr rfl).2⟩, ?_⟩
    rintro g ⟨hg1, hg2⟩
    exact (hmem g).mp ⟨List.mem_toFinset.mp hg1, (cInc_iff α β c g).mpr hg2⟩

/-- Symmetric difference of two lists. -/
def cXor {E : Type*} [DecidableEq E] (N D : List E) : List E :=
  N.filter (fun e => !D.contains e) ++ D.filter (fun e => !N.contains e)

lemma mem_cXor {E : Type*} [DecidableEq E] (N D : List E) (e : E) :
    e ∈ cXor N D ↔ (e ∈ N ∧ e ∉ D) ∨ (e ∈ D ∧ e ∉ N) := by
  simp [cXor]

/-- Boolean test "`D` is a flip set for `N` inside `vs`". -/
def cFlipOK {W E : Type*} [DecidableEq W] [DecidableEq E] (α β : E → W) (vs : List W)
    (N D : List E) : Bool :=
  !D.isEmpty && D.all (fun e => vs.contains (α e) && vs.contains (β e)) &&
    cIsLM α β vs (cXor N D)

/-- Boolean test "no edge of `D` shares an end with an edge of `D'`". -/
def cDisj {W E : Type*} [DecidableEq W] (α β : E → W) (D D' : List E) : Bool :=
  D.all (fun e => D'.all (fun e' =>
    α e != α e' && α e != β e' && β e != α e' && β e != β e'))

lemma cDisj_sound {W E : Type*} [DecidableEq W] [DecidableEq E] (α β : E → W) (D D' : List E)
    (h : cDisj α β D D' = true) (c : W) :
    ¬(epTouch α β D.toFinset c ∧ epTouch α β D'.toFinset c) := by
  rintro ⟨⟨e, he, hce⟩, ⟨e', he', hce'⟩⟩
  unfold cDisj at h
  rw [List.all_eq_true] at h
  have h1 := h e (List.mem_toFinset.mp he)
  rw [List.all_eq_true] at h1
  have h2 := h1 e' (List.mem_toFinset.mp he')
  simp only [Bool.and_eq_true, bne_iff_ne, ne_eq] at h2
  obtain ⟨⟨⟨a, b⟩, c'⟩, d⟩ := h2
  unfold epCross at hce hce'
  simp only [Finset.mem_singleton] at hce hce'
  rcases hce with ⟨p, -⟩ | ⟨-, p⟩ <;> rcases hce' with ⟨q, -⟩ | ⟨-, q⟩
  · exact a (p.trans q.symm)
  · exact b (p.trans q.symm)
  · exact c' (p.trans q.symm)
  · exact d (p.trans q.symm)

/-- Greedy choice of pairwise disjoint flip sets for `N` from a list of candidates. -/
def cPick {W E : Type*} [DecidableEq W] [DecidableEq E] (α β : E → W) (vs : List W)
    (N : List E) : List (List E) → List (List E) → List (List E)
  | [], ch => ch
  | D :: ds, ch =>
    if cFlipOK α β vs N D && ch.all (fun D' => cDisj α β D D') then
      cPick α β vs N ds (D :: ch)
    else cPick α β vs N ds ch

lemma cPick_inv {W E : Type*} [DecidableEq W] [DecidableEq E] (α β : E → W) (vs : List W)
    (N : List E) : ∀ (ds ch : List (List E)),
    (∀ D ∈ ch, cFlipOK α β vs N D = true) →
    ch.Pairwise (fun D D' => cDisj α β D D' = true) →
    (∀ D ∈ cPick α β vs N ds ch, cFlipOK α β vs N D = true) ∧
      (cPick α β vs N ds ch).Pairwise (fun D D' => cDisj α β D D' = true) := by
  intro ds
  induction ds with
  | nil =>
    intro ch h1 h2
    simp only [cPick]
    exact ⟨h1, h2⟩
  | cons D ds ih =>
    intro ch h1 h2
    simp only [cPick]
    split_ifs with hc
    · rw [Bool.and_eq_true, List.all_eq_true] at hc
      apply ih
      · intro D' hD'
        rcases List.mem_cons.mp hD' with rfl | h
        · exact hc.1
        · exact h1 D' h
      · exact List.pairwise_cons.mpr ⟨fun D' hD' => hc.2 D' hD', h2⟩
    · exact ih ch h1 h2

open Classical in
lemma cPick_alt {W E : Type*} [DecidableEq W] [DecidableEq E] (α β : E → W) (vs : List W)
    (N : List E) (R : List (List E)) (hok : ∀ D ∈ R, cFlipOK α β vs N D = true)
    (hpw : R.Pairwise (fun D D' => cDisj α β D D' = true)) :
    EpAlt α β vs.toFinset N.toFinset R.length := by
  have hget : ∀ i : Fin R.length, cFlipOK α β vs N (R.get i) = true :=
    fun i => hok _ (List.get_mem R i)
  have hparts : ∀ i : Fin R.length, (R.get i) ≠ [] ∧
      (∀ e ∈ R.get i, α e ∈ vs ∧ β e ∈ vs) ∧ cIsLM α β vs (cXor N (R.get i)) = true := by
    intro i
    have := hget i
    unfold cFlipOK at this
    rw [Bool.and_eq_true, Bool.and_eq_true, List.all_eq_true] at this
    obtain ⟨⟨a, b⟩, c⟩ := this
    refine ⟨?_, ?_, c⟩
    · intro hnil
      rw [hnil] at a
      simp at a
    · intro e he
      have := b e he
      simpa using this
  refine ⟨fun i => (R.get i).toFinset, ?_, ?_, ?_, ?_⟩
  · intro i
    obtain ⟨e, he⟩ := List.exists_mem_of_ne_nil _ (hparts i).1
    exact ⟨e, List.mem_toFinset.mpr he⟩
  · intro i e he
    have := (hparts i).2.1 e (List.mem_toFinset.mp he)
    exact ⟨List.mem_toFinset.mpr this.1, List.mem_toFinset.mpr this.2⟩
  · intro i
    have h1 := cIsLM_sound α β vs _ (hparts i).2.2
    have h2 : ∀ S : Finset E, (∀ e, e ∈ S ↔ e ∈ (cXor N (R.get i)).toFinset) →
        S ∈ epLM α β vs.toFinset := by
      intro S hS
      have : S = (cXor N (R.get i)).toFinset := Finset.ext hS
      rw [this]
      exact h1
    apply h2
    intro e
    simp only [Finset.mem_symmDiff, List.mem_toFinset, mem_cXor]
  · intro i j hij c
    have hp := List.pairwise_iff_get.mp hpw
    rcases lt_or_gt_of_ne hij with h | h
    · exact cDisj_sound α β _ _ (hp i j h) c
    · exact fun hh => cDisj_sound α β _ _ (hp j i h) c ⟨hh.2, hh.1⟩

/-- "The edge `e` cannot be added to the partial matching `N`." -/
def cConf {W E : Type*} [DecidableEq W] (α β : E → W) (allvs : List W) (N : List E) (e : E) :
    Bool :=
  allvs.any (fun c => cInc α β c e && N.any (cInc α β c))

/-- Exhaustive search over the local matchings extending `N`, vertex by vertex; `leaf` is
evaluated on every complete matching. -/
def cChk {W E : Type*} [DecidableEq W] (α β : E → W) (allvs : List W) (es : List E)
    (leaf : List E → Bool) : List W → List E → Bool
  | [], N => leaf N
  | v :: vs, N =>
    if N.any (cInc α β v) then cChk α β allvs es leaf vs N
    else es.all (fun e => !cInc α β v e || cConf α β allvs N e ||
      cChk α β allvs es leaf vs (e :: N))

lemma cChk_sound {W E : Type*} [DecidableEq W] [DecidableEq E] (α β : E → W) (allvs : List W)
    (es : List E) (leaf : List E → Bool) (hes : ∀ e, e ∈ es) (hnl : ∀ e, α e ≠ β e)
    (P : Finset E → Prop) (hleaf : ∀ N : List E, leaf N = true → N.Nodup → P N.toFinset)
    (M : Finset E) (hM : M ∈ epLM α β allvs.toFinset) :
    ∀ (vs : List W) (N : List E), cChk α β allvs es leaf vs N = true → N.Nodup →
      (∀ e ∈ N, e ∈ M) → (∀ c ∈ allvs, c ∉ vs → ∃ e ∈ N, epCross α β {c} e) →
      (∀ c ∈ vs, c ∈ allvs) → P M := by
  intro vs
  induction vs with
  | nil =>
    intro N h hnd hsub hcov _
    have hMN : M = N.toFinset := by
      ext g
      rw [List.mem_toFinset]
      constructor
      · intro hg
        obtain ⟨c, hc, hcg⟩ : ∃ c ∈ allvs, epCross α β {c} g := by
          rcases hM.1 g hg with h' | h'
          · exact ⟨α g, List.mem_toFinset.mp h', Or.inl ⟨Finset.mem_singleton_self _,
              fun h'' => hnl g (Finset.mem_singleton.mp h'').symm⟩⟩
          · exact ⟨β g, List.mem_toFinset.mp h', Or.inr ⟨fun h'' =>
              hnl g (Finset.mem_singleton.mp h''), Finset.mem_singleton_self _⟩⟩
        obtain ⟨e, he, hce⟩ := hcov c hc List.not_mem_nil
        obtain ⟨e₀, -, huniq⟩ := hM.2 c (List.mem_toFinset.mpr hc)
        have a1 := huniq g ⟨hg, hcg⟩
        have a2 := huniq e ⟨hsub e he, hce⟩
        rw [a1, ← a2]
        exact he
      · exact hsub g
    simp only [cChk] at h
    rw [hMN]
    exact hleaf N h hnd
  | cons v vs ih =>
    intro N h hnd hsub hcov hvs
    simp only [cChk] at h
    split_ifs at h with hv
    · apply ih N h hnd hsub
      · intro c hc hcn
        by_cases hcv : c = v
        · subst hcv
          rw [List.any_eq_true] at hv
          obtain ⟨e, he, hce⟩ := hv
          exact ⟨e, he, (cInc_iff α β c e).mp hce⟩
        · apply hcov c hc
          intro h'
          rcases List.mem_cons.mp h' with h'' | h''
          · exact hcv h''
          · exact hcn h''
      · exact fun c hc => hvs c (List.mem_cons_of_mem _ hc)
    · have hvall : v ∈ allvs := hvs v List.mem_cons_self
      obtain ⟨e, ⟨heM, hce⟩, -⟩ := hM.2 v (List.mem_toFinset.mpr hvall)
      rw [List.all_eq_true] at h
      have h1 := h e (hes e)
      have hinc : cInc α β v e = true := (cInc_iff α β v e).mpr hce
      have heN : e ∉ N := by
        intro heN
        exact hv (List.any_eq_true.mpr ⟨e, heN, hinc⟩)
      have hconf : cConf α β allvs N e = false := by
        rw [Bool.eq_false_iff]
        intro hc
        unfold cConf at hc
        rw [List.any_eq_true] at hc
        obtain ⟨c, hc1, hc2⟩ := hc
        rw [Bool.and_eq_true, List.any_eq_true] at hc2
        obtain ⟨hc3, e', he', hc4⟩ := hc2
        obtain ⟨e₀, -, hu⟩ := hM.2 c (List.mem_toFinset.mpr hc1)
        have a1 := hu e ⟨heM, (cInc_iff α β c e).mp hc3⟩
        have a2 := hu e' ⟨hsub e' he', (cInc_iff α β c e').mp hc4⟩
        exact heN ((a1.trans a2.symm) ▸ he')
      rw [hinc, hconf] at h1
      simp only [Bool.not_true, Bool.false_or] at h1
      apply ih (e :: N) h1 (List.nodup_cons.mpr ⟨heN, hnd⟩)
      · intro g hg
        rcases List.mem_cons.mp hg with rfl | hg
        · exact heM
        · exact hsub g hg
      · intro c hc hcn
        by_cases hcv : c = v
        · subst hcv
          exact ⟨e, List.mem_cons_self, hce⟩
        · have hcn' : c ∉ v :: vs := by
            intro h'
            rcases List.mem_cons.mp h' with h'' | h''
            · exact hcv h''
            · exact hcn h''
          obtain ⟨e', he', hce'⟩ := hcov c hc hcn'
          exact ⟨e', List.mem_cons_of_mem _ he', hce'⟩
      · exact fun c hc => hvs c (List.mem_cons_of_mem _ hc)

open Classical in
lemma ep_sum_ind {E : Type*} [Fintype E] (lam : E → ℝ) (N : Finset E) :
    ∑ e, lam e * epInd N e = ∑ e ∈ N, lam e := by
  unfold epInd
  simp only [mul_ite, mul_one, mul_zero]
  rw [Finset.sum_ite, Finset.sum_const_zero, add_zero]
  congr 1
  ext e
  simp

/-- The certificate check: no loops, the dual objective is at
least `1/3` (edges that do not meet the vertex set must have weight `0`), and the dual constraint holds for every local matching, with the number of
alternating cycles bounded from below by a greedy choice among the candidate flip sets. -/
def cCheck {W E : Type*} [DecidableEq W] [DecidableEq E] (α β : E → W) (vs : List W)
    (es : List E) (lam : E → ℤ) (mu : ℤ) (den : ℕ) (flips : List (List E)) : Bool :=
  es.all (fun e => α e != β e) &&
  es.all (fun e => vs.contains (α e) || vs.contains (β e) || lam e == 0) &&
  decide ((den : ℤ) ≤ 3 * mu + (es.map lam).sum) &&
  decide (0 < den) &&
  cChk α β vs es (fun N => decide (mu + (N.map lam).sum ≤
    (den : ℤ) * ((cPick α β vs N flips []).length : ℤ))) vs []

set_option maxHeartbeats 800000 in
/-- **Soundness of the certificate check.** -/
theorem cCheck_sound {W E : Type*} [DecidableEq W] [DecidableEq E] [Fintype E] (α β : E → W)
    (vs : List W) (es : List E) (hes : ∀ e, e ∈ es) (hnd : es.Nodup) (lam : E → ℤ) (mu : ℤ)
    (den : ℕ) (flips : List (List E)) (h : cCheck α β vs es lam mu den flips = true) :
    EpBurl α β vs.toFinset := by
  unfold cCheck at h
  rw [Bool.and_eq_true, Bool.and_eq_true, Bool.and_eq_true, Bool.and_eq_true] at h
  obtain ⟨⟨⟨⟨hnl0, htouch0⟩, hobj0⟩, hden0⟩, hchk⟩ := h
  have hnl : ∀ e, α e ≠ β e := by
    intro e
    have := (List.all_eq_true.mp hnl0) e (hes e)
    simpa using this
  have htouch : ∀ e, (α e ∈ vs.toFinset ∨ β e ∈ vs.toFinset) ∨ lam e = 0 := by
    intro e
    have := (List.all_eq_true.mp htouch0) e (hes e)
    simpa using this
  have hden : 0 < den := of_decide_eq_true hden0
  have huniv : (Finset.univ : Finset E) = es.toFinset := by
    ext e
    simp [hes e]
  have hobj : (den : ℤ) ≤ 3 * mu + ∑ e, lam e := by
    have := of_decide_eq_true hobj0
    rw [huniv, List.sum_toFinset lam hnd]
    exact this
  have hleaf : ∀ N : List E, decide (mu + (N.map lam).sum ≤
      (den : ℤ) * ((cPick α β vs N flips []).length : ℤ)) = true → N.Nodup →
      mu + ∑ e ∈ N.toFinset, lam e ≤ (den : ℤ) * (epAltNum α β vs.toFinset N.toFinset : ℤ) := by
    intro N hN hNnd
    have h1 := of_decide_eq_true hN
    obtain ⟨i1, i2⟩ := cPick_inv α β vs N flips []
      (fun D hD => absurd hD List.not_mem_nil) List.Pairwise.nil
    have halt := cPick_alt α β vs N _ i1 i2
    have hle := epAlt_le_altNum' α β vs.toFinset (fun e _ => hnl e) N.toFinset _ halt
    rw [List.sum_toFinset lam hNnd]
    have h2 : (den : ℤ) * ((cPick α β vs N flips []).length : ℤ) ≤
        (den : ℤ) * (epAltNum α β vs.toFinset N.toFinset : ℤ) :=
      mul_le_mul_of_nonneg_left (by exact_mod_cast hle) (by positivity)
    exact h1.trans h2
  have hP : ∀ M ∈ epLM α β vs.toFinset,
      mu + ∑ e ∈ M, lam e ≤ (den : ℤ) * (epAltNum α β vs.toFinset M : ℤ) := by
    intro M hM
    exact cChk_sound α β vs es _ hes hnl
      (fun M => mu + ∑ e ∈ M, lam e ≤ (den : ℤ) * (epAltNum α β vs.toFinset M : ℤ))
      hleaf M hM vs [] hchk List.nodup_nil (fun e he => absurd he List.not_mem_nil)
      (fun c hc hcn => absurd hc hcn) (fun c hc => hc)
  intro p hp
  obtain ⟨hp0, hpLM, hp1, hpbal⟩ := hp
  have hA : ∀ N, p N * ((mu : ℝ) + ∑ e, (lam e : ℝ) * epInd N e) ≤
      p N * ((den : ℝ) * (epAltNum α β vs.toFinset N : ℝ)) := by
    intro N
    by_cases hpN : p N = 0
    · rw [hpN, zero_mul, zero_mul]
    · have := hP N (hpLM N hpN)
      have hr : (mu : ℝ) + ∑ e ∈ N, (lam e : ℝ) ≤
          (den : ℝ) * (epAltNum α β vs.toFinset N : ℝ) := by exact_mod_cast this
      rw [ep_sum_ind]
      exact mul_le_mul_of_nonneg_left hr (hp0 N)
  have hB : ∑ N, p N * ((mu : ℝ) + ∑ e, (lam e : ℝ) * epInd N e) =
      (mu : ℝ) + (∑ e, (lam e : ℝ)) / 3 := by
    have h1 : ∀ N, p N * ((mu : ℝ) + ∑ e, (lam e : ℝ) * epInd N e) =
        p N * (mu : ℝ) + ∑ e, (lam e : ℝ) * (p N * epInd N e) := by
      intro N
      rw [mul_add, Finset.mul_sum]
      congr 1
      apply Finset.sum_congr rfl
      intro e _
      ring
    rw [Finset.sum_congr rfl (fun N _ => h1 N), Finset.sum_add_distrib, ← Finset.sum_mul, hp1,
      one_mul, Finset.sum_comm, Finset.sum_div]
    congr 1
    apply Finset.sum_congr rfl
    intro e _
    rw [← Finset.mul_sum]
    rcases htouch e with ht | ht
    · rw [hpbal e ht]
      ring
    · rw [ht]
      simp
  have hC : ∑ N, p N * ((den : ℝ) * (epAltNum α β vs.toFinset N : ℝ)) =
      (den : ℝ) * ∑ N, p N * (epAltNum α β vs.toFinset N : ℝ) := by
    rw [Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro N _
    ring
  have hD := Finset.sum_le_sum (fun N (_ : N ∈ Finset.univ) => hA N)
  rw [hB, hC] at hD
  have hobjR : (den : ℝ) ≤ 3 * (mu : ℝ) + ∑ e, (lam e : ℝ) := by exact_mod_cast hobj
  have hdenR : (0 : ℝ) < den := by exact_mod_cast hden
  have hE : (den : ℝ) * (1 / 3) ≤
      (den : ℝ) * ∑ N, p N * (epAltNum α β vs.toFinset N : ℝ) := by linarith
  exact le_of_mul_le_mul_left hE hdenR

/-- A concrete certificate: vertices `0, …, n-1` form the set `X`, larger numbers are outside
vertices; `lam`, `mu` are the dual variables multiplied by `den`; `flips` are candidate flip
sets, as lists of edge indices. -/
structure LpCert where
  n : ℕ
  edges : List (ℕ × ℕ)
  lam : List ℤ
  mu : ℤ
  den : ℕ
  flips : List (List ℕ)

def LpCert.α (c : LpCert) (e : Fin c.edges.length) : ℕ := (c.edges.get e).1

def LpCert.β (c : LpCert) (e : Fin c.edges.length) : ℕ := (c.edges.get e).2

def LpCert.check (c : LpCert) : Bool :=
  cCheck c.α c.β (List.range c.n) (List.finRange c.edges.length)
    (fun e => c.lam.getD e.1 0) c.mu c.den
    (c.flips.map (fun D => D.filterMap (fun i =>
      if h : i < c.edges.length then some ⟨i, h⟩ else none)))

theorem LpCert.sound (c : LpCert) (h : c.check = true) :
    EpBurl c.α c.β (Finset.range c.n) := by
  have := cCheck_sound c.α c.β (List.range c.n) (List.finRange c.edges.length)
    (fun e => List.mem_finRange e) (List.nodup_finRange _) _ _ _ _ h
  rwa [List.toFinset_range] at this

/-! ### The model graph of a chain pattern

A pattern is a list of node codes: `0, 1, 2` = rung node with passing rail `0, 1, 2`;
`3, 4, 5` = node between a 3-cut and a 2-cut with passing rail `0, 1, 2`; `6, 7` = node between
a 2-cut and a 3-cut with passing rail `0, 1`. -/

/-- Threading state: the edge indices of the current rails, the numbers of edges and vertices
created so far, the upper ends of the edges (in order of creation) and the lower ends found so
far. -/
structure LpSt where
  rails : List ℕ
  ne : ℕ
  nv : ℕ
  ups : List ℕ
  lows : List (ℕ × ℕ)

/-- The two rails different from `k`, in increasing order. -/
def lpOther (k : ℕ) (i : ℕ) : ℕ := ((List.range 3).filter (fun j => j != k)).getD i 0

/-- One node of the pattern. -/
def lpStep (s : LpSt) (c : ℕ) : LpSt :=
  if c / 3 = 0 then
    { rails := (s.rails.set (lpOther (c % 3) 0) s.ne).set (lpOther (c % 3) 1) (s.ne + 1),
      ne := s.ne + 3, nv := s.nv + 2, ups := s.ups ++ [s.nv, s.nv + 1, s.nv],
      lows := s.lows ++ [(s.rails.getD (lpOther (c % 3) 0) 0, s.nv),
        (s.rails.getD (lpOther (c % 3) 1) 0, s.nv + 1), (s.ne + 2, s.nv + 1)] }
  else if c / 3 = 1 then
    { rails := [s.rails.getD (c % 3) 0, s.ne], ne := s.ne + 1, nv := s.nv + 1,
      ups := s.ups ++ [s.nv],
      lows := s.lows ++ [(s.rails.getD (lpOther (c % 3) 0) 0, s.nv),
        (s.rails.getD (lpOther (c % 3) 1) 0, s.nv)] }
  else
    { rails := [s.rails.getD (c % 3) 0, s.ne, s.ne + 1], ne := s.ne + 2, nv := s.nv + 1,
      ups := s.ups ++ [s.nv, s.nv],
      lows := s.lows ++ [(s.rails.getD (1 - c % 3) 0, s.nv)] }

/-- Number of vertices of the model graph. -/
def lpNV (pat : List ℕ) : ℕ := (pat.map (fun c => if c / 3 = 0 then 2 else 1)).sum

/-- Number of rails at the top cut. -/
def lpW0 (pat : List ℕ) : ℕ := if pat.headD 0 / 3 = 2 then 2 else 3

/-- The state after the first `m` nodes. -/
def lpStAt (pat : List ℕ) (m : ℕ) : LpSt :=
  (pat.take m).foldl lpStep
    { rails := List.range (lpW0 pat), ne := lpW0 pat, nv := 0,
      ups := List.replicate (lpW0 pat) (lpNV pat), lows := [] }

/-- The edges of the model graph: vertices `0, …, lpNV pat - 1`, the outside vertex above
(`lpNV pat`) and the outside vertex below (`lpNV pat + 1`). -/
def lpEdges (pat : List ℕ) : List (ℕ × ℕ) :=
  (List.range (lpStAt pat pat.length).ne).map (fun i =>
    ((lpStAt pat pat.length).ups.getD i 0,
      (((lpStAt pat pat.length).lows.lookup i).getD (lpNV pat + 1))))

/-- A certificate for a pattern: the dual solution and the candidate flip sets, for the model
graph of the pattern. -/
structure LpCertP where
  pat : List ℕ
  lam : List ℤ
  mu : ℤ
  den : ℕ
  flips : List (List ℕ)

def LpCertP.toCert (c : LpCertP) : LpCert :=
  { n := lpNV c.pat, edges := lpEdges c.pat, lam := c.lam, mu := c.mu, den := c.den,
    flips := c.flips }

def LpCertP.check (c : LpCertP) : Bool := c.toCert.check

/-! ### Coverage: every chain pattern of ten nodes contains a certified pattern -/

/-- A search tree of certificates; the key of a certificate is computed from its reversed
pattern. The keys are only an index: nothing about them is assumed in the proofs. -/
inductive LpTree where
  | leaf : LpTree
  | node (l : LpTree) (key : ℕ) (c : LpCertP) (r : LpTree) : LpTree

def LpTree.find : LpTree → ℕ → Option LpCertP
  | .leaf, _ => none
  | .node l k c r, x => if x < k then l.find x else if k < x then r.find x else some c

def LpTree.certs : LpTree → List LpCertP
  | .leaf => []
  | .node l _ c r => l.certs ++ c :: r.certs

def LpTree.allOK : LpTree → Bool
  | .leaf => true
  | .node l _ c r => l.allOK && c.check && r.allOK

lemma LpTree.find_mem : ∀ (t : LpTree) (x : ℕ) (c : LpCertP), t.find x = some c →
    c ∈ t.certs := by
  intro t
  induction t with
  | leaf => intro x c h; simp [LpTree.find] at h
  | node l k c₀ r ihl ihr =>
    intro x c h
    simp only [LpTree.find] at h
    simp only [LpTree.certs, List.mem_append, List.mem_cons]
    split_ifs at h with h1 h2
    · exact Or.inl (ihl x c h)
    · exact Or.inr (Or.inr (ihr x c h))
    · exact Or.inr (Or.inl (Option.some.inj h).symm)

lemma LpTree.allOK_mem : ∀ t : LpTree, t.allOK = true → ∀ c ∈ t.certs, c.check = true := by
  intro t
  induction t with
  | leaf => intro _ c hc; simp [LpTree.certs] at hc
  | node l k c₀ r ihl ihr =>
    intro h c hc
    simp only [LpTree.allOK, Bool.and_eq_true] at h
    simp only [LpTree.certs, List.mem_append, List.mem_cons] at hc
    rcases hc with hc | rfl | hc
    · exact ihl h.1.1 c hc
    · exact h.1.2
    · exact ihr h.2 c hc

lemma LpTree.allOK_node (l r : LpTree) (k : ℕ) (c : LpCertP) (hl : l.allOK = true)
    (hc : c.check = true) (hr : r.allOK = true) : (LpTree.node l k c r).allOK = true := by
  simp [LpTree.allOK, hl, hc, hr]

/-- The node codes that may follow a node. -/
def lpNext : Option ℕ → List ℕ
  | none => [0, 1, 2, 3, 4, 5, 6, 7]
  | some c => if c / 3 = 1 then [6, 7] else [0, 1, 2, 3, 4, 5]

/-- `l` is a valid continuation after a node `last`. -/
def lpExt : Option ℕ → List ℕ → Prop
  | _, [] => True
  | last, c :: l => c ∈ lpNext last ∧ lpExt (some c) l

/-- Does a suffix of the chain (given in reversed order) carry a certificate? -/
def lpHit (t : LpTree) : List ℕ → ℕ → List ℕ → Bool
  | [], _, _ => false
  | c :: rest, acc, pre =>
    (match t.find (acc * 9 + c + 1) with
      | some cert => cert.pat == c :: pre
      | none => false) || lpHit t rest (acc * 9 + c + 1) (c :: pre)

lemma lpHit_sound (t : LpTree) : ∀ (rest : List ℕ) (acc : ℕ) (pre : List ℕ),
    lpHit t rest acc pre = true →
    ∃ cert ∈ t.certs, ∃ r1 r2 : List ℕ, rest = r1 ++ r2 ∧ cert.pat = r1.reverse ++ pre := by
  intro rest
  induction rest with
  | nil => intro acc pre h; simp [lpHit] at h
  | cons c rest ih =>
    intro acc pre h
    simp only [lpHit, Bool.or_eq_true] at h
    rcases h with h | h
    · cases hf : t.find (acc * 9 + c + 1) with
      | none => rw [hf] at h; simp at h
      | some cert =>
        rw [hf] at h
        have hp : cert.pat = c :: pre := by simpa using h
        exact ⟨cert, LpTree.find_mem t _ cert hf, [c], rest, rfl, by rw [hp]; rfl⟩
    · obtain ⟨cert, hc, r1, r2, h1, h2⟩ := ih _ _ h
      exact ⟨cert, hc, c :: r1, r2, by rw [h1]; rfl, by rw [h2]; simp⟩

/-- Exhaustive search: every valid continuation of the chain by `f` nodes runs into a certified
suffix. -/
def lpCov (t : LpTree) : ℕ → List ℕ → Bool
  | 0, _ => false
  | f + 1, rq =>
    (lpNext rq.head?).all (fun c => lpHit t (c :: rq) 0 [] || lpCov t f (c :: rq))

theorem lpCov_sound (t : LpTree) : ∀ (f : ℕ) (rq ext : List ℕ), lpCov t f rq = true →
    ext.length = f → lpExt rq.head? ext →
    ∃ cert ∈ t.certs, ∃ a b : List ℕ, rq.reverse ++ ext = a ++ cert.pat ++ b := by
  intro f
  induction f with
  | zero => intro rq ext h; simp [lpCov] at h
  | succ f ih =>
    intro rq ext h hlen hext
    obtain ⟨c, ext', rfl⟩ : ∃ c ext', ext = c :: ext' := by
      cases ext with
      | nil => simp at hlen
      | cons c ext' => exact ⟨c, ext', rfl⟩
    obtain ⟨hc, hext'⟩ := hext
    simp only [lpCov, List.all_eq_true] at h
    have h1 := h c hc
    rw [Bool.or_eq_true] at h1
    rcases h1 with h1 | h1
    · obtain ⟨cert, hcert, r1, r2, e1, e2⟩ := lpHit_sound t _ _ _ h1
      refine ⟨cert, hcert, r2.reverse, ext', ?_⟩
      have : rq.reverse ++ c :: ext' = (c :: rq).reverse ++ ext' := by simp
      rw [this, e1, e2]
      simp
    · obtain ⟨cert, hcert, a, b, e⟩ := ih (c :: rq) ext' h1 (by simpa using hlen) hext'
      exact ⟨cert, hcert, a, b, by rw [← e]; simp⟩

set_option maxHeartbeats 1600000 in
open Classical in
/-- **Burls are invariant under incidence isomorphism.** Let `ψ`, `ψi` be mutually inverse
bijections between the edges meeting `X` and the edges meeting `X'`, and `φ` a map from `X`
onto `X'`, such that an edge meets a vertex of `X` iff its image meets the image vertex, and
edges inside `X` correspond to edges inside `X'`. Then a burl `X'` gives a burl `X`. -/
theorem ep_burl_iso {W E W' E' : Type*} [Fintype E] [Fintype E'] (α β : E → W)
    (α' β' : E' → W') (X : Finset W) (X' : Finset W') (φ : W → W') (ψ : E → E') (ψi : E' → E)
    (hnl : ∀ e, α e ∈ X → α e ≠ β e)
    (hφ : ∀ c ∈ X, φ c ∈ X') (hφs : ∀ c' ∈ X', ∃ c ∈ X, φ c = c')
    (h1 : ∀ e, (α e ∈ X ∨ β e ∈ X) → (α' (ψ e) ∈ X' ∨ β' (ψ e) ∈ X'))
    (h2 : ∀ e', (α' e' ∈ X' ∨ β' e' ∈ X') → (α (ψi e') ∈ X ∨ β (ψi e') ∈ X))
    (h3 : ∀ e, (α e ∈ X ∨ β e ∈ X) → ψi (ψ e) = e)
    (h4 : ∀ e', (α' e' ∈ X' ∨ β' e' ∈ X') → ψ (ψi e') = e')
    (hcr : ∀ e c, (α e ∈ X ∨ β e ∈ X) → c ∈ X →
      (epCross α' β' {φ c} (ψ e) ↔ epCross α β {c} e))
    (hin : ∀ e, (α e ∈ X ∨ β e ∈ X) →
      ((α' (ψ e) ∈ X' ∧ β' (ψ e) ∈ X') ↔ (α e ∈ X ∧ β e ∈ X)))
    (hburl : EpBurl α' β' X') : EpBurl α β X := by
  -- local matchings go forward
  have hA : ∀ N : Finset E, N ∈ epLM α β X → N.image ψ ∈ epLM α' β' X' := by
    intro N hN
    refine ⟨fun e' he' => ?_, fun c' hc' => ?_⟩
    · obtain ⟨e, he, rfl⟩ := Finset.mem_image.mp he'
      exact h1 e (hN.1 e he)
    · obtain ⟨c, hc, rfl⟩ := hφs c' hc'
      obtain ⟨g, ⟨hg1, hg2⟩, huniq⟩ := hN.2 c hc
      refine ⟨ψ g, ⟨Finset.mem_image.mpr ⟨g, hg1, rfl⟩,
        (hcr g c (hN.1 g hg1) hc).mpr hg2⟩, ?_⟩
      rintro e' ⟨he', hce'⟩
      obtain ⟨g₂, hg₂, rfl⟩ := Finset.mem_image.mp he'
      rw [huniq g₂ ⟨hg₂, (hcr g₂ c (hN.1 g₂ hg₂) hc).mp hce'⟩]
  -- and come back
  have hA' : ∀ S : Finset E, (∀ e ∈ S, α e ∈ X ∨ β e ∈ X) → S.image ψ ∈ epLM α' β' X' →
      S ∈ epLM α β X := by
    intro S hS hLM
    refine ⟨hS, fun c hc => ?_⟩
    obtain ⟨e', ⟨he1, he2⟩, huniq⟩ := hLM.2 (φ c) (hφ c hc)
    obtain ⟨g, hg, rfl⟩ := Finset.mem_image.mp he1
    refine ⟨g, ⟨hg, (hcr g c (hS g hg) hc).mp he2⟩, ?_⟩
    rintro g₂ ⟨hg₂, hcg₂⟩
    have := huniq (ψ g₂) ⟨Finset.mem_image.mpr ⟨g₂, hg₂, rfl⟩,
      (hcr g₂ c (hS g₂ hg₂) hc).mpr hcg₂⟩
    rw [← h3 g₂ (hS g₂ hg₂), this, h3 g (hS g hg)]
  -- alternating families pull back
  have hB : ∀ (N : Finset E) (k : ℕ), N ∈ epLM α β X → EpAlt α' β' X' (N.image ψ) k →
      EpAlt α β X N k := by
    rintro N k hN ⟨D', hne, hins, hflip, hdisj⟩
    have hT' : ∀ i, ∀ e' ∈ D' i, α' e' ∈ X' ∨ β' e' ∈ X' := fun i e' he' =>
      Or.inl (hins i e' he').1
    have hDin : ∀ i, ∀ g ∈ (D' i).image ψi, α g ∈ X ∧ β g ∈ X := by
      intro i g hg
      obtain ⟨e', he', rfl⟩ := Finset.mem_image.mp hg
      have ht := hT' i e' he'
      have := (hin (ψi e') (h2 e' ht)).mp (by rw [h4 e' ht]; exact hins i e' he')
      exact this
    have hDmem : ∀ i g, (α g ∈ X ∨ β g ∈ X) → (g ∈ (D' i).image ψi ↔ ψ g ∈ D' i) := by
      intro i g hg
      constructor
      · intro h'
        obtain ⟨e', he', rfl⟩ := Finset.mem_image.mp h'
        rw [h4 e' (hT' i e' he')]
        exact he'
      · intro h'
        exact Finset.mem_image.mpr ⟨ψ g, h', h3 g hg⟩
    have hNmem : ∀ g, (α g ∈ X ∨ β g ∈ X) → (ψ g ∈ N.image ψ ↔ g ∈ N) := by
      intro g hg
      constructor
      · intro h'
        obtain ⟨g₀, hg₀, heq⟩ := Finset.mem_image.mp h'
        have : g₀ = g := by rw [← h3 g₀ (hN.1 g₀ hg₀), heq, h3 g hg]
        exact this ▸ hg₀
      · intro h'
        exact Finset.mem_image.mpr ⟨g, h', rfl⟩
    refine ⟨fun i => (D' i).image ψi, fun i => ?_, hDin, fun i => ?_, fun i j hij c => ?_⟩
    · obtain ⟨e', he'⟩ := hne i
      exact ⟨ψi e', Finset.mem_image.mpr ⟨e', he', rfl⟩⟩
    · have hS : ∀ e ∈ symmDiff N ((D' i).image ψi), α e ∈ X ∨ β e ∈ X := by
        intro e he
        rcases Finset.mem_symmDiff.mp he with h' | h'
        · exact hN.1 e h'.1
        · exact Or.inl (hDin i e h'.1).1
      apply hA' _ hS
      have hmap : (symmDiff N ((D' i).image ψi)).image ψ = symmDiff (N.image ψ) (D' i) := by
        ext e'
        rw [Finset.mem_image, Finset.mem_symmDiff]
        constructor
        · rintro ⟨g, hg, rfl⟩
          have hTg := hS g hg
          rcases Finset.mem_symmDiff.mp hg with ⟨a, b⟩ | ⟨a, b⟩
          · exact Or.inl ⟨(hNmem g hTg).mpr a, fun h' => b ((hDmem i g hTg).mpr h')⟩
          · exact Or.inr ⟨(hDmem i g hTg).mp a, fun h' => b ((hNmem g hTg).mp h')⟩
        · rintro (⟨a, b⟩ | ⟨a, b⟩)
          · obtain ⟨g, hg, rfl⟩ := Finset.mem_image.mp a
            have hTg := hN.1 g hg
            exact ⟨g, Finset.mem_symmDiff.mpr
              (Or.inl ⟨hg, fun h' => b ((hDmem i g hTg).mp h')⟩), rfl⟩
          · have ht := hT' i e' a
            have hTg := h2 e' ht
            have hψ := h4 e' ht
            refine ⟨ψi e', Finset.mem_symmDiff.mpr (Or.inr ⟨?_, ?_⟩), hψ⟩
            · exact Finset.mem_image.mpr ⟨e', a, rfl⟩
            · intro h'
              exact b (hψ ▸ (hNmem (ψi e') hTg).mpr h')
      rw [hmap]
      exact hflip i
    · rintro ⟨⟨g, hg, hgc⟩, ⟨g₂, hg₂, hg₂c⟩⟩
      have hgin := hDin i g hg
      have hcX : c ∈ X := by
        rw [epCross_singleton] at hgc
        rcases hgc with ⟨h', -⟩ | ⟨-, h'⟩
        · exact h' ▸ hgin.1
        · exact h' ▸ hgin.2
      have hTg : α g ∈ X ∨ β g ∈ X := Or.inl hgin.1
      have hTg₂ : α g₂ ∈ X ∨ β g₂ ∈ X := Or.inl (hDin j g₂ hg₂).1
      exact hdisj i j hij (φ c)
        ⟨⟨ψ g, (hDmem i g hTg).mp hg, (hcr g c hTg hcX).mpr hgc⟩,
          ⟨ψ g₂, (hDmem j g₂ hTg₂).mp hg₂, (hcr g₂ c hTg₂ hcX).mpr hg₂c⟩⟩
  have hnum : ∀ N : Finset E, N ∈ epLM α β X →
      epAltNum α' β' X' (N.image ψ) ≤ epAltNum α β X N :=
    fun N hN => epAlt_le_altNum' α β X hnl N _ (hB N _ hN (epAltNum_spec α' β' X' _))
  intro p hp
  obtain ⟨hp0, hpS, hp1, hpb⟩ := hp
  -- the transported distribution
  obtain ⟨p', hp'⟩ : ∃ p' : Finset E' → ℝ, ∀ N', p' N' =
      if (∀ e' ∈ N', α' e' ∈ X' ∨ β' e' ∈ X') then p (N'.image ψi) else 0 := ⟨_, fun _ => rfl⟩
  have hGF : ∀ N : Finset E, (∀ e ∈ N, α e ∈ X ∨ β e ∈ X) → (N.image ψ).image ψi = N := by
    intro N hN
    rw [Finset.image_image]
    ext e
    rw [Finset.mem_image]
    constructor
    · rintro ⟨g, hg, rfl⟩
      rw [Function.comp_apply, h3 g (hN g hg)]
      exact hg
    · intro he
      exact ⟨e, he, h3 e (hN e he)⟩
  have hFG : ∀ N' : Finset E', (∀ e' ∈ N', α' e' ∈ X' ∨ β' e' ∈ X') →
      (N'.image ψi).image ψ = N' := by
    intro N' hN'
    rw [Finset.image_image]
    ext e'
    rw [Finset.mem_image]
    constructor
    · rintro ⟨g, hg, rfl⟩
      rw [Function.comp_apply, h4 g (hN' g hg)]
      exact hg
    · intro he
      exact ⟨e', he, h4 e' (hN' e' he)⟩
  have hsumeq : ∀ f : Finset E' → ℝ,
      ∑ N' : Finset E', p' N' * f N' = ∑ N : Finset E, p N * f (N.image ψ) := by
    intro f
    have hl : ∑ N' ∈ Finset.univ.filter
        (fun N' : Finset E' => ∀ e' ∈ N', α' e' ∈ X' ∨ β' e' ∈ X'), p' N' * f N' =
        ∑ N' : Finset E', p' N' * f N' := by
      apply Finset.sum_filter_of_ne
      intro N' _ hne
      by_contra hcon
      rw [hp', if_neg hcon, zero_mul] at hne
      exact hne rfl
    have hr : ∑ N ∈ Finset.univ.filter
        (fun N : Finset E => ∀ e ∈ N, α e ∈ X ∨ β e ∈ X), p N * f (N.image ψ) =
        ∑ N : Finset E, p N * f (N.image ψ) := by
      apply Finset.sum_filter_of_ne
      intro N _ hne
      have : p N ≠ 0 := fun h' => hne (by rw [h', zero_mul])
      exact (hpS N this).1
    rw [← hl, ← hr]
    refine Finset.sum_nbij' (fun N' => N'.image ψi) (fun N => N.image ψ) ?_ ?_ ?_ ?_ ?_
    · intro N' hN'
      rw [Finset.mem_filter] at hN' ⊢
      refine ⟨Finset.mem_univ _, fun e he => ?_⟩
      obtain ⟨e', he', rfl⟩ := Finset.mem_image.mp he
      exact h2 e' (hN'.2 e' he')
    · intro N hN
      rw [Finset.mem_filter] at hN ⊢
      refine ⟨Finset.mem_univ _, fun e' he' => ?_⟩
      obtain ⟨e, he, rfl⟩ := Finset.mem_image.mp he'
      exact h1 e (hN.2 e he)
    · intro N' hN'
      exact hFG N' (Finset.mem_filter.mp hN').2
    · intro N hN
      exact hGF N (Finset.mem_filter.mp hN).2
    · intro N' hN'
      have hall := (Finset.mem_filter.mp hN').2
      rw [hp', if_pos hall, hFG N' hall]
  have hbal : EpBalanced α' β' X' p' := by
    refine ⟨fun N' => ?_, fun N' hN' => ?_, ?_, fun e' he' => ?_⟩
    · rw [hp']
      split_ifs
      · exact hp0 _
      · exact le_refl _
    · rw [hp'] at hN'
      by_cases hall : ∀ e' ∈ N', α' e' ∈ X' ∨ β' e' ∈ X'
      · rw [if_pos hall] at hN'
        have := hA _ (hpS _ hN')
        rwa [hFG N' hall] at this
      · rw [if_neg hall] at hN'
        exact absurd rfl hN'
    · have := hsumeq (fun _ => 1)
      simp only [mul_one] at this
      rw [this]
      exact hp1
    · rw [hsumeq (fun N' => epInd N' e'), ← hpb (ψi e') (h2 e' he')]
      refine Finset.sum_congr rfl fun N _ => ?_
      by_cases hpN : p N = 0
      · rw [hpN, zero_mul, zero_mul]
      · congr 1
        have hNT := (hpS N hpN).1
        have hiff : e' ∈ N.image ψ ↔ ψi e' ∈ N := by
          constructor
          · intro h'
            obtain ⟨g, hg, rfl⟩ := Finset.mem_image.mp h'
            rw [h3 g (hNT g hg)]
            exact hg
          · intro h'
            exact Finset.mem_image.mpr ⟨ψi e', h', h4 e' he'⟩
        unfold epInd
        simp only [hiff]
  have hfin := hburl p' hbal
  rw [hsumeq (fun N' => (epAltNum α' β' X' N' : ℝ))] at hfin
  refine hfin.trans (Finset.sum_le_sum fun N _ => ?_)
  by_cases hpN : p N = 0
  · rw [hpN, zero_mul, zero_mul]
  · exact mul_le_mul_of_nonneg_left (by exact_mod_cast hnum N (hpS N hpN)) (hp0 N)

/-! ### Tokens of a chain pattern

Vertex tokens `(m, i)`: node `m`, slot `i`. Edge tokens `(m, j)`: for `j < 3` the rail `j` at
the cut `m`, for `j = 3` the rung of the node `m`. -/

def lpSlots (pat : List ℕ) (m : ℕ) : ℕ := if pat.getD m 0 / 3 = 0 then 2 else 1

def lpWid (pat : List ℕ) (m : ℕ) : ℕ :=
  if m = 0 then lpW0 pat else if pat.getD (m - 1) 0 / 3 = 1 then 2 else 3

/-- The three edge tokens at a vertex token. -/
def lpVTok (pat : List ℕ) (m i : ℕ) : List (ℕ × ℕ) :=
  if pat.getD m 0 / 3 = 0 then
    [(m, lpOther (pat.getD m 0 % 3) i), (m + 1, lpOther (pat.getD m 0 % 3) i), (m, 3)]
  else if pat.getD m 0 / 3 = 1 then
    [(m, lpOther (pat.getD m 0 % 3) 0), (m, lpOther (pat.getD m 0 % 3) 1), (m + 1, 1)]
  else [(m, 1 - pat.getD m 0 % 3), (m + 1, 1), (m + 1, 2)]

def lpValidT (pat : List ℕ) (m j : ℕ) : Bool :=
  (decide (j < lpWid pat m) && decide (m ≤ pat.length)) ||
    (j == 3 && decide (m < pat.length) && pat.getD m 0 / 3 == 0)

/-- The token at which the edge of a token was created (edges of passing rails keep theirs). -/
def lpOrig (pat : List ℕ) : ℕ → ℕ → ℕ × ℕ
  | 0, j => (0, j)
  | m + 1, j =>
    if j = 3 then (m + 1, 3)
    else if pat.getD m 0 / 3 = 0 then
      (if j = pat.getD m 0 % 3 then lpOrig pat m j else (m + 1, j))
    else (if j = 0 then lpOrig pat m (pat.getD m 0 % 3) else (m + 1, j))

/-- The index of the edge of a token in the model graph. -/
def lpIdx (pat : List ℕ) (m j : ℕ) : ℕ :=
  if j = 3 then (lpStAt pat m).ne + 2 else (lpStAt pat m).rails.getD j 0

/-- The number of the vertex of a token in the model graph. -/
def lpVnum (pat : List ℕ) (m i : ℕ) : ℕ := (lpStAt pat m).nv + i

def lpAllV (pat : List ℕ) : List (ℕ × ℕ) :=
  (List.range pat.length).flatMap (fun m => (List.range (lpSlots pat m)).map (fun i => (m, i)))

def lpAllT (pat : List ℕ) : List (ℕ × ℕ) :=
  ((List.range (pat.length + 1)).flatMap (fun m => (List.range 4).map (fun j => (m, j)))).filter
    (fun t => lpValidT pat t.1 t.2)

/-- Incidence in the model graph, by edge index. -/
def lpInc (pat : List ℕ) (c e : ℕ) : Bool :=
  (((lpEdges pat).getD e (0, 0)).1 == c) != (((lpEdges pat).getD e (0, 0)).2 == c)

/-- The facts about the model graph of a pattern that the transfer uses, as a Boolean check. -/
def lpTokOK (pat : List ℕ) : Bool :=
  (lpEdges pat).all (fun e => e.1 != e.2) &&
  ((lpAllV pat).map (fun t => lpVnum pat t.1 t.2) == List.range (lpNV pat)) &&
  (lpAllT pat).all (fun t => decide (lpIdx pat t.1 t.2 < (lpEdges pat).length)) &&
  (lpAllV pat).all (fun t => (lpVTok pat t.1 t.2).all (fun s => lpValidT pat s.1 s.2)) &&
  (lpAllV pat).all (fun t => (List.range (lpEdges pat).length).all (fun e =>
    lpInc pat (lpVnum pat t.1 t.2) e ==
      ((lpVTok pat t.1 t.2).map (fun s => lpIdx pat s.1 s.2)).contains e)) &&
  (lpAllT pat).all (fun t => (lpAllT pat).all (fun s =>
    (lpIdx pat t.1 t.2 == lpIdx pat s.1 s.2) == (lpOrig pat t.1 t.2 == lpOrig pat s.1 s.2)))

/-- A vertex set `X` of a multigraph is laid out along the pattern `pat`: the vertices `v m i`
and the edges `tk m j` have the incidences that the pattern prescribes. -/
def EpTok {W E : Type*} (α β : E → W) (X : Finset W) (pat : List ℕ) (v : ℕ → ℕ → W)
    (tk : ℕ → ℕ → E) : Prop :=
  (∀ m i, m < pat.length → i < lpSlots pat m → ∀ g,
    epCross α β {v m i} g ↔ ∃ t ∈ lpVTok pat m i, g = tk t.1 t.2) ∧
  (∀ w, w ∈ X ↔ ∃ m i, m < pat.length ∧ i < lpSlots pat m ∧ w = v m i) ∧
  (∀ m i m' i', m < pat.length → i < lpSlots pat m → m' < pat.length → i' < lpSlots pat m' →
    v m i = v m' i' → m = m' ∧ i = i') ∧
  (∀ m j m' j', lpValidT pat m j = true → lpValidT pat m' j' = true →
    (tk m j = tk m' j' ↔ lpOrig pat m j = lpOrig pat m' j')) ∧
  (∀ g, α g ∈ X → α g ≠ β g)

lemma mem_lpAllV (pat : List ℕ) (m i : ℕ) :
    (m, i) ∈ lpAllV pat ↔ m < pat.length ∧ i < lpSlots pat m := by
  simp [lpAllV]

lemma mem_lpAllT (pat : List ℕ) (m j : ℕ) :
    (m, j) ∈ lpAllT pat ↔ lpValidT pat m j = true := by
  simp only [lpAllT, List.mem_filter, List.mem_flatMap, List.mem_range, List.mem_map,
    Prod.mk.injEq]
  constructor
  · exact fun h => h.2
  · intro h
    refine ⟨⟨m, ?_, j, ?_, rfl, rfl⟩, h⟩
    · unfold lpValidT at h
      simp only [Bool.or_eq_true, Bool.and_eq_true, decide_eq_true_eq, beq_iff_eq] at h
      omega
    · unfold lpValidT lpWid lpW0 at h
      simp only [Bool.or_eq_true, Bool.and_eq_true, decide_eq_true_eq, beq_iff_eq] at h
      rcases h with ⟨h1, -⟩ | ⟨⟨h1, -⟩, -⟩
      · split_ifs at h1 <;> omega
      · omega

/-- An edge without loop has both ends in `X` iff it meets two different vertices of `X`. -/
lemma ep_inner_iff {W E : Type*} (α β : E → W) (X : Finset W) (g : E) (hne : α g ≠ β g) :
    (α g ∈ X ∧ β g ∈ X) ↔
      ∃ w₁ ∈ X, ∃ w₂ ∈ X, w₁ ≠ w₂ ∧ epCross α β {w₁} g ∧ epCross α β {w₂} g := by
  constructor
  · rintro ⟨h1, h2⟩
    refine ⟨α g, h1, β g, h2, hne, ?_, ?_⟩
    · rw [epCross_singleton]; exact Or.inl ⟨rfl, fun h => hne h.symm⟩
    · rw [epCross_singleton]; exact Or.inr ⟨hne, rfl⟩
  · rintro ⟨w₁, h1, w₂, h2, hw, c1, c2⟩
    rw [epCross_singleton] at c1 c2
    rcases c1 with ⟨a, -⟩ | ⟨-, a⟩ <;> rcases c2 with ⟨b, -⟩ | ⟨-, b⟩
    · exact absurd (a.symm.trans b) hw
    · exact ⟨a ▸ h1, b ▸ h2⟩
    · exact ⟨b ▸ h2, a ▸ h1⟩
    · exact absurd (a.symm.trans b) hw


set_option maxHeartbeats 3200000 in
open Classical in
/-- **Transfer.** If `X` is laid out along the pattern of a certificate, the model graph of the
pattern has the expected incidences and the certificate passes the check, then `X` is a burl. -/
theorem ep_burl_of_tok {W E : Type*} [Fintype E] (α β : E → W) (X : Finset W) (c : LpCertP)
    (v : ℕ → ℕ → W) (tk : ℕ → ℕ → E) (htok : EpTok α β X c.pat v tk)
    (hok : lpTokOK c.pat = true) (hchk : c.check = true) : EpBurl α β X := by
  obtain ⟨hA, hB, hC, hD, hE⟩ := htok
  have hburl' := LpCert.sound c.toCert hchk
  unfold lpTokOK at hok
  rw [Bool.and_eq_true, Bool.and_eq_true, Bool.and_eq_true, Bool.and_eq_true,
    Bool.and_eq_true] at hok
  obtain ⟨⟨⟨⟨⟨m0, m1⟩, m2⟩, m3⟩, m4⟩, m5⟩ := hok
  -- the facts about the model graph
  have hmap : (lpAllV c.pat).map (fun t => lpVnum c.pat t.1 t.2) = List.range (lpNV c.pat) :=
    beq_iff_eq.mp m1
  have M0a : ∀ m i, m < c.pat.length → i < lpSlots c.pat m →
      lpVnum c.pat m i < lpNV c.pat := by
    intro m i hm hi
    have : lpVnum c.pat m i ∈ (lpAllV c.pat).map (fun t => lpVnum c.pat t.1 t.2) :=
      List.mem_map.mpr ⟨(m, i), (mem_lpAllV _ _ _).mpr ⟨hm, hi⟩, rfl⟩
    rw [hmap] at this
    exact List.mem_range.mp this
  have M0b : ∀ cn, cn < lpNV c.pat → ∃ m i, m < c.pat.length ∧ i < lpSlots c.pat m ∧
      lpVnum c.pat m i = cn := by
    intro cn hcn
    have : cn ∈ (lpAllV c.pat).map (fun t => lpVnum c.pat t.1 t.2) := by
      rw [hmap]; exact List.mem_range.mpr hcn
    obtain ⟨⟨m, i⟩, ht, rfl⟩ := List.mem_map.mp this
    obtain ⟨hm, hi⟩ := (mem_lpAllV _ _ _).mp ht
    exact ⟨m, i, hm, hi, rfl⟩
  have M0c : ∀ m i m' i', m < c.pat.length → i < lpSlots c.pat m → m' < c.pat.length →
      i' < lpSlots c.pat m' → lpVnum c.pat m i = lpVnum c.pat m' i' → m = m' ∧ i = i' := by
    intro m i m' i' hm hi hm' hi' heq
    have hnd : ((lpAllV c.pat).map (fun t => lpVnum c.pat t.1 t.2)).Nodup := by
      rw [hmap]; exact List.nodup_range
    have := List.inj_on_of_nodup_map hnd ((mem_lpAllV _ _ _).mpr ⟨hm, hi⟩)
      ((mem_lpAllV _ _ _).mpr ⟨hm', hi'⟩) heq
    exact Prod.mk.inj this
  have M1 : ∀ m j, lpValidT c.pat m j = true → lpIdx c.pat m j < (lpEdges c.pat).length := by
    intro m j hv
    exact of_decide_eq_true ((List.all_eq_true.mp m2) (m, j) ((mem_lpAllT _ _ _).mpr hv))
  have M3 : ∀ m i, m < c.pat.length → i < lpSlots c.pat m → ∀ s ∈ lpVTok c.pat m i,
      lpValidT c.pat s.1 s.2 = true := by
    intro m i hm hi s hs
    exact (List.all_eq_true.mp ((List.all_eq_true.mp m3) (m, i)
      ((mem_lpAllV _ _ _).mpr ⟨hm, hi⟩))) s hs
  have M2 : ∀ m i, m < c.pat.length → i < lpSlots c.pat m → ∀ e, e < (lpEdges c.pat).length →
      (lpInc c.pat (lpVnum c.pat m i) e = true ↔
        ∃ s ∈ lpVTok c.pat m i, lpIdx c.pat s.1 s.2 = e) := by
    intro m i hm hi e he
    have h1 := (List.all_eq_true.mp ((List.all_eq_true.mp m4) (m, i)
      ((mem_lpAllV _ _ _).mpr ⟨hm, hi⟩))) e (List.mem_range.mpr he)
    rw [beq_iff_eq] at h1
    rw [h1]
    simp only [List.contains_iff_mem, List.mem_map]
  have M4 : ∀ m j m' j', lpValidT c.pat m j = true → lpValidT c.pat m' j' = true →
      (lpIdx c.pat m j = lpIdx c.pat m' j' ↔ lpOrig c.pat m j = lpOrig c.pat m' j') := by
    intro m j m' j' hv hv'
    have h1 := (List.all_eq_true.mp ((List.all_eq_true.mp m5) (m, j)
      ((mem_lpAllT _ _ _).mpr hv))) (m', j') ((mem_lpAllT _ _ _).mpr hv')
    rw [beq_iff_eq] at h1
    rw [← beq_iff_eq, ← beq_iff_eq (a := lpOrig c.pat m j), h1]
  have hget : ∀ e : Fin c.toCert.edges.length,
      (lpEdges c.pat).getD e.1 (0, 0) = c.toCert.edges.get e := by
    intro e
    have h1 : c.toCert.edges.get e = (lpEdges c.pat)[e.1]'e.2 := rfl
    rw [h1]
    exact List.getD_eq_getElem _ _ e.2
  have Mloop : ∀ e : Fin c.toCert.edges.length, c.toCert.α e ≠ c.toCert.β e := by
    intro e
    have h1 := (List.all_eq_true.mp m0) (c.toCert.edges.get e) (List.get_mem _ e)
    simpa [LpCert.α, LpCert.β] using h1
  have hcross' : ∀ (e : Fin c.toCert.edges.length) (cn : ℕ),
      epCross c.toCert.α c.toCert.β {cn} e ↔ lpInc c.pat cn e.1 = true := by
    intro e cn
    rw [← cInc_iff]
    unfold cInc lpInc LpCert.α LpCert.β
    rw [hget e]
  have hv00 : lpValidT c.pat 0 0 = true := by
    unfold lpValidT lpWid lpW0
    simp only [Bool.or_eq_true, Bool.and_eq_true, decide_eq_true_eq]
    left
    refine ⟨?_, Nat.zero_le _⟩
    split_ifs <;> omega
  have hne0 : 0 < c.toCert.edges.length := lt_of_le_of_lt (Nat.zero_le _) (M1 0 0 hv00)
  -- the three maps
  obtain ⟨φ, hφdef⟩ : ∃ φ : W → ℕ, ∀ w, φ w =
      if h : ∃ m i, (m < c.pat.length ∧ i < lpSlots c.pat m) ∧ w = v m i then
        lpVnum c.pat h.choose h.choose_spec.choose else 0 := ⟨_, fun _ => rfl⟩
  have hφv : ∀ m i, m < c.pat.length → i < lpSlots c.pat m →
      φ (v m i) = lpVnum c.pat m i := by
    intro m i hm hi
    have hex : ∃ m' i', (m' < c.pat.length ∧ i' < lpSlots c.pat m') ∧ v m i = v m' i' :=
      ⟨m, i, ⟨hm, hi⟩, rfl⟩
    rw [hφdef, dif_pos hex]
    obtain ⟨⟨a1, a2⟩, a3⟩ := hex.choose_spec.choose_spec
    obtain ⟨e1, e2⟩ := hC m i _ _ hm hi a1 a2 a3
    exact (congrArg₂ (lpVnum c.pat) e1 e2).symm
  obtain ⟨ψ, hψdef⟩ : ∃ ψ : E → Fin c.toCert.edges.length, ∀ g, ψ g =
      if h : ∃ m j, lpValidT c.pat m j = true ∧ g = tk m j then
        ⟨lpIdx c.pat h.choose h.choose_spec.choose, M1 _ _ h.choose_spec.choose_spec.1⟩
      else ⟨0, hne0⟩ := ⟨_, fun _ => rfl⟩
  have hψt : ∀ m j, lpValidT c.pat m j = true → (ψ (tk m j)).1 = lpIdx c.pat m j := by
    intro m j hv
    have hex : ∃ m' j', lpValidT c.pat m' j' = true ∧ tk m j = tk m' j' := ⟨m, j, hv, rfl⟩
    rw [hψdef, dif_pos hex]
    obtain ⟨a1, a2⟩ := hex.choose_spec.choose_spec
    exact ((M4 _ _ _ _ hv a1).mpr ((hD _ _ _ _ hv a1).mp a2)).symm
  obtain ⟨ψi, hψidef⟩ : ∃ ψi : Fin c.toCert.edges.length → E, ∀ e, ψi e =
      if h : ∃ m j, lpValidT c.pat m j = true ∧ lpIdx c.pat m j = e.1 then
        tk h.choose h.choose_spec.choose else tk 0 0 := ⟨_, fun _ => rfl⟩
  have hψit : ∀ (e : Fin c.toCert.edges.length) m j, lpValidT c.pat m j = true →
      lpIdx c.pat m j = e.1 → ψi e = tk m j := by
    intro e m j hv he
    have hex : ∃ m' j', lpValidT c.pat m' j' = true ∧ lpIdx c.pat m' j' = e.1 :=
      ⟨m, j, hv, he⟩
    rw [hψidef, dif_pos hex]
    obtain ⟨a1, a2⟩ := hex.choose_spec.choose_spec
    exact (hD _ _ _ _ a1 hv).mpr ((M4 _ _ _ _ a1 hv).mp (a2.trans he.symm))
  -- edges meeting the vertex sets carry tokens
  have hTreal : ∀ g, (α g ∈ X ∨ β g ∈ X) → ∃ w ∈ X, epCross α β {w} g := by
    rintro g (h | h)
    · exact ⟨α g, h, (epCross_singleton _ _ _ _).mpr
        (Or.inl ⟨rfl, fun h' => hE g h h'.symm⟩)⟩
    · by_cases heq : α g = β g
      · exact absurd heq (hE g (heq ▸ h))
      · exact ⟨β g, h, (epCross_singleton _ _ _ _).mpr (Or.inr ⟨heq, rfl⟩)⟩
  have hcrT : ∀ g w, w ∈ X → epCross α β {w} g → (α g ∈ X ∨ β g ∈ X) := by
    intro g w hw hc
    rw [epCross_singleton] at hc
    rcases hc with ⟨a, -⟩ | ⟨-, a⟩
    · exact Or.inl (a ▸ hw)
    · exact Or.inr (a ▸ hw)
  have hKreal : ∀ g, (α g ∈ X ∨ β g ∈ X) → ∃ m j, lpValidT c.pat m j = true ∧ g = tk m j := by
    intro g hg
    obtain ⟨w, hw, hc⟩ := hTreal g hg
    obtain ⟨m, i, hm, hi, rfl⟩ := (hB w).mp hw
    obtain ⟨t, ht, rfl⟩ := (hA m i hm hi g).mp hc
    exact ⟨t.1, t.2, M3 m i hm hi t ht, rfl⟩
  have hTmodel : ∀ e : Fin c.toCert.edges.length,
      (c.toCert.α e ∈ Finset.range c.toCert.n ∨ c.toCert.β e ∈ Finset.range c.toCert.n) →
      ∃ cn, cn < lpNV c.pat ∧ epCross c.toCert.α c.toCert.β {cn} e := by
    rintro e (h | h)
    · exact ⟨_, Finset.mem_range.mp h, (epCross_singleton _ _ _ _).mpr
        (Or.inl ⟨rfl, fun h' => Mloop e h'.symm⟩)⟩
    · exact ⟨_, Finset.mem_range.mp h, (epCross_singleton _ _ _ _).mpr
        (Or.inr ⟨Mloop e, rfl⟩)⟩
  have hcrT' : ∀ (e : Fin c.toCert.edges.length) cn, cn < lpNV c.pat →
      epCross c.toCert.α c.toCert.β {cn} e →
      (c.toCert.α e ∈ Finset.range c.toCert.n ∨ c.toCert.β e ∈ Finset.range c.toCert.n) := by
    intro e cn hcn hc
    rw [epCross_singleton] at hc
    rcases hc with ⟨a, -⟩ | ⟨-, a⟩
    · exact Or.inl (Finset.mem_range.mpr (a ▸ hcn))
    · exact Or.inr (Finset.mem_range.mpr (a ▸ hcn))
  -- incidences correspond
  have hcr : ∀ g w, (α g ∈ X ∨ β g ∈ X) → w ∈ X →
      (epCross c.toCert.α c.toCert.β {φ w} (ψ g) ↔ epCross α β {w} g) := by
    intro g w hg hw
    obtain ⟨m, i, hm, hi, rfl⟩ := (hB w).mp hw
    obtain ⟨m₀, j₀, hv₀, rfl⟩ := hKreal g hg
    rw [hcross', hφv m i hm hi, hψt m₀ j₀ hv₀, M2 m i hm hi _ (M1 m₀ j₀ hv₀), hA m i hm hi]
    constructor
    · rintro ⟨s, hs, hidx⟩
      have hvs := M3 m i hm hi s hs
      exact ⟨s, hs, (hD _ _ _ _ hv₀ hvs).mpr ((M4 _ _ _ _ hv₀ hvs).mp hidx.symm)⟩
    · rintro ⟨s, hs, htk⟩
      have hvs := M3 m i hm hi s hs
      exact ⟨s, hs, ((M4 _ _ _ _ hv₀ hvs).mpr ((hD _ _ _ _ hv₀ hvs).mp htk)).symm⟩
  have hφX : ∀ w ∈ X, φ w < lpNV c.pat := by
    intro w hw
    obtain ⟨m, i, hm, hi, rfl⟩ := (hB w).mp hw
    rw [hφv m i hm hi]
    exact M0a m i hm hi
  have hφinj : ∀ w ∈ X, ∀ w' ∈ X, φ w = φ w' → w = w' := by
    intro w hw w' hw' heq
    obtain ⟨m, i, hm, hi, rfl⟩ := (hB w).mp hw
    obtain ⟨m', i', hm', hi', rfl⟩ := (hB w').mp hw'
    rw [hφv m i hm hi, hφv m' i' hm' hi'] at heq
    obtain ⟨e1, e2⟩ := M0c m i m' i' hm hi hm' hi' heq
    rw [e1, e2]
  have hφs : ∀ cn, cn < lpNV c.pat → ∃ w ∈ X, φ w = cn := by
    intro cn hcn
    obtain ⟨m, i, hm, hi, rfl⟩ := M0b cn hcn
    exact ⟨v m i, (hB _).mpr ⟨m, i, hm, hi, rfl⟩, hφv m i hm hi⟩
  have h3 : ∀ g, (α g ∈ X ∨ β g ∈ X) → ψi (ψ g) = g := by
    intro g hg
    obtain ⟨m, j, hv, rfl⟩ := hKreal g hg
    exact hψit _ m j hv (hψt m j hv).symm
  have hKmodel : ∀ e : Fin c.toCert.edges.length,
      (c.toCert.α e ∈ Finset.range c.toCert.n ∨ c.toCert.β e ∈ Finset.range c.toCert.n) →
      ∃ m i, m < c.pat.length ∧ i < lpSlots c.pat m ∧ ∃ s ∈ lpVTok c.pat m i,
        lpIdx c.pat s.1 s.2 = e.1 := by
    intro e he
    obtain ⟨cn, hcn, hc⟩ := hTmodel e he
    obtain ⟨m, i, hm, hi, rfl⟩ := M0b cn hcn
    rw [hcross', M2 m i hm hi _ e.2] at hc
    exact ⟨m, i, hm, hi, hc⟩
  have h4 : ∀ e : Fin c.toCert.edges.length,
      (c.toCert.α e ∈ Finset.range c.toCert.n ∨ c.toCert.β e ∈ Finset.range c.toCert.n) →
      ψ (ψi e) = e := by
    intro e he
    obtain ⟨m, i, hm, hi, s, hs, hidx⟩ := hKmodel e he
    have hvs := M3 m i hm hi s hs
    rw [hψit e s.1 s.2 hvs hidx]
    exact Fin.ext ((hψt s.1 s.2 hvs).trans hidx)
  have h1 : ∀ g, (α g ∈ X ∨ β g ∈ X) →
      (c.toCert.α (ψ g) ∈ Finset.range c.toCert.n ∨
        c.toCert.β (ψ g) ∈ Finset.range c.toCert.n) := by
    intro g hg
    obtain ⟨w, hw, hc⟩ := hTreal g hg
    exact hcrT' _ _ (hφX w hw) ((hcr g w hg hw).mpr hc)
  have h2 : ∀ e : Fin c.toCert.edges.length,
      (c.toCert.α e ∈ Finset.range c.toCert.n ∨ c.toCert.β e ∈ Finset.range c.toCert.n) →
      (α (ψi e) ∈ X ∨ β (ψi e) ∈ X) := by
    intro e he
    obtain ⟨m, i, hm, hi, s, hs, hidx⟩ := hKmodel e he
    have hvs := M3 m i hm hi s hs
    rw [hψit e s.1 s.2 hvs hidx]
    exact hcrT _ (v m i) ((hB _).mpr ⟨m, i, hm, hi, rfl⟩) ((hA m i hm hi _).mpr ⟨s, hs, rfl⟩)
  have hin : ∀ g, (α g ∈ X ∨ β g ∈ X) →
      ((c.toCert.α (ψ g) ∈ Finset.range c.toCert.n ∧
        c.toCert.β (ψ g) ∈ Finset.range c.toCert.n) ↔ (α g ∈ X ∧ β g ∈ X)) := by
    intro g hg
    have hneg : α g ≠ β g := by
      rcases hg with h | h
      · exact hE g h
      · intro heq; exact hE g (heq ▸ h) heq
    rw [ep_inner_iff α β X g hneg, ep_inner_iff c.toCert.α c.toCert.β _ (ψ g) (Mloop _)]
    constructor
    · rintro ⟨c₁, hc₁, c₂, hc₂, hne, x1, x2⟩
      obtain ⟨w₁, hw₁, rfl⟩ := hφs c₁ (Finset.mem_range.mp hc₁)
      obtain ⟨w₂, hw₂, rfl⟩ := hφs c₂ (Finset.mem_range.mp hc₂)
      exact ⟨w₁, hw₁, w₂, hw₂, fun h => hne (h ▸ rfl), (hcr g w₁ hg hw₁).mp x1,
        (hcr g w₂ hg hw₂).mp x2⟩
    · rintro ⟨w₁, hw₁, w₂, hw₂, hne, x1, x2⟩
      exact ⟨φ w₁, Finset.mem_range.mpr (hφX w₁ hw₁), φ w₂, Finset.mem_range.mpr (hφX w₂ hw₂),
        fun h => hne (hφinj w₁ hw₁ w₂ hw₂ h), (hcr g w₁ hg hw₁).mpr x1,
        (hcr g w₂ hg hw₂).mpr x2⟩
  exact ep_burl_iso α β c.toCert.α c.toCert.β X (Finset.range c.toCert.n) φ ψ ψi hE
    (fun w hw => Finset.mem_range.mpr (hφX w hw))
    (fun cn hcn => hφs cn (Finset.mem_range.mp hcn)) h1 h2 h3 h4 hcr hin hburl'

/-! ### Structure of the nodes of a chain next to a cut of size two -/

lemma ep_prop_split (p1 p2 q1 q2 : Prop) (h1 : p1 → ¬q1) (h2 : p2 → ¬q2) :
    (((p1 ∨ q1) ∧ ¬(p2 ∨ q2)) ∨ (¬(p1 ∨ q1) ∧ (p2 ∨ q2))) ↔
      ¬(((p1 ∧ ¬p2) ∨ (¬p1 ∧ p2)) ↔ ((q1 ∧ ¬q2) ∨ (¬q1 ∧ q2))) := by
  by_cases p1 <;> by_cases p2 <;> by_cases q1 <;> by_cases q2 <;> simp_all

open Classical in
/-- Splitting one vertex `u` off a set `N = C ∪ {u}`: an edge leaves `N` iff it leaves exactly
one of `{u}` and `C`; and the cut sizes are related. -/
lemma ep_split_vertex {W E : Type*} [Fintype E] (α β : E → W) (L : Finset W)
    (h : EpCubicD α β L) (N C : Finset W) (u : W) (hu : u ∈ L) (hCN : C ⊆ N)
    (hNC : N \ C = {u}) :
    (∀ g, epCross α β N g ↔ ¬(epCross α β {u} g ↔ epCross α β C g)) ∧
      (epCut α β N).card + 2 * (epCut α β {u} ∩ epCut α β C).card =
        3 + (epCut α β C).card := by
  have huN : u ∈ N ∧ u ∉ C := by
    have : u ∈ N \ C := by rw [hNC]; exact Finset.mem_singleton_self u
    exact Finset.mem_sdiff.mp this
  have hmem : ∀ w, w ∈ N ↔ w = u ∨ w ∈ C := by
    intro w
    constructor
    · intro hw
      by_cases hwC : w ∈ C
      · exact Or.inr hwC
      · have : w ∈ N \ C := Finset.mem_sdiff.mpr ⟨hw, hwC⟩
        rw [hNC] at this
        exact Or.inl (Finset.mem_singleton.mp this)
    · rintro (rfl | hw)
      · exact huN.1
      · exact hCN hw
  have hcr : ∀ g, epCross α β N g ↔ ¬(epCross α β {u} g ↔ epCross α β C g) := by
    intro g
    unfold epCross
    simp only [Finset.mem_singleton, hmem]
    exact ep_prop_split _ _ _ _ (fun h' => h' ▸ huN.2) (fun h' => h' ▸ huN.2)
  refine ⟨hcr, ?_⟩
  have hx := ep_xor_card (epCut α β {u}) (epCut α β C) (epCut α β N) (by
    intro e
    rw [mem_epCut, mem_epCut, mem_epCut]
    exact hcr e)
  rw [h.2 u hu] at hx
  exact hx

