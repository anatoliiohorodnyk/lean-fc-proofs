/-- **The pruning lemma.** In a cubic bridgeless connected multigraph on `N` vertices with `t`
pairwise disjoint triangles, every edge lies in at least `2 ^ (5t - 3N/2 - 3)` perfect
matchings. -/
theorem ep_tri_pack_count {W E : Type*} [Fintype E] (α β : E → W) (L : Finset W)
    (h : EpCubicD α β L) (hb : EpBridgeless α β L) (hconn : EpConnected α β L)
    (𝒯 : Finset (Finset W))
    (htri : ∀ T ∈ 𝒯, ∃ x y z exy eyz ezx, EpTriangle α β L x y z exy eyz ezx ∧ T = {x, y, z})
    (hdisj : ∀ T ∈ 𝒯, ∀ T' ∈ 𝒯, T ≠ T' → Disjoint T T')
    (f : E) (hf : α f ∈ L) :
    (2 : ℝ) ^ (5 * (𝒯.card : ℝ) - 3 * (L.card : ℝ) / 2 - 3) ≤ (epMe α β L f : ℝ) := by
  have hT : ∀ T ∈ 𝒯, T ⊆ L ∧ T.card = 3 ∧ (epCut α β T).card = 3 := by
    intro T hT
    obtain ⟨x, y, z, exy, eyz, ezx, ht, rfl⟩ := htri T hT
    exact ep_triangle_cut0 α β L h hb hconn x y z exy eyz ezx ht
  have hsame : ∀ T ∈ 𝒯, ∀ T' ∈ 𝒯, ∀ w, w ∈ T → w ∈ T' → T = T' := by
    intro T hT T' hT' w hw hw'
    by_contra hne
    exact Finset.disjoint_left.mp (hdisj T hT T' hT' hne) hw hw'
  obtain ⟨M, hM, hfM⟩ := epD_edge_in_pm α β L h hb f hf
  obtain ⟨B, hBcard, hB1, hB2⟩ : ∃ B : Finset E, B.card ≤ 3 ∧
      (∀ T ∈ 𝒯, α f ∈ T → β f ∈ T → epCut α β T ⊆ B) ∧
      ((∀ T ∈ 𝒯, ¬(α f ∈ T ∧ β f ∈ T)) → f ∈ B) := by
    by_cases hfi : ∃ T ∈ 𝒯, α f ∈ T ∧ β f ∈ T
    · obtain ⟨T₀, hT₀, ha, hb'⟩ := hfi
      refine ⟨epCut α β T₀, le_of_eq (hT T₀ hT₀).2.2, ?_, fun hno => absurd ⟨ha, hb'⟩ (hno T₀ hT₀)⟩
      intro T hT' ha' _
      rw [hsame T hT' T₀ hT₀ _ ha' ha]
    · refine ⟨{f}, by simp, ?_, fun _ => Finset.mem_singleton_self f⟩
      intro T hT' ha hb'
      exact absurd ⟨T, hT', ha, hb'⟩ hfi
  have hker := ep_pack_kernel (epTT α β 𝒯) 𝒯 (fun T => epCut α β T) B
  have hmatch := ep_pack_match α β L 𝒯 (fun T hT' => (hT T hT').1) hdisj
    (fun T hT' A hA hodd => by
      obtain ⟨x, y, z, exy, eyz, ezx, ht, rfl⟩ := htri T hT'
      exact ep_tri_odd_ext α β L h hb hconn x y z exy eyz ezx ht A hA hodd)
    (fun T hT' => by rw [(hT T hT').2.1]; decide) M hM f hfM B hB1 hB2
  have hedges := ep_pack_edges α β L h 𝒯 (fun T hT' => (hT T hT').1) hdisj
    (fun T hT' => (hT T hT').2.1) (fun T hT' => (hT T hT').2.2)
  have hnat : 2 ^ (epTT α β 𝒯).card ≤ 2 ^ (𝒯.card + 3) * epMe α β L f := by
    refine le_trans hker ?_
    exact Nat.mul_le_mul (Nat.pow_le_pow_right (by norm_num) (by omega)) hmatch
  have hreal : (2 : ℝ) ^ ((epTT α β 𝒯).card : ℝ) ≤
      (2 : ℝ) ^ ((𝒯.card : ℝ) + 3) * (epMe α β L f : ℝ) := by
    have : ((2 ^ (epTT α β 𝒯).card : ℕ) : ℝ) ≤ ((2 ^ (𝒯.card + 3) * epMe α β L f : ℕ) : ℝ) :=
      by exact_mod_cast hnat
    push_cast at this
    rw [Real.rpow_natCast]
    have h2 : (2 : ℝ) ^ ((𝒯.card : ℝ) + 3) = (2 : ℝ) ^ (𝒯.card + 3) := by
      rw [← Real.rpow_natCast]; push_cast; rfl
    rw [h2]
    exact this
  have hexp : 5 * (𝒯.card : ℝ) - 3 * (L.card : ℝ) / 2 - 3 ≤
      ((epTT α β 𝒯).card : ℝ) - ((𝒯.card : ℝ) + 3) := by
    have : (12 * 𝒯.card : ℝ) ≤ 2 * ((epTT α β 𝒯).card : ℝ) + 3 * (L.card : ℝ) := by
      exact_mod_cast hedges
    linarith
  calc (2 : ℝ) ^ (5 * (𝒯.card : ℝ) - 3 * (L.card : ℝ) / 2 - 3)
      ≤ (2 : ℝ) ^ (((epTT α β 𝒯).card : ℝ) - ((𝒯.card : ℝ) + 3)) :=
        Real.rpow_le_rpow_of_exponent_le (by norm_num) hexp
    _ = (2 : ℝ) ^ ((epTT α β 𝒯).card : ℝ) / (2 : ℝ) ^ ((𝒯.card : ℝ) + 3) :=
        Real.rpow_sub (by norm_num) _ _
    _ ≤ (epMe α β L f : ℝ) := by
        rw [div_le_iff₀ (Real.rpow_pos_of_pos (by norm_num) _)]
        linarith

