open Classical in
/-- **A node between a cut of size three and a cut of size two.** Its vertex `u` has two edges
in the upper cut and one in the lower cut, and one edge lies in both cuts. -/
theorem ep_b32_node {W E : Type*} [Fintype E] (α β : E → W) (L : Finset W)
    (h : EpCubicD α β L) (N C : Finset W) (u : W) (hu : u ∈ L) (hCN : C ⊆ N)
    (hNC : N \ C = {u}) (hN : (epCut α β N).card = 3) (hC : (epCut α β C).card = 2) :
    ∃ a1 a2 dn ps : E, a1 ≠ a2 ∧ a1 ≠ dn ∧ a2 ≠ dn ∧ ps ≠ a1 ∧ ps ≠ a2 ∧ ps ≠ dn ∧
      (∀ g, epCross α β {u} g ↔ g = a1 ∨ g = a2 ∨ g = dn) ∧
      (∀ g, epCross α β N g ↔ g = a1 ∨ g = a2 ∨ g = ps) ∧
      (∀ g, epCross α β C g ↔ g = dn ∨ g = ps) := by
  obtain ⟨hcr, hcard⟩ := ep_split_vertex α β L h N C u hu hCN hNC
  have hI : (epCut α β {u} ∩ epCut α β C).card = 1 := by omega
  obtain ⟨dn, hdn⟩ := Finset.card_eq_one.mp hI
  have hdnI : dn ∈ epCut α β {u} ∩ epCut α β C := by rw [hdn]; exact Finset.mem_singleton_self _
  obtain ⟨hdnu, hdnC⟩ := Finset.mem_inter.mp hdnI
  have hIm : ∀ g, g ∈ epCut α β {u} → g ∈ epCut α β C → g = dn := by
    intro g h1 h2
    have : g ∈ epCut α β {u} ∩ epCut α β C := Finset.mem_inter.mpr ⟨h1, h2⟩
    rw [hdn] at this
    exact Finset.mem_singleton.mp this
  obtain ⟨ps, hps⟩ := Finset.card_eq_one.mp (by
    rw [Finset.card_erase_of_mem hdnC, hC] : ((epCut α β C).erase dn).card = 1)
  obtain ⟨a1, a2, ha12, ha⟩ := Finset.card_eq_two.mp (by
    rw [Finset.card_erase_of_mem hdnu, h.2 u hu] : ((epCut α β {u}).erase dn).card = 2)
  have hCm : ∀ g, g ∈ epCut α β C ↔ g = dn ∨ g = ps := by
    intro g
    constructor
    · intro hg
      by_cases hgd : g = dn
      · exact Or.inl hgd
      · have : g ∈ (epCut α β C).erase dn := Finset.mem_erase.mpr ⟨hgd, hg⟩
        rw [hps] at this
        exact Or.inr (Finset.mem_singleton.mp this)
    · rintro (rfl | rfl)
      · exact hdnC
      · have : g ∈ (epCut α β C).erase dn := by rw [hps]; exact Finset.mem_singleton_self _
        exact (Finset.mem_erase.mp this).2
  have hum : ∀ g, g ∈ epCut α β {u} ↔ g = a1 ∨ g = a2 ∨ g = dn := by
    intro g
    constructor
    · intro hg
      by_cases hgd : g = dn
      · exact Or.inr (Or.inr hgd)
      · have : g ∈ (epCut α β {u}).erase dn := Finset.mem_erase.mpr ⟨hgd, hg⟩
        rw [ha, Finset.mem_insert, Finset.mem_singleton] at this
        rcases this with h' | h'
        · exact Or.inl h'
        · exact Or.inr (Or.inl h')
    · rintro (rfl | rfl | rfl)
      · have : g ∈ (epCut α β {u}).erase dn := by rw [ha]; exact Finset.mem_insert_self _ _
        exact (Finset.mem_erase.mp this).2
      · have : g ∈ (epCut α β {u}).erase dn := by
          rw [ha]; exact Finset.mem_insert_of_mem (Finset.mem_singleton_self _)
        exact (Finset.mem_erase.mp this).2
      · exact hdnu
  have hpsd : ps ≠ dn := by
    have : ps ∈ (epCut α β C).erase dn := by rw [hps]; exact Finset.mem_singleton_self _
    exact (Finset.mem_erase.mp this).1
  have ha1d : a1 ≠ dn := by
    have : a1 ∈ (epCut α β {u}).erase dn := by rw [ha]; exact Finset.mem_insert_self _ _
    exact (Finset.mem_erase.mp this).1
  have ha2d : a2 ≠ dn := by
    have : a2 ∈ (epCut α β {u}).erase dn := by
      rw [ha]; exact Finset.mem_insert_of_mem (Finset.mem_singleton_self _)
    exact (Finset.mem_erase.mp this).1
  have hpsu : ps ∉ epCut α β {u} := fun h' => hpsd (hIm ps h' ((hCm ps).mpr (Or.inr rfl)))
  have ha1C : a1 ∉ epCut α β C := fun h' => ha1d (hIm a1 ((hum a1).mpr (Or.inl rfl)) h')
  have ha2C : a2 ∉ epCut α β C :=
    fun h' => ha2d (hIm a2 ((hum a2).mpr (Or.inr (Or.inl rfl))) h')
  have hpsa1 : ps ≠ a1 := fun h' => hpsu (h' ▸ (hum a1).mpr (Or.inl rfl))
  have hpsa2 : ps ≠ a2 := fun h' => hpsu (h' ▸ (hum a2).mpr (Or.inr (Or.inl rfl)))
  refine ⟨a1, a2, dn, ps, ha12, ha1d, ha2d, hpsa1, hpsa2, hpsd, ?_, ?_, ?_⟩
  · intro g; rw [← mem_epCut]; exact hum g
  · intro g
    rw [hcr g, ← mem_epCut, ← mem_epCut, hum g, hCm g]
    constructor
    · intro hne
      by_cases hgu : g = a1 ∨ g = a2 ∨ g = dn
      · rcases hgu with rfl | rfl | rfl
        · exact Or.inl rfl
        · exact Or.inr (Or.inl rfl)
        · exact absurd ⟨fun _ => Or.inl rfl, fun _ => Or.inr (Or.inr rfl)⟩ hne
      · by_cases hgC : g = dn ∨ g = ps
        · rcases hgC with rfl | rfl
          · exact absurd (Or.inr (Or.inr rfl)) hgu
          · exact Or.inr (Or.inr rfl)
        · exact absurd ⟨fun h' => absurd h' hgu, fun h' => absurd h' hgC⟩ hne
    · rintro (rfl | rfl | rfl) hiff
      · rcases hiff.mp (Or.inl rfl) with h' | h'
        · exact ha1d h'
        · exact hpsa1 h'.symm
      · rcases hiff.mp (Or.inr (Or.inl rfl)) with h' | h'
        · exact ha2d h'
        · exact hpsa2 h'.symm
      · rcases hiff.mpr (Or.inr rfl) with h' | h' | h'
        · exact hpsa1 h'
        · exact hpsa2 h'
        · exact hpsd h'
  · intro g; rw [← mem_epCut]; exact hCm g

