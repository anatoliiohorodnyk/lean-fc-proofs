        rcases Finset.mem_insert.mp (hR₁ hw.1) with h' | h'
        · exact Finset.mem_insert.mpr (Or.inl h')
        · exact Finset.mem_insert_of_mem (Finset.mem_sdiff.mpr ⟨h', hw.2⟩)
