          rw [hP, Finset.mem_biUnion]
          rcases hT2 with ⟨h1, h2⟩ | ⟨h1, h2⟩
          · refine ⟨β e, Finset.mem_sdiff.mpr ⟨hlive.2.1, ?_⟩, ?_⟩
            · intro hbU
              obtain ⟨T', hT', hb⟩ := (hUmem _).mp hbU
              exact h2 (hnoTT T hT1 T' hT' h1 hb ▸ hb)
            · rw [mem_epCut]
              unfold epCross
              simp only [Finset.mem_singleton]
              exact Or.inr ⟨hlive.2.2, trivial⟩
          · refine ⟨α e, Finset.mem_sdiff.mpr ⟨hlive.1, ?_⟩, ?_⟩
            · intro haU
              obtain ⟨T', hT', ha⟩ := (hUmem _).mp haU
              exact h1 ((hnoTT T' hT' T hT1 ha h2).symm ▸ ha)
            · rw [mem_epCut]
              unfold epCross
              simp only [Finset.mem_singleton]
              exact Or.inl ⟨trivial, fun h' => hlive.2.2 h'.symm⟩
        rw [if_pos heP]
        have hone : (𝒯.filter (fun T => epCross α β T e)).card ≤ 1 := by
          rw [Finset.card_le_one]
          intro T₁ hT₁ T₂ hT₂
          obtain ⟨a1, a2⟩ := Finset.mem_filter.mp hT₁
          obtain ⟨b1, b2⟩ := Finset.mem_filter.mp hT₂
          rcases a2 with ⟨p1, p2⟩ | ⟨p1, p2⟩ <;> rcases b2 with ⟨q1, q2⟩ | ⟨q1, q2⟩
          · exact hsame T₁ a1 T₂ b1 _ p1 q1
          · exact hnoTT T₁ a1 T₂ b1 p1 q2
          · exact (hnoTT T₂ b1 T₁ a1 q1 p2).symm
          · exact hsame T₁ a1 T₂ b1 _ p2 q2
        omega
  have hbound : ∑ e : E, (𝒯.filter (fun T => epCross α β T e)).card ≤
      2 * (epTT α β 𝒯).card + P.card := by
    refine le_trans (Finset.sum_le_sum (fun e _ => hper e)) ?_
    rw [Finset.sum_add_distrib, ← Finset.mul_sum, Finset.sum_ite_mem, Finset.sum_ite_mem,
      Finset.univ_inter, Finset.univ_inter, Finset.sum_const, Finset.sum_const, smul_eq_mul,
      smul_eq_mul, mul_one, mul_one]
  rw [Finset.sum_congr rfl (fun T hT => hcut3 T hT), Finset.sum_const, smul_eq_mul] at hsum
  omega

/-- The ends of an edge that meets exactly the vertices `p ≠ q`. -/
lemma ep_pq_edge_ends {W E : Type*} (α β : E → W) (g : E) (p q : W) (hpq : p ≠ q)
    (H : ∀ w, epCross α β {w} g ↔ w = p ∨ w = q) :
    (α g = p ∧ β g = q) ∨ (α g = q ∧ β g = p) := by
  have hp := (H p).mpr (Or.inl rfl)
  have hq := (H q).mpr (Or.inr rfl)
  unfold epCross at hp hq
  simp only [Finset.mem_singleton] at hp hq
  rcases hp with ⟨a, b⟩ | ⟨a, b⟩ <;> rcases hq with ⟨c, d⟩ | ⟨c, d⟩
  · exact absurd (a.symm.trans c) hpq
  · exact Or.inl ⟨a, d⟩
  · exact Or.inr ⟨c, b⟩
  · exact absurd (b.symm.trans d) hpq

