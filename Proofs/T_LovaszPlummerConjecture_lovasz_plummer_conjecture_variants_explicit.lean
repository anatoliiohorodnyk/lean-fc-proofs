open Classical in
/-- In a simple cubic multigraph laid out along a model, the vertex `φ i` has as many boundary
edges as `i` lacks neighbours in the model. -/
theorem ep_model_bdry_card {W E : Type*} [Fintype E] (α β : E → W) (L X : Finset W)
    (h : EpCubicD α β L) (h4 : EpCyc4 α β L) (h6 : 6 ≤ L.card) (hXL : X ⊆ L)
    (n : ℕ) (I : List (ℕ × ℕ)) (φ : ℕ → W) (hiso : EpIsoI α β X n I φ) (i : ℕ) (hi : i < n) :
    ((epCut α β {φ i}).filter (epCross α β X)).card + (lvNbrs I n i).card = 3 := by
  obtain ⟨hφX, hφinj, hφsurj, hadj⟩ := hiso
  have hvX : φ i ∈ X := hφX i hi
  have himg : ((epCut α β {φ i}).filter (fun g => ¬epCross α β X g)).image
      (epOther α β (φ i)) = (lvNbrs I n i).image φ := by
    ext z
    simp only [Finset.mem_image, Finset.mem_filter, mem_epCut, lvNbrs, Finset.mem_range]
    constructor
    · rintro ⟨g, ⟨hgv, hgX⟩, rfl⟩
      obtain ⟨hne, hends⟩ := epOther_spec α β (φ i) g hgv
      have hzX : epOther α β (φ i) g ∈ X := by
        by_contra h'
        exact hgX ((ep_cross_set_of_ends α β X (φ i) _ g hvX hends).mpr h')
      obtain ⟨j, hj, hjz⟩ := hφsurj _ hzX
      refine ⟨j, ⟨hj, (hadj i j hi hj).mp ⟨g, ?_⟩⟩, hjz⟩
      rw [hjz]; exact hends
    · rintro ⟨j, ⟨hj, hIj⟩, rfl⟩
      obtain ⟨g, hg⟩ := (hadj i j hi hj).mpr hIj
      have hne := ep_ends_ne α β L h (φ i) (φ j) g (hXL hvX) hg
      have hc := ep_cross_both_of_ends α β (φ i) (φ j) g hne hg
      exact ⟨g, ⟨hc.1, fun hx =>
        (ep_cross_set_of_ends α β X (φ i) (φ j) g hvX hg).mp hx (hφX j hj)⟩,
        ep_ends_unique α β (φ i) (φ j) _ g hg (epOther_spec α β (φ i) g hc.1).2⟩
  have hinj : Set.InjOn (epOther α β (φ i))
      ↑((epCut α β {φ i}).filter (fun g => ¬epCross α β X g)) := by
    intro g₁ h1 g₂ h2 heq
    rw [Finset.mem_coe, Finset.mem_filter, mem_epCut] at h1 h2
    obtain ⟨hne1, he1⟩ := epOther_spec α β (φ i) g₁ h1.1
    obtain ⟨-, he2⟩ := epOther_spec α β (φ i) g₂ h2.1
    have hzX : epOther α β (φ i) g₁ ∈ X := by
      by_contra h'
      exact h1.2 ((ep_cross_set_of_ends α β X (φ i) _ g₁ hvX he1).mpr h')
    rw [← heq] at he2
    exact ep_cyc4_no_parallel α β L h h4 h6 (φ i) _ (hXL hvX) (hXL hzX) (Ne.symm hne1) g₁ g₂
      (ep_cross_both_of_ends α β (φ i) _ g₁ hne1 he1)
      (ep_cross_both_of_ends α β (φ i) _ g₂ hne1 he2)
  have hinjφ : Set.InjOn φ ↑(lvNbrs I n i) := by
    intro j₁ h1 j₂ h2 heq
    simp only [lvNbrs, Finset.coe_filter, Finset.mem_range, Set.mem_setOf_eq] at h1 h2
    exact hφinj j₁ j₂ h1.1 h2.1 heq
  have hcard : ((epCut α β {φ i}).filter (fun g => ¬epCross α β X g)).card =
      (lvNbrs I n i).card := by
    rw [← Finset.card_image_of_injOn hinj, himg, Finset.card_image_of_injOn hinjφ]
  have hsplit := Finset.card_filter_add_card_filter_not (s := epCut α β {φ i})
    (p := epCross α β X)
  rw [h.2 (φ i) (hXL hvX), hcard] at hsplit
  exact hsplit

/-- Transfer of burls along a relation between the edges meeting `X` and those meeting `X'`
that is a bijection (`ep_burl_iso` with the two edge maps chosen). -/
theorem ep_burl_of_rel {W E W' E' : Type*} [Fintype E] [Fintype E'] [Nonempty E] [Nonempty E']
    (α β : E → W) (α' β' : E' → W') (X : Finset W) (X' : Finset W') (φ : W → W')
    (R : E → E' → Prop) (hnl : ∀ e, α e ∈ X → α e ≠ β e)
    (hφ : ∀ c ∈ X, φ c ∈ X') (hφs : ∀ c' ∈ X', ∃ c ∈ X, φ c = c')
    (hR1 : ∀ e, (α e ∈ X ∨ β e ∈ X) → ∃ e', (α' e' ∈ X' ∨ β' e' ∈ X') ∧ R e e')
    (hR2 : ∀ e', (α' e' ∈ X' ∨ β' e' ∈ X') → ∃ e, (α e ∈ X ∨ β e ∈ X) ∧ R e e')
    (hU1 : ∀ e e₁ e₂, (α e ∈ X ∨ β e ∈ X) → (α' e₁ ∈ X' ∨ β' e₁ ∈ X') →
      (α' e₂ ∈ X' ∨ β' e₂ ∈ X') → R e e₁ → R e e₂ → e₁ = e₂)
    (hU2 : ∀ e₁ e₂ e', (α e₁ ∈ X ∨ β e₁ ∈ X) → (α e₂ ∈ X ∨ β e₂ ∈ X) →
      (α' e' ∈ X' ∨ β' e' ∈ X') → R e₁ e' → R e₂ e' → e₁ = e₂)
    (hcr : ∀ e e' c, (α e ∈ X ∨ β e ∈ X) → (α' e' ∈ X' ∨ β' e' ∈ X') → R e e' → c ∈ X →
      (epCross α' β' {φ c} e' ↔ epCross α β {c} e))
    (hin : ∀ e e', (α e ∈ X ∨ β e ∈ X) → (α' e' ∈ X' ∨ β' e' ∈ X') → R e e' →
      ((α' e' ∈ X' ∧ β' e' ∈ X') ↔ (α e ∈ X ∧ β e ∈ X)))
    (hburl : EpBurl α' β' X') : EpBurl α β X := by
  classical
  have h1 : ∀ e, ∃ e', (α e ∈ X ∨ β e ∈ X) → (α' e' ∈ X' ∨ β' e' ∈ X') ∧ R e e' := by
    intro e
    by_cases he : α e ∈ X ∨ β e ∈ X
    · obtain ⟨e', he'⟩ := hR1 e he
      exact ⟨e', fun _ => he'⟩
    · exact ⟨Classical.arbitrary E', fun h' => absurd h' he⟩
  have h2 : ∀ e', ∃ e, (α' e' ∈ X' ∨ β' e' ∈ X') → (α e ∈ X ∨ β e ∈ X) ∧ R e e' := by
    intro e'
    by_cases he : α' e' ∈ X' ∨ β' e' ∈ X'
    · obtain ⟨e, he'⟩ := hR2 e' he
      exact ⟨e, fun _ => he'⟩
    · exact ⟨Classical.arbitrary E, fun h' => absurd h' he⟩
  choose ψ hψ using h1
  choose ψi hψi using h2
  exact ep_burl_iso α β α' β' X X' φ ψ ψi hnl hφ hφs
    (fun e he => (hψ e he).1) (fun e' he' => (hψi e' he').1)
    (fun e he => hU2 _ _ (ψ e) (hψi _ (hψ e he).1).1 he (hψ e he).1 (hψi _ (hψ e he).1).2
      (hψ e he).2)
    (fun e' he' => hU1 (ψi e') _ _ (hψi e' he').1 (hψ _ (hψi e' he').1).1 he'
      (hψ _ (hψi e' he').1).2 (hψi e' he').2)
    (fun e c he hc => hcr e (ψ e) c he (hψ e he).1 (hψ e he).2 hc)
    (fun e he => hin e (ψ e) he (hψ e he).1 (hψ e he).2) hburl

set_option maxHeartbeats 1600000 in
open Classical in
/-- **a1. Model transfer.** A vertex set of a simple cubic multigraph whose induced graph is the
internal graph of a checked certificate is a burl. (From `LpCert.sound` and `ep_burl_iso`:
an edge meeting `X` is determined by the vertices of `X` on it, on both sides.) -/
theorem ep_burl_of_model {W E : Type*} [Fintype E] (α β : E → W) (L X : Finset W)
    (h : EpCubicD α β L) (h4 : EpCyc4 α β L) (h6 : 6 ≤ L.card) (hXL : X ⊆ L)
    (c : LpCert) (φ : ℕ → W) (hiso : EpIsoI α β X c.n c.internal φ)
    (hmod : c.ModelOK) (hchk : c.check = true) : EpBurl α β X := by
  obtain ⟨hn0, hK1, hK2, hK4b, hK4⟩ := hmod
  have hcount : ∀ i, i < c.n → ((epCut α β {φ i}).filter (epCross α β X)).card +
      (lvNbrs c.internal c.n i).card = 3 := fun i hi =>
    ep_model_bdry_card α β L X h h4 h6 hXL c.n c.internal φ hiso i hi
  obtain ⟨hφX, hφinj, hφsurj, hadj⟩ := hiso
  have hnl : ∀ e, α e ∈ X → α e ≠ β e := by
    intro g hg
    rcases h.1 g with h' | h'
    · exact h'.2.2
    · exact absurd (hXL hg) h'.1
  have hnl' : ∀ e, β e ∈ X → α e ≠ β e := by
    intro g hg
    rcases h.1 g with h' | h'
    · exact h'.2.2
    · exact absurd (by rw [← h'.2]; exact hXL hg) h'.1
  -- the inverse of `φ`
  have hinv : ∀ w, ∃ i, w ∈ X → i < c.n ∧ φ i = w := by
    intro w
    by_cases hw : w ∈ X
    · obtain ⟨i, hi⟩ := hφsurj w hw
      exact ⟨i, fun _ => hi⟩
    · exact ⟨0, fun h' => absurd h' hw⟩
  choose φi hφi using hinv
  have hφiφ : ∀ i, i < c.n → φi (φ i) = i := fun i hi =>
    hφinj _ _ (hφi (φ i) (hφX i hi)).1 hi (hφi (φ i) (hφX i hi)).2
  haveI : Nonempty E := by
    have h3 := h.2 (φ 0) (hXL (hφX 0 hn0))
    obtain ⟨g, -⟩ := Finset.card_pos.mp (by omega : 0 < (epCut α β {φ 0}).card)
    exact ⟨g⟩
  haveI : Nonempty (Fin c.edges.length) := by
    have h2 := hK4b 0 hn0
    obtain ⟨j, hj⟩ := Finset.card_pos.mp (by omega : 0 < (lvNbrs c.internal c.n 0).card)
    simp only [lvNbrs, Finset.mem_filter] at hj
    rcases hj.2 with h' | h'
    · obtain ⟨⟨e, -⟩, -⟩ := (c.mem_internal _ _).mp h'
      exact ⟨e⟩
    · obtain ⟨⟨e, -⟩, -⟩ := (c.mem_internal _ _).mp h'
      exact ⟨e⟩
  have hcrossK : ∀ (e' : Fin c.edges.length) (i : ℕ),
      epCross c.α c.β {i} e' ↔ (c.α e' = i ∨ c.β e' = i) := by
    intro e' i
    have hne := hK1 e'
    rw [epCross_singleton]
    constructor
    · rintro (⟨a, -⟩ | ⟨-, b⟩)
      · exact Or.inl a
      · exact Or.inr b
    · rintro (a | b)
      · exact Or.inl ⟨a, fun b => hne (a.trans b.symm)⟩
      · exact Or.inr ⟨fun a => hne (a.trans b.symm), b⟩
  -- a real edge meeting `X` has an end `φ i` and another end
  have hreal : ∀ g, (α g ∈ X ∨ β g ∈ X) → ∃ i z, i < c.n ∧ z ≠ φ i ∧
      ((α g = φ i ∧ β g = z) ∨ (α g = z ∧ β g = φ i)) := by
    intro g hg
    rcases hg with hg | hg
    · obtain ⟨i, hi, hiw⟩ := hφsurj _ hg
      exact ⟨i, β g, hi, fun e => hnl g hg (by rw [e, hiw]), Or.inl ⟨hiw.symm, rfl⟩⟩
    · obtain ⟨i, hi, hiw⟩ := hφsurj _ hg
      exact ⟨i, α g, hi, fun e => hnl' g hg (by rw [e, hiw]), Or.inr ⟨rfl, hiw.symm⟩⟩
  -- a certificate edge meeting `{0, …, n-1}` has an end `i < n` and another end
  have hcert : ∀ e' : Fin c.edges.length, (c.α e' < c.n ∨ c.β e' < c.n) → ∃ i m, i < c.n ∧
      m ≠ i ∧ ((c.α e' = i ∧ c.β e' = m) ∨ (c.α e' = m ∧ c.β e' = i)) := by
    intro e' he'
    rcases he' with he' | he'
    · exact ⟨c.α e', c.β e', he', fun e => hK1 e' e.symm, Or.inl ⟨rfl, rfl⟩⟩
    · exact ⟨c.β e', c.α e', he', fun e => hK1 e' e, Or.inr ⟨rfl, rfl⟩⟩
  -- signatures
  have hsigR : ∀ g i z, i < c.n → z ≠ φ i → ((α g = φ i ∧ β g = z) ∨ (α g = z ∧ β g = φ i)) →
      ∀ k, k < c.n → (epCross α β {φ k} g ↔ (k = i ∨ φ k = z)) := by
    intro g i z hi hz hends k hk
    rw [ep_cross_iff_of_ends α β (φ i) z (φ k) g hz hends]
    constructor
    · rintro (e | e)
      · exact Or.inl (hφinj k i hk hi e)
      · exact Or.inr e
    · rintro (e | e)
      · exact Or.inl (by rw [e])
      · exact Or.inr e
  have hsigC : ∀ (e' : Fin c.edges.length) (i m : ℕ), m ≠ i →
      ((c.α e' = i ∧ c.β e' = m) ∨ (c.α e' = m ∧ c.β e' = i)) →
      ∀ k, ((c.α e' = k ∨ c.β e' = k) ↔ (k = i ∨ k = m)) := by
    intro e' i m hm hends k
    rcases hends with ⟨b1, b2⟩ | ⟨b1, b2⟩ <;> rw [b1, b2]
    · exact ⟨fun h' => h'.elim (fun e => Or.inl e.symm) (fun e => Or.inr e.symm),
        fun h' => h'.elim (fun e => Or.inl e.symm) (fun e => Or.inr e.symm)⟩
    · exact ⟨fun h' => h'.elim (fun e => Or.inr e.symm) (fun e => Or.inl e.symm),
        fun h' => h'.elim (fun e => Or.inr e.symm) (fun e => Or.inl e.symm)⟩
  have hbd1 : ∀ i, i < c.n → ∀ g₁ g₂, epCross α β {φ i} g₁ → epCross α β X g₁ →
      epCross α β {φ i} g₂ → epCross α β X g₂ → g₁ = g₂ := by
    intro i hi g₁ g₂ a1 a2 b1 b2
    have h1 := hcount i hi
    have h2 := hK4b i hi
    have hle : ((epCut α β {φ i}).filter (epCross α β X)).card ≤ 1 := by omega
    exact Finset.card_le_one.mp hle g₁
      (Finset.mem_filter.mpr ⟨(mem_epCut _ _ _ _).mpr a1, a2⟩) g₂
      (Finset.mem_filter.mpr ⟨(mem_epCut _ _ _ _).mpr b1, b2⟩)
  refine ep_burl_of_rel α β c.α c.β X (Finset.range c.n) φi
    (fun g e' => ∀ k, k < c.n → (epCross α β {φ k} g ↔ (c.α e' = k ∨ c.β e' = k)))
    hnl (fun w hw => Finset.mem_range.mpr (hφi w hw).1)
    (fun i hi => ⟨φ i, hφX i (Finset.mem_range.mp hi), hφiφ i (Finset.mem_range.mp hi)⟩)
    ?_ ?_ ?_ ?_ ?_ ?_ (c.sound hchk)
  · -- hR1
    intro g hg
    obtain ⟨i, z, hi, hz, hends⟩ := hreal g hg
    have hs := hsigR g i z hi hz hends
    by_cases hzX : z ∈ X
    · obtain ⟨j, hj, hjz⟩ := hφsurj z hzX
      have hji : j ≠ i := fun e => hz (by rw [← hjz, e])
      have hI := (hadj i j hi hj).mp ⟨g, by rw [hjz]; exact hends⟩
      have hex : ∃ e' : Fin c.edges.length,
          (c.α e' = i ∧ c.β e' = j) ∨ (c.α e' = j ∧ c.β e' = i) := by
        rcases hI with h' | h'
        · obtain ⟨⟨e', h1, h2⟩, -⟩ := (c.mem_internal _ _).mp h'
          exact ⟨e', Or.inl ⟨h1, h2⟩⟩
        · obtain ⟨⟨e', h1, h2⟩, -⟩ := (c.mem_internal _ _).mp h'
          exact ⟨e', Or.inr ⟨h1, h2⟩⟩
      obtain ⟨e', he'⟩ := hex
      refine ⟨e', ?_, fun k hk => ?_⟩
      · rcases he' with ⟨b1, -⟩ | ⟨-, b2⟩
        · exact Or.inl (Finset.mem_range.mpr (by rw [b1]; exact hi))
        · exact Or.inr (Finset.mem_range.mpr (by rw [b2]; exact hi))
      · rw [hs k hk, hsigC e' i j hji he' k]
        constructor
        · rintro (e | e)
          · exact Or.inl e
          · exact Or.inr (hφinj k j hk hj (e.trans hjz.symm))
        · rintro (e | e)
          · exact Or.inl e
          · exact Or.inr (by rw [e, hjz])
    · have hcx : epCross α β X g :=
        (ep_cross_set_of_ends α β X (φ i) z g (hφX i hi) hends).mpr hzX
      have hci := (ep_cross_both_of_ends α β (φ i) z g hz hends).1
      have h1 := hcount i hi
      have hpos : 0 < ((epCut α β {φ i}).filter (epCross α β X)).card := Finset.card_pos.mpr
        ⟨g, Finset.mem_filter.mpr ⟨(mem_epCut _ _ _ _).mpr hci, hcx⟩⟩
      obtain ⟨e', he'⟩ := (hK4 i hi).mp (by omega)
      have hex : ∃ m, c.n ≤ m ∧ ((c.α e' = i ∧ c.β e' = m) ∨ (c.α e' = m ∧ c.β e' = i)) := by
        rcases he' with ⟨b1, b2⟩ | ⟨b1, b2⟩
        · exact ⟨_, b2, Or.inl ⟨b1, rfl⟩⟩
        · exact ⟨_, b2, Or.inr ⟨rfl, b1⟩⟩
      obtain ⟨m, hm, hem⟩ := hex
      refine ⟨e', ?_, fun k hk => ?_⟩
      · rcases hem with ⟨b1, -⟩ | ⟨-, b2⟩
        · exact Or.inl (Finset.mem_range.mpr (by rw [b1]; exact hi))
        · exact Or.inr (Finset.mem_range.mpr (by rw [b2]; exact hi))
      · rw [hs k hk, hsigC e' i m (by omega) hem k]
        constructor
        · rintro (e | e)
          · exact Or.inl e
          · exact absurd (by rw [← e]; exact hφX k hk) hzX
        · rintro (e | e)
          · exact Or.inl e
          · omega
  · -- hR2
    intro e' he'
    rw [Finset.mem_range, Finset.mem_range] at he'
    obtain ⟨i, m, hi, hmi, hem⟩ := hcert e' he'
    have hs := hsigC e' i m hmi hem
    by_cases hm : m < c.n
    · have hI : (i, m) ∈ c.internal ∨ (m, i) ∈ c.internal := by
        rcases hem with ⟨b1, b2⟩ | ⟨b1, b2⟩
        · exact Or.inl ((c.mem_internal _ _).mpr ⟨⟨e', b1, b2⟩, hi, hm⟩)
        · exact Or.inr ((c.mem_internal _ _).mpr ⟨⟨e', b1, b2⟩, hm, hi⟩)
      obtain ⟨g, hg⟩ := (hadj i m hi hm).mpr hI
      have hz : φ m ≠ φ i := fun e => hmi (hφinj m i hm hi e)
      refine ⟨g, ?_, fun k hk => ?_⟩
      · rcases hg with ⟨b1, -⟩ | ⟨-, b2⟩
        · exact Or.inl (by rw [b1]; exact hφX i hi)
        · exact Or.inr (by rw [b2]; exact hφX i hi)
      · rw [hsigR g i (φ m) hi hz hg k hk, hs k]
        constructor
        · rintro (e | e)
          · exact Or.inl e
          · exact Or.inr (hφinj k m hk hm e)
        · rintro (e | e)
          · exact Or.inl e
          · exact Or.inr (by rw [e])
    · have hle : (lvNbrs c.internal c.n i).card ≤ 2 := (hK4 i hi).mpr ⟨e', by
        rcases hem with ⟨b1, b2⟩ | ⟨b1, b2⟩
        · exact Or.inl ⟨b1, by rw [b2]; omega⟩
        · exact Or.inr ⟨b2, by rw [b1]; omega⟩⟩
      have h1 := hcount i hi
      obtain ⟨g, hg⟩ := Finset.card_pos.mp
        (by omega : 0 < ((epCut α β {φ i}).filter (epCross α β X)).card)
      obtain ⟨hgi, hgX⟩ := Finset.mem_filter.mp hg
      rw [mem_epCut] at hgi
      obtain ⟨z, hz, hends⟩ := ep_cross_other α β (φ i) g hgi
      have hzX : z ∉ X := (ep_cross_set_of_ends α β X (φ i) z g (hφX i hi) hends).mp hgX
      refine ⟨g, ?_, fun k hk => ?_⟩
      · rcases hends with ⟨b1, -⟩ | ⟨-, b2⟩
        · exact Or.inl (by rw [b1]; exact hφX i hi)
        · exact Or.inr (by rw [b2]; exact hφX i hi)
      · rw [hsigR g i z hi hz hends k hk, hs k]
        constructor
        · rintro (e | e)
          · exact Or.inl e
          · exact absurd (by rw [← e]; exact hφX k hk) hzX
        · rintro (e | e)
          · exact Or.inl e
          · omega
  · -- hU1
    intro g e₁ e₂ hg he₁ he₂ hR₁ hR₂
    rw [Finset.mem_range, Finset.mem_range] at he₁
    exact hK2 e₁ e₂ he₁ (fun i hi => (hR₁ i hi).symm.trans (hR₂ i hi))
  · -- hU2
    intro g₁ g₂ e' hg₁ hg₂ he' hR₁ hR₂
    have hsig : ∀ k, k < c.n → (epCross α β {φ k} g₁ ↔ epCross α β {φ k} g₂) :=
      fun k hk => (hR₁ k hk).trans (hR₂ k hk).symm
    obtain ⟨i, z, hi, hz, hends⟩ := hreal g₁ hg₁
    have hc₁ := ep_cross_both_of_ends α β (φ i) z g₁ hz hends
    have hc₂ : epCross α β {φ i} g₂ := (hsig i hi).mp hc₁.1
    by_cases hzX : z ∈ X
    · obtain ⟨j, hj, hjz⟩ := hφsurj z hzX
      have hc₂' : epCross α β {z} g₂ := by
        rw [← hjz]; exact (hsig j hj).mp (by rw [hjz]; exact hc₁.2)
      exact ep_cyc4_no_parallel α β L h h4 h6 (φ i) z (hXL (hφX i hi)) (hXL hzX)
        (Ne.symm hz) g₁ g₂ hc₁ ⟨hc₂, hc₂'⟩
    · have hx₁ : epCross α β X g₁ :=
        (ep_cross_set_of_ends α β X (φ i) z g₁ (hφX i hi) hends).mpr hzX
      obtain ⟨z₂, hz₂, hends₂⟩ := ep_cross_other α β (φ i) g₂ hc₂
      have hz₂X : z₂ ∉ X := by
        intro hin
        obtain ⟨j, hj, hjz⟩ := hφsurj z₂ hin
        have hcj : epCross α β {φ j} g₂ := by
          rw [hjz]; exact (ep_cross_both_of_ends α β (φ i) z₂ g₂ hz₂ hends₂).2
        have := (ep_cross_iff_of_ends α β (φ i) z (φ j) g₁ hz hends).mp ((hsig j hj).mpr hcj)
        rcases this with e | e
        · exact hz₂ (by rw [← hjz, e])
        · exact hzX (by rw [← e]; exact hφX j hj)
      have hx₂ : epCross α β X g₂ :=
        (ep_cross_set_of_ends α β X (φ i) z₂ g₂ (hφX i hi) hends₂).mpr hz₂X
      exact hbd1 i hi g₁ g₂ hc₁.1 hx₁ hc₂ hx₂
  · -- hcr
    intro g e' w hg he' hR hw
    have := hR (φi w) (hφi w hw).1
    rw [(hφi w hw).2] at this
    rw [hcrossK]
    exact this.symm
  · -- hin
    intro g e' hg he' hR
    have hneg : α g ≠ β g := by
      rcases hg with h' | h'
      · exact hnl g h'
      · exact hnl' g h'
    rw [ep_inner_iff α β X g hneg, ep_inner_iff c.α c.β _ e' (hK1 e')]
    constructor
    · rintro ⟨c₁, hc₁, c₂, hc₂, hne, x1, x2⟩
      rw [Finset.mem_range] at hc₁ hc₂
      exact ⟨φ c₁, hφX c₁ hc₁, φ c₂, hφX c₂ hc₂, fun h' => hne (hφinj _ _ hc₁ hc₂ h'),
        (hR c₁ hc₁).mpr ((hcrossK _ _).mp x1), (hR c₂ hc₂).mpr ((hcrossK _ _).mp x2)⟩
    · rintro ⟨w₁, hw₁, w₂, hw₂, hne, x1, x2⟩
      obtain ⟨i₁, hi₁, hiw₁⟩ := hφsurj w₁ hw₁
      obtain ⟨i₂, hi₂, hiw₂⟩ := hφsurj w₂ hw₂
      rw [← hiw₁] at x1
      rw [← hiw₂] at x2
      exact ⟨i₁, Finset.mem_range.mpr hi₁, i₂, Finset.mem_range.mpr hi₂,
        fun h' => hne (by rw [← hiw₁, ← hiw₂, h']),
        (hcrossK _ _).mpr ((hR i₁ hi₁).mp x1), (hcrossK _ _).mpr ((hR i₂ hi₂).mp x2)⟩

lemma ep_adj_comm {W E : Type*} (α β : E → W) (u v : W) : EpAdj α β u v ↔ EpAdj α β v u :=
  ⟨fun ⟨g, hg⟩ => ⟨g, hg.symm⟩, fun ⟨g, hg⟩ => ⟨g, hg.symm⟩⟩

lemma mem_lvExt (I : List (ℕ × ℕ)) (n i j k l : ℕ) :
    (k, l) ∈ lvExt I n i j ↔
      (k, l) ∈ I ∨ (k = i ∧ l = n) ∨ (k = j ∧ l = n + 1) ∨ (k = n ∧ l = n + 1) := by
  simp [lvExt]

lemma ep_card_sdiff_pair {W : Type*} [DecidableEq W] (X : Finset W) (u a : W) (hu : u ∈ X)
    (ha : a ∈ X) (hua : u ≠ a) : (X \ {u, a}).card + 2 = X.card := by
  have hsub : ({u, a} : Finset W) ⊆ X := by
    intro w hw
    rcases Finset.mem_insert.mp hw with e | e
    · rw [e]; exact hu
    · rw [Finset.mem_singleton.mp e]; exact ha
  have h1 := Finset.card_sdiff_add_card_eq_card hsub
  rw [Finset.card_pair hua] at h1
  exact h1

/-! ### Theorem D: the levels -/

set_option maxHeartbeats 800000 in
open Classical in
/-- **a7. Pendant-pair extension of a layout.** If `X ∖ {u, a}` is laid out along `(n, I)`,
`u ~ a`, the only other neighbour of `u` in `X` is `φ i` and the only other neighbour of `a` in
`X` is `φ j`, then `X` is laid out along `lvExt I n i j` by any `φ'` that extends `φ` with
`φ' n = u`, `φ' (n + 1) = a`.
(`EpAdj` dead-loop point: `EpAdj α β v v` can hold when `v` carries a dead loop, i.e. `v ∉ L`.
Here `¬EpAdj α β u u` and `¬EpAdj α β a a` follow from `hu'`, `ha'`.) -/
theorem ep_isoI_ext {W E : Type*} (α β : E → W) (X : Finset W) (n : ℕ) (I : List (ℕ × ℕ))
    (φ φ' : ℕ → W) (u a : W) (i j : ℕ) (hu : u ∈ X) (ha : a ∈ X) (hua : u ≠ a)
    (hi : i < n) (hj : j < n) (hI : ∀ e ∈ I, e.1 < n ∧ e.2 < n)
    (hiso : EpIsoI α β (X \ {u, a}) n I φ)
    (hadj : EpAdj α β u a) (huy : EpAdj α β u (φ i)) (haq : EpAdj α β a (φ j))
    (hu' : ∀ z ∈ X, EpAdj α β u z → z = a ∨ z = φ i)
    (ha' : ∀ z ∈ X, EpAdj α β a z → z = u ∨ z = φ j)
    (h0 : ∀ k, k < n → φ' k = φ k) (h1 : φ' n = u) (h2 : φ' (n + 1) = a) :
    EpIsoI α β X (n + 2) (lvExt I n i j) φ' := by
  obtain ⟨hφX, hφinj, hφsurj, hA⟩ := hiso
  have hmem : ∀ k, k < n → φ k ∈ X ∧ φ k ≠ u ∧ φ k ≠ a := by
    intro k hk
    have := hφX k hk
    simp only [Finset.mem_sdiff, Finset.mem_insert, Finset.mem_singleton] at this
    exact ⟨this.1, fun e => this.2 (Or.inl e), fun e => this.2 (Or.inr e)⟩
  have hB : ∀ k l, (k, l) ∈ I → k < n ∧ l < n := fun k l hh => hI (k, l) hh
  have huu : ¬EpAdj α β u u := fun hh =>
    (hu' u hu hh).elim hua (fun e => (hmem i hi).2.1 e.symm)
  have haa : ¬EpAdj α β a a := fun hh =>
    (ha' a ha hh).elim (fun e => hua e.symm) (fun e => (hmem j hj).2.2 e.symm)
  have hul : ∀ l, l < n → (EpAdj α β u (φ l) ↔ l = i) := by
    intro l hl
    constructor
    · intro hh
      rcases hu' (φ l) (hmem l hl).1 hh with e | e
      · exact absurd e (hmem l hl).2.2
      · exact hφinj l i hl hi e
    · intro e; rw [e]; exact huy
  have hal : ∀ l, l < n → (EpAdj α β a (φ l) ↔ l = j) := by
    intro l hl
    constructor
    · intro hh
      rcases ha' (φ l) (hmem l hl).1 hh with e | e
      · exact absurd e (hmem l hl).2.1
      · exact hφinj l j hl hj e
    · intro e; rw [e]; exact haq
  refine ⟨?_, ?_, ?_, ?_⟩
  · intro k hk
    rcases (by omega : k < n ∨ k = n ∨ k = n + 1) with hk' | hk' | hk'
    · rw [h0 k hk']; exact (hmem k hk').1
    · rw [hk', h1]; exact hu
    · rw [hk', h2]; exact ha
  · intro k l hk hl hkl
    rcases (by omega : k < n ∨ k = n ∨ k = n + 1) with hk' | hk' | hk' <;>
      rcases (by omega : l < n ∨ l = n ∨ l = n + 1) with hl' | hl' | hl'
    · rw [h0 k hk', h0 l hl'] at hkl; exact hφinj k l hk' hl' hkl
    · rw [h0 k hk', hl', h1] at hkl; exact absurd hkl (hmem k hk').2.1
    · rw [h0 k hk', hl', h2] at hkl; exact absurd hkl (hmem k hk').2.2
    · rw [hk', h1, h0 l hl'] at hkl; exact absurd hkl.symm (hmem l hl').2.1
    · rw [hk', hl']
    · rw [hk', hl', h1, h2] at hkl; exact absurd hkl hua
    · rw [hk', h2, h0 l hl'] at hkl; exact absurd hkl.symm (hmem l hl').2.2
    · rw [hk', hl', h2, h1] at hkl; exact absurd hkl.symm hua
    · rw [hk', hl']
  · intro x hx
    by_cases hxu : x = u
    · exact ⟨n, by omega, h1.trans hxu.symm⟩
    · by_cases hxa : x = a
      · exact ⟨n + 1, by omega, h2.trans hxa.symm⟩
      · obtain ⟨k, hk, e⟩ := hφsurj x (Finset.mem_sdiff.mpr ⟨hx, by
          simp only [Finset.mem_insert, Finset.mem_singleton]
          exact fun hh => hh.elim hxu hxa⟩)
        exact ⟨k, by omega, (h0 k hk).trans e⟩
  · intro k l hk hl
    rw [mem_lvExt, mem_lvExt]
    rcases (by omega : k < n ∨ k = n ∨ k = n + 1) with hk' | hk' | hk' <;>
      rcases (by omega : l < n ∨ l = n ∨ l = n + 1) with hl' | hl' | hl'
    · rw [h0 k hk', h0 l hl', hA k l hk' hl']
      constructor
      · rintro (hh | hh)
        · exact Or.inl (Or.inl hh)
        · exact Or.inr (Or.inl hh)
      · rintro ((hh | hh | hh | hh) | (hh | hh | hh | hh)) <;>
          first | exact Or.inl hh | exact Or.inr hh | omega
    · rw [h0 k hk', hl', h1, ep_adj_comm, hul k hk']
      constructor
      · intro e; exact Or.inl (Or.inr (Or.inl ⟨e, rfl⟩))
      · rintro ((hh | hh | hh | hh) | (hh | hh | hh | hh)) <;>
          first | exact hh.1 | (have := hB _ _ hh; omega) | omega
    · rw [h0 k hk', hl', h2, ep_adj_comm, hal k hk']
      constructor
      · intro e; exact Or.inl (Or.inr (Or.inr (Or.inl ⟨e, rfl⟩)))
      · rintro ((hh | hh | hh | hh) | (hh | hh | hh | hh)) <;>
          first | exact hh.1 | (have := hB _ _ hh; omega) | omega
    · rw [hk', h1, h0 l hl', hul l hl']
      constructor
      · intro e; exact Or.inr (Or.inr (Or.inl ⟨e, rfl⟩))
      · rintro ((hh | hh | hh | hh) | (hh | hh | hh | hh)) <;>
          first | exact hh.1 | (have := hB _ _ hh; omega) | omega
    · rw [hk', hl', h1]
      constructor
      · intro hh; exact absurd hh huu
      · rintro ((hh | hh | hh | hh) | (hh | hh | hh | hh)) <;>
          first | (have := hB _ _ hh; omega) | omega
    · rw [hk', hl', h1, h2]
      exact ⟨fun _ => Or.inl (Or.inr (Or.inr (Or.inr ⟨rfl, rfl⟩))), fun _ => hadj⟩
    · rw [hk', h2, h0 l hl', hal l hl']
      constructor
      · intro e; exact Or.inr (Or.inr (Or.inr (Or.inl ⟨e, rfl⟩)))
      · rintro ((hh | hh | hh | hh) | (hh | hh | hh | hh)) <;>
          first | exact hh.1 | (have := hB _ _ hh; omega) | omega
    · rw [hk', hl', h2, h1]
      exact ⟨fun _ => Or.inr (Or.inr (Or.inr (Or.inr ⟨rfl, rfl⟩))),
        fun _ => (ep_adj_comm α β u a).mp hadj⟩
    · rw [hk', hl', h2]
      constructor
      · intro hh; exact absurd hh haa
      · rintro ((hh | hh | hh | hh) | (hh | hh | hh | hh)) <;>
          first | (have := hB _ _ hh; omega) | omega

/-- `l` (new index ↦ old index) renumbers the model `(n, I)` into `(n, I')`. Decidable; the
two-variable parts are quantified over `Fin n` (instance search fails on nested bounded `ℕ`
quantifiers here). -/
def lvPermOK (n : ℕ) (I I' : List (ℕ × ℕ)) (l : List ℕ) : Prop :=
  (∀ i, i < n → l.getD i 0 < n) ∧
  (∀ i j : Fin n, l.getD i.1 0 = l.getD j.1 0 → i = j) ∧
  (∀ k, k < n → k ∈ (List.range n).map (fun i => l.getD i 0)) ∧
  (∀ i j : Fin n, (((i.1, j.1) ∈ I' ∨ (j.1, i.1) ∈ I') ↔
    ((l.getD i.1 0, l.getD j.1 0) ∈ I ∨ (l.getD j.1 0, l.getD i.1 0) ∈ I)))

/-- Renumbering a layout. -/
theorem ep_isoI_perm {W E : Type*} (α β : E → W) (X : Finset W) (n : ℕ) (I I' : List (ℕ × ℕ))
    (φ : ℕ → W) (l : List ℕ) (hl : lvPermOK n I I' l) (hiso : EpIsoI α β X n I φ) :
    ∃ φ', EpIsoI α β X n I' φ' := by
  obtain ⟨hτ, hinj, hsurj, hI⟩ := hl
  obtain ⟨hφX, hφinj, hφsurj, hadj⟩ := hiso
  refine ⟨fun i => φ (l.getD i 0), fun i hi => hφX _ (hτ i hi),
    fun i j hi hj he => congrArg Fin.val
      (hinj ⟨i, hi⟩ ⟨j, hj⟩ (hφinj _ _ (hτ i hi) (hτ j hj) he)), fun x hx => ?_,
    fun i j hi hj => ?_⟩
  · obtain ⟨k, hk, hkx⟩ := hφsurj x hx
    obtain ⟨i, hi, hik⟩ := List.mem_map.mp (hsurj k hk)
    exact ⟨i, List.mem_range.mp hi, (congrArg φ hik).trans hkx⟩
  · rw [hI ⟨i, hi⟩ ⟨j, hj⟩]
    exact hadj _ _ (hτ i hi) (hτ j hj)

theorem lvPerm_X5_04 : lvPermOK 7 (lvExt lvX5 5 0 4) lvX7 [0, 3, 4, 1, 2, 5, 6] := by
  unfold lvPermOK; decide +kernel

theorem lvPerm_X5_13 : lvPermOK 7 (lvExt lvX5 5 1 3) lvX7 [1, 0, 3, 2, 4, 5, 6] := by
