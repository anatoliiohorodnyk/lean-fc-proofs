          (epConB α β ({x, y, z} : Finset W) x y) Z := by
        unfold EpTwig; rw [b2]
      by_cases htw : EpTwig α β Z
      · rw [if_pos htw, if_pos (this.mp htw)]
      · rw [if_neg htw, if_neg (fun h' => htw (this.mpr h'))]
