    (ht : EpTriangle α β L x y z exy eyz ezx)
    (h3 : (epCut α β ({x, y, z} : Finset W)).card = 3) (𝒳₁ : Finset (Finset W))
    (hfol : EpFol0 (epConA α β ({x, y, z} : Finset W) x y) (epConB α β ({x, y, z} : Finset W) x y)
      (epL' L ({x, y, z} : Finset W) x) 𝒳₁) :
