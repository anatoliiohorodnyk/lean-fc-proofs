/-- The admissible pendant pairs of `P3`, `X5`, `X7`, `X9` (stated over `Fin` and outside
`open Classical`, so that `decide` finds the instances). -/
theorem lvKey3 : ∀ p r : Fin 3, p.1 < r.1 → (p.1, r.1) ∉ lvP3 → (r.1, p.1) ∉ lvP3 →
    p.1 = 0 ∧ r.1 = 2 := by
  decide +kernel

theorem lvKey5 : ∀ p r : Fin 5, p.1 < r.1 → (p.1, r.1) ∉ lvX5 → (r.1, p.1) ∉ lvX5 →
    (p.1, r.1) = (0, 2) ∨ (p.1, r.1) = (0, 4) ∨ (p.1, r.1) = (1, 3) ∨ (p.1, r.1) = (1, 4) ∨
      (p.1, r.1) = (2, 3) := by
  decide +kernel

theorem lvKey7 : ∀ p r : Fin 7, p.1 < r.1 → (p.1, r.1) ∉ lvX7 → (r.1, p.1) ∉ lvX7 →
    (lvNbrs lvX7 7 p.1).card ≤ 2 → (lvNbrs lvX7 7 r.1).card ≤ 2 →
    (p.1, r.1) = (1, 3) ∨ (p.1, r.1) = (1, 4) ∨ (p.1, r.1) = (1, 5) ∨ (p.1, r.1) = (1, 6) ∨
      (p.1, r.1) = (3, 5) ∨ (p.1, r.1) = (3, 6) ∨ (p.1, r.1) = (4, 5) ∨
      (p.1, r.1) = (4, 6) := by
  decide +kernel

theorem lvKey9 : ∀ p r : Fin 9, p.1 < r.1 → (p.1, r.1) ∉ lvX9 → (r.1, p.1) ∉ lvX9 →
    (lvNbrs lvX9 9 p.1).card ≤ 2 → (lvNbrs lvX9 9 r.1).card ≤ 2 →
    (p.1, r.1) = (1, 4) ∨ (p.1, r.1) = (1, 5) ∨ (p.1, r.1) = (1, 7) ∨ (p.1, r.1) = (1, 8) ∨
      (p.1, r.1) = (4, 5) ∨ (p.1, r.1) = (4, 7) ∨ (p.1, r.1) = (4, 8) ∨
      (p.1, r.1) = (5, 7) ∨ (p.1, r.1) = (5, 8) := by
  decide +kernel

/-- Three vertices `a - m - b` forming a path are laid out along `P3`. -/
theorem ep_isoI_P3 {W E : Type*} (α β : E → W) (X : Finset W) (a m b : W)
    (hX : ∀ x, x ∈ X ↔ x = a ∨ x = m ∨ x = b) (ham : a ≠ m) (hab : a ≠ b) (hmb : m ≠ b)
    (h1 : EpAdj α β a m) (h2 : EpAdj α β m b) (h3 : ¬EpAdj α β a b)
    (ha : ¬EpAdj α β a a) (hm : ¬EpAdj α β m m) (hb : ¬EpAdj α β b b) :
    EpIsoI α β X 3 lvP3 (fun k => if k = 0 then a else if k = 1 then m else b) := by
  have h1' := (ep_adj_comm α β a m).mp h1
  have h2' := (ep_adj_comm α β m b).mp h2
  have h3' : ¬EpAdj α β b a := fun hh => h3 ((ep_adj_comm α β b a).mp hh)
  refine ⟨?_, ?_, ?_, ?_⟩
  · intro i hi
    interval_cases i <;> simp [hX]
  · intro i j hi hj
    interval_cases i <;> interval_cases j <;>
      simp [ham, hab, hmb, ham.symm, hab.symm, hmb.symm]
  · intro x hx
    rcases (hX x).mp hx with e | e | e
    · exact ⟨0, by omega, by simp [e]⟩
    · exact ⟨1, by omega, by simp [e]⟩
    · exact ⟨2, by omega, by simp [e]⟩
  · intro i j hi hj
    interval_cases i <;> interval_cases j <;>
      simp [lvP3, h1, h2, h3, ha, hm, hb, h1', h2', h3']

set_option maxHeartbeats 800000 in
open Classical in
/-- **Theorem D, level 3.** A set with three vertices and a cut of size five is the path. -/
theorem ep_cut5_card3 {W E : Type*} [Fintype E] (α β : E → W) (L X : Finset W)
    (h : EpCubicD α β L) (h4 : EpCyc4 α β L) (h6 : 6 ≤ L.card) (hXL : X ⊆ L)
    (h5 : (epCut α β X).card = 5) (h3 : X.card = 3) : ∃ φ, EpIsoI α β X 3 lvP3 φ := by
  obtain ⟨x, y, z, hxy, hxz, hyz, hX⟩ := Finset.card_eq_three.mp h3
  have hmemX : ∀ w, w ∈ X ↔ w = x ∨ w = y ∨ w = z := fun w => by
    rw [hX]; simp only [Finset.mem_insert, Finset.mem_singleton]
  have hxX : x ∈ X := (hmemX x).mpr (Or.inl rfl)
  have hyX : y ∈ X := (hmemX y).mpr (Or.inr (Or.inl rfl))
  have hzX : z ∈ X := (hmemX z).mpr (Or.inr (Or.inr rfl))
  -- no loop at a vertex of `L` (the `EpAdj` dead-loop point)
  have hloop : ∀ v ∈ X, ¬EpAdj α β v v := fun v hv ⟨g, hg⟩ =>
    ep_ends_ne α β L h v v g (hXL hv) hg rfl
  have hd1 : Disjoint ({x} : Finset W) {y} := Finset.disjoint_singleton.mpr hxy
  have e1 := ep_cut_union α β {x} {y} hd1
  rw [h.2 x (hXL hxX), h.2 y (hXL hyX)] at e1
  have hd2 : Disjoint (({x} : Finset W) ∪ {y}) {z} := by
    rw [Finset.disjoint_singleton_right, Finset.mem_union, Finset.mem_singleton,
      Finset.mem_singleton]
    exact fun h' => h'.elim (fun e => hxz e.symm) (fun e => hyz e.symm)
  have e2 := ep_cut_union α β (({x} : Finset W) ∪ {y}) {z} hd2
  have hXeq : ({x} : Finset W) ∪ {y} ∪ {z} = X := by
    ext w
    rw [hmemX]
    simp only [Finset.mem_union, Finset.mem_singleton]
    tauto
  rw [hXeq, h5, h.2 z (hXL hzX)] at e2
  have hxyL : ({x} : Finset W) ∪ {y} ⊆ L := by
    intro w hw
    rcases Finset.mem_union.mp hw with h' | h'
    · rw [Finset.mem_singleton.mp h']; exact hXL hxX
    · rw [Finset.mem_singleton.mp h']; exact hXL hyX
  have hc2 : (({x} : Finset W) ∪ {y}).card = 2 := by
    rw [Finset.card_union_of_disjoint hd1, Finset.card_singleton, Finset.card_singleton]
  have c1 := h4.1 _ hxyL (Finset.card_pos.mp (by omega))
    (fun h' => by rw [h'] at hc2; omega)
