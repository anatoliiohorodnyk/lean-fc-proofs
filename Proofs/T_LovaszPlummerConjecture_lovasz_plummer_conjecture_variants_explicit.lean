/-- **Odd sets of leaving edges of a triangle extend.** In a cubic bridgeless multigraph, an
odd set `A` of edges leaving a triangle together with suitable triangle edges covers every
vertex of the triangle exactly once. -/
theorem ep_tri_odd_ext {W E : Type*} [Fintype E] (α β : E → W) (L : Finset W)
    (h : EpCubicD α β L) (hb : EpBridgeless α β L) (hconn : EpConnected α β L)
    (x y z : W) (exy eyz ezx : E) (ht : EpTriangle α β L x y z exy eyz ezx)
    (A : Finset E) (hA : A ⊆ epCut α β ({x, y, z} : Finset W)) (hodd : Odd A.card) :
    ∃ N : Finset E, (∀ g ∈ N, α g ∈ ({x, y, z} : Finset W) ∧ β g ∈ ({x, y, z} : Finset W) ∧
        α g ≠ β g) ∧
      ∀ c ∈ ({x, y, z} : Finset W), ∃! g, g ∈ A ∪ N ∧ epCross α β {c} g := by
  obtain ⟨hTL, hT3, hTcut⟩ := ep_triangle_cut0 α β L h hb hconn x y z exy eyz ezx ht
  obtain ⟨Nf, hNf⟩ := ep_triangle_hfc α β L x y z exy eyz ezx ht
  have hAle : A.card ≤ 3 := hTcut ▸ Finset.card_le_card hA
  have hA13 : A.card = 1 ∨ A.card = 3 := by
    have := Nat.odd_iff.mp hodd
    omega
  rcases hA13 with h1 | h3
  · obtain ⟨f, rfl⟩ := Finset.card_eq_one.mp h1
    have hf : epCross α β ({x, y, z} : Finset W) f :=
      (mem_epCut _ _ _ _).mp (hA (Finset.mem_singleton_self f))
    obtain ⟨hN1, hN2⟩ := hNf f hf
    refine ⟨Nf f, hN1, fun c hc => ?_⟩
    have := hN2 c hc
    rwa [Finset.insert_eq] at this
  · have hAeq : A = epCut α β ({x, y, z} : Finset W) :=
      Finset.eq_of_subset_of_card_le hA (by rw [hTcut, h3])
    obtain ⟨hx, hy, hz, hxy, hyz, hxz, Hxy, Hyz, Hzx⟩ := ht
    refine ⟨∅, fun g hg => absurd hg (Finset.notMem_empty g), ?_⟩
    rw [Finset.union_empty, hAeq]
    -- each vertex of the triangle has at most one leaving edge
    have hle : ∀ (c : W) (e₁ e₂ : E), c ∈ L → e₁ ≠ e₂ → epCross α β {c} e₁ →
        epCross α β {c} e₂ → ¬epCross α β ({x, y, z} : Finset W) e₁ →
        ¬epCross α β ({x, y, z} : Finset W) e₂ →
        ((epCut α β ({x, y, z} : Finset W)).filter (epCross α β {c})).card ≤ 1 := by
      intro c e₁ e₂ hc hne c1 c2 n1 n2
      have hsub : (epCut α β ({x, y, z} : Finset W)).filter (epCross α β {c}) ⊆
          (epCut α β {c}) \ {e₁, e₂} := by
        intro g hg
        obtain ⟨g1, g2⟩ := Finset.mem_filter.mp hg
        rw [mem_epCut] at g1
        rw [Finset.mem_sdiff, mem_epCut, Finset.mem_insert, Finset.mem_singleton]
        refine ⟨g2, ?_⟩
        rintro (rfl | rfl)
        · exact n1 g1
        · exact n2 g1
      have h2 : ({e₁, e₂} : Finset E) ⊆ epCut α β {c} := by
        intro g hg
        rw [mem_epCut]
        rcases Finset.mem_insert.mp hg with rfl | hg
        · exact c1
        · rw [Finset.mem_singleton.mp hg]; exact c2
      have := Finset.card_le_card hsub
      rw [Finset.card_sdiff_of_subset h2, h.2 c hc, Finset.card_pair hne] at this
      omega
    have hin : ∀ (g : E) (p q : W), p ≠ q → (∀ w, epCross α β {w} g ↔ w = p ∨ w = q) →
        p ∈ ({x, y, z} : Finset W) → q ∈ ({x, y, z} : Finset W) →
        ¬epCross α β ({x, y, z} : Finset W) g := by
      intro g p q hpq H hp hq hcr
      unfold epCross at hcr
      rcases ep_pq_edge_ends α β g p q hpq H with ⟨a, b⟩ | ⟨a, b⟩
      · rw [a, b] at hcr; tauto
      · rw [a, b] at hcr; tauto
    have mx : x ∈ ({x, y, z} : Finset W) := by simp
    have my : y ∈ ({x, y, z} : Finset W) := by simp
    have mz : z ∈ ({x, y, z} : Finset W) := by simp
    have nxy := hin exy x y hxy Hxy mx my
    have nyz := hin eyz y z hyz Hyz my mz
    have nzx := hin ezx z x (Ne.symm hxz) Hzx mz mx
    have d1 : exy ≠ ezx := by
      intro heq
      have := (Hzx y).mp (heq ▸ (Hxy y).mpr (Or.inr rfl))
      rcases this with h' | h'
      · exact hyz h'
      · exact hxy h'.symm
    have d2 : exy ≠ eyz := by
      intro heq
      have := (Hyz x).mp (heq ▸ (Hxy x).mpr (Or.inl rfl))
      rcases this with h' | h'
      · exact hxy h'
      · exact hxz h'
    have d3 : eyz ≠ ezx := by
      intro heq
      have := (Hzx y).mp (heq ▸ (Hyz y).mpr (Or.inl rfl))
      rcases this with h' | h'
      · exact hyz h'
      · exact hxy h'.symm
    have lx := hle x exy ezx hx d1 ((Hxy x).mpr (Or.inl rfl)) ((Hzx x).mpr (Or.inr rfl)) nxy nzx
    have ly := hle y exy eyz hy d2 ((Hxy y).mpr (Or.inr rfl)) ((Hyz y).mpr (Or.inl rfl)) nxy nyz
    have lz := hle z eyz ezx hz d3 ((Hyz z).mpr (Or.inr rfl)) ((Hzx z).mpr (Or.inl rfl)) nyz nzx
    -- the three leaving edges are distributed over the three vertices
    have hdc := ep_double_count α β (epCut α β ({x, y, z} : Finset W))
      (fun e he => (epD_live_of_cross h _ e ((mem_epCut _ _ _ _).mp he)).2.2)
      ({x, y, z} : Finset W)
    have hf1 : (epCut α β ({x, y, z} : Finset W)).filter
        (epCross α β ({x, y, z} : Finset W)) = epCut α β ({x, y, z} : Finset W) := by
      apply Finset.filter_true_of_mem
      intro e he
      exact (mem_epCut _ _ _ _).mp he
    have hf2 : (epCut α β ({x, y, z} : Finset W)).filter
        (fun e => α e ∈ ({x, y, z} : Finset W) ∧ β e ∈ ({x, y, z} : Finset W)) = ∅ := by
      apply Finset.filter_false_of_mem
      intro e he hi
      have := (mem_epCut _ _ _ _).mp he
      unfold epCross at this
      tauto
    rw [hf1, hf2, Finset.card_empty, hTcut,
      Finset.sum_insert (by simp [hxy, hxz]), Finset.sum_insert (by simp [hyz]),
      Finset.sum_singleton] at hdc
    intro c hc
    have hc1 : ((epCut α β ({x, y, z} : Finset W)).filter (epCross α β {c})).card = 1 := by
      rcases Finset.mem_insert.mp hc with rfl | hc
      · omega
      · rcases Finset.mem_insert.mp hc with rfl | hc
        · omega
        · rw [Finset.mem_singleton.mp hc]; omega
    obtain ⟨g, hg⟩ := Finset.card_eq_one.mp hc1
    have hgm : ∀ g', (g' ∈ epCut α β ({x, y, z} : Finset W) ∧ epCross α β {c} g') ↔ g' = g := by
      intro g'
      rw [← Finset.mem_filter, hg, Finset.mem_singleton]
    exact ⟨g, (hgm g).mpr rfl, fun g' hg' => (hgm g').mp hg'⟩

