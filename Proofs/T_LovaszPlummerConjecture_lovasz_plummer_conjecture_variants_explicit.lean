open Classical in
/-- **P2′ (the full 4-cut lemma).** In a cyclically 4-edge-connected cubic multigraph every set
with a cut of size four and at least four vertices is a burl.
(EKKKN Lemma 17 with `m(G|X) ≥ 2` derived: a perfect matching of `G` avoiding the cut exists
(`ep_pm_avoid_cut4`); no edge of it is a bridge of `G|X` by `EpCyc4`; `ep_kotzig_in` gives a
second matching; then `ep_cut4_burl`.) -/
theorem ep_cut4_burl_cyc4 {W E : Type*} [Fintype E] (α β : E → W) (L X : Finset W)
    (h : EpCubicD α β L) (h4 : EpCyc4 α β L) (hXL : X ⊆ L)
    (hcut : (epCut α β X).card = 4) (hX4 : 4 ≤ X.card) : EpBurl α β X := by
  obtain ⟨hb, -⟩ := EpCyc4.bridgelessD h h4
  obtain ⟨M₀, hM₀, hM₀c⟩ := ep_pm_avoid_cut4 α β L X h hb hXL hcut
  have hN₁ : M₀.filter (fun e => α e ∈ X ∨ β e ∈ X) ∈ epLM α β X :=
    ep_restrict_LM α β L X hXL hM₀
  have hN₁in : ∀ e ∈ M₀.filter (fun e => α e ∈ X ∨ β e ∈ X),
      α e ∈ X ∧ β e ∈ X ∧ α e ≠ β e := by
    intro e he
    obtain ⟨he1, he2⟩ := Finset.mem_filter.mp he
    have hnc := hM₀c e he1
    unfold epCross at hnc
    refine ⟨?_, ?_, hM₀.1 e he1⟩ <;> tauto
  obtain ⟨w₀, hw₀⟩ : X.Nonempty := Finset.card_pos.mp (by omega)
  have hN₁ne : (M₀.filter (fun e => α e ∈ X ∨ β e ∈ X)).Nonempty := by
    obtain ⟨e₀, ⟨h1, -⟩, -⟩ := hN₁.2 w₀ hw₀
    exact ⟨e₀, h1⟩
  -- an outside vertex
  obtain ⟨z, hzL, hzX⟩ : ∃ z, z ∈ L ∧ z ∉ X := by
    obtain ⟨g, hg⟩ := Finset.card_pos.mp (by omega : 0 < (epCut α β X).card)
    rw [mem_epCut] at hg
    obtain ⟨l1, l2, -⟩ := epD_live_of_cross h X g hg
    unfold epCross at hg
    rcases hg with ⟨-, h'⟩ | ⟨h', -⟩
    · exact ⟨_, l2, h'⟩
    · exact ⟨_, l1, h'⟩
  have hbr : ∀ e ∈ M₀.filter (fun e => α e ∈ X ∨ β e ∈ X), ∀ T ⊆ X,
      ¬(∀ g, (α g ∈ X ∧ β g ∈ X ∧ epCross α β T g) ↔ g = e) := by
    intro e he T hT hiff
    obtain ⟨ei1, ei2, ecr⟩ := (hiff e).mpr rfl
    have hTX : ∀ w, w ∈ T → w ∈ X := fun w hw => hT hw
    -- the cut edges of `X` at `T` and at `X \ T`
    have hsplit := Finset.card_filter_add_card_filter_not (s := epCut α β X)
      (p := fun g => epCross α β T g)
    have hcutT : epCut α β T = insert e ((epCut α β X).filter (fun g => epCross α β T g)) := by
      ext g
      rw [mem_epCut, Finset.mem_insert, Finset.mem_filter, mem_epCut]
      constructor
      · intro hc
        by_cases hint : α g ∈ X ∧ β g ∈ X
        · exact Or.inl ((hiff g).mp ⟨hint.1, hint.2, hc⟩)
        · refine Or.inr ⟨?_, hc⟩
          have a1 := hTX (α g); have a2 := hTX (β g)
          unfold epCross at hc ⊢; tauto
      · rintro (rfl | ⟨-, hc⟩)
        · exact ecr
        · exact hc
    have hcutT' : epCut α β (X \ T) =
        insert e ((epCut α β X).filter (fun g => ¬epCross α β T g)) := by
      ext g
      rw [mem_epCut, Finset.mem_insert, Finset.mem_filter, mem_epCut]
      have a1 := hTX (α g); have a2 := hTX (β g)
      constructor
      · intro hc
        by_cases hint : α g ∈ X ∧ β g ∈ X
        · refine Or.inl ((hiff g).mp ⟨hint.1, hint.2, ?_⟩)
          unfold epCross at hc ⊢; simp only [Finset.mem_sdiff] at hc; tauto
        · refine Or.inr ⟨?_, ?_⟩ <;>
            (unfold epCross at hc ⊢; simp only [Finset.mem_sdiff] at hc; tauto)
      · rintro (rfl | ⟨hx, hnt⟩)
        · have b1 := hTX (α g); have b2 := hTX (β g)
          unfold epCross at ecr ⊢; simp only [Finset.mem_sdiff]; tauto
        · unfold epCross at hx hnt ⊢; simp only [Finset.mem_sdiff]; tauto
    have he1 : e ∉ (epCut α β X).filter (fun g => epCross α β T g) := by
      intro h'
      have := (mem_epCut _ _ _ _).mp (Finset.mem_filter.mp h').1
      unfold epCross at this; tauto
    have he2 : e ∉ (epCut α β X).filter (fun g => ¬epCross α β T g) := by
      intro h'
      have := (mem_epCut _ _ _ _).mp (Finset.mem_filter.mp h').1
      unfold epCross at this; tauto
    have hcT : (epCut α β T).card =
        ((epCut α β X).filter (fun g => epCross α β T g)).card + 1 := by
      rw [hcutT, Finset.card_insert_of_notMem he1]
    have hcT' : (epCut α β (X \ T)).card =
        ((epCut α β X).filter (fun g => ¬epCross α β T g)).card + 1 := by
      rw [hcutT', Finset.card_insert_of_notMem he2]
    -- an end of `e` in `T` and one in `X \ T`
    obtain ⟨t, ht, s, hsX, hsT⟩ : ∃ t, t ∈ T ∧ ∃ s, s ∈ X ∧ s ∉ T := by
      unfold epCross at ecr
      rcases ecr with ⟨a, b⟩ | ⟨a, b⟩
      · exact ⟨_, a, _, ei2, b⟩
      · exact ⟨_, b, _, ei1, a⟩
    have hTne : T.Nonempty := ⟨t, ht⟩
    have hTL : T ≠ L := fun h' => hsT (h' ▸ hXL hsX)
    have hT'ne : (X \ T).Nonempty := ⟨s, Finset.mem_sdiff.mpr ⟨hsX, hsT⟩⟩
    have hT'L : X \ T ≠ L := fun h' => by
      have : t ∈ X \ T := h' ▸ hXL (hT ht)
      exact (Finset.mem_sdiff.mp this).2 ht
    have c1 := h4.1 T (hT.trans hXL) hTne hTL
    have c2 := h4.1 (X \ T) (Finset.sdiff_subset.trans hXL) hT'ne hT'L
    rw [hcut] at hsplit
    have hT3 : (epCut α β T).card = 3 := by omega
    have hT'3 : (epCut α β (X \ T)).card = 3 := by omega
    have d1 : T.card = 1 := by
      rcases h4.2 T (hT.trans hXL) hT3 with h' | h'
      · exact h'
      · exfalso
        have : 1 < (L \ T).card := Finset.one_lt_card.mpr
          ⟨z, Finset.mem_sdiff.mpr ⟨hzL, fun h'' => hzX (hT h'')⟩, s,
            Finset.mem_sdiff.mpr ⟨hXL hsX, hsT⟩, fun h'' => hzX (h'' ▸ hsX)⟩
        omega
    have d2 : (X \ T).card = 1 := by
      rcases h4.2 (X \ T) (Finset.sdiff_subset.trans hXL) hT'3 with h' | h'
      · exact h'
      · exfalso
        have : 1 < (L \ (X \ T)).card := Finset.one_lt_card.mpr
          ⟨z, Finset.mem_sdiff.mpr ⟨hzL, fun h'' => hzX (Finset.mem_sdiff.mp h'').1⟩, t,
            Finset.mem_sdiff.mpr ⟨hXL (hT ht), fun h'' => (Finset.mem_sdiff.mp h'').2 ht⟩,
            fun h'' => hzX (h'' ▸ hT ht)⟩
        omega
    have := Finset.card_sdiff_add_card_eq_card hT
    omega
  obtain ⟨N₂, hne, hN₂in, hN₂cov⟩ := ep_kotzig_in α β X w₀ hw₀ _ hN₁in hN₁.2 hN₁ne hbr
  have hN₂ : N₂ ∈ epLM α β X := ⟨fun e he => Or.inl (hN₂in e he).1, hN₂cov⟩
  refine ep_cut4_burl α β L X h hXL hcut _ N₂ hN₁ hN₂ (Ne.symm hne) (fun g hg hc => ?_)
    (fun g hg hc => ?_)
  · obtain ⟨a1, a2, -⟩ := hN₁in g hg
    unfold epCross at hc; tauto
  · obtain ⟨a1, a2, -⟩ := hN₂in g hg
    unfold epCross at hc; tauto

set_option maxHeartbeats 800000 in
open Classical in
/-- **P4 (refined S3).** If a set with a cut of size five is not a burl, some boundary edge `f`
is the only boundary edge of exactly one local matching: "`G|X` minus the inner end of `f` has
exactly one perfect matching".
(Balanced `p`: the number `k` of boundary edges of a local matching is odd with mean `5/3`; if
every local matching with `k = 1` had a second one with the same boundary edge, then
`a ≥ (3 - k)/2` pointwise and `E[a] ≥ 2/3`.) -/
theorem ep_cut5_unique {W E : Type*} [Fintype E] (α β : E → W) (L X : Finset W)
    (h : EpCubicD α β L) (hXL : X ⊆ L) (h5 : (epCut α β X).card = 5)
    (hnb : ¬EpBurl α β X) :
    ∃ f ∈ epCut α β X, ∃ N ∈ epLM α β X, f ∈ N ∧ (∀ g ∈ N, epCross α β X g → g = f) ∧
      ∀ N' ∈ epLM α β X, f ∈ N' → (∀ g ∈ N', epCross α β X g → g = f) → N' = N := by
  by_contra hcon
  have hall : ∀ f ∈ epCut α β X, ∀ N ∈ epLM α β X, f ∈ N →
      (∀ g ∈ N, epCross α β X g → g = f) →
      ∃ N' ∈ epLM α β X, f ∈ N' ∧ (∀ g ∈ N', epCross α β X g → g = f) ∧ N' ≠ N := by
    intro f hf N hN hfN honly
    by_contra hno
    refine hcon ⟨f, hf, N, hN, hfN, honly, fun N' hN' hfN' honly' => ?_⟩
    by_contra hne
    exact hno ⟨N', hN', hfN', honly', hne⟩
  refine hnb ?_
  have hnl : ∀ g, α g ∈ X → α g ≠ β g := by
    intro g hg
    rcases h.1 g with h' | h'
    · exact h'.2.2
    · exact absurd (hXL hg) h'.1
  have hXodd : X.card % 2 = 1 := (ep_cut5_parity α β L X h hXL h5).1
  intro p hp
  obtain ⟨hp0, hpS, hp1, hpb⟩ := hp
  have hpar : ∀ N, N ∈ epLM α β X → (N.filter (epCross α β X)).card % 2 = 1 := by
    intro N hN
    have hNnl : ∀ g ∈ N, α g ≠ β g := by
      intro g hg
      rcases h.1 g with h' | h'
      · exact h'.2.2
      · exact absurd (epD_live_of_mem_lm h X hXL hN g hg).1 h'.1
    have hd := ep_double_count α β N hNnl X
    have h1 : ∀ c ∈ X, (N.filter (epCross α β {c})).card = 1 :=
      fun c hcX => (ep_unique_iff_card N _).mp (hN.2 c hcX)
    rw [Finset.sum_congr rfl h1, Finset.sum_const, smul_eq_mul, mul_one] at hd
    omega
  have hinside : ∀ (f : E) (M : Finset E), M ∈ epLM α β X →
      (∀ g ∈ M, epCross α β X g → g = f) → ∀ g ∈ M, g ≠ f → α g ∈ X ∧ β g ∈ X := by
    intro f M hM ho g hg hgf
    have hnc : ¬epCross α β X g := fun hc => hgf (ho g hg hc)
    unfold epCross at hnc
    rcases hM.1 g hg with h' | h'
    · exact ⟨h', by by_contra h''; exact hnc (Or.inl ⟨h', h''⟩)⟩
    · exact ⟨by by_contra h''; exact hnc (Or.inr ⟨h'', h'⟩), h'⟩
  have hA : ∀ N, p N ≠ 0 → (N.filter (epCross α β X)).card = 1 →
      1 ≤ epAltNum α β X N := by
    intro N hN h1
    have hNLM := hpS N hN
    obtain ⟨f, hf⟩ := Finset.card_eq_one.mp h1
    have hfmem : f ∈ N.filter (epCross α β X) := by rw [hf]; exact Finset.mem_singleton_self f
    obtain ⟨hfN, hfc⟩ := Finset.mem_filter.mp hfmem
    have honly : ∀ g ∈ N, epCross α β X g → g = f := by
      intro g hg hgc
      have : g ∈ N.filter (epCross α β X) := Finset.mem_filter.mpr ⟨hg, hgc⟩
      rw [hf] at this; exact Finset.mem_singleton.mp this
    obtain ⟨N', hN', hfN', honly', hne'⟩ :=
      hall f ((mem_epCut _ _ _ _).mpr hfc) N hNLM hfN honly
    refine ep_two_LM_altNum' α β X hnl hN' (Ne.symm hne') ?_
    intro g hg
    rcases Finset.mem_symmDiff.mp hg with ⟨h', hn'⟩ | ⟨h', hn'⟩
    · exact hinside f N hNLM honly g h' (fun e => hn' (e ▸ hfN'))
    · exact hinside f N' hN' honly' g h' (fun e => hn' (e ▸ hfN))
  have hexp : ∑ N, p N * ((N.filter (epCross α β X)).card : ℝ) = 5 / 3 := by
    have : ∀ N, p N * ((N.filter (epCross α β X)).card : ℝ) =
        ∑ e ∈ epCut α β X, p N * epInd N e := by
      intro N; rw [← Finset.mul_sum, ep_sum_ind_cut]
    rw [Finset.sum_congr rfl (fun N _ => this N), Finset.sum_comm]
    have h3 : ∀ e ∈ epCut α β X, ∑ N, p N * epInd N e = 1 / 3 := by
      intro e he
      refine hpb e ?_
      rw [mem_epCut] at he
      rcases he with ⟨h', -⟩ | ⟨-, h'⟩
      · exact Or.inl h'
      · exact Or.inr h'
    rw [Finset.sum_congr rfl h3, Finset.sum_const, h5]; norm_num
  have hsum : ∑ N, p N * ((3 - ((N.filter (epCross α β X)).card : ℝ)) / 2) = 2 / 3 := by
    have : ∀ N, p N * ((3 - ((N.filter (epCross α β X)).card : ℝ)) / 2) =
        3 / 2 * p N - (p N * ((N.filter (epCross α β X)).card : ℝ)) / 2 := fun N => by ring
    rw [Finset.sum_congr rfl (fun N _ => this N), Finset.sum_sub_distrib, ← Finset.mul_sum,
      ← Finset.sum_div, hexp, hp1]
    norm_num
  have hge : (2 : ℝ) / 3 ≤ ∑ N, p N * (epAltNum α β X N : ℝ) := by
    rw [← hsum]
    refine Finset.sum_le_sum fun N _ => ?_
    by_cases hN : p N = 0
    · rw [hN, zero_mul, zero_mul]
    · refine mul_le_mul_of_nonneg_left ?_ (hp0 N)
      have hpN := hpar N (hpS N hN)
      have h3 : (0 : ℝ) ≤ (epAltNum α β X N : ℝ) := Nat.cast_nonneg _
      by_cases h1 : (N.filter (epCross α β X)).card = 1
      · rw [h1]
        have := hA N hN h1
        have h1' : (1 : ℝ) ≤ (epAltNum α β X N : ℝ) := by exact_mod_cast this
        norm_num; linarith
      · have h2 : 3 ≤ (N.filter (epCross α β X)).card := by omega
        have h2' : (3 : ℝ) ≤ ((N.filter (epCross α β X)).card : ℝ) := by exact_mod_cast h2
        linarith
  linarith

/-! ### Ends of an edge and cut bookkeeping (helpers for D1) -/

lemma ep_cross_other {W E : Type*} (α β : E → W) (a : W) (g : E)
    (hg : epCross α β {a} g) :
    ∃ z, z ≠ a ∧ ((α g = a ∧ β g = z) ∨ (α g = z ∧ β g = a)) := by
  rw [epCross_singleton] at hg
  rcases hg with ⟨b1, b2⟩ | ⟨b1, b2⟩
  · exact ⟨β g, b2, Or.inl ⟨b1, rfl⟩⟩
  · exact ⟨α g, b1, Or.inr ⟨rfl, b2⟩⟩

lemma ep_cross_both_of_ends {W E : Type*} (α β : E → W) (a z : W) (g : E) (hz : z ≠ a)
    (hg : (α g = a ∧ β g = z) ∨ (α g = z ∧ β g = a)) :
    epCross α β {a} g ∧ epCross α β {z} g := by
  rw [epCross_singleton, epCross_singleton]
  rcases hg with ⟨b1, b2⟩ | ⟨b1, b2⟩
  · exact ⟨Or.inl ⟨b1, by rw [b2]; exact hz⟩, Or.inr ⟨by rw [b1]; exact Ne.symm hz, b2⟩⟩
  · exact ⟨Or.inr ⟨by rw [b1]; exact hz, b2⟩, Or.inl ⟨b1, by rw [b2]; exact Ne.symm hz⟩⟩

lemma ep_cross_set_of_ends {W E : Type*} (α β : E → W) (X : Finset W) (a z : W) (g : E)
    (ha : a ∈ X) (hg : (α g = a ∧ β g = z) ∨ (α g = z ∧ β g = a)) :
    epCross α β X g ↔ z ∉ X := by
  unfold epCross
  rcases hg with ⟨b1, b2⟩ | ⟨b1, b2⟩ <;> rw [b1, b2] <;> tauto

lemma ep_ends_unique {W E : Type*} (α β : E → W) (u a z : W) (g : E)
    (h1 : (α g = u ∧ β g = a) ∨ (α g = a ∧ β g = u))
    (h2 : (α g = u ∧ β g = z) ∨ (α g = z ∧ β g = u)) : z = a := by
  rcases h1 with ⟨b1, b2⟩ | ⟨b1, b2⟩ <;> rcases h2 with ⟨c1, c2⟩ | ⟨c1, c2⟩
  · exact c2.symm.trans b2
  · exact c1.symm.trans (b1.trans (c2.symm.trans b2))
  · exact c2.symm.trans (b2.trans (c1.symm.trans b1))
  · exact c1.symm.trans b1

/-- A vertex of `L` is not adjacent to itself: the only loops of an `EpCubicD` multigraph are
the dead loops, and they sit outside `L`. (This is the `EpAdj` dead-loop point: `EpAdj α β v v`
can hold for `v ∉ L`.) -/
lemma ep_ends_ne {W E : Type*} [Fintype E] (α β : E → W) (L : Finset W) (h : EpCubicD α β L)
    (a z : W) (g : E) (ha : a ∈ L) (hg : (α g = a ∧ β g = z) ∨ (α g = z ∧ β g = a)) :
    z ≠ a := by
  intro e'
  have hα : α g = a := by
    rcases hg with ⟨b1, -⟩ | ⟨b1, -⟩
    · exact b1
    · exact b1.trans e'
  have hβ : β g = a := by
    rcases hg with ⟨-, b2⟩ | ⟨-, b2⟩
    · exact b2.trans e'
    · exact b2
  rcases h.1 g with h' | h'
  · exact h'.2.2 (hα.trans hβ.symm)
  · exact h'.1 (by rw [hα]; exact ha)

lemma ep_btw_of_ends {W E : Type*} [Fintype E] (α β : E → W) (A B : Finset W) (a z : W) (g : E)
    (ha : a ∈ A) (hz : z ∈ B) (hg : (α g = a ∧ β g = z) ∨ (α g = z ∧ β g = a)) :
    g ∈ epBtw α β A B := by
  rw [mem_epBtw]
  rcases hg with ⟨b1, b2⟩ | ⟨b1, b2⟩
  · left; rw [b1, b2]; exact ⟨ha, hz⟩
  · right; rw [b1, b2]; exact ⟨hz, ha⟩

open Classical in
/-- Removing a vertex `u` from `T`: `d(T - u) + 2 k = d(T) + 3`, where `k` is the number of
edges at `u` that leave `T`. -/
theorem ep_cut_erase {W E : Type*} [Fintype E] (α β : E → W) (L T : Finset W)
    (h : EpCubicD α β L) (hTL : T ⊆ L) (u : W) (hu : u ∈ T) :
    (epCut α β (T \ {u})).card + 2 * (epCut α β {u} ∩ epCut α β T).card =
      (epCut α β T).card + 3 := by
  have hd : Disjoint (T \ {u}) {u} := Finset.sdiff_disjoint
  have e1 := ep_cut_union α β (T \ {u}) {u} hd
  have hTu : T \ {u} ∪ {u} = T :=
    Finset.sdiff_union_of_subset (Finset.singleton_subset_iff.mpr hu)
  rw [hTu, h.2 u (hTL hu)] at e1
  have hpart : epCut α β {u} = epBtw α β (T \ {u}) {u} ∪ (epCut α β {u} ∩ epCut α β T) := by
    ext g
    have a1 : α g = u → α g ∈ T := fun e => by rw [e]; exact hu
    have a2 : β g = u → β g ∈ T := fun e => by rw [e]; exact hu
    simp only [Finset.mem_union, Finset.mem_inter, mem_epCut, mem_epBtw, epCross,
      Finset.mem_sdiff, Finset.mem_singleton]
    tauto
  have hdisj : Disjoint (epBtw α β (T \ {u}) {u}) (epCut α β {u} ∩ epCut α β T) := by
    rw [Finset.disjoint_left]
    intro g h1 h2
    have a1 : α g = u → α g ∈ T := fun e => by rw [e]; exact hu
    have a2 : β g = u → β g ∈ T := fun e => by rw [e]; exact hu
    simp only [Finset.mem_inter, mem_epCut, mem_epBtw, epCross,
      Finset.mem_sdiff, Finset.mem_singleton] at h1 h2
    tauto
  have e2 := Finset.card_union_of_disjoint hdisj
  rw [← hpart, h.2 u (hTL hu)] at e2
  omega

open Classical in
/-- D1 step 2: in a non-burl with a cut of size five and at least five vertices, every vertex
has at most one boundary edge. -/
theorem ep_cut5_bdry_le_one {W E : Type*} [Fintype E] (α β : E → W) (L X : Finset W)
    (h : EpCubicD α β L) (h4 : EpCyc4 α β L) (hXL : X ⊆ L)
    (h5 : (epCut α β X).card = 5) (hX5 : 5 ≤ X.card) (hnb : ¬EpBurl α β X)
    (u : W) (hu : u ∈ X) : (epCut α β {u} ∩ epCut α β X).card ≤ 1 := by
  have e1 := ep_cut_erase α β L X h hXL u hu
  rw [h5] at e1
  have hk : (epCut α β {u} ∩ epCut α β X).card ≤ 3 := by
    rw [← h.2 u (hXL hu)]; exact Finset.card_le_card Finset.inter_subset_left
  have hcard := Finset.card_sdiff_add_card_eq_card (Finset.singleton_subset_iff.mpr hu)
  rw [Finset.card_singleton] at hcard
  have hnl : ∀ g, α g ∈ X → α g ≠ β g := by
    intro g hg
    rcases h.1 g with h' | h'
    · exact h'.2.2
    · exact absurd (hXL hg) h'.1
  by_contra hgt
  have hsub : X \ {u} ⊆ L := Finset.sdiff_subset.trans hXL
  by_cases h3 : (epCut α β {u} ∩ epCut α β X).card = 3
  · have hne : (X \ {u}).Nonempty := Finset.card_pos.mp (by omega)
    have hneL : X \ {u} ≠ L := fun h' => by
      have : u ∈ X \ {u} := by rw [h']; exact hXL hu
      exact (Finset.mem_sdiff.mp this).2 (Finset.mem_singleton_self u)
    have := h4.1 _ hsub hne hneL
    omega
  · have hc4 : (epCut α β (X \ {u})).card = 4 := by omega
    exact hnb (ep_burl_mono α β (X \ {u}) X Finset.sdiff_subset hnl
      (ep_cut4_burl_cyc4 α β L (X \ {u}) h h4 hsub hc4 (by omega)))

set_option maxHeartbeats 1600000 in
open Classical in
/-- D1, steps 3-7: the boundary edge `f` with inner end `u` from P4, and the bridge `e` of the
unique perfect matching of `G|X - u`, one side of which is a single vertex `a`. -/
theorem ep_cut5_reduce_aux {W E : Type*} [Fintype E] (α β : E → W) (L X : Finset W)
    (h : EpCubicD α β L) (h4 : EpCyc4 α β L) (hXL : X ⊆ L) (h5 : (epCut α β X).card = 5)
    (hX5 : 5 ≤ X.card) (hnb : ¬EpBurl α β X) :
    ∃ (u a : W) (f e : E), u ∈ X ∧ epCross α β X f ∧ epCross α β {u} f ∧
      (∀ c ∈ X, epCross α β {c} f → c = u) ∧ a ∈ X \ {u} ∧
      ∀ g, (α g ∈ X \ {u} ∧ β g ∈ X \ {u} ∧ epCross α β {a} g) ↔ g = e := by
  have hnl : ∀ g, α g ∈ X → α g ≠ β g := by
    intro g hg
    rcases h.1 g with h' | h'
    · exact h'.2.2
    · exact absurd (hXL hg) h'.1
  obtain ⟨hodd, hout⟩ := ep_cut5_parity α β L X h hXL h5
  have hL8 : 8 ≤ L.card := by
    have := Finset.card_sdiff_add_card_eq_card hXL; omega
  obtain ⟨f, hf, N, hN, hfN, honly, huniq⟩ := ep_cut5_unique α β L X h hXL h5 hnb
  rw [mem_epCut] at hf
  -- the inner end `u` of `f`
  obtain ⟨u, hu, hfu, hfu'⟩ : ∃ u ∈ X, epCross α β {u} f ∧
      ∀ c ∈ X, epCross α β {c} f → c = u := by
    have hf' := hf
    unfold epCross at hf'
    rcases hf' with ⟨a1, a2⟩ | ⟨a1, a2⟩
    · refine ⟨α f, a1, ?_, ?_⟩
      · rw [epCross_singleton]; exact Or.inl ⟨rfl, fun e => a2 (by rw [e]; exact a1)⟩
      · intro c hc hcf
        rw [epCross_singleton] at hcf
        rcases hcf with ⟨b1, -⟩ | ⟨-, b2⟩
        · exact b1.symm
        · exact absurd (by rw [b2]; exact hc) a2
    · refine ⟨β f, a2, ?_, ?_⟩
      · rw [epCross_singleton]; exact Or.inr ⟨fun e => a1 (by rw [e]; exact a2), rfl⟩
      · intro c hc hcf
        rw [epCross_singleton] at hcf
        rcases hcf with ⟨b1, -⟩ | ⟨-, b2⟩
        · exact absurd (by rw [b1]; exact hc) a1
        · exact b2.symm
  have hYX : X \ {u} ⊆ X := Finset.sdiff_subset
  have hmemY : ∀ w, w ∈ X \ {u} ↔ w ∈ X ∧ w ≠ u := fun w => by
    rw [Finset.mem_sdiff, Finset.mem_singleton]
  have hcovu : ∀ g ∈ N, epCross α β {u} g → g = f := by
    intro g hg hc
    obtain ⟨e₀, -, hun⟩ := hN.2 u hu
    rw [hun g ⟨hg, hc⟩, hun f ⟨hfN, hfu⟩]
  have hMin : ∀ g ∈ N.erase f, α g ∈ X \ {u} ∧ β g ∈ X \ {u} ∧ α g ≠ β g := by
    intro g hg
    obtain ⟨hgf, hgN⟩ := Finset.mem_erase.mp hg
    have hnc : ¬epCross α β X g := fun hc => hgf (honly g hgN hc)
    have hin : α g ∈ X ∧ β g ∈ X := by
      have := hN.1 g hgN
      unfold epCross at hnc; tauto
    have hne := hnl g hin.1
    have hnu : ¬epCross α β {u} g := fun hc => hgf (hcovu g hgN hc)
    rw [epCross_singleton] at hnu
    rw [hmemY, hmemY]
    refine ⟨⟨hin.1, ?_⟩, ⟨hin.2, ?_⟩, hne⟩
    · intro e; exact hnu (Or.inl ⟨e, fun e' => hne (e.trans e'.symm)⟩)
    · intro e; exact hnu (Or.inr ⟨fun e' => hne (e'.trans e.symm), e⟩)
  have hMcov : ∀ c ∈ X \ {u}, ∃! e, e ∈ N.erase f ∧ epCross α β {c} e := by
    intro c hc
    obtain ⟨hcX, hcu⟩ := (hmemY c).mp hc
    obtain ⟨e₀, ⟨h1, h2⟩, hun⟩ := hN.2 c hcX
    have hne : e₀ ≠ f := fun e => hcu (hfu' c hcX (by rw [← e]; exact h2))
    exact ⟨e₀, ⟨Finset.mem_erase.mpr ⟨hne, h1⟩, h2⟩,
      fun e' he' => hun e' ⟨Finset.mem_of_mem_erase he'.1, he'.2⟩⟩
  have hYcard := Finset.card_sdiff_add_card_eq_card (Finset.singleton_subset_iff.mpr hu)
  rw [Finset.card_singleton] at hYcard
  obtain ⟨w₀, hw₀⟩ : (X \ {u}).Nonempty := Finset.card_pos.mp (by omega)
  have hMne : (N.erase f).Nonempty := by
    obtain ⟨e₀, ⟨h1, -⟩, -⟩ := hMcov w₀ hw₀
    exact ⟨e₀, h1⟩
  -- Kotzig: the unique perfect matching of `G|X - u` has a bridge `e`
  obtain ⟨e, heM, T, hTY, hiff⟩ : ∃ e ∈ N.erase f, ∃ T ⊆ X \ {u},
      ∀ g, (α g ∈ X \ {u} ∧ β g ∈ X \ {u} ∧ epCross α β T g) ↔ g = e := by
    by_contra hno
    have hbr : ∀ e ∈ N.erase f, ∀ T ⊆ X \ {u},
        ¬(∀ g, (α g ∈ X \ {u} ∧ β g ∈ X \ {u} ∧ epCross α β T g) ↔ g = e) :=
      fun e he T hT hiff => hno ⟨e, he, T, hT, hiff⟩
    obtain ⟨M', hne, hM'in, hM'cov⟩ :=
      ep_kotzig_in α β (X \ {u}) w₀ hw₀ _ hMin hMcov hMne hbr
    have hfM' : f ∉ M' := fun hfm => by
      obtain ⟨a1, a2, -⟩ := hM'in f hfm
      rw [hmemY] at a1 a2
      unfold epCross at hf; tauto
    have hN' : insert f M' ∈ epLM α β X := by
      refine ⟨fun g hg => ?_, fun c hc => ?_⟩
      · rcases Finset.mem_insert.mp hg with hgf | hgM
        · rw [hgf]; unfold epCross at hf; tauto
        · exact Or.inl ((hmemY _).mp (hM'in g hgM).1).1
      · by_cases hcu : c = u
        · rw [hcu]
          refine ⟨f, ⟨Finset.mem_insert_self _ _, hfu⟩, fun g hg => ?_⟩
          rcases Finset.mem_insert.mp hg.1 with hgf | hgM
          · exact hgf
          · exfalso
            obtain ⟨a1, a2, -⟩ := hM'in g hgM
            rw [hmemY] at a1 a2
            have := hg.2
            rw [epCross_singleton] at this
            tauto
        · obtain ⟨e₀, ⟨h1, h2⟩, hun⟩ := hM'cov c ((hmemY c).mpr ⟨hc, hcu⟩)
          refine ⟨e₀, ⟨Finset.mem_insert_of_mem h1, h2⟩, fun g hg => ?_⟩
          rcases Finset.mem_insert.mp hg.1 with hgf | hgM
          · exact absurd (hfu' c hc (by rw [← hgf]; exact hg.2)) hcu
          · exact hun g ⟨hgM, hg.2⟩
    have honly' : ∀ g ∈ insert f M', epCross α β X g → g = f := by
      intro g hg hc
      rcases Finset.mem_insert.mp hg with hgf | hgM
      · exact hgf
      · exfalso
        obtain ⟨a1, a2, -⟩ := hM'in g hgM
        rw [hmemY] at a1 a2
        unfold epCross at hc; tauto
    have hEq := huniq _ hN' (Finset.mem_insert_self _ _) honly'
    apply hne
    rw [← hEq, Finset.erase_insert hfM']
  obtain ⟨ei1, ei2, ecr⟩ := (hiff e).mpr rfl
  -- `|T|` is odd
  have hTodd : T.card % 2 = 1 := by
    have hd := ep_double_count α β (N.erase f) (fun g hg => (hMin g hg).2.2) T
    have h1 : ∀ c ∈ T, ((N.erase f).filter (epCross α β {c})).card = 1 :=
      fun c hc => (ep_unique_iff_card _ _).mp (hMcov c (hTY hc))
    rw [Finset.sum_congr rfl h1, Finset.sum_const, smul_eq_mul, mul_one] at hd
    have h2 : (N.erase f).filter (epCross α β T) = {e} := by
      ext g
      rw [Finset.mem_filter, Finset.mem_singleton]
      constructor
      · rintro ⟨hg, hc⟩
        exact (hiff g).mp ⟨(hMin g hg).1, (hMin g hg).2.1, hc⟩
      · intro hg
        rw [hg]; exact ⟨heM, ecr⟩
    rw [h2, Finset.card_singleton] at hd
    omega
  -- cuts
  have hku : (epCut α β {u} ∩ epCut α β X).card = 1 := by
    have h1 := ep_cut5_bdry_le_one α β L X h h4 hXL h5 hX5 hnb u hu
    have h2 : 0 < (epCut α β {u} ∩ epCut α β X).card := Finset.card_pos.mpr
      ⟨f, Finset.mem_inter.mpr ⟨(mem_epCut _ _ _ _).mpr hfu, (mem_epCut _ _ _ _).mpr hf⟩⟩
    omega
  have hcY : (epCut α β (X \ {u})).card = 6 := by
    have := ep_cut_erase α β L X h hXL u hu; omega
  have hYL : X \ {u} ⊆ L := hYX.trans hXL
  have hdT : Disjoint T ((X \ {u}) \ T) := Finset.disjoint_sdiff
  have e1 := ep_cut_union α β T ((X \ {u}) \ T) hdT
  have hbtw : epBtw α β T ((X \ {u}) \ T) = {e} := by
    ext g
    rw [mem_epBtw, Finset.mem_singleton, ← hiff g]
    have a1 : α g ∈ T → α g ∈ X \ {u} := fun h' => hTY h'
    have a2 : β g ∈ T → β g ∈ X \ {u} := fun h' => hTY h'
    unfold epCross
    simp only [Finset.mem_sdiff] at a1 a2 ⊢
    tauto
  rw [Finset.union_sdiff_of_subset hTY, hcY, hbtw, Finset.card_singleton] at e1
  obtain ⟨t, ht, s, hsY, hsT⟩ : ∃ t, t ∈ T ∧ ∃ s, s ∈ X \ {u} ∧ s ∉ T := by
    have ecr' := ecr
    unfold epCross at ecr'
    rcases ecr' with ⟨a, b⟩ | ⟨a, b⟩
    · exact ⟨_, a, _, ei2, b⟩
    · exact ⟨_, b, _, ei1, a⟩
  have c1 := h4.1 T (hTY.trans hYL) ⟨t, ht⟩
    (fun h' => hsT (by rw [h']; exact hYL hsY))
  have c2 := h4.1 ((X \ {u}) \ T) (Finset.sdiff_subset.trans hYL)
    ⟨s, Finset.mem_sdiff.mpr ⟨hsY, hsT⟩⟩ (fun h' => by
      have : t ∈ (X \ {u}) \ T := by rw [h']; exact hYL (hTY ht)
      exact (Finset.mem_sdiff.mp this).2 ht)
  have hpT := epD_cut_parity α β L h T (hTY.trans hYL)
  -- wlog the side `A` of the bridge has cut 3
  obtain ⟨A, hAY, hA3, hAiff⟩ : ∃ A ⊆ X \ {u}, (epCut α β A).card = 3 ∧
      ∀ g, (α g ∈ X \ {u} ∧ β g ∈ X \ {u} ∧ epCross α β A g) ↔ g = e := by
    by_cases hT3 : (epCut α β T).card = 3
    · exact ⟨T, hTY, hT3, hiff⟩
    · refine ⟨(X \ {u}) \ T, Finset.sdiff_subset, by omega, fun g => ?_⟩
      rw [← hiff g]
      unfold epCross
      simp only [Finset.mem_sdiff]
      tauto
  have hA1 : A.card = 1 := by
    rcases h4.2 A (hAY.trans hYL) hA3 with h' | h'
    · exact h'
    · exfalso
      obtain ⟨z, hz⟩ : (L \ X).Nonempty := Finset.card_pos.mp (by omega)
      obtain ⟨hzL, hzX⟩ := Finset.mem_sdiff.mp hz
      have : 1 < (L \ A).card := Finset.one_lt_card.mpr
        ⟨u, Finset.mem_sdiff.mpr ⟨hXL hu, fun h'' => ((hmemY u).mp (hAY h'')).2 rfl⟩, z,
          Finset.mem_sdiff.mpr ⟨hzL, fun h'' => hzX (hYX (hAY h''))⟩,
          fun h'' => hzX (by rw [← h'']; exact hu)⟩
      omega
  obtain ⟨a, haA⟩ := Finset.card_eq_one.mp hA1
  rw [haA] at hAiff hA3 hAY
  exact ⟨u, a, f, e, hu, hf, hfu, hfu', hAY (Finset.mem_singleton_self a), hAiff⟩

set_option maxHeartbeats 1600000 in
open Classical in
/-- **Lemma D1 (reduction step).** A non-burl `X` with a cut of size five and at least five
vertices is a smaller non-burl with a cut of size five plus a pendant pair `u`, `a`: `u ~ a`,
`u ~ y`, `a ~ q` with `y ≠ q` in `X \ {u, a}`, `y ≁ q`, and `u`, `a` have no other neighbour in
`X`. (Twelve steps; uses P1, P2′, P3, P4, P5.) -/
theorem ep_cut5_reduce {W E : Type*} [Fintype E] (α β : E → W) (L X : Finset W)
    (h : EpCubicD α β L) (h4 : EpCyc4 α β L) (hXL : X ⊆ L) (h5 : (epCut α β X).card = 5)
    (hX5 : 5 ≤ X.card) (hnb : ¬EpBurl α β X) :
    ∃ u a y q : W, u ∈ X ∧ a ∈ X ∧ u ≠ a ∧ y ∈ X \ {u, a} ∧ q ∈ X \ {u, a} ∧ y ≠ q ∧
      EpAdj α β u a ∧ EpAdj α β u y ∧ EpAdj α β a q ∧ ¬EpAdj α β y q ∧
      (∀ z ∈ X, EpAdj α β u z → z = a ∨ z = y) ∧ (∀ z ∈ X, EpAdj α β a z → z = u ∨ z = q) ∧
      (epCut α β (X \ {u, a})).card = 5 ∧ ¬EpBurl α β (X \ {u, a}) := by
  have hnl : ∀ g, α g ∈ X → α g ≠ β g := by
    intro g hg
    rcases h.1 g with h' | h'
    · exact h'.2.2
    · exact absurd (hXL hg) h'.1
  obtain ⟨hodd, hout⟩ := ep_cut5_parity α β L X h hXL h5
  have hL8 : 8 ≤ L.card := by
    have := Finset.card_sdiff_add_card_eq_card hXL; omega
  obtain ⟨u, a, f, e, hu, hf, hfu, hfu', haY, hAiff⟩ :=
    ep_cut5_reduce_aux α β L X h h4 hXL h5 hX5 hnb
  have hX' : X \ {u, a} = (X \ {u}) \ {a} := by
    ext w
    simp only [Finset.mem_sdiff, Finset.mem_insert, Finset.mem_singleton]
    tauto
  have hYX : X \ {u} ⊆ X := Finset.sdiff_subset
  have hYL : X \ {u} ⊆ L := hYX.trans hXL
  have hmemY : ∀ w, w ∈ X \ {u} ↔ w ∈ X ∧ w ≠ u := fun w => by
    rw [Finset.mem_sdiff, Finset.mem_singleton]
  have hku : (epCut α β {u} ∩ epCut α β X).card = 1 := by
    have h1 := ep_cut5_bdry_le_one α β L X h h4 hXL h5 hX5 hnb u hu
    have h2 : 0 < (epCut α β {u} ∩ epCut α β X).card := Finset.card_pos.mpr
      ⟨f, Finset.mem_inter.mpr ⟨(mem_epCut _ _ _ _).mpr hfu, (mem_epCut _ _ _ _).mpr hf⟩⟩
    omega
  have hcY : (epCut α β (X \ {u})).card = 6 := by
    have := ep_cut_erase α β L X h hXL u hu; omega
  obtain ⟨haX, hau⟩ := (hmemY a).mp haY
  obtain ⟨ea1, ea2, eacr⟩ := (hAiff e).mpr rfl
  -- `q`: the other end of the bridge
  obtain ⟨q, hqa, heq⟩ := ep_cross_other α β a e eacr
  have hqY : q ∈ X \ {u} := by
    rcases heq with ⟨b1, b2⟩ | ⟨b1, b2⟩
    · rw [← b2]; exact ea2
    · rw [← b1]; exact ea1
  obtain ⟨hqX, hqu⟩ := (hmemY q).mp hqY
  -- neighbours of `a` inside `X`
  have hNa : ∀ z ∈ X, EpAdj α β a z → z = u ∨ z = q := by
    intro z hz ⟨g, hg⟩
    by_cases hzu : z = u
    · exact Or.inl hzu
    · right
      have hza := ep_ends_ne α β L h a z g (hXL haX) hg
      have hge : g = e := (hAiff g).mp (by
        rcases hg with ⟨b1, b2⟩ | ⟨b1, b2⟩
        · refine ⟨by rw [b1]; exact haY, by rw [b2]; exact (hmemY z).mpr ⟨hz, hzu⟩, ?_⟩
          rw [epCross_singleton]; exact Or.inl ⟨b1, by rw [b2]; exact hza⟩
        · refine ⟨by rw [b1]; exact (hmemY z).mpr ⟨hz, hzu⟩, by rw [b2]; exact haY, ?_⟩
          rw [epCross_singleton]; exact Or.inr ⟨by rw [b1]; exact hza, b2⟩)
      rw [hge] at hg
      exact ep_ends_unique α β a q z e heq hg
  have hka := ep_cut5_bdry_le_one α β L X h h4 hXL h5 hX5 hnb a haX
  -- `a` is adjacent to `u`
  have hadj : EpAdj α β u a := by
    by_contra hno
    have hsub : (epCut α β {a}).erase e ⊆ epCut α β {a} ∩ epCut α β X := by
      intro g hg
      obtain ⟨hge, hga⟩ := Finset.mem_erase.mp hg
      refine Finset.mem_inter.mpr ⟨hga, ?_⟩
      rw [mem_epCut] at hga ⊢
      by_contra hnc
      obtain ⟨z, hza, hends⟩ := ep_cross_other α β a g hga
      have hzX : z ∈ X := by
        by_contra h'
        exact hnc ((ep_cross_set_of_ends α β X a z g haX hends).mpr h')
      rcases hNa z hzX ⟨g, hends⟩ with h' | h'
      · rw [h'] at hends
        exact hno ⟨g, hends.symm⟩
      · refine hge ((hAiff g).mp ?_)
        rcases hends with ⟨b1, b2⟩ | ⟨b1, b2⟩
        · rw [b1, b2, h']; exact ⟨haY, hqY, hga⟩
        · rw [b1, b2, h']; exact ⟨hqY, haY, hga⟩
    have h1 := Finset.card_le_card hsub
    rw [Finset.card_erase_of_mem ((mem_epCut _ _ _ _).mpr eacr), h.2 a (hXL haX)] at h1
    omega
  obtain ⟨g₁, hg₁⟩ := hadj
  have hg₁c := ep_cross_both_of_ends α β u a g₁ hau hg₁
  -- the third edge at `u`
  have hfg₁ : f ≠ g₁ := fun e' => hau (hfu' a haX (by rw [e']; exact hg₁c.2))
  have hcu3 : (((epCut α β {u}).erase f).erase g₁).card = 1 := by
    rw [Finset.card_erase_of_mem (Finset.mem_erase.mpr
        ⟨Ne.symm hfg₁, (mem_epCut _ _ _ _).mpr hg₁c.1⟩),
      Finset.card_erase_of_mem ((mem_epCut _ _ _ _).mpr hfu), h.2 u (hXL hu)]
  obtain ⟨g₃, hg₃s⟩ := Finset.card_eq_one.mp hcu3
  have hg₃m : g₃ ∈ ((epCut α β {u}).erase f).erase g₁ := by
    rw [hg₃s]; exact Finset.mem_singleton_self g₃
  obtain ⟨hg₃g₁, hg₃'⟩ := Finset.mem_erase.mp hg₃m
  obtain ⟨hg₃f, hg₃u⟩ := Finset.mem_erase.mp hg₃'
  rw [mem_epCut] at hg₃u
  obtain ⟨y, hyu, hg₃⟩ := ep_cross_other α β u g₃ hg₃u
  have hyX : y ∈ X := by
    by_contra h'
    have hc : epCross α β X g₃ := (ep_cross_set_of_ends α β X u y g₃ hu hg₃).mpr h'
    have : 1 < (epCut α β {u} ∩ epCut α β X).card := Finset.one_lt_card.mpr
      ⟨f, Finset.mem_inter.mpr ⟨(mem_epCut _ _ _ _).mpr hfu, (mem_epCut _ _ _ _).mpr hf⟩,
        g₃, Finset.mem_inter.mpr ⟨(mem_epCut _ _ _ _).mpr hg₃u, (mem_epCut _ _ _ _).mpr hc⟩,
        Ne.symm hg₃f⟩
    omega
  have hya : y ≠ a := by
    intro e'
    rw [e'] at hg₃
    exact hg₃g₁ (ep_cyc4_no_parallel α β L h h4 (by omega) u a (hXL hu) (hXL haX)
      (Ne.symm hau) g₃ g₁ (ep_cross_both_of_ends α β u a g₃ hau hg₃)
      (ep_cross_both_of_ends α β u a g₁ hau hg₁))
  -- neighbours of `u` inside `X`
  have hNu : ∀ z ∈ X, EpAdj α β u z → z = a ∨ z = y := by
    intro z hz ⟨g, hg⟩
    have hzu := ep_ends_ne α β L h u z g (hXL hu) hg
    have hgc := ep_cross_both_of_ends α β u z g hzu hg
    by_cases hgf : g = f
    · exact absurd (hfu' z hz (by rw [← hgf]; exact hgc.2)) hzu
    · by_cases hgg : g = g₁
      · rw [hgg] at hg
        exact Or.inl (ep_ends_unique α β u a z g₁ hg₁ hg)
      · have : g ∈ ((epCut α β {u}).erase f).erase g₁ :=
          Finset.mem_erase.mpr ⟨hgg, Finset.mem_erase.mpr ⟨hgf, (mem_epCut _ _ _ _).mpr hgc.1⟩⟩
        rw [hg₃s, Finset.mem_singleton] at this
        rw [this] at hg
        exact Or.inr (ep_ends_unique α β u y z g₃ hg₃ hg)
  have hg₃e : g₃ ≠ e := by
    intro e'
    rw [hmemY] at ea1 ea2
    rw [e'] at hg₃
    rcases hg₃ with ⟨b1, -⟩ | ⟨-, b2⟩
    · exact ea1.2 b1
    · exact ea2.2 b2
  -- cut bounds for `{u, a}`
  have hdua : Disjoint ({u} : Finset W) {a} := Finset.disjoint_singleton.mpr (Ne.symm hau)
  have eua := ep_cut_union α β {u} {a} hdua
  rw [h.2 u (hXL hu), h.2 a (hXL haX)] at eua
  have hbua : 0 < (epBtw α β {u} {a}).card := Finset.card_pos.mpr
    ⟨g₁, ep_btw_of_ends α β {u} {a} u a g₁ (Finset.mem_singleton_self u)
      (Finset.mem_singleton_self a) hg₁⟩
  have huaL : ({u} : Finset W) ∪ {a} ⊆ L := by
    intro w hw
    rcases Finset.mem_union.mp hw with h' | h'
    · rw [Finset.mem_singleton.mp h']; exact hXL hu
    · rw [Finset.mem_singleton.mp h']; exact hXL haX
  have huaX : ({u} : Finset W) ∪ {a} ⊆ X := by
    intro w hw
    rcases Finset.mem_union.mp hw with h' | h'
    · rw [Finset.mem_singleton.mp h']; exact hu
    · rw [Finset.mem_singleton.mp h']; exact haX
  have huacard : (({u} : Finset W) ∪ {a}).card = 2 := by
    rw [Finset.card_union_of_disjoint hdua, Finset.card_singleton, Finset.card_singleton]
  -- `y ≠ q`: no triangle
  have hyq : y ≠ q := by
    intro e'
    have hd3 : Disjoint (({u} : Finset W) ∪ {a}) {y} := by
      rw [Finset.disjoint_singleton_right, Finset.mem_union, Finset.mem_singleton,
        Finset.mem_singleton]
      exact fun h' => h'.elim hyu hya
    have e3 := ep_cut_union α β (({u} : Finset W) ∪ {a}) {y} hd3
    rw [h.2 y (hXL hyX)] at e3
    have hb3 : 1 < (epBtw α β (({u} : Finset W) ∪ {a}) {y}).card := Finset.one_lt_card.mpr
      ⟨g₃, ep_btw_of_ends α β _ _ u y g₃ (Finset.mem_union_left _ (Finset.mem_singleton_self u))
          (Finset.mem_singleton_self y) hg₃,
        e, ep_btw_of_ends α β _ _ a y e (Finset.mem_union_right _ (Finset.mem_singleton_self a))
          (Finset.mem_singleton_self y) (by rw [e']; exact heq), hg₃e⟩
    have hT3L : ({u} : Finset W) ∪ {a} ∪ {y} ⊆ L := by
      intro w hw
      rcases Finset.mem_union.mp hw with h' | h'
      · exact huaL h'
      · rw [Finset.mem_singleton.mp h']; exact hXL hyX
    have hT3card : (({u} : Finset W) ∪ {a} ∪ {y}).card = 3 := by
      rw [Finset.card_union_of_disjoint hd3, huacard, Finset.card_singleton]
    have hsd := Finset.card_sdiff_add_card_eq_card hT3L
    have c3 := h4.1 _ hT3L (Finset.card_pos.mp (by omega))
      (fun h' => by rw [h'] at hT3card; omega)
    have h3' : (epCut α β (({u} : Finset W) ∪ {a} ∪ {y})).card = 3 := by omega
    rcases h4.2 _ hT3L h3' with h' | h' <;> omega
  -- `y ≁ q`: no 4-cycle
  have hnadj : ¬EpAdj α β y q := by
    rintro ⟨g₄, hg₄⟩
    have hdyq : Disjoint ({y} : Finset W) {q} := Finset.disjoint_singleton.mpr hyq
    have eyq := ep_cut_union α β {y} {q} hdyq
    rw [h.2 y (hXL hyX), h.2 q (hXL hqX)] at eyq
    have hbyq : 0 < (epBtw α β {y} {q}).card := Finset.card_pos.mpr
      ⟨g₄, ep_btw_of_ends α β {y} {q} y q g₄ (Finset.mem_singleton_self y)
        (Finset.mem_singleton_self q) hg₄⟩
    have hd4 : Disjoint (({u} : Finset W) ∪ {a}) (({y} : Finset W) ∪ {q}) := by
      rw [Finset.disjoint_left]
      intro w hw hw'
      rw [Finset.mem_union, Finset.mem_singleton, Finset.mem_singleton] at hw hw'
      rcases hw with h' | h' <;> rcases hw' with h'' | h''
      · exact hyu (h''.symm.trans h')
      · exact hqu (h''.symm.trans h')
      · exact hya (h''.symm.trans h')
      · exact hqa (h''.symm.trans h')
    have e4 := ep_cut_union α β (({u} : Finset W) ∪ {a}) (({y} : Finset W) ∪ {q}) hd4
    have hb4 : 1 < (epBtw α β (({u} : Finset W) ∪ {a}) (({y} : Finset W) ∪ {q})).card :=
      Finset.one_lt_card.mpr
      ⟨g₃, ep_btw_of_ends α β _ _ u y g₃ (Finset.mem_union_left _ (Finset.mem_singleton_self u))
          (Finset.mem_union_left _ (Finset.mem_singleton_self y)) hg₃,
        e, ep_btw_of_ends α β _ _ a q e (Finset.mem_union_right _ (Finset.mem_singleton_self a))
          (Finset.mem_union_right _ (Finset.mem_singleton_self q)) heq, hg₃e⟩
    have hyqX : ({y} : Finset W) ∪ {q} ⊆ X := by
      intro w hw
      rcases Finset.mem_union.mp hw with h' | h'
      · rw [Finset.mem_singleton.mp h']; exact hyX
      · rw [Finset.mem_singleton.mp h']; exact hqX
    have hCX : ({u} : Finset W) ∪ {a} ∪ (({y} : Finset W) ∪ {q}) ⊆ X :=
      Finset.union_subset huaX hyqX
    have hCcard : (({u} : Finset W) ∪ {a} ∪ (({y} : Finset W) ∪ {q})).card = 4 := by
      rw [Finset.card_union_of_disjoint hd4, huacard, Finset.card_union_of_disjoint hdyq,
        Finset.card_singleton, Finset.card_singleton]
    have hpC := epD_cut_parity α β L h _ (hCX.trans hXL)
    have hsd := Finset.card_sdiff_add_card_eq_card (hCX.trans hXL)
    have c4 := h4.1 _ (hCX.trans hXL) (Finset.card_pos.mp (by omega))
      (fun h' => by rw [h'] at hCcard; omega)
    have hC4 : (epCut α β (({u} : Finset W) ∪ {a} ∪ (({y} : Finset W) ∪ {q}))).card = 4 := by
      omega
    exact hnb (ep_burl_mono α β _ X hCX hnl
      (ep_cut4_burl_cyc4 α β L _ h h4 (hCX.trans hXL) hC4 (by omega)))
  -- the cut of `X ∖ {u, a}`
  have hcut' : (epCut α β (X \ {u, a})).card = 5 := by
    rw [hX']
    have e5 := ep_cut_erase α β L (X \ {u}) h hYL a haY
    have hset : epCut α β {a} ∩ epCut α β (X \ {u}) = (epCut α β {a}).erase e := by
      ext g
      rw [Finset.mem_inter, Finset.mem_erase, mem_epCut, mem_epCut]
      constructor
      · rintro ⟨hga, hgY⟩
        refine ⟨fun h' => ?_, hga⟩
        rw [h'] at hgY
        unfold epCross at hgY
        rcases hgY with ⟨-, b⟩ | ⟨b, -⟩
        · exact b ea2
        · exact b ea1
      · rintro ⟨hne, hga⟩
        refine ⟨hga, ?_⟩
        by_contra hnc
        have hin : α g ∈ X \ {u} ∧ β g ∈ X \ {u} := by
          have hga' := hga
          rw [epCross_singleton] at hga'
          unfold epCross at hnc
          rcases hga' with ⟨b1, -⟩ | ⟨-, b2⟩
          · have hin1 : α g ∈ X \ {u} := by rw [b1]; exact haY
            exact ⟨hin1, by by_contra h'; exact hnc (Or.inl ⟨hin1, h'⟩)⟩
          · have hin2 : β g ∈ X \ {u} := by rw [b2]; exact haY
            exact ⟨by by_contra h'; exact hnc (Or.inr ⟨h', hin2⟩), hin2⟩
        exact hne ((hAiff g).mp ⟨hin.1, hin.2, hga⟩)
    rw [hset, Finset.card_erase_of_mem ((mem_epCut _ _ _ _).mpr eacr), h.2 a (hXL haX),
      hcY] at e5
    omega
  have hnb' : ¬EpBurl α β (X \ {u, a}) := fun hb =>
    hnb (ep_burl_mono α β _ X Finset.sdiff_subset hnl hb)
  refine ⟨u, a, y, q, hu, haX, Ne.symm hau, ?_, ?_, hyq, ⟨g₁, hg₁⟩, ⟨g₃, hg₃⟩, ⟨e, heq⟩,
    hnadj, hNu, hNa, hcut', hnb'⟩
  · simp only [Finset.mem_sdiff, Finset.mem_insert, Finset.mem_singleton]
    exact ⟨hyX, fun h' => h'.elim hyu hya⟩
  · simp only [Finset.mem_sdiff, Finset.mem_insert, Finset.mem_singleton]
    exact ⟨hqX, fun h' => h'.elim hqu hqa⟩

/-! ### a1. Model transfer -/

open Classical in
/-- The end of `g` other than `v`. -/
noncomputable def epOther {W E : Type*} (α β : E → W) (v : W) (g : E) : W :=
  if α g = v then β g else α g

lemma epOther_spec {W E : Type*} (α β : E → W) (v : W) (g : E) (hg : epCross α β {v} g) :
    epOther α β v g ≠ v ∧
      ((α g = v ∧ β g = epOther α β v g) ∨ (α g = epOther α β v g ∧ β g = v)) := by
  classical
  rw [epCross_singleton] at hg
  rcases hg with ⟨b1, b2⟩ | ⟨b1, b2⟩
  · have e : epOther α β v g = β g := if_pos b1
    rw [e]; exact ⟨b2, Or.inl ⟨b1, rfl⟩⟩
  · have e : epOther α β v g = α g := if_neg b1
    rw [e]; exact ⟨b1, Or.inr ⟨rfl, b2⟩⟩

lemma ep_cross_iff_of_ends {W E : Type*} (α β : E → W) (a z c : W) (g : E) (hz : z ≠ a)
    (hg : (α g = a ∧ β g = z) ∨ (α g = z ∧ β g = a)) :
    epCross α β {c} g ↔ (c = a ∨ c = z) := by
  rw [epCross_singleton]
  rcases hg with ⟨b1, b2⟩ | ⟨b1, b2⟩ <;> rw [b1, b2]
  · constructor
    · rintro (⟨e, -⟩ | ⟨-, e⟩)
      · exact Or.inl e.symm
      · exact Or.inr e.symm
    · rintro (e | e)
      · exact Or.inl ⟨e.symm, fun e' => hz (e'.trans e)⟩
      · exact Or.inr ⟨fun e' => hz (e'.trans e).symm, e.symm⟩
  · constructor
    · rintro (⟨e, -⟩ | ⟨-, e⟩)
      · exact Or.inr e.symm
      · exact Or.inl e.symm
    · rintro (e | e)
      · exact Or.inr ⟨fun e' => hz (e'.trans e), e.symm⟩
      · exact Or.inl ⟨e.symm, fun e' => hz (e'.trans e).symm⟩

