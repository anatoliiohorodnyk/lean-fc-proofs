open Classical in
/-- **Theorem A (merges with a 7-vertex twig).** Let the lifts of `X` and `Y` be laid out along
`X7` or `X9` with `p`, `q` at the pendant pair (L2′: positions `3, 4` in `X7`, `7, 8` in `X9`),
`X`, `Y` disjoint with no edge between. If one of the two lifts is `X9`, the merge is a burl.
(`ep_isoI_glue` and the certificates `lvC_mergeHS`, `lvC_mergeSH`, `lvC_mergeSS`.) -/
theorem epSp_merge_burl_of_S {W E : Type*} [Fintype E] (α β : E → W) (L : Finset W)
    (p q : W) (h : EpCubicD α β L) (h4 : EpCyc4 α β L) (h12 : 12 ≤ L.card)
    (hpL : p ∈ L) (hqL : q ∈ L) (X Y : Finset W) (hXL : X ⊆ L \ {p, q}) (hYL : Y ⊆ L \ {p, q})
    (hXY : Disjoint X Y) (hno : ∀ x ∈ X, ∀ y ∈ Y, ¬EpAdj α β x y)
    (φ ψ : ℕ → W)
    (hcase : ((EpIsoI α β (X ∪ {p, q}) 7 lvX7 φ ∧ φ 3 = p ∧ φ 4 = q) ∧
        (EpIsoI α β (Y ∪ {p, q}) 9 lvX9 ψ ∧ ψ 7 = p ∧ ψ 8 = q)) ∨
      ((EpIsoI α β (X ∪ {p, q}) 9 lvX9 φ ∧ φ 7 = p ∧ φ 8 = q) ∧
        (EpIsoI α β (Y ∪ {p, q}) 7 lvX7 ψ ∧ ψ 3 = p ∧ ψ 4 = q)) ∨
      ((EpIsoI α β (X ∪ {p, q}) 9 lvX9 φ ∧ φ 7 = p ∧ φ 8 = q) ∧
        (EpIsoI α β (Y ∪ {p, q}) 9 lvX9 ψ ∧ ψ 7 = p ∧ ψ 8 = q))) :
    EpBurl α β (X ∪ Y ∪ {p, q}) := by
  have hP : ∀ w, w ∈ ({p, q} : Finset W) ↔ w = p ∨ w = q := by
    intro w; simp only [Finset.mem_insert, Finset.mem_singleton]
  have hpX : p ∉ X := fun h' => (Finset.mem_sdiff.mp (hXL h')).2 ((hP p).mpr (Or.inl rfl))
  have hqX : q ∉ X := fun h' => (Finset.mem_sdiff.mp (hXL h')).2 ((hP q).mpr (Or.inr rfl))
  have hpY : p ∉ Y := fun h' => (Finset.mem_sdiff.mp (hYL h')).2 ((hP p).mpr (Or.inl rfl))
  have hqY : q ∉ Y := fun h' => (Finset.mem_sdiff.mp (hYL h')).2 ((hP q).mpr (Or.inr rfl))
  have hZL : X ∪ Y ∪ {p, q} ⊆ L := by
    intro w hw
    rcases Finset.mem_union.mp hw with h' | h'
    · exact (Finset.mem_sdiff.mp (Finset.union_subset hXL hYL h')).1
    · rcases (hP w).mp h' with e | e
      · rw [e]; exact hpL
      · rw [e]; exact hqL
  rcases hcase with ⟨⟨h1, e1, e2⟩, h2, e3, e4⟩ | ⟨⟨h1, e1, e2⟩, h2, e3, e4⟩ |
    ⟨⟨h1, e1, e2⟩, h2, e3, e4⟩
  · have hpq : p ≠ q := fun e => by
      have := h1.2.1 3 4 (by omega) (by omega) (by rw [e1, e2, e]); omega
    obtain ⟨χ, hχ⟩ := ep_isoI_glue α β X Y p q hpq hpX hqX hpY hqY hXY hno 7 9 14 lvX7 lvX9
      lvC_mergeHS.internal φ ψ h1 h2 3 4 7 8 (by omega) (by omega) (by omega) (by omega)
      e1 e2 e3 e4 _ lvGlue_HS
    exact ep_burl_of_model α β L _ h h4 (by omega) hZL lvC_mergeHS χ hχ lvC_mergeHS_model
      lvC_mergeHS_ok
  · have hpq : p ≠ q := fun e => by
      have := h1.2.1 7 8 (by omega) (by omega) (by rw [e1, e2, e]); omega
    obtain ⟨χ, hχ⟩ := ep_isoI_glue α β X Y p q hpq hpX hqX hpY hqY hXY hno 9 7 14 lvX9 lvX7
      lvC_mergeSH.internal φ ψ h1 h2 7 8 3 4 (by omega) (by omega) (by omega) (by omega)
      e1 e2 e3 e4 _ lvGlue_SH
    exact ep_burl_of_model α β L _ h h4 (by omega) hZL lvC_mergeSH χ hχ lvC_mergeSH_model
      lvC_mergeSH_ok
  · have hpq : p ≠ q := fun e => by
      have := h1.2.1 7 8 (by omega) (by omega) (by rw [e1, e2, e]); omega
    obtain ⟨χ, hχ⟩ := ep_isoI_glue α β X Y p q hpq hpX hqX hpY hqY hXY hno 9 9 16 lvX9 lvX9
      lvC_mergeSS.internal φ ψ h1 h2 7 8 7 8 (by omega) (by omega) (by omega) (by omega)
      e1 e2 e3 e4 _ lvGlue_SS
    exact ep_burl_of_model α β L _ h h4 (by omega) hZL lvC_mergeSS χ hχ lvC_mergeSS_model
      lvC_mergeSS_ok

/-- The data of a bad split (HD1–HD3). `s` and `t` are adjacent,
`N(t) = {s, w₁, w₂}`, `N(w₁) = {t, x, xs}`; `{s, x, a, b, c}` induces the 5-cycle
`s–a–x–c–b–s` and `{w₂, xs, a', b', c'}` the 5-cycle `w₂–a'–xs–c'–b'–w₂`; (HD1), (HD2): the
neighbourhoods of the four marks; the twelve vertices are distinct; (HD3): no edge between
the two houses. -/
def EpBadData {W E : Type*} (α β : E → W) (s t w₁ w₂ x xs a b c a' b' c' : W) : Prop :=
  (∀ z, EpAdj α β t z ↔ z = s ∨ z = w₁ ∨ z = w₂) ∧
  (∀ z, EpAdj α β w₁ z ↔ z = t ∨ z = x ∨ z = xs) ∧
  -- HD1
  (∀ z, EpAdj α β s z ↔ z = t ∨ z = a ∨ z = b) ∧ (∀ z, EpAdj α β x z ↔ z = w₁ ∨ z = a ∨ z = c) ∧
  -- HD2
  (∀ z, EpAdj α β w₂ z ↔ z = t ∨ z = a' ∨ z = b') ∧
  (∀ z, EpAdj α β xs z ↔ z = w₁ ∨ z = a' ∨ z = c') ∧
  -- the two 5-cycles
  EpAdj α β b c ∧ EpAdj α β b' c' ∧
  [s, t, w₁, w₂, x, xs, a, b, c, a', b', c'].Nodup ∧
  -- HD3
  (∀ z ∈ ({s, x, a, b, c} : Set W), ∀ z' ∈ ({w₂, xs, a', b', c'} : Set W), ¬EpAdj α β z z')

lemma lv_ne_of_nodup {W : Type*} (l : List W) (hl : l.Nodup) (i j : ℕ) (hi : i < l.length)
    (hj : j < l.length) (hij : i ≠ j) : l.get ⟨i, hi⟩ ≠ l.get ⟨j, hj⟩ :=
  fun e => hij (congrArg Fin.val (List.nodup_iff_injective_get.mp hl e))

/-- The neighbours of a vertex of `L` from its three edges. (A vertex of `L` is not adjacent
to itself: dead loops are outside `L`.) -/
lemma ep_nbrs_of_three {W E : Type*} [Fintype E] (α β : E → W) (L : Finset W)
    (h : EpCubicD α β L) (v : W) (hv : v ∈ L) (e₁ e₂ e₃ : E) (z₁ z₂ z₃ : W)
    (hcut : ∀ g, epCross α β {v} g ↔ g = e₁ ∨ g = e₂ ∨ g = e₃)
    (h1 : (α e₁ = v ∧ β e₁ = z₁) ∨ (α e₁ = z₁ ∧ β e₁ = v))
    (h2 : (α e₂ = v ∧ β e₂ = z₂) ∨ (α e₂ = z₂ ∧ β e₂ = v))
    (h3 : (α e₃ = v ∧ β e₃ = z₃) ∨ (α e₃ = z₃ ∧ β e₃ = v)) :
    ∀ z, EpAdj α β v z ↔ z = z₁ ∨ z = z₂ ∨ z = z₃ := by
  intro z
  constructor
  · rintro ⟨g, hg⟩
    have hz := ep_ends_ne α β L h v z g hv hg
    have hc := (ep_cross_both_of_ends α β v z g hz hg).1
    rcases (hcut g).mp hc with e | e | e
    · rw [e] at hg; exact Or.inl (ep_ends_unique α β v z₁ z e₁ h1 hg)
    · rw [e] at hg; exact Or.inr (Or.inl (ep_ends_unique α β v z₂ z e₂ h2 hg))
    · rw [e] at hg; exact Or.inr (Or.inr (ep_ends_unique α β v z₃ z e₃ h3 hg))
  · rintro (e | e | e)
    · rw [e]; exact ⟨e₁, h1⟩
    · rw [e]; exact ⟨e₂, h2⟩
    · rw [e]; exact ⟨e₃, h3⟩

lemma lv_or_swap23 {A B C : Prop} : A ∨ B ∨ C ↔ A ∨ C ∨ B := by tauto

lemma lv_or_rot {A B C : Prop} : A ∨ B ∨ C ↔ C ∨ A ∨ B := by tauto

/-- `ep_isoI_perm` with the new layout written out. -/
theorem ep_isoI_perm_fun {W E : Type*} (α β : E → W) (X : Finset W) (n : ℕ)
    (I I' : List (ℕ × ℕ)) (φ : ℕ → W) (l : List ℕ) (hl : lvPermOK n I I' l)
    (hiso : EpIsoI α β X n I φ) : EpIsoI α β X n I' (fun i => φ (l.getD i 0)) := by
  obtain ⟨hτ, hinj, hsurj, hI⟩ := hl
  obtain ⟨hφX, hφinj, hφsurj, hadj⟩ := hiso
  refine ⟨fun i hi => hφX _ (hτ i hi),
    fun i j hi hj he => congrArg Fin.val
      (hinj ⟨i, hi⟩ ⟨j, hj⟩ (hφinj _ _ (hτ i hi) (hτ j hj) he)), fun x hx => ?_,
    fun i j hi hj => ?_⟩
  · obtain ⟨k, hk, hkx⟩ := hφsurj x hx
    obtain ⟨i, hi, hik⟩ := List.mem_map.mp (hsurj k hk)
    exact ⟨i, List.mem_range.mp hi, (congrArg φ hik).trans hkx⟩
  · rw [hI ⟨i, hi⟩ ⟨j, hj⟩]
    exact hadj _ _ (hτ i hi) (hτ j hj)

theorem lvAut7_a : lvPermOK 7 lvX7 lvX7 [2, 1, 0, 4, 3, 6, 5] := by
  unfold lvPermOK; decide +kernel

theorem lvAut7_b : lvPermOK 7 lvX7 lvX7 [0, 1, 2, 5, 6, 3, 4] := by
  unfold lvPermOK; decide +kernel

theorem lvAut7_c : lvPermOK 7 lvX7 lvX7 [2, 1, 0, 6, 5, 4, 3] := by
  unfold lvPermOK; decide +kernel

theorem lvAut9 : lvPermOK 9 lvX9 lvX9 [2, 1, 0, 6, 5, 4, 3, 8, 7] := by
  unfold lvPermOK; decide +kernel

/-- L2′ for the models: two adjacent vertices with at most two neighbours each are a pendant
pair of `X7` (`(3,4)` or `(5,6)`), resp. the pendant pair `(7,8)` of `X9`. -/
theorem lvKeyAdj7 : ∀ i j : Fin 7, ((i.1, j.1) ∈ lvX7 ∨ (j.1, i.1) ∈ lvX7) →
    (lvNbrs lvX7 7 i.1).card ≤ 2 → (lvNbrs lvX7 7 j.1).card ≤ 2 →
    (i.1, j.1) = (3, 4) ∨ (i.1, j.1) = (4, 3) ∨ (i.1, j.1) = (5, 6) ∨ (i.1, j.1) = (6, 5) := by
  decide +kernel

theorem lvKeyAdj9 : ∀ i j : Fin 9, ((i.1, j.1) ∈ lvX9 ∨ (j.1, i.1) ∈ lvX9) →
    (lvNbrs lvX9 9 i.1).card ≤ 2 → (lvNbrs lvX9 9 j.1).card ≤ 2 →
    (i.1, j.1) = (7, 8) ∨ (i.1, j.1) = (8, 7) := by
  decide +kernel

theorem lvNb7_0 : ∀ j : Fin 7, ((0, j.1) ∈ lvX7 ∨ (j.1, 0) ∈ lvX7) →
    j.1 = 3 ∨ j.1 = 1 ∨ j.1 = 5 := by
  decide +kernel

theorem lvNb7_2 : ∀ j : Fin 7, ((2, j.1) ∈ lvX7 ∨ (j.1, 2) ∈ lvX7) →
    j.1 = 4 ∨ j.1 = 1 ∨ j.1 = 6 := by
  decide +kernel

theorem lvNb7_3 : ∀ j : Fin 7, ((3, j.1) ∈ lvX7 ∨ (j.1, 3) ∈ lvX7) → j.1 = 0 ∨ j.1 = 4 := by
  decide +kernel

theorem lvNb7_4 : ∀ j : Fin 7, ((4, j.1) ∈ lvX7 ∨ (j.1, 4) ∈ lvX7) → j.1 = 2 ∨ j.1 = 3 := by
  decide +kernel

theorem lvDeg7 : (lvNbrs lvX7 7 0).card = 3 ∧ (lvNbrs lvX7 7 2).card = 3 := by
  decide +kernel

theorem lvCodes : ∀ s ∈ [0, 3, 4, 7, 2, 9, 1, 5, 6, 8, 12, 13],
    s < 7 ∨ (7 ≤ s ∧ s < 14 ∧ s ≠ 10 ∧ s ≠ 11) := by
  decide +kernel

theorem lvCodesNodup : [0, 3, 4, 7, 2, 9, 1, 5, 6, 8, 12, 13].Nodup := by
  decide +kernel

open Classical in
/-- A model vertex with a neighbour outside the laid-out set has at most two neighbours in the
model. -/
theorem ep_model_deg_le_two {W E : Type*} [Fintype E] (α β : E → W) (L S : Finset W)
    (h : EpCubicD α β L) (h4 : EpCyc4 α β L) (h6 : 6 ≤ L.card) (hSL : S ⊆ L)
    (n : ℕ) (I : List (ℕ × ℕ)) (φ : ℕ → W) (hiso : EpIsoI α β S n I φ) (k : ℕ) (hk : k < n)
    (v : W) (hv : v ∉ S) (hadj : EpAdj α β v (φ k)) : (lvNbrs I n k).card ≤ 2 := by
  have h1 := ep_model_bdry_card α β L S h h4 h6 hSL n I φ hiso k hk
  obtain ⟨g, hg⟩ := hadj
  have hφS := hiso.1 k hk
  have hne : v ≠ φ k := fun e => hv (by rw [e]; exact hφS)
  have hg' : (α g = φ k ∧ β g = v) ∨ (α g = v ∧ β g = φ k) := hg.symm
  have hc := (ep_cross_both_of_ends α β (φ k) v g hne hg').1
  have hx := (ep_cross_set_of_ends α β S (φ k) v g hφS hg').mpr hv
  have hpos : 0 < ((epCut α β {φ k}).filter (epCross α β S)).card :=
    Finset.card_pos.mpr ⟨g, Finset.mem_filter.mpr ⟨(mem_epCut _ _ _ _).mpr hc, hx⟩⟩
  omega

open Classical in
/-- A model vertex with three neighbours in the model has no other neighbour. -/
theorem ep_nbrs_model {W E : Type*} [Fintype E] (α β : E → W) (L S : Finset W)
    (h : EpCubicD α β L) (h4 : EpCyc4 α β L) (h6 : 6 ≤ L.card) (hSL : S ⊆ L)
    (n : ℕ) (I : List (ℕ × ℕ)) (φ : ℕ → W) (hiso : EpIsoI α β S n I φ) (i : ℕ) (hi : i < n)
    (hdeg : (lvNbrs I n i).card = 3) (z : W) (hz : EpAdj α β (φ i) z) :
    ∃ j, ∃ hj : j < n, z = φ j ∧ ((i, j) ∈ I ∨ (j, i) ∈ I) := by
  have h1 := ep_model_bdry_card α β L S h h4 h6 hSL n I φ hiso i hi
  obtain ⟨hφS, hφinj, hφsurj, hadj⟩ := hiso
  have hzS : z ∈ S := by
    by_contra hzS
    obtain ⟨g, hg⟩ := hz
    have hne := ep_ends_ne α β L h (φ i) z g (hSL (hφS i hi)) hg
    have hc := (ep_cross_both_of_ends α β (φ i) z g hne hg).1
    have hx := (ep_cross_set_of_ends α β S (φ i) z g (hφS i hi) hg).mpr hzS
    have hpos : 0 < ((epCut α β {φ i}).filter (epCross α β S)).card :=
      Finset.card_pos.mpr ⟨g, Finset.mem_filter.mpr ⟨(mem_epCut _ _ _ _).mpr hc, hx⟩⟩
    omega
  obtain ⟨j, hj, e⟩ := hφsurj z hzS
  refine ⟨j, hj, e.symm, (hadj i j hi hj).mp ?_⟩
  rw [e]; exact hz

open Classical in
/-- **L2′ for `X7`.** Two adjacent vertices `p`, `q` of a set laid out along `X7`, each with a
neighbour outside, can be put at the positions `3`, `4`. -/
theorem ep_lift_norm7 {W E : Type*} [Fintype E] (α β : E → W) (L S : Finset W)
    (h : EpCubicD α β L) (h4 : EpCyc4 α β L) (h6 : 6 ≤ L.card) (hSL : S ⊆ L) (φ : ℕ → W)
    (hiso : EpIsoI α β S 7 lvX7 φ) (p q o₁ o₂ : W) (hp : p ∈ S) (hq : q ∈ S)
    (hpq : EpAdj α β p q) (ho₁ : o₁ ∉ S) (hpo : EpAdj α β p o₁) (ho₂ : o₂ ∉ S)
    (hqo : EpAdj α β q o₂) : ∃ φ', EpIsoI α β S 7 lvX7 φ' ∧ φ' 3 = p ∧ φ' 4 = q := by
  have hiso' := hiso
  obtain ⟨hφS, hφinj, hφsurj, hadj⟩ := hiso'
  obtain ⟨i, hi, hip⟩ := hφsurj p hp
  obtain ⟨j, hj, hjq⟩ := hφsurj q hq
  have hdi := ep_model_deg_le_two α β L S h h4 h6 hSL 7 lvX7 φ hiso i hi o₁ ho₁
    (by rw [hip]; exact (ep_adj_comm α β p o₁).mp hpo)
  have hdj := ep_model_deg_le_two α β L S h h4 h6 hSL 7 lvX7 φ hiso j hj o₂ ho₂
    (by rw [hjq]; exact (ep_adj_comm α β q o₂).mp hqo)
  have hs := (hadj i j hi hj).mp (by rw [hip, hjq]; exact hpq)
  have hk := lvKeyAdj7 ⟨i, hi⟩ ⟨j, hj⟩ hs hdi hdj
  dsimp only at hk
  rcases hk with e | e | e | e <;> obtain ⟨rfl, rfl⟩ := Prod.mk.inj e
  · exact ⟨φ, hiso, hip, hjq⟩
  · exact ⟨_, ep_isoI_perm_fun α β S 7 lvX7 lvX7 φ [2, 1, 0, 4, 3, 6, 5] lvAut7_a hiso,
      hip, hjq⟩
  · exact ⟨_, ep_isoI_perm_fun α β S 7 lvX7 lvX7 φ [0, 1, 2, 5, 6, 3, 4] lvAut7_b hiso,
      hip, hjq⟩
  · exact ⟨_, ep_isoI_perm_fun α β S 7 lvX7 lvX7 φ [2, 1, 0, 6, 5, 4, 3] lvAut7_c hiso,
      hip, hjq⟩

open Classical in
/-- **L2′ for `X9`.** The same with the positions `7`, `8`. -/
theorem ep_lift_norm9 {W E : Type*} [Fintype E] (α β : E → W) (L S : Finset W)
    (h : EpCubicD α β L) (h4 : EpCyc4 α β L) (h6 : 6 ≤ L.card) (hSL : S ⊆ L) (φ : ℕ → W)
    (hiso : EpIsoI α β S 9 lvX9 φ) (p q o₁ o₂ : W) (hp : p ∈ S) (hq : q ∈ S)
    (hpq : EpAdj α β p q) (ho₁ : o₁ ∉ S) (hpo : EpAdj α β p o₁) (ho₂ : o₂ ∉ S)
    (hqo : EpAdj α β q o₂) : ∃ φ', EpIsoI α β S 9 lvX9 φ' ∧ φ' 7 = p ∧ φ' 8 = q := by
  have hiso' := hiso
  obtain ⟨hφS, hφinj, hφsurj, hadj⟩ := hiso'
  obtain ⟨i, hi, hip⟩ := hφsurj p hp
  obtain ⟨j, hj, hjq⟩ := hφsurj q hq
  have hdi := ep_model_deg_le_two α β L S h h4 h6 hSL 9 lvX9 φ hiso i hi o₁ ho₁
    (by rw [hip]; exact (ep_adj_comm α β p o₁).mp hpo)
  have hdj := ep_model_deg_le_two α β L S h h4 h6 hSL 9 lvX9 φ hiso j hj o₂ ho₂
    (by rw [hjq]; exact (ep_adj_comm α β q o₂).mp hqo)
  have hs := (hadj i j hi hj).mp (by rw [hip, hjq]; exact hpq)
  have hk := lvKeyAdj9 ⟨i, hi⟩ ⟨j, hj⟩ hs hdi hdj
  dsimp only at hk
  rcases hk with e | e <;> obtain ⟨rfl, rfl⟩ := Prod.mk.inj e
  · exact ⟨φ, hiso, hip, hjq⟩
  · exact ⟨_, ep_isoI_perm_fun α β S 9 lvX9 lvX9 φ [2, 1, 0, 6, 5, 4, 3, 8, 7] lvAut9 hiso,
      hip, hjq⟩

