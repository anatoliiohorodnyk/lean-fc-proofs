open Classical in
/-- **Replacement for `ep_cyc4_local`**: the same conclusion, and none of the four splits is
bad. (`ep_good_choice` + `ep_cyc4_local_at`; each of the four splits is an `EpPath4` through
`w` with first edge `f`: `hP1`, `hP1.swap`, `hP2`, `hP2.swap`.)

Existing statement, for comparison:
    theorem ep_cyc4_local (h : EpCubicD α β L) (h4 : EpCyc4 α β L) (h6 : 6 ≤ L.card) (e : E)
        (heL : α e ∈ L) : ∃ (w w₁ w₂ : W) (f g₁ g₂ h₁ h₁' h₂ h₂' : E), … (the first seven
        conjuncts below) -/
theorem ep_cyc4_local_good {W E : Type*} [Fintype E] (α β : E → W) (L : Finset W)
    (h : EpCubicD α β L) (h4 : EpCyc4 α β L) (h12 : 12 ≤ L.card) (e : E) (heL : α e ∈ L) :
    ∃ (w w₁ w₂ : W) (f g₁ g₂ h₁ h₁' h₂ h₂' : E),
      EpPath4 α β L w w₁ f h₁ g₂ h₁' g₁ ∧ EpPath4 α β L w w₂ f h₂ g₁ h₂' g₂ ∧
      ¬(α e ∈ ({w, w₁} : Finset W) ∨ β e ∈ ({w, w₁} : Finset W)) ∧
      ¬(α e ∈ ({w, w₂} : Finset W) ∨ β e ∈ ({w, w₂} : Finset W)) ∧
      epCross α β {epOut α β {w, w₁} f} e ∧ epCross α β {epOut α β {w, w₂} f} e ∧
      (∀ M, M ∈ epPM α β L → e ∈ M → h₁ ∈ M ∨ h₁' ∈ M ∨ h₂ ∈ M ∨ h₂' ∈ M) ∧
      ¬EpBadSplit α β L w w₁ f h₁ g₂ h₁' ∧ ¬EpBadSplit α β L w w₁ f h₁' g₂ h₁ ∧
      ¬EpBadSplit α β L w w₂ f h₂ g₁ h₂' ∧ ¬EpBadSplit α β L w w₂ f h₂' g₁ h₂ := by
  obtain ⟨v, w, f, hve, hvf, hfe, hwf, hwv, hgood⟩ := ep_good_choice α β L h h4 h12 e heL
  obtain ⟨w₁, w₂, g₁, g₂, h₁, h₁', h₂, h₂', hP1, hP2, k1, k2, c1, c2, hM⟩ :=
    ep_cyc4_local_at α β L h h4 (by omega) e heL v w f hve hvf hfe hwf hwv
  exact ⟨w, w₁, w₂, f, g₁, g₂, h₁, h₁', h₂, h₂', hP1, hP2, k1, k2, c1, c2, hM,
    fun hb => hgood ⟨w₁, h₁, g₂, h₁', g₁, hP1, hb⟩,
    fun hb => hgood ⟨w₁, h₁', g₂, h₁, g₁, hP1.swap, hb⟩,
    fun hb => hgood ⟨w₂, h₂, g₁, h₂', g₂, hP2, hb⟩,
    fun hb => hgood ⟨w₂, h₂', g₁, h₂, g₂, hP2.swap, hb⟩⟩

open Classical in
/-- The weight of a rootless foliage: the member containing `v` plus the rest. -/
lemma ep_fol0_drop_eq {W E : Type*} [Fintype E] (α β : E → W) (L : Finset W)
    (𝒳 : Finset (Finset W)) (hfol : EpFol0 α β L 𝒳) (A : Finset W) (hA : A ∈ 𝒳) (v : W)
    (hv : v ∈ A) :
    epFw α β 𝒳 = (if EpTwig α β A then (4731 : ℝ) / 18400 else 2324 / 18400) +
      epFw α β (𝒳.filter (fun X => v ∉ X)) := by
  unfold epFw
  rw [← Finset.sum_filter_add_sum_filter_not 𝒳 (fun X => v ∉ X)]
  have hs : 𝒳.filter (fun X => ¬v ∉ X) = {A} := by
    ext X
    rw [Finset.mem_filter, Finset.mem_singleton, not_not]
    constructor
    · rintro ⟨hX, hvX⟩
      by_contra hne
      exact Finset.disjoint_left.mp (hfol.2 X hX A hA hne) hvX hv
    · intro e; rw [e]; exact ⟨hA, hv⟩
  rw [hs, Finset.sum_singleton, add_comm]

set_option maxHeartbeats 1600000 in
open Classical in
/-- **Theorem G: replacement for `epSp_fol` at a split that is not bad.** Loss `2 β₁ − β₂`
instead of `2 β₁`. Uses `2 β₂ ≤ β₁` (here `2 · 2324 ≤ 4731`).

The numerals are `β₁ = 4731/18400` and `β₂ = 2324/18400`, the values in `epFw`.

Existing statement, for comparison:
    theorem epSp_fol (h : EpCubicD α β L) (hp : EpPath4 α β L p q a b c d m)
        (𝒳' : Finset (Finset W))
        (hfol : EpFol0 (epSpA α β p q a b c d) (epSpB α β p q a b c d) (L \ {p, q}) 𝒳') :
        ∃ 𝒳, EpFol0 α β L 𝒳 ∧
          epFw (epSpA α β p q a b c d) (epSpB α β p q a b c d) 𝒳' - 2 * (4731 / 18400) ≤
            epFw α β 𝒳 -/
theorem epSp_fol_good {W E : Type*} [Fintype E] (α β : E → W) (L : Finset W) (p q : W)
    (a b c d m : E) (h : EpCubicD α β L) (h4 : EpCyc4 α β L) (h12 : 12 ≤ L.card)
    (hp : EpPath4 α β L p q a b c d m)
    (hab : epOut α β {p, q} a ≠ epOut α β {p, q} b)
    (hcd : epOut α β {p, q} c ≠ epOut α β {p, q} d)
    (hgood : ¬EpBadSplit α β L p q a b c d)
    (𝒳' : Finset (Finset W))
    (hfol : EpFol0 (epSpA α β p q a b c d) (epSpB α β p q a b c d) (L \ {p, q}) 𝒳') :
    ∃ 𝒳, EpFol0 α β L 𝒳 ∧
      epFw (epSpA α β p q a b c d) (epSpB α β p q a b c d) 𝒳' -
        (2 * (4731 / 18400) - 2324 / 18400) ≤ epFw α β 𝒳 := by
  have hP : ∀ w, w ∈ ({p, q} : Finset W) ↔ w = p ∨ w = q := by
    intro w; simp only [Finset.mem_insert, Finset.mem_singleton]
  have hp' := hp
  obtain ⟨hpL, hqL, hpq, -⟩ := hp'
  -- the members avoiding the outer ends of `a` and `c` (as in `epSp_fol`)
  obtain ⟨f1, w1⟩ := ep_fol0_drop _ _ _ 𝒳' hfol (epOut α β {p, q} a)
  obtain ⟨f2, w2⟩ := ep_fol0_drop _ _ _ _ f1 (epOut α β {p, q} c)
  have hmem : ∀ X ∈ (𝒳'.filter (fun X => (epOut α β {p, q} a) ∉ X)).filter (fun X => (epOut α β {p, q} c) ∉ X),
      EpBurl α β X ∧ (epCut α β X).card = (epCut (epSpA α β p q a b c d) (epSpB α β p q a b c d) X).card := by
    intro X hX
    obtain ⟨hX1, hcX⟩ := Finset.mem_filter.mp hX
    obtain ⟨hX2, haX⟩ := Finset.mem_filter.mp hX1
    exact epSp_burl α β L p q a b c d m h hp X (hfol.1 X hX2).1 haX hcX (hfol.1 X hX2).2
  have heq : epFw α β ((𝒳'.filter (fun X => (epOut α β {p, q} a) ∉ X)).filter (fun X => (epOut α β {p, q} c) ∉ X)) =
      epFw (epSpA α β p q a b c d) (epSpB α β p q a b c d) ((𝒳'.filter (fun X => (epOut α β {p, q} a) ∉ X)).filter (fun X => (epOut α β {p, q} c) ∉ X)) := by
    unfold epFw
    refine Finset.sum_congr rfl fun X hX => ?_
    have : EpTwig α β X ↔ EpTwig (epSpA α β p q a b c d) (epSpB α β p q a b c d) X := by
      unfold EpTwig; rw [(hmem X hX).2]
    by_cases ht : EpTwig α β X
    · rw [if_pos ht, if_pos (this.mp ht)]
    · rw [if_neg ht, if_neg (fun h' => ht (this.mpr h'))]
  have hK : EpFol0 α β L ((𝒳'.filter (fun X => (epOut α β {p, q} a) ∉ X)).filter (fun X => (epOut α β {p, q} c) ∉ X)) :=
    ⟨fun X hX => ⟨((f2.1 X hX).1).trans Finset.sdiff_subset, (hmem X hX).1⟩, f2.2⟩
  -- 1. no member contains the outer end of `a`
  by_cases hA : ∃ A ∈ 𝒳', (epOut α β {p, q} a) ∈ A
  swap
  · have e1 : 𝒳'.filter (fun X => (epOut α β {p, q} a) ∉ X) = 𝒳' :=
      Finset.filter_true_of_mem (fun X hX hx => hA ⟨X, hX, hx⟩)
    refine ⟨_, hK, ?_⟩
    linarith [heq, w2, congrArg (epFw (epSpA α β p q a b c d) (epSpB α β p q a b c d)) e1]
  obtain ⟨A, hA𝒳, haA⟩ := hA
  have hsumA := ep_fol0_drop_eq (epSpA α β p q a b c d) (epSpB α β p q a b c d) _ 𝒳' hfol A hA𝒳 (epOut α β {p, q} a) haA
  -- 1′. no other member contains the outer end of `c`
  by_cases hC : ∃ C ∈ 𝒳'.filter (fun X => (epOut α β {p, q} a) ∉ X), (epOut α β {p, q} c) ∈ C
  swap
  · have e2 : (𝒳'.filter (fun X => (epOut α β {p, q} a) ∉ X)).filter (fun X => (epOut α β {p, q} c) ∉ X) =
        𝒳'.filter (fun X => (epOut α β {p, q} a) ∉ X) :=
      Finset.filter_true_of_mem (fun X hX hx => hC ⟨X, hX, hx⟩)
    refine ⟨_, hK, ?_⟩
    linarith [heq, w1, congrArg (epFw (epSpA α β p q a b c d) (epSpB α β p q a b c d)) e2]
  obtain ⟨C, hC𝒳₁, hcC⟩ := hC
  obtain ⟨hC𝒳, haC⟩ := Finset.mem_filter.mp hC𝒳₁
  have hsumC := ep_fol0_drop_eq (epSpA α β p q a b c d) (epSpB α β p q a b c d) _ _ f1 C hC𝒳₁ (epOut α β {p, q} c) hcC
  have hAC : A ≠ C := fun e => haC (e ▸ haA)
  have hdAC : Disjoint A C := hfol.2 A hA𝒳 C hC𝒳 hAC
  have hcA : (epOut α β {p, q} c) ∉ A := fun h' => Finset.disjoint_left.mp hdAC h' hcC
  have hAL := (hfol.1 A hA𝒳).1
  have hCL := (hfol.1 C hC𝒳).1
  have hAburl := (hfol.1 A hA𝒳).2
  have hCburl := (hfol.1 C hC𝒳).2
  have wle : ∀ X : Finset W,
      (if EpTwig (epSpA α β p q a b c d) (epSpB α β p q a b c d) X then (4731 : ℝ) / 18400 else 2324 / 18400) ≤ 4731 / 18400 := by
    intro X; split_ifs <;> norm_num
  have wge : ∀ X : Finset W,
      (2324 : ℝ) / 18400 ≤ (if EpTwig α β X then (4731 : ℝ) / 18400 else 2324 / 18400) := by
    intro X; split_ifs <;> norm_num
  have hKA : ∀ X ∈ (𝒳'.filter (fun X => (epOut α β {p, q} a) ∉ X)).filter (fun X => (epOut α β {p, q} c) ∉ X),
      Disjoint X A := by
    intro X hX
    obtain ⟨hX1, hcX⟩ := Finset.mem_filter.mp hX
    obtain ⟨hX2, haX⟩ := Finset.mem_filter.mp hX1
    exact hfol.2 X hX2 A hA𝒳 (fun e => haX (e ▸ haA))
  have hKC : ∀ X ∈ (𝒳'.filter (fun X => (epOut α β {p, q} a) ∉ X)).filter (fun X => (epOut α β {p, q} c) ∉ X),
      Disjoint X C := by
    intro X hX
    obtain ⟨hX1, hcX⟩ := Finset.mem_filter.mp hX
    obtain ⟨hX2, haX⟩ := Finset.mem_filter.mp hX1
    exact hfol.2 X hX2 C hC𝒳 (fun e => hcX (e ▸ hcC))
  have hKP : ∀ X ∈ (𝒳'.filter (fun X => (epOut α β {p, q} a) ∉ X)).filter (fun X => (epOut α β {p, q} c) ∉ X),
      Disjoint X ({p, q} : Finset W) := fun X hX =>
    Finset.disjoint_left.mpr fun w hw => (Finset.mem_sdiff.mp ((f2.1 X hX).1 hw)).2
  -- keeping one more burl of `G` that contains an outer end
  have hkeep : ∀ Z : Finset W, Z ⊆ L → EpBurl α β Z → ((epOut α β {p, q} a) ∈ Z ∨ (epOut α β {p, q} c) ∈ Z) →
      (∀ X ∈ (𝒳'.filter (fun X => (epOut α β {p, q} a) ∉ X)).filter (fun X => (epOut α β {p, q} c) ∉ X), Disjoint X Z) →
      ∃ 𝒳, EpFol0 α β L 𝒳 ∧
        epFw (epSpA α β p q a b c d) (epSpB α β p q a b c d) 𝒳' - (2 * (4731 / 18400) - 2324 / 18400) ≤ epFw α β 𝒳 := by
    intro Z hZL hZb hZo hZd
    have hZn : Z ∉ (𝒳'.filter (fun X => (epOut α β {p, q} a) ∉ X)).filter (fun X => (epOut α β {p, q} c) ∉ X) := by
      intro hZ
      obtain ⟨hZ1, n2⟩ := Finset.mem_filter.mp hZ
      obtain ⟨-, n1⟩ := Finset.mem_filter.mp hZ1
      exact hZo.elim n1 n2
    refine ⟨insert Z ((𝒳'.filter (fun X => (epOut α β {p, q} a) ∉ X)).filter
      (fun X => (epOut α β {p, q} c) ∉ X)), ⟨fun X hX => ?_, fun X hX X' hX' hne => ?_⟩, ?_⟩
    · rcases Finset.mem_insert.mp hX with e | hX
      · rw [e]; exact ⟨hZL, hZb⟩
      · exact hK.1 X hX
    · rcases Finset.mem_insert.mp hX with e | hX <;>
        rcases Finset.mem_insert.mp hX' with e' | hX'
      · exact absurd (e.trans e'.symm) hne
      · rw [e]; exact (hZd X' hX').symm
      · rw [e']; exact hZd X hX
      · exact hK.2 X hX X' hX' hne
    · rw [epFw_insert α β _ Z hZn]
      have h1 := wge Z
      have h2 := wle A
