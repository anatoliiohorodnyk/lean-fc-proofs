open Classical in
/-- **Chains of ten nodes are burls**, given a tree of certificates that covers all patterns of
length ten. Replaces the ladder argument (41 nodes). -/
theorem ep_chain_burl10 {W E : Type*} [Fintype E] (α β : E → W) (L : Finset W) (r : W)
    (𝒮 𝒴 : Finset (Finset W)) (h : EpCubicD α β L) (hb : EpBridgeless α β L)
    (hconn : EpConnected α β L) (hr : r ∈ L) (hdec : EpDecomp α β L r 𝒮)
    (href : EpRefines L r 𝒮 𝒴)
    (hmax : ∀ 𝒮', EpDecomp α β L r 𝒮' → EpRefines L r 𝒮' 𝒴 → 𝒮'.card ≤ 𝒮.card)
    (hnc : ¬EpHasCore α β L) (N : ℕ → Finset W) (hNS : ∀ i, i ≤ 10 → N i ∈ 𝒮)
    (hchild : ∀ i, i < 10 → epChildren 𝒮 (N i) = {N (i + 1)})
    (t : LpTree) (hall : t.allOK = true) (htok : t.allTok = true)
    (hcov : lpCov t 10 [] = true) : EpBurl α β (N 0 \ N 10) := by
  obtain ⟨code, v, cut, rg, hlab⟩ := ep_chain_lab α β L r 𝒮 𝒴 h hb hconn hr hdec href hmax hnc
    10 N hNS hchild
  have hext := ep_lab_ext α β 10 N code v cut rg hlab 10 0 rfl
  rw [if_pos rfl] at hext
  obtain ⟨cert, hcert, A, B, hsplit⟩ := lpCov_sound t 10 [] (lpSeg code 0 10) hcov
    (lpSeg_length code 0 10) hext
  rw [List.reverse_nil, List.nil_append] at hsplit
  obtain ⟨hok, hne⟩ := LpTree.allTok_mem t htok cert hcert
  have hchk := LpTree.allOK_mem t hall cert hcert
  have hlen : A.length + cert.pat.length + B.length = 10 := by
    have := congrArg List.length hsplit
    rw [lpSeg_length, List.length_append, List.length_append] at this
    omega
  have hpos : 0 < cert.pat.length := List.length_pos_of_ne_nil hne
  -- the certified pattern is the pattern of a segment
  have hpat : cert.pat = lpSeg code A.length (A.length + cert.pat.length) := by
    have e1 := lpSeg_append code A.length 0 10 (by omega)
    have e2 := lpSeg_append code cert.pat.length A.length 10 (by omega)
    rw [Nat.zero_add] at e1
    rw [e1, e2, ← List.append_assoc] at hsplit
    have h1 := List.append_inj hsplit (by
      rw [List.length_append, List.length_append, lpSeg_length, lpSeg_length]; omega)
    have h2 := List.append_inj h1.1 (by rw [lpSeg_length]; omega)
    exact h2.2.symm
  have htk := ep_lab_tok α β 10 N code v cut rg hlab A.length (A.length + cert.pat.length)
    (by omega) (by omega)
  rw [← hpat] at htk
  have hburl := ep_burl_of_tok α β _ cert _ _ htk hok hchk
  obtain ⟨hInv, hnest, hloop, -⟩ := hlab
  have hmono : ∀ d i, i + d ≤ 10 → N (i + d) ⊆ N i := by
    intro d
    induction d with
    | zero => intro i _; exact Finset.Subset.refl _
    | succ d ih =>
      intro i hi
      exact (hnest (i + d) (by omega)).trans (ih i (by omega))
  have hsub : N A.length \ N (A.length + cert.pat.length) ⊆ N 0 \ N 10 := by
    have s1 := hmono A.length 0 (by omega)
    have s2 := hmono (10 - (A.length + cert.pat.length)) (A.length + cert.pat.length) (by omega)
    rw [Nat.zero_add] at s1
    rw [show A.length + cert.pat.length + (10 - (A.length + cert.pat.length)) = 10 by omega] at s2
    exact Finset.sdiff_subset_sdiff s1 s2
  exact ep_burl_mono α β _ _ hsub (fun g hg => hloop g (Finset.mem_sdiff.mp hg).1) hburl

