open Classical in
/-- **Chains are labelled chains.** In a `𝒴`-maximum decomposition of a multigraph without a
core, a chain of members, each the only child of the previous one, can be labelled. -/
theorem ep_chain_lab {W E : Type*} [Fintype E] (α β : E → W) (L : Finset W) (r : W)
    (𝒮 𝒴 : Finset (Finset W)) (h : EpCubicD α β L) (hb : EpBridgeless α β L)
    (hconn : EpConnected α β L) (hr : r ∈ L) (hdec : EpDecomp α β L r 𝒮)
    (href : EpRefines L r 𝒮 𝒴)
    (hmax : ∀ 𝒮', EpDecomp α β L r 𝒮' → EpRefines L r 𝒮' 𝒴 → 𝒮'.card ≤ 𝒮.card)
    (hnc : ¬EpHasCore α β L) (n : ℕ) (N : ℕ → Finset W) (hNS : ∀ i, i ≤ n → N i ∈ 𝒮)
    (hchild : ∀ i, i < n → epChildren 𝒮 (N i) = {N (i + 1)}) :
    ∃ (code : ℕ → ℕ) (v : ℕ → ℕ → W) (cut : ℕ → ℕ → E) (rg : ℕ → E),
      EpLab α β n N code v cut rg := by
  have hstep : ∀ i, i < n → N (i + 1) ⊂ N i := by
    intro i hi
    have : N (i + 1) ∈ epChildren 𝒮 (N i) := by
      rw [hchild i hi]; exact Finset.mem_singleton_self _
    exact ((mem_epChildren 𝒮 (N i) _).mp this).2.1
  have hN0L : N 0 ⊆ L := (hdec.2.1 (N 0) (hNS 0 (Nat.zero_le n))).1
  -- an enumeration of the first cut
  obtain ⟨c0, hc0⟩ : ∃ c0 : ℕ → E,
      (∀ j j', j < (epCut α β (N 0)).card → j' < (epCut α β (N 0)).card → c0 j = c0 j' →
        j = j') ∧
      ∀ g, epCross α β (N 0) g ↔ ∃ j, j < (epCut α β (N 0)).card ∧ c0 j = g := by
    have hcard := (hdec.2.1 (N 0) (hNS 0 (Nat.zero_le n))).2.2.2
    obtain ⟨e₀, -⟩ : (epCut α β (N 0)).Nonempty := Finset.card_pos.mp (by omega)
    have hlen : (epCut α β (N 0)).toList.length = (epCut α β (N 0)).card := Finset.length_toList _
    have hnd : (epCut α β (N 0)).toList.Nodup := Finset.nodup_toList _
    refine ⟨fun j => (epCut α β (N 0)).toList.getD j e₀, ?_, ?_⟩
    · intro j j' hj hj' heq
      rw [← hlen] at hj hj'
      simp only [List.getD_eq_getElem _ _ hj, List.getD_eq_getElem _ _ hj'] at heq
      exact (List.Nodup.getElem_inj_iff hnd).mp heq
    · intro g
      rw [← mem_epCut, ← Finset.mem_toList, List.mem_iff_getElem]
      constructor
      · rintro ⟨j, hj, rfl⟩
        exact ⟨j, by rw [← hlen]; exact hj, List.getD_eq_getElem _ _ hj⟩
      · rintro ⟨j, hj, rfl⟩
        rw [← hlen] at hj
        exact ⟨j, hj, (List.getD_eq_getElem _ _ hj).symm⟩
  -- one step
  have key : ∀ (m : ℕ) (c : ℕ → E), ∃ (code : ℕ) (vt : ℕ → W) (c' : ℕ → E) (rgm : E),
      (m < n ∧ (∀ j j', j < (epCut α β (N m)).card → j' < (epCut α β (N m)).card →
        c j = c j' → j = j') ∧
        ∀ g, epCross α β (N m) g ↔ ∃ j, j < (epCut α β (N m)).card ∧ c j = g) →
      (((∀ j j', j < (epCut α β (N (m + 1))).card → j' < (epCut α β (N (m + 1))).card →
          c' j = c' j' → j = j') ∧
        ∀ g, epCross α β (N (m + 1)) g ↔ ∃ j, j < (epCut α β (N (m + 1))).card ∧ c' j = g) ∧
        EpLabNode α β (N m) (N (m + 1)) code vt c c' rgm) := by
    intro m c
    by_cases hyp : m < n ∧ (∀ j j', j < (epCut α β (N m)).card →
        j' < (epCut α β (N m)).card → c j = c j' → j = j') ∧
        ∀ g, epCross α β (N m) g ↔ ∃ j, j < (epCut α β (N m)).card ∧ c j = g
    · obtain ⟨code, vt, c', rgm, h1, h2⟩ := ep_lab_step α β L r 𝒮 𝒴 h hb hconn hr hdec href hmax
        hnc (N m) (N (m + 1)) (hNS m (by omega)) (hchild m hyp.1) c hyp.2.1 hyp.2.2
      exact ⟨code, vt, c', rgm, fun _ => ⟨h1, h2⟩⟩
    · exact ⟨0, fun _ => r, c, c 0, fun h' => absurd h' hyp⟩
  choose codeF vF cF rgF hF using key
  obtain ⟨cut, hcut0, hcutS⟩ : ∃ cut : ℕ → ℕ → E, cut 0 = c0 ∧
      ∀ m, cut (m + 1) = cF m (cut m) :=
    ⟨fun m => Nat.rec c0 (fun m prev => cF m prev) m, rfl, fun m => rfl⟩
  have hInv : ∀ m, m ≤ n →
      (∀ j j', j < (epCut α β (N m)).card → j' < (epCut α β (N m)).card → cut m j = cut m j' →
        j = j') ∧
      ∀ g, epCross α β (N m) g ↔ ∃ j, j < (epCut α β (N m)).card ∧ cut m j = g := by
    intro m
    induction m with
    | zero => intro _; rw [hcut0]; exact hc0
    | succ m ih =>
      intro hm
      rw [hcutS m]
      exact (hF m (cut m) ⟨by omega, ih (by omega)⟩).1
  refine ⟨fun m => codeF m (cut m), fun m => vF m (cut m), cut, fun m => rgF m (cut m),
    hInv, fun m hm => (hstep m hm).1, ?_, ?_⟩
  · intro g hg
    rcases h.1 g with h' | h'
    · exact h'.2.2
    · exact absurd (hN0L hg) h'.1
  · intro m hm
    have := (hF m (cut m) ⟨hm, hInv m (le_of_lt hm)⟩).2
    rw [← hcutS m] at this
    unfold EpLabNode at this
    exact this

lemma lpSeg_cons (code : ℕ → ℕ) (a b : ℕ) (hab : a < b) :
    lpSeg code a b = code a :: lpSeg code (a + 1) b := by
  obtain ⟨k, hk⟩ : ∃ k, b - a = k + 1 := ⟨b - a - 1, by omega⟩
  have hk' : b - (a + 1) = k := by omega
  unfold lpSeg
  rw [hk, hk', List.range_succ_eq_map, List.map_cons, List.map_map]
  congr 1
  apply List.map_congr_left
  intro m _
  simp only [Function.comp]
  congr 1
  omega

lemma lpSeg_append (code : ℕ → ℕ) : ∀ (d a c : ℕ), a + d ≤ c →
    lpSeg code a c = lpSeg code a (a + d) ++ lpSeg code (a + d) c := by
  intro d
  induction d with
  | zero =>
    intro a c _
    simp [lpSeg]
  | succ d ih =>
    intro a c h
    rw [lpSeg_cons code a c (by omega), lpSeg_cons code a (a + (d + 1)) (by omega),
      ih (a + 1) c (by omega), show a + 1 + d = a + (d + 1) by omega]
    rfl

