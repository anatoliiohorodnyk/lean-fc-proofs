    intro m m' w hm hm' h1 h2
    by_contra hne
    rcases Nat.lt_or_gt_of_ne hne with hlt | hlt
    · exact hAdisj m m' w hlt hm' h1 h2
    · exact hAdisj m' m w hlt hm h2 h1
  have hAX : ∀ m, m < n → ∀ w, (w ∈ N m ∧ w ∉ N (m + 1)) → w ∈ N 0 \ N n := by
    intro m hm w hw
