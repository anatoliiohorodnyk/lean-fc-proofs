  -- the vertices
  obtain ⟨v, hv⟩ : ∃ v : ℕ → Fin 3 → W, ∀ m j, v m j = if cut m j = ix m then x m else y m :=
    ⟨_, fun _ _ => rfl⟩
  have hvA : ∀ m, m < n → ∀ j, v m j ∈ N m ∧ v m j ∉ N (m + 1) := by
    intro m hm j
    rw [hxyA m hm, hv]
    by_cases hc : cut m j = ix m
    · rw [if_pos hc]; exact Or.inl rfl
    · rw [if_neg hc]; exact Or.inr rfl
