open Classical in
/-- **F-I, F-II (a bad split is house/house).** From a bad split: both lifts are non-burls
(`ep_burl_mono`) with a cut of size five (`epSp_lift_cut5`), hence `X7` or `X9`
(`ep_cut5_classify`) with `p`, `q` at the pendant pair (L2′); no edge between the twigs
(`epSp_merge_burl_of_edge`); not `X9` (`epSp_merge_burl_of_S`). -/
theorem ep_bad_split_data {W E : Type*} [Fintype E] (α β : E → W) (L : Finset W) (p q : W)
    (a b c d m : E) (h : EpCubicD α β L) (h4 : EpCyc4 α β L) (h12 : 12 ≤ L.card)
    (hp : EpPath4 α β L p q a b c d m) (hbad : EpBadSplit α β L p q a b c d) :
    ∃ A B C A' B' C' : W,
      EpBadData α β (epOut α β {p, q} a) p q (epOut α β {p, q} c) (epOut α β {p, q} b)
        (epOut α β {p, q} d) A B C A' B' C' := by
  obtain ⟨X, Y, hXL, hYL, hXY, haX, hbX, hcY, hdY, hX3, hX5, hY3, hY5, hnb⟩ := hbad
  obtain ⟨⟨noa, nob, noc, nod⟩, ha, hb, hc, hd, hm, -⟩ := epSp_facts α β L p q a b c d m h hp
  have hp' := hp
  obtain ⟨hpL, hqL, hpq, hsp, hsq, -⟩ := hp'
  have hP : ∀ w, w ∈ ({p, q} : Finset W) ↔ w = p ∨ w = q := by
    intro w; simp only [Finset.mem_insert, Finset.mem_singleton]
  have hdis : ∀ w, w ∈ X → w ∉ Y := fun w hw => Finset.disjoint_left.mp hXY hw
  have hcX : (epOut α β {p, q} c) ∉ X := fun h' => hdis _ h' hcY
  have hdX : (epOut α β {p, q} d) ∉ X := fun h' => hdis _ h' hdY
  have haY : (epOut α β {p, q} a) ∉ Y := fun h' => hdis _ haX h'
  have hbY : (epOut α β {p, q} b) ∉ Y := fun h' => hdis _ hbX h'
  have hpX : p ∉ X := fun h' => (Finset.mem_sdiff.mp (hXL h')).2 ((hP p).mpr (Or.inl rfl))
  have hqX : q ∉ X := fun h' => (Finset.mem_sdiff.mp (hXL h')).2 ((hP q).mpr (Or.inr rfl))
  have hpY : p ∉ Y := fun h' => (Finset.mem_sdiff.mp (hYL h')).2 ((hP p).mpr (Or.inl rfl))
  have hqY : q ∉ Y := fun h' => (Finset.mem_sdiff.mp (hYL h')).2 ((hP q).mpr (Or.inr rfl))
  have hcutX : (epCut α β (X ∪ {p, q})).card = 5 := by
    rw [(epSp_lift_cut α β L p q a b c d m h hp X hXL).1 haX hbX hcX hdX, hX3]
  have hcutY : (epCut α β (Y ∪ {p, q})).card = 5 := by
    rw [(epSp_lift_cut α β L p q a b c d m h hp Y hYL).2.1 hcY hdY haY hbY, hY3]
  have hnlL : ∀ g, α g ∈ L → α g ≠ β g := by
    intro g hg
    rcases h.1 g with h' | h'
    · exact h'.2.2
    · exact absurd hg h'.1
  have hlift : ∀ T : Finset W, T ⊆ L \ {p, q} → T ∪ {p, q} ⊆ L := by
    intro T hT w hw
    rcases Finset.mem_union.mp hw with h' | h'
    · exact (Finset.mem_sdiff.mp (hT h')).1
    · rcases (hP w).mp h' with e | e
      · rw [e]; exact hpL
      · rw [e]; exact hqL
  have hXpL := hlift X hXL
  have hYpL := hlift Y hYL
  have hZL := hlift (X ∪ Y) (Finset.union_subset hXL hYL)
  have hnbX : ¬EpBurl α β (X ∪ {p, q}) := fun hb' =>
    hnb (ep_burl_mono α β _ _ (Finset.union_subset_union_left Finset.subset_union_left)
      (fun g hg => hnlL g (hZL hg)) hb')
  have hnbY : ¬EpBurl α β (Y ∪ {p, q}) := fun hb' =>
    hnb (ep_burl_mono α β _ _ (Finset.union_subset_union_left Finset.subset_union_right)
      (fun g hg => hnlL g (hZL hg)) hb')
  have hcard : ∀ T : Finset W, T ⊆ L \ {p, q} → (T ∪ {p, q}).card = T.card + 2 := by
    intro T hT
    rw [Finset.card_union_of_disjoint (Finset.disjoint_left.mpr fun w hw =>
      (Finset.mem_sdiff.mp (hT hw)).2), Finset.card_pair hpq]
  have hcardX := hcard X hXL
  have hcardY := hcard Y hYL
  -- no edge between the two twigs (C2)
  have hno : ∀ x ∈ X, ∀ y ∈ Y, ¬EpAdj α β x y := fun x hx y hy hadj =>
    hnb (epSp_merge_burl_of_edge α β L p q a b c d m h h4 h12 hp X Y hXL hYL hXY haX hbX
      hcY hdY hX3 hY3 hX5 hY5 ⟨x, hx, y, hy, hadj⟩)
  -- the neighbours of `p` and `q`
  have hNp := ep_nbrs_of_three α β L h p hpL a m c (epOut α β {p, q} a) q (epOut α β {p, q} c)
    (fun g => (hsp g).trans lv_or_swap23) ha hm hc
  have hNq := ep_nbrs_of_three α β L h q hqL m b d p (epOut α β {p, q} b) (epOut α β {p, q} d)
    (fun g => (hsq g).trans lv_or_rot) hm.symm hb hd
  have hpq_adj : EpAdj α β p q := ⟨m, hm⟩
  have hpa : EpAdj α β p (epOut α β {p, q} a) := ⟨a, ha⟩
  have hpc : EpAdj α β p (epOut α β {p, q} c) := ⟨c, hc⟩
  have hqb : EpAdj α β q (epOut α β {p, q} b) := ⟨b, hb⟩
  have hqd : EpAdj α β q (epOut α β {p, q} d) := ⟨d, hd⟩
  have hpS : ∀ T : Finset W, p ∈ T ∪ {p, q} := fun T =>
    Finset.mem_union_right _ ((hP p).mpr (Or.inl rfl))
  have hqS : ∀ T : Finset W, q ∈ T ∪ {p, q} := fun T =>
    Finset.mem_union_right _ ((hP q).mpr (Or.inr rfl))
  have ocX : (epOut α β {p, q} c) ∉ X ∪ {p, q} := fun h' => (Finset.mem_union.mp h').elim hcX noc
  have odX : (epOut α β {p, q} d) ∉ X ∪ {p, q} := fun h' => (Finset.mem_union.mp h').elim hdX nod
  have oaY : (epOut α β {p, q} a) ∉ Y ∪ {p, q} := fun h' => (Finset.mem_union.mp h').elim haY noa
  have obY : (epOut α β {p, q} b) ∉ Y ∪ {p, q} := fun h' => (Finset.mem_union.mp h').elim hbY nob
  clear ha hb hc hd
  -- both lifts are `X7` or `X9` (Theorem D), with `p`, `q` at the pendant pair (L2′)
  have hnormX : (∃ φ, EpIsoI α β (X ∪ {p, q}) 7 lvX7 φ ∧ φ 3 = p ∧ φ 4 = q) ∨
      (∃ φ, EpIsoI α β (X ∪ {p, q}) 9 lvX9 φ ∧ φ 7 = p ∧ φ 8 = q) := by
    rcases ep_cut5_classify α β L _ h h4 (by omega) hXpL hcutX (by omega) hnbX with
      ⟨-, φ, hφ⟩ | ⟨-, φ, hφ⟩
    · exact Or.inl (ep_lift_norm7 α β L _ h h4 (by omega) hXpL φ hφ p q _ _ (hpS X) (hqS X)
        hpq_adj ocX hpc odX hqd)
    · exact Or.inr (ep_lift_norm9 α β L _ h h4 (by omega) hXpL φ hφ p q _ _ (hpS X) (hqS X)
        hpq_adj ocX hpc odX hqd)
  have hnormY : (∃ ψ, EpIsoI α β (Y ∪ {p, q}) 7 lvX7 ψ ∧ ψ 3 = p ∧ ψ 4 = q) ∨
      (∃ ψ, EpIsoI α β (Y ∪ {p, q}) 9 lvX9 ψ ∧ ψ 7 = p ∧ ψ 8 = q) := by
    rcases ep_cut5_classify α β L _ h h4 (by omega) hYpL hcutY (by omega) hnbY with
      ⟨-, ψ, hψ⟩ | ⟨-, ψ, hψ⟩
    · exact Or.inl (ep_lift_norm7 α β L _ h h4 (by omega) hYpL ψ hψ p q _ _ (hpS Y) (hqS Y)
        hpq_adj oaY hpa obY hqb)
    · exact Or.inr (ep_lift_norm9 α β L _ h h4 (by omega) hYpL ψ hψ p q _ _ (hpS Y) (hqS Y)
        hpq_adj oaY hpa obY hqb)
  -- neither is `X9` (Theorem A)
  obtain ⟨φ, hφ, e3, e4⟩ : ∃ φ, EpIsoI α β (X ∪ {p, q}) 7 lvX7 φ ∧ φ 3 = p ∧ φ 4 = q := by
    rcases hnormX with hX7 | ⟨φ, hφ⟩
    · exact hX7
    · exfalso
      rcases hnormY with ⟨ψ, hψ⟩ | ⟨ψ, hψ⟩
      · exact hnb (epSp_merge_burl_of_S α β L p q h h4 h12 hpL hqL X Y hXL hYL hXY hno φ ψ
          (Or.inr (Or.inl ⟨hφ, hψ⟩)))
      · exact hnb (epSp_merge_burl_of_S α β L p q h h4 h12 hpL hqL X Y hXL hYL hXY hno φ ψ
          (Or.inr (Or.inr ⟨hφ, hψ⟩)))
  obtain ⟨ψ, hψ, f3, f4⟩ : ∃ ψ, EpIsoI α β (Y ∪ {p, q}) 7 lvX7 ψ ∧ ψ 3 = p ∧ ψ 4 = q := by
    rcases hnormY with hY7 | ⟨ψ, hψ⟩
    · exact hY7
    · exact absurd (epSp_merge_burl_of_S α β L p q h h4 h12 hpL hqL X Y hXL hYL hXY hno φ ψ
        (Or.inl ⟨⟨hφ, e3, e4⟩, hψ⟩)) hnb
  -- the two houses
  obtain ⟨HX1, HX2, HX3, HX4, HX5, HX6⟩ :=
    ep_house_data α β L X p q h h4 (by omega) hXpL hpX hqX φ hφ e3 e4
  obtain ⟨HY1, HY2, HY3, HY4, HY5, HY6⟩ :=
    ep_house_data α β L Y p q h h4 (by omega) hYpL hpY hqY ψ hψ f3 f4
  have eoa : (epOut α β {p, q} a) = φ 0 := HX5 _ haX hpa
  have eob : (epOut α β {p, q} b) = φ 2 := HX6 _ hbX hqb
  have eoc : (epOut α β {p, q} c) = ψ 0 := HY5 _ hcY hpc
  have eod : (epOut α β {p, q} d) = ψ 2 := HY6 _ hdY hqd
  rw [eoa, eoc] at hNp
  rw [eob, eod] at hNq
  -- the twelve vertices are distinct
  have hND : [φ 0, p, q, ψ 0, φ 2, ψ 2, φ 1, φ 5, φ 6, ψ 1, ψ 5, ψ 6].Nodup := by
    obtain ⟨χ, hχlt, hχge⟩ : ∃ χ : ℕ → W, (∀ s, s < 7 → χ s = φ s) ∧
        (∀ s, 7 ≤ s → χ s = ψ (s - 7)) :=
      ⟨fun s => if s < 7 then φ s else ψ (s - 7), fun s hs => if_pos hs,
        fun s hs => if_neg (by omega)⟩
    have hφc : ∀ i, i < 7 → φ i ∈ X ∨ φ i = p ∨ φ i = q := by
      intro i hi
      rcases Finset.mem_union.mp (hφ.1 i hi) with h' | h'
      · exact Or.inl h'
      · exact Or.inr ((hP _).mp h')
    have hmix : ∀ i j, i < 7 → 7 ≤ j → j < 14 → j ≠ 10 → j ≠ 11 → φ i ≠ ψ (j - 7) := by
      intro i j hi h1 h2 h3 h4' e'
      have hy : ψ (j - 7) ∈ Y := HY1 (j - 7) (by omega) (by omega) (by omega)
      rcases hφc i hi with h' | h' | h'
      · exact hdis _ h' (by rw [e']; exact hy)
      · exact hpY (by rw [← h', e']; exact hy)
      · exact hqY (by rw [← h', e']; exact hy)
    have hinj : ∀ s ∈ [0, 3, 4, 7, 2, 9, 1, 5, 6, 8, 12, 13],
        ∀ t ∈ [0, 3, 4, 7, 2, 9, 1, 5, 6, 8, 12, 13], χ s = χ t → s = t := by
      intro s hs t ht e
      rcases lvCodes s hs with vs | ⟨v1, v2, v3, v4⟩ <;>
        rcases lvCodes t ht with vt | ⟨u1, u2, u3, u4⟩
      · rw [hχlt s vs, hχlt t vt] at e
        exact hφ.2.1 s t vs vt e
      · rw [hχlt s vs, hχge t u1] at e
        exact absurd e (hmix s t vs u1 u2 u3 u4)
      · rw [hχge s v1, hχlt t vt] at e
        exact absurd e.symm (hmix t s vt v1 v2 v3 v4)
      · rw [hχge s v1, hχge t u1] at e
        have := hψ.2.1 (s - 7) (t - 7) (by omega) (by omega) e
        omega
    have hmap := List.Nodup.map_on hinj lvCodesNodup
    have hl : List.map χ [0, 3, 4, 7, 2, 9, 1, 5, 6, 8, 12, 13] =
        [φ 0, p, q, ψ 0, φ 2, ψ 2, φ 1, φ 5, φ 6, ψ 1, ψ 5, ψ 6] := by
      simp only [List.map_cons, List.map_nil]
      rw [hχlt 0 (by omega), hχlt 3 (by omega), hχlt 4 (by omega), hχge 7 (by omega),
        hχlt 2 (by omega), hχge 9 (by omega), hχlt 1 (by omega), hχlt 5 (by omega),
        hχlt 6 (by omega), hχge 8 (by omega), hχge 12 (by omega), hχge 13 (by omega), e3, e4]
    rw [hl] at hmap
    exact hmap
  refine ⟨φ 1, φ 5, φ 6, ψ 1, ψ 5, ψ 6, ?_⟩
  rw [eoa, eob, eoc, eod]
  refine ⟨hNp, hNq, HX2, HX3, HY2, HY3, HX4, HY4, hND, ?_⟩
  intro z hz z' hz'
  have i0 := HX1 0 (by omega) (by omega) (by omega)
  have i1 := HX1 1 (by omega) (by omega) (by omega)
  have i2 := HX1 2 (by omega) (by omega) (by omega)
  have i5 := HX1 5 (by omega) (by omega) (by omega)
  have i6 := HX1 6 (by omega) (by omega) (by omega)
  have j0 := HY1 0 (by omega) (by omega) (by omega)
  have j1 := HY1 1 (by omega) (by omega) (by omega)
  have j2 := HY1 2 (by omega) (by omega) (by omega)
  have j5 := HY1 5 (by omega) (by omega) (by omega)
  have j6 := HY1 6 (by omega) (by omega) (by omega)
  have hzX : z ∈ X := by
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hz
    rcases hz with e | e | e | e | e <;> rw [e] <;> assumption
  have hzY : z' ∈ Y := by
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hz'
    rcases hz' with e | e | e | e | e <;> rw [e] <;> assumption
  exact hno z hzX z' hzY

/-- **T-1.** In the data of a bad split the neighbours `a`, `b` of `s` are its two neighbours
other than `t`: if `N(s) = {t, s', t'}` then `{a, b} = {s', t'}`. -/
theorem ep_bad_T1 {W E : Type*} (α β : E → W) (s t w₁ w₂ x xs a b c a' b' c' s' t' : W)
    (hd : EpBadData α β s t w₁ w₂ x xs a b c a' b' c')
    (hs : ∀ z, EpAdj α β s z ↔ z = t ∨ z = s' ∨ z = t') :
    (a = s' ∧ b = t') ∨ (a = t' ∧ b = s') := by
  obtain ⟨-, -, A3, -, -, -, -, -, ND, -⟩ := hd
  have hat : a ≠ t := lv_ne_of_nodup _ ND 6 1 (by simp) (by simp) (by decide)
  have hbt : b ≠ t := lv_ne_of_nodup _ ND 7 1 (by simp) (by simp) (by decide)
  have hab : a ≠ b := lv_ne_of_nodup _ ND 6 7 (by simp) (by simp) (by decide)
  have ha := (hs a).mp ((A3 a).mpr (Or.inr (Or.inl rfl)))
  have hb := (hs b).mp ((A3 b).mpr (Or.inr (Or.inr rfl)))
  rcases ha with e | e | e
  · exact absurd e hat
  · rcases hb with e' | e' | e'
    · exact absurd e' hbt
    · exact absurd (e.trans e'.symm) hab
    · exact Or.inl ⟨e, e'⟩
  · rcases hb with e' | e' | e'
    · exact absurd e' hbt
    · exact Or.inr ⟨e, e'⟩
    · exact absurd (e.trans e'.symm) hab

/-- **T-1′.** No vertex of the `Y`-house is adjacent to `s` or to a neighbour `s'` of `s` other
than `t` (both lie in the `X`-house). -/
theorem ep_bad_T1' {W E : Type*} (α β : E → W) (s t w₁ w₂ x xs a b c a' b' c' s' : W)
    (hd : EpBadData α β s t w₁ w₂ x xs a b c a' b' c') (hs' : EpAdj α β s s') (hst : s' ≠ t) :
    ∀ z ∈ ({w₂, xs, a', b', c'} : Set W), ¬EpAdj α β s z ∧ ¬EpAdj α β s' z := by
  obtain ⟨-, -, A3, -, -, -, -, -, -, H⟩ := hd
  intro z hz
  rcases (A3 s').mp hs' with e | e | e
  · exact absurd e hst
  · exact ⟨H s (by simp) z hz, by rw [e]; exact H a (by simp) z hz⟩
  · exact ⟨H s (by simp) z hz, by rw [e]; exact H b (by simp) z hz⟩

/-- **T-3, one side.** Let `(v, w)` and `(u, z)` have bad data, `u ~ v`, `u ≠ w`, and `z'` a
neighbour of `u`. Then the `X`-house of `(u, z)`, which is `u – a₃ – x₃ – c₃ – b₃ – u`, does
not run `u – v – w – …`: neither `a₃ = v, x₃ = w` nor `b₃ = v, c₃ = w`.
(Seven steps; every contradiction is a vertex of the `Y`-house of `(v, w)`
adjacent to `u`, or two equal vertices among the twelve of `(u, z)`.) -/
theorem ep_bad_M {W E : Type*} (α β : E → W) (u v w z z' : W)
    {w₁ w₂ x xs a b c a' b' c' : W} {r₁ r₂ x₃ xs₃ a₃ b₃ c₃ a₃' b₃' c₃' : W}
    (hvu : EpAdj α β v u) (huw : u ≠ w) (huz : EpAdj α β u z) (huz' : EpAdj α β u z')
    (hd₁ : EpBadData α β v w w₁ w₂ x xs a b c a' b' c')
    (hd₃ : EpBadData α β u z r₁ r₂ x₃ xs₃ a₃ b₃ c₃ a₃' b₃' c₃')
    (hcase : (a₃ = v ∧ b₃ = z' ∧ x₃ = w) ∨ (a₃ = z' ∧ b₃ = v ∧ c₃ = w)) : False := by
  have F1 := ep_bad_T1' α β v w w₁ w₂ x xs a b c a' b' c' u hd₁ hvu huw
  have hY : ∀ y, (y = a' ∨ y = b' ∨ y = c' ∨ y = xs ∨ y = w₂) → ¬EpAdj α β u y := by
    intro y hy
    refine (F1 y ?_).2
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff]
    tauto
  obtain ⟨A1, A2, -, -, A5, A6, -, -, -, -⟩ := hd₁
  obtain ⟨-, C2, -, C4, -, -, C7, -, ND, -⟩ := hd₃
  have n_ac : a₃ ≠ c₃ := lv_ne_of_nodup _ ND 6 8 (by simp) (by simp) (by decide)
  have n_bx : b₃ ≠ x₃ := lv_ne_of_nodup _ ND 7 4 (by simp) (by simp) (by decide)
  have n_ra : r₁ ≠ a₃ := lv_ne_of_nodup _ ND 2 6 (by simp) (by simp) (by decide)
  have n_rc : r₁ ≠ c₃ := lv_ne_of_nodup _ ND 2 8 (by simp) (by simp) (by decide)
  have n_zx : z ≠ x₃ := lv_ne_of_nodup _ ND 1 4 (by simp) (by simp) (by decide)
  rcases hcase with ⟨ea, eb, ex⟩ | ⟨ea, eb, ec⟩
  · have h1 : EpAdj α β w c₃ := by rw [← ex]; exact (C4 c₃).mpr (Or.inr (Or.inr rfl))
    rcases (A1 c₃).mp h1 with e | e | e
    · exact n_ac (ea.trans e.symm)
    · have h2 : EpAdj α β w r₁ := by rw [← ex]; exact (C4 r₁).mpr (Or.inl rfl)
      rcases (A1 r₁).mp h2 with e' | e' | e'
      · exact n_ra (e'.trans ea.symm)
      · exact n_rc (e'.trans e.symm)
      · have h3 : EpAdj α β w₂ z := by rw [← e']; exact (C2 z).mpr (Or.inl rfl)
        rcases (A5 z).mp h3 with e'' | e'' | e''
        · exact n_zx (e''.trans ex.symm)
        · exact hY z (Or.inl e'') huz
        · exact hY z (Or.inr (Or.inl e'')) huz
    · have h2 : EpAdj α β w₂ z' := by
        rw [← e, ← eb]; exact (ep_adj_comm α β b₃ c₃).mp C7
      rcases (A5 z').mp h2 with e' | e' | e'
      · exact n_bx (eb.trans (e'.trans ex.symm))
      · exact hY z' (Or.inl e') huz'
      · exact hY z' (Or.inr (Or.inl e')) huz'
  · have h1 : EpAdj α β w x₃ := by
      rw [← ec]; exact (ep_adj_comm α β x₃ c₃).mp ((C4 c₃).mpr (Or.inr (Or.inr rfl)))
    rcases (A1 x₃).mp h1 with e | e | e
    · exact n_bx (eb.trans e.symm)
    · have h2 : EpAdj α β w₁ z' := by
        rw [← e, ← ea]; exact (C4 a₃).mpr (Or.inr (Or.inl rfl))
      rcases (A2 z').mp h2 with e' | e' | e'
      · exact n_ac (ea.trans (e'.trans ec.symm))
      · have h3 : EpAdj α β w₁ r₁ := by rw [← e]; exact (C4 r₁).mpr (Or.inl rfl)
        rcases (A2 r₁).mp h3 with e'' | e'' | e''
        · exact n_rc (e''.trans ec.symm)
        · exact n_ra (e''.trans (e'.symm.trans ea.symm))
        · have h4 : EpAdj α β xs z := by rw [← e'']; exact (C2 z).mpr (Or.inl rfl)
          rcases (A6 z).mp h4 with e3 | e3 | e3
          · exact n_zx (e3.trans e.symm)
          · exact hY z (Or.inl e3) huz
          · exact hY z (Or.inr (Or.inr (Or.inl e3))) huz
      · exact hY z' (Or.inr (Or.inr (Or.inr (Or.inl e')))) huz'
    · have h2 : EpAdj α β w₂ z' := by
        rw [← e, ← ea]; exact (C4 a₃).mpr (Or.inr (Or.inl rfl))
      rcases (A5 z').mp h2 with e' | e' | e'
      · exact n_ac (ea.trans (e'.trans ec.symm))
      · exact hY z' (Or.inl e') huz'
      · exact hY z' (Or.inr (Or.inl e')) huz'

/-- **T-3 (both choices at one end exclude the other end).** Let `e` join `u` and `v`,
`N(v) = {u, w, w'}`, `N(u) = {v, z, z'}`. If the splits at `(v, w)` and at `(v, w')` both have
bad data, then no split at `(u, z)` has. (The `X`-house of `(u, z)` runs `u – v – w – …` or
`u – v – w' – …`; `ep_bad_M` excludes both.) -/
theorem ep_bad_T3 {W E : Type*} (α β : E → W) (u v w w' z z' : W)
    (hv : ∀ y, EpAdj α β v y ↔ y = u ∨ y = w ∨ y = w')
    (hu : ∀ y, EpAdj α β u y ↔ y = v ∨ y = z ∨ y = z') (huw : u ≠ w) (huw' : u ≠ w')
    {w₁ w₂ x xs a b c a' b' c' : W} (hd₁ : EpBadData α β v w w₁ w₂ x xs a b c a' b' c')
    {y₁ y₂ x₂ xs₂ a₂ b₂ c₂ a₂' b₂' c₂' : W}
    (hd₂ : EpBadData α β v w' y₁ y₂ x₂ xs₂ a₂ b₂ c₂ a₂' b₂' c₂')
    {r₁ r₂ x₃ xs₃ a₃ b₃ c₃ a₃' b₃' c₃' : W} :
    ¬EpBadData α β u z r₁ r₂ x₃ xs₃ a₃ b₃ c₃ a₃' b₃' c₃' := by
  intro hd₃
  have hvu := (hv u).mpr (Or.inl rfl)
  have huz := (hu z).mpr (Or.inr (Or.inl rfl))
  have huz' := (hu z').mpr (Or.inr (Or.inr rfl))
  have hT := ep_bad_T1 α β u z r₁ r₂ x₃ xs₃ a₃ b₃ c₃ a₃' b₃' c₃' v z' hd₃
    (fun y => by rw [hu y]; exact ⟨fun h' => h'.elim (fun e => Or.inr (Or.inl e))
      (fun h' => h'.elim Or.inl (fun e => Or.inr (Or.inr e))),
      fun h' => h'.elim (fun e => Or.inr (Or.inl e))
      (fun h' => h'.elim Or.inl (fun e => Or.inr (Or.inr e)))⟩)
  have hd₃' := hd₃
  obtain ⟨-, -, -, C4, -, -, C7, -, ND, -⟩ := hd₃'
  have n_sx : u ≠ x₃ := lv_ne_of_nodup _ ND 0 4 (by simp) (by simp) (by decide)
  have n_sc : u ≠ c₃ := lv_ne_of_nodup _ ND 0 8 (by simp) (by simp) (by decide)
  rcases hT with ⟨ea, eb⟩ | ⟨ea, eb⟩
  · have h1 : EpAdj α β v x₃ := by
      rw [← ea]; exact (ep_adj_comm α β x₃ a₃).mp ((C4 a₃).mpr (Or.inr (Or.inl rfl)))
    rcases (hv x₃).mp h1 with e | e | e
    · exact n_sx e.symm
    · exact ep_bad_M α β u v w z z' hvu huw huz huz' hd₁ hd₃ (Or.inl ⟨ea, eb, e⟩)
    · exact ep_bad_M α β u v w' z z' hvu huw' huz huz' hd₂ hd₃ (Or.inl ⟨ea, eb, e⟩)
  · have h1 : EpAdj α β v c₃ := by rw [← eb]; exact C7
    rcases (hv c₃).mp h1 with e | e | e
    · exact n_sc e.symm
    · exact ep_bad_M α β u v w z z' hvu huw huz huz' hd₁ hd₃ (Or.inr ⟨ea, eb, e⟩)
    · exact ep_bad_M α β u v w' z z' hvu huw' huz huz' hd₂ hd₃ (Or.inr ⟨ea, eb, e⟩)

open Classical in
/-- **Theorem T.** For every edge `e` some end `v` of `e` and some other edge `f` at `v`, with
far end `w`, give a choice that is not bad. -/
theorem ep_good_choice {W E : Type*} [Fintype E] (α β : E → W) (L : Finset W)
    (h : EpCubicD α β L) (h4 : EpCyc4 α β L) (h12 : 12 ≤ L.card) (e : E) (heL : α e ∈ L) :
    ∃ (v w : W) (f : E), epCross α β {v} e ∧ epCross α β {v} f ∧ f ≠ e ∧
      epCross α β {w} f ∧ w ≠ v ∧ ¬EpBadChoice α β L f w := by
  have hnp := ep_cyc4_no_parallel α β L h h4 (by omega)
  have hene : α e ≠ β e := by
    rcases h.1 e with h' | h'
    · exact h'.2.2
    · exact absurd heL h'.1
  have hbL : β e ∈ L := by
    rcases h.1 e with h' | h'
    · exact h'.2.1
    · exact absurd heL h'.1
  obtain ⟨v, hv⟩ : ∃ v, v = β e := ⟨_, rfl⟩
  obtain ⟨u, hu⟩ : ∃ u, u = α e := ⟨_, rfl⟩
  rw [← hv] at hbL hene
  rw [← hu] at heL hene
  have hecr : ∀ t, epCross α β {t} e ↔ t = u ∨ t = v :=
    ep_edge_cross α β u v e hene (Or.inl ⟨hu.symm, hv.symm⟩)
  have cev := (hecr v).mpr (Or.inr rfl)
  have ceu := (hecr u).mpr (Or.inl rfl)
  -- the other two edges at `v` and at `u`
