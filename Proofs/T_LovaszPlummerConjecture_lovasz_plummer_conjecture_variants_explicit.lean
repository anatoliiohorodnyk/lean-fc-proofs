  have pN := epD_cut_parity α β L h N (hdec.2.1 N hN).1
  have pC := epD_cut_parity α β L h C (hdec.2.1 C hCS).1
  have hsd := Finset.card_sdiff_add_card_eq_card hCN.1
  omega

open Classical in
/-- `ep_member_three` with the extra information that a set with a cut of size three is its own
enlargement. -/
lemma ep_member_three' {W E : Type*} [Fintype E] (α β : E → W) (L N : Finset W) (r : W)
    (h : EpCubicD α β L) (hb : EpBridgeless α β L) (hNL : N ⊆ L) (hrN : r ∉ N)
    (hcut : (epCut α β N).card = 2 ∨ (epCut α β N).card = 3) :
    ∃ M, N ⊆ M ∧ M ⊆ L ∧ r ∉ M ∧ (epCut α β M).card = 3 ∧ M.card ≤ N.card + 1 ∧
      ((epCut α β N).card = 3 → M = N) := by
  by_cases h3 : (epCut α β N).card = 3
  · exact ⟨N, Finset.Subset.refl _, hNL, hrN, h3, by omega, fun _ => rfl⟩
  · obtain ⟨M, a1, a2, a3, a4, a5⟩ := ep_member_three α β L N r h hb hNL hrN hcut
    exact ⟨M, a1, a2, a3, a4, a5, fun h' => absurd h' h3⟩

/-- **Size of the top of a chain, by cut sizes.** `c` is the cut size. Leaves have at most eight
vertices and exactly five under a cut of size three; atoms of nodes with one child have at most
two vertices and exactly one next to a cut of size two; no two consecutive cuts have size two.
Then, for a chain `N 0 ⊋ … ⊋ N j` ending in the leaf `N j`:

* `j = 0`: `|N 0| ≤ 5 + 3b`;
* `j ≥ 1`: `|N 0| + a ≤ 5 + 2j + 2b`,

where `a = 1` if the cut of `N 0` has size two and `b = 1` if the cut of the leaf has size two. -/
theorem ep_chain_size_cut {W : Type*} [DecidableEq W] (𝒮 : Finset (Finset W))
    (c : Finset W → ℕ)
    (hleaf : ∀ S ∈ 𝒮, epChildren 𝒮 S = ∅ → S.card ≤ 8 ∧ (c S ≠ 2 → S.card ≤ 5))
    (hone : ∀ S ∈ 𝒮, ∀ C, epChildren 𝒮 S = {C} →
      (S \ C).card ≤ 2 ∧ ((c S = 2 ∨ c C = 2) → (S \ C).card = 1))
    (hadj : ∀ S ∈ 𝒮, ∀ C, epChildren 𝒮 S = {C} → ¬(c S = 2 ∧ c C = 2))
    (N : ℕ → Finset W) (j : ℕ) (hNS : ∀ i, i ≤ j → N i ∈ 𝒮)
    (hNch : ∀ i, i < j → epChildren 𝒮 (N i) = {N (i + 1)}) (hNleaf : epChildren 𝒮 (N j) = ∅) :
    (N 0).card + (if 1 ≤ j ∧ c (N 0) = 2 then 1 else 0) ≤
      5 + 2 * j + (if c (N j) = 2 then (if j = 0 then 3 else 2) else 0) := by
  have hsubs : ∀ i, i < j → N (i + 1) ⊆ N i := by
    intro i hi
    have : N (i + 1) ∈ epChildren 𝒮 (N i) := by
      rw [hNch i hi]; exact Finset.mem_singleton_self _
    exact ((mem_epChildren 𝒮 (N i) _).mp this).2.1.1
  -- `d` nodes above the leaf: the leaf itself (`d = 0`), or the closed form (`d ≥ 1`)
  have key : ∀ d i, i + d = j →
      (d = 0 → (N i).card ≤ 8 ∧ (c (N j) ≠ 2 → (N i).card ≤ 5)) ∧
      (1 ≤ d → (N i).card + (if c (N i) = 2 then 1 else 0) ≤
        5 + 2 * d + (if c (N j) = 2 then 2 else 0)) := by
    intro d
    induction d with
    | zero =>
      intro i hi
      have hij : i = j := by omega
      subst hij
      obtain ⟨l8, l5⟩ := hleaf _ (hNS i (le_refl i)) hNleaf
      exact ⟨fun _ => ⟨l8, l5⟩, fun h1 => absurd h1 (by omega)⟩
    | succ d ih =>
      intro i hi
      obtain ⟨s2, s1⟩ := hone _ (hNS i (by omega)) _ (hNch i (by omega))
      have hnn := hadj _ (hNS i (by omega)) _ (hNch i (by omega))
      obtain ⟨ih0, ih1⟩ := ih (i + 1) (by omega)
      have h3 := Finset.card_sdiff_add_card_eq_card (hsubs i (by omega))
      refine ⟨fun h0 => absurd h0 (Nat.succ_ne_zero d), fun _ => ?_⟩
      rcases Nat.eq_zero_or_pos d with hd | hd
      · -- the node just above the leaf
        subst hd
        have hj : i + 1 = j := by omega
        subst hj
        obtain ⟨l8, l5⟩ := ih0 rfl
        by_cases hci : c (N i) = 2
        · by_cases hcn : c (N (i + 1)) = 2
          · exact absurd ⟨hci, hcn⟩ hnn
          · have e1 := s1 (Or.inl hci)
            have e2 := l5 hcn
            rw [if_pos hci, if_neg hcn]; omega
        · by_cases hcn : c (N (i + 1)) = 2
          · have e1 := s1 (Or.inr hcn)
            rw [if_neg hci, if_pos hcn]; omega
          · have e2 := l5 hcn
            rw [if_neg hci, if_neg hcn]; omega
      · have ih1' := ih1 hd
        by_cases hci : c (N i) = 2
        · by_cases hcn : c (N (i + 1)) = 2
          · exact absurd ⟨hci, hcn⟩ hnn
          · have e1 := s1 (Or.inl hci)
            rw [if_neg hcn] at ih1'
            rw [if_pos hci]; omega
        · by_cases hcn : c (N (i + 1)) = 2
          · have e1 := s1 (Or.inr hcn)
            rw [if_pos hcn] at ih1'
            rw [if_neg hci]; omega
          · rw [if_neg hcn] at ih1'
            rw [if_neg hci]; omega
  obtain ⟨k0, k1⟩ := key j 0 (by omega)
  rcases Nat.eq_zero_or_pos j with hj | hj
  · subst hj
    obtain ⟨l8, l5⟩ := k0 rfl
    have h10 : ¬(1 ≤ 0 ∧ c (N 0) = 2) := fun h' => absurd h'.1 (by omega)
    rw [if_neg h10]
    by_cases hc : c (N 0) = 2
    · rw [if_pos hc, if_pos rfl]; omega
    · have e2 := l5 hc
      rw [if_neg hc]; omega
  · have k1' := k1 hj
    have hj0 : j ≠ 0 := by omega
    by_cases hc0 : c (N 0) = 2
    · rw [if_pos hc0] at k1'
      rw [if_pos ⟨hj, hc0⟩]
      by_cases hcj : c (N j) = 2
      · rw [if_pos hcj] at k1'
        rw [if_pos hcj, if_neg hj0]; exact k1'
      · rw [if_neg hcj] at k1'
        rw [if_neg hcj]; exact k1'
    · rw [if_neg hc0] at k1'
      rw [if_neg (fun h' : 1 ≤ j ∧ c (N 0) = 2 => hc0 h'.2)]
      by_cases hcj : c (N j) = 2
      · rw [if_pos hcj] at k1'
        rw [if_pos hcj, if_neg hj0]; exact k1'
      · rw [if_neg hcj] at k1'
        rw [if_neg hcj]; exact k1'

/-! ### (ii) Chains ending with a node above a cut of size two

`lpCov t f rq` (existing) says: every valid continuation of `rq` by `f` nodes runs into a
certified suffix. It stops at the first hit, so "the chain ends with a `B32` node" cannot be
expressed with it. `lpCovEnd` is the same search with one change at the last node: a last node
that is not a `B32` code (`c / 3 ≠ 1`) is accepted without a certificate. -/

/-- Every valid continuation of the chain by `f` nodes **whose last node is a `(3,2)` node**
(code `3`, `4` or `5`) runs into a certified suffix. -/
def lpCovEnd (t : LpTree) : ℕ → List ℕ → Bool
  | 0, _ => true
  | f + 1, rq =>
    (lpNext rq.head?).all (fun c =>
      lpHit t (c :: rq) 0 [] || (if f = 0 then decide (c / 3 ≠ 1) else lpCovEnd t f (c :: rq)))

theorem lpCovEnd_sound (t : LpTree) : ∀ (f : ℕ) (rq ext : List ℕ), lpCovEnd t f rq = true →
    ext.length = f → 0 < f → lpExt rq.head? ext → (∀ c, ext.getLast? = some c → c / 3 = 1) →
    ∃ cert ∈ t.certs, ∃ a b : List ℕ, rq.reverse ++ ext = a ++ cert.pat ++ b := by
  intro f
  induction f with
  | zero => intro rq ext _ _ h0; exact absurd h0 (Nat.lt_irrefl 0)
  | succ f ih =>
    intro rq ext h hlen _ hext hlast
    obtain ⟨c, ext', rfl⟩ : ∃ c ext', ext = c :: ext' := by
      cases ext with
      | nil => simp at hlen
      | cons c ext' => exact ⟨c, ext', rfl⟩
    obtain ⟨hc, hext'⟩ := hext
    simp only [lpCovEnd, List.all_eq_true] at h
    have h1 := h c hc
    rw [Bool.or_eq_true] at h1
    rcases h1 with h1 | h1
    · obtain ⟨cert, hcert, r1, r2, e1, e2⟩ := lpHit_sound t _ _ _ h1
      refine ⟨cert, hcert, r2.reverse, ext', ?_⟩
      have : rq.reverse ++ c :: ext' = (c :: rq).reverse ++ ext' := by simp
      rw [this, e1, e2]
      simp
    · by_cases hf : f = 0
      · -- `c` is the last node, so it is a `(3,2)` node; the search says it is not
        exfalso
        subst hf
        have hnil : ext' = [] := List.length_eq_zero_iff.mp (by simpa using hlen)
        subst hnil
        rw [if_pos rfl] at h1
        have hc1 : c / 3 = 1 := hlast c (by simp)
        simp [hc1] at h1
      · rw [if_neg hf] at h1
        have hlast' : ∀ c', ext'.getLast? = some c' → c' / 3 = 1 := by
          intro c' hc'
          apply hlast c'
          cases ext' with
          | nil => simp at hc'
          | cons x xs => simpa [List.getLast?_cons_cons] using hc'
        obtain ⟨cert, hcert, a, b, e⟩ := ih (c :: rq) ext' h1 (by simpa using hlen)
          (Nat.pos_of_ne_zero hf) hext' hlast'
        exact ⟨cert, hcert, a, b, by rw [← e]; simp⟩

/-! ### (iii) Segments with a certified pattern -/

set_option maxHeartbeats 1600000 in
open Classical in
/-- **A segment of a labelled chain whose pattern contains a certified pattern is a burl.**
(The second half of the proof of `ep_chain_burl10`, for an arbitrary segment `[a, b)`.) -/
theorem ep_seg_burl {W E : Type*} [Fintype E] (α β : E → W) (n : ℕ) (N : ℕ → Finset W)
    (code : ℕ → ℕ) (v : ℕ → ℕ → W) (cut : ℕ → ℕ → E) (rg : ℕ → E)
    (hlab : EpLab α β n N code v cut rg)
    (t : LpTree) (hall : t.allOK = true) (htok : t.allTok = true)
    (a b : ℕ) (hab : a < b) (hbn : b ≤ n)
    (cert : LpCertP) (hcert : cert ∈ t.certs) (A B : List ℕ)
    (hsplit : lpSeg code a b = A ++ cert.pat ++ B) : EpBurl α β (N a \ N b) := by
  obtain ⟨hok, hne⟩ := LpTree.allTok_mem t htok cert hcert
  have hchk := LpTree.allOK_mem t hall cert hcert
  have hlen : A.length + cert.pat.length + B.length = b - a := by
    have := congrArg List.length hsplit
    rw [lpSeg_length, List.length_append, List.length_append] at this
    omega
  have hpos : 0 < cert.pat.length := List.length_pos_of_ne_nil hne
  -- the certified pattern is the pattern of the segment `[a + |A|, a + |A| + |pat|)`
  have hpat : cert.pat = lpSeg code (a + A.length) (a + A.length + cert.pat.length) := by
    have e1 := lpSeg_append code A.length a b (by omega)
    have e2 := lpSeg_append code cert.pat.length (a + A.length) b (by omega)
    rw [e1, e2, ← List.append_assoc] at hsplit
    have h1 := List.append_inj hsplit (by
      rw [List.length_append, List.length_append, lpSeg_length, lpSeg_length]; omega)
    have h2 := List.append_inj h1.1 (by rw [lpSeg_length]; omega)
    exact h2.2.symm
  have htk := ep_lab_tok α β n N code v cut rg hlab (a + A.length)
    (a + A.length + cert.pat.length) (by omega) (by omega)
  rw [← hpat] at htk
  have hburl := ep_burl_of_tok α β _ cert _ _ htk hok hchk
  obtain ⟨hInv, hnest, hloop, -⟩ := hlab
  have hmono : ∀ d i, i + d ≤ n → N (i + d) ⊆ N i := by
    intro d
    induction d with
    | zero => intro i _; exact Finset.Subset.refl _
    | succ d ih =>
      intro i hi
      exact (hnest (i + d) (by omega)).trans (ih i (by omega))
  have hsub : N (a + A.length) \ N (a + A.length + cert.pat.length) ⊆ N a \ N b := by
    have s1 := hmono A.length a (by omega)
    have s2 := hmono (b - (a + A.length + cert.pat.length)) (a + A.length + cert.pat.length)
      (by omega)
    rw [show a + A.length + cert.pat.length + (b - (a + A.length + cert.pat.length)) = b by
      omega] at s2
    exact Finset.sdiff_subset_sdiff s1 s2
  have hN0 : ∀ i, i ≤ n → N i ⊆ N 0 := by
    intro i hi
    have := hmono i 0 (by omega)
    rwa [Nat.zero_add] at this
  exact ep_burl_mono α β _ _ hsub
    (fun g hg => hloop g (hN0 a (by omega) (Finset.mem_sdiff.mp hg).1)) hburl

/-! ### (iv) The second burl of a chain with a cut of size two at an end

Statements for a chain of exactly seven nodes `N 0 ⊋ … ⊋ N 7`; a longer chain is used through
its first or last eight members. -/

open Classical in
/-- **F1 in use.** A chain of seven nodes whose top member has a cut of size two is a burl,
given a tree of certificates covering the patterns of length seven that start with a `(2,3)`
node (codes `6`, `7`). -/
theorem ep_chain_burl_top2 {W E : Type*} [Fintype E] (α β : E → W) (L : Finset W) (r : W)
    (𝒮 𝒴 : Finset (Finset W)) (h : EpCubicD α β L) (hb : EpBridgeless α β L)
    (hconn : EpConnected α β L) (hr : r ∈ L) (hdec : EpDecomp α β L r 𝒮)
    (href : EpRefines L r 𝒮 𝒴)
    (hmax : ∀ 𝒮', EpDecomp α β L r 𝒮' → EpRefines L r 𝒮' 𝒴 → 𝒮'.card ≤ 𝒮.card)
    (hnc : ¬EpHasCore α β L) (N : ℕ → Finset W) (hNS : ∀ i, i ≤ 7 → N i ∈ 𝒮)
    (hchild : ∀ i, i < 7 → epChildren 𝒮 (N i) = {N (i + 1)})
    (h2 : (epCut α β (N 0)).card = 2)
    (t : LpTree) (hall : t.allOK = true) (htok : t.allTok = true)
    (hc6 : lpCov t 6 [6] = true) (hc7 : lpCov t 6 [7] = true) : EpBurl α β (N 0 \ N 7) := by
  obtain ⟨code, v, cut, rg, hlab⟩ := ep_chain_lab α β L r 𝒮 𝒴 h hb hconn hr hdec href hmax hnc
    7 N hNS hchild
  have hcode : code 0 = 6 ∨ code 0 = 7 := by
    rcases hlab.2.2.2 0 (by omega) with ⟨-, c3, -⟩ | ⟨-, c3, -⟩ | ⟨c1, c2, -⟩
    · omega
    · omega
    · omega
  have hext := ep_lab_ext α β 7 N code v cut rg hlab 6 1 rfl
  rw [if_neg (by omega : ¬(1 = 0))] at hext
  have hcons := lpSeg_cons code 0 7 (by omega)
  have fin : ∀ c0, code 0 = c0 → lpCov t 6 [c0] = true → EpBurl α β (N 0 \ N 7) := by
    intro c0 hc0 hcov
    rw [show 1 - 1 = 0 from rfl, hc0] at hext
    obtain ⟨cert, hcert, A, B, hsplit⟩ := lpCov_sound t 6 [c0] (lpSeg code 1 7) hcov
      (by rw [lpSeg_length]) hext
    have hsplit' : lpSeg code 0 7 = A ++ cert.pat ++ B := by
      rw [hcons, hc0, ← hsplit]; rfl
    exact ep_seg_burl α β 7 N code v cut rg hlab t hall htok 0 7 (by omega) (le_refl 7) cert
      hcert A B hsplit'
  rcases hcode with h6 | h7
  · exact fin 6 h6 hc6
  · exact fin 7 h7 hc7

open Classical in
/-- **F2 in use.** A chain of seven nodes whose bottom member has a cut of size two is a burl,
given a tree of certificates covering the patterns of length seven that end with a `(3,2)`
node. -/
theorem ep_chain_burl_bot2 {W E : Type*} [Fintype E] (α β : E → W) (L : Finset W) (r : W)
    (𝒮 𝒴 : Finset (Finset W)) (h : EpCubicD α β L) (hb : EpBridgeless α β L)
    (hconn : EpConnected α β L) (hr : r ∈ L) (hdec : EpDecomp α β L r 𝒮)
    (href : EpRefines L r 𝒮 𝒴)
    (hmax : ∀ 𝒮', EpDecomp α β L r 𝒮' → EpRefines L r 𝒮' 𝒴 → 𝒮'.card ≤ 𝒮.card)
    (hnc : ¬EpHasCore α β L) (N : ℕ → Finset W) (hNS : ∀ i, i ≤ 7 → N i ∈ 𝒮)
    (hchild : ∀ i, i < 7 → epChildren 𝒮 (N i) = {N (i + 1)})
    (h2 : (epCut α β (N 7)).card = 2)
    (t : LpTree) (hall : t.allOK = true) (htok : t.allTok = true)
    (hcov : lpCovEnd t 7 [] = true) : EpBurl α β (N 0 \ N 7) := by
  obtain ⟨code, v, cut, rg, hlab⟩ := ep_chain_lab α β L r 𝒮 𝒴 h hb hconn hr hdec href hmax hnc
    7 N hNS hchild
  have h2' : (epCut α β (N (6 + 1))).card = 2 := h2
  have hcode : code 6 / 3 = 1 := by
    rcases hlab.2.2.2 6 (by omega) with ⟨-, -, c3, -⟩ | ⟨c1, -⟩ | ⟨-, -, -, c3, -⟩
    · omega
    · exact c1
    · omega
  have hext := ep_lab_ext α β 7 N code v cut rg hlab 7 0 rfl
  rw [if_pos rfl] at hext
  have hseg : lpSeg code 0 7 =
      [code 0, code 1, code 2, code 3, code 4, code 5, code 6] := by
    simp [lpSeg, List.range_succ]
  have hlast : ∀ c, (lpSeg code 0 7).getLast? = some c → c / 3 = 1 := by
    intro c hc
    rw [hseg] at hc
    have : c = code 6 := by simpa using hc.symm
    rw [this]; exact hcode
  obtain ⟨cert, hcert, A, B, hsplit⟩ := lpCovEnd_sound t 7 [] (lpSeg code 0 7) hcov
    (by rw [lpSeg_length]) (by omega) hext hlast
  have hsplit' : lpSeg code 0 7 = A ++ cert.pat ++ B := by
    rw [← hsplit]; rfl
  exact ep_seg_burl α β 7 N code v cut rg hlab t hall htok 0 7 (by omega) (le_refl 7) cert
    hcert A B hsplit'

