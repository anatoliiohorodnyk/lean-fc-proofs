        ih _ _ _ (Q.erase q₀) (by rw [Finset.card_erase_of_mem hq₀Q]; omega) h₁ hb₁ hconn₁ htri₁
          (by omega)
      refine ⟨α', β', L', Relation.ReflTransGen.head hstep hreach, hpr', by omega, by omega,
        fun 𝒳' hfol' => ?_⟩
