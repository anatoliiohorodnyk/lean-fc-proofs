  · obtain ⟨hodd, -⟩ := ep_cut5_parity α β L X h hXL h5
    rcases (by omega : X.card = 7 ∨ X.card = 9) with hc | hc
    · exact Or.inl ⟨hc, ep_cut5_card7 α β L X h h4 h6 hXL h5 hc hnb⟩
    · exact Or.inr ⟨hc, ep_cut5_card9 α β L X h h4 h6 hXL h5 hc hnb⟩

/-! ## 3. Bad splits and bad choices -/

open Classical in
/-- A bad split: two disjoint 3-twigs of the split multigraph, one containing both ends of the
new edge `a`, the other both ends of the new edge `c`, whose merge with `{p, q}` is not a burl
of `G`. -/
def EpBadSplit {W E : Type*} [Fintype E] (α β : E → W) (L : Finset W) (p q : W)
    (a b c d : E) : Prop :=
  ∃ X Y : Finset W, X ⊆ L \ {p, q} ∧ Y ⊆ L \ {p, q} ∧ Disjoint X Y ∧
    epOut α β {p, q} a ∈ X ∧ epOut α β {p, q} b ∈ X ∧
    epOut α β {p, q} c ∈ Y ∧ epOut α β {p, q} d ∈ Y ∧
    (epCut (epSpA α β p q a b c d) (epSpB α β p q a b c d) X).card = 3 ∧ 5 ≤ X.card ∧
    (epCut (epSpA α β p q a b c d) (epSpB α β p q a b c d) Y).card = 3 ∧ 5 ≤ Y.card ∧
    ¬EpBurl α β (X ∪ Y ∪ {p, q})

open Classical in
/-- The choice `(f, w)` is bad: some split along a path through `w` with first edge `f` is
bad. -/
def EpBadChoice {W E : Type*} [Fintype E] (α β : E → W) (L : Finset W) (f : E) (w : W) :
    Prop :=
  ∃ (q : W) (b c d m : E), EpPath4 α β L w q f b c d m ∧ EpBadSplit α β L w q f b c d

lemma ep_card_two_more {E : Type*} [DecidableEq E] (S S' : Finset E) (a b : E) (hab : a ≠ b)
    (ha : a ∈ S') (hb : b ∈ S') (ha' : a ∉ S) (hb' : b ∉ S)
    (hrest : ∀ g, g ≠ a → g ≠ b → (g ∈ S' ↔ g ∈ S)) : S'.card = S.card + 2 := by
  have hS : S' = insert a (insert b S) := by
    ext g
    rw [Finset.mem_insert, Finset.mem_insert]
    by_cases hga : g = a
    · rw [hga]; exact ⟨fun _ => Or.inl rfl, fun _ => ha⟩
    · by_cases hgb : g = b
      · rw [hgb]; exact ⟨fun _ => Or.inr (Or.inl rfl), fun _ => hb⟩
      · rw [hrest g hga hgb]
        exact ⟨fun h' => Or.inr (Or.inr h'), fun h' => h'.elim (fun e => absurd e hga)
          (fun h'' => h''.elim (fun e => absurd e hgb) id)⟩
  have h1 : a ∉ insert b S := by
    rw [Finset.mem_insert]; exact fun h' => h'.elim hab ha'
  rw [hS, Finset.card_insert_of_notMem h1, Finset.card_insert_of_notMem hb']

lemma ep_cross_lift {W E : Type*} [DecidableEq W] (α β : E → W) (T P : Finset W) (g : E)
    (s o : W) (hs : s ∈ P) (ho : o ∉ P) (hg : (α g = s ∧ β g = o) ∨ (α g = o ∧ β g = s)) :
    epCross α β (T ∪ P) g ↔ o ∉ T := by
  rw [ep_cross_pq α β g s o hg]
  simp only [Finset.mem_union]
  tauto

lemma ep_cross_union_out {W E : Type*} [DecidableEq W] (α β : E → W) (T P : Finset W) (g : E)
    (h1 : α g ∉ P) (h2 : β g ∉ P) : epCross α β (T ∪ P) g ↔ epCross α β T g := by
  unfold epCross
  simp only [Finset.mem_union]
  tauto

/-- The whole vertex set has an empty cut. -/
lemma ep_cut_univ {W E : Type*} [Fintype E] (α β : E → W) (L : Finset W)
    (h : EpCubicD α β L) : epCut α β L = ∅ := by
  refine Finset.eq_empty_of_forall_notMem fun g hg => ?_
  rw [mem_epCut] at hg
  unfold epCross at hg
  rcases h.1 g with h' | h'
  · tauto
  · rw [h'.2] at hg; tauto

open Classical in
/-- The ends of the five edges of a path configuration; every other edge avoids `p`, `q`. -/
lemma epSp_facts {W E : Type*} [Fintype E] (α β : E → W) (L : Finset W) (p q : W)
    (a b c d m : E) (h : EpCubicD α β L) (hp : EpPath4 α β L p q a b c d m) :
    (epOut α β {p, q} a ∉ ({p, q} : Finset W) ∧ epOut α β {p, q} b ∉ ({p, q} : Finset W) ∧
      epOut α β {p, q} c ∉ ({p, q} : Finset W) ∧ epOut α β {p, q} d ∉ ({p, q} : Finset W)) ∧
    ((α a = p ∧ β a = epOut α β {p, q} a) ∨ (α a = epOut α β {p, q} a ∧ β a = p)) ∧
    ((α b = q ∧ β b = epOut α β {p, q} b) ∨ (α b = epOut α β {p, q} b ∧ β b = q)) ∧
    ((α c = p ∧ β c = epOut α β {p, q} c) ∨ (α c = epOut α β {p, q} c ∧ β c = p)) ∧
    ((α d = q ∧ β d = epOut α β {p, q} d) ∨ (α d = epOut α β {p, q} d ∧ β d = q)) ∧
    ((α m = p ∧ β m = q) ∨ (α m = q ∧ β m = p)) ∧
    (∀ g, g ≠ a → g ≠ b → g ≠ c → g ≠ d → g ≠ m →
      α g ∉ ({p, q} : Finset W) ∧ β g ∉ ({p, q} : Finset W)) := by
  obtain ⟨he1, he2, hm⟩ := hp.ends
  have hnl : ∀ g, α g ∈ L → α g ≠ β g := by
    intro g hg
    rcases h.1 g with h' | h'
    · exact h'.2.2
    · exact absurd hg h'.1
  have hlv : ∀ g, β g ∈ L → α g ∈ L := by
    intro g hg
    rcases h.1 g with h' | h'
    · exact h'.1
    · exact absurd (h'.2 ▸ hg) h'.1
  have htouch := hp.touch hnl hlv
  refine ⟨⟨(he1 a (Or.inl rfl)).1, (he2 b (Or.inl rfl)).1, (he1 c (Or.inr rfl)).1,
    (he2 d (Or.inr rfl)).1⟩, (he1 a (Or.inl rfl)).2, (he2 b (Or.inl rfl)).2,
    (he1 c (Or.inr rfl)).2, (he2 d (Or.inr rfl)).2, hm, fun g h1 h2 h3 h4 h5 => ?_⟩
  have hnot : ¬(α g ∈ ({p, q} : Finset W) ∨ β g ∈ ({p, q} : Finset W)) := by
    rw [htouch g]
    exact fun h' => h'.elim h1 (fun h' => h'.elim h2 (fun h' => h'.elim h3
      (fun h' => h'.elim h4 h5)))
  exact ⟨fun h' => hnot (Or.inl h'), fun h' => hnot (Or.inr h')⟩

set_option maxHeartbeats 1600000 in
open Classical in
/-- **Cuts of lifts.** For `T ⊆ L ∖ {p, q}`: if exactly one of the two new edges is inside `T`,
the lift `T ∪ {p, q}` has two more cut edges in `G` than `T` has in the split multigraph; if
both are inside, the two cuts are the same set. -/
lemma epSp_lift_cut {W E : Type*} [Fintype E] (α β : E → W) (L : Finset W) (p q : W)
    (a b c d m : E) (h : EpCubicD α β L) (hp : EpPath4 α β L p q a b c d m) (T : Finset W)
    (hTL : T ⊆ L \ {p, q}) :
    (epOut α β {p, q} a ∈ T → epOut α β {p, q} b ∈ T → epOut α β {p, q} c ∉ T → epOut α β {p, q} d ∉ T →
      (epCut α β (T ∪ {p, q})).card = (epCut (epSpA α β p q a b c d) (epSpB α β p q a b c d) T).card + 2) ∧
    (epOut α β {p, q} c ∈ T → epOut α β {p, q} d ∈ T → epOut α β {p, q} a ∉ T → epOut α β {p, q} b ∉ T →
      (epCut α β (T ∪ {p, q})).card = (epCut (epSpA α β p q a b c d) (epSpB α β p q a b c d) T).card + 2) ∧
    (epOut α β {p, q} a ∈ T → epOut α β {p, q} b ∈ T → epOut α β {p, q} c ∈ T → epOut α β {p, q} d ∈ T →
      epCut α β (T ∪ {p, q}) = epCut (epSpA α β p q a b c d) (epSpB α β p q a b c d) T) := by
  obtain ⟨⟨noa, nob, noc, nod⟩, ha, hb, hc, hd, hm, hother⟩ :=
    epSp_facts α β L p q a b c d m h hp
  obtain ⟨hpL, hqL, hpq, hsp, hsq, d1, d2, d3, d4, d5, d6, d7, d8, d9, d10⟩ := hp
  have hpP : p ∈ ({p, q} : Finset W) := by simp
  have hqP : q ∈ ({p, q} : Finset W) := by simp
  have hpT : p ∉ T := fun h' => (Finset.mem_sdiff.mp (hTL h')).2 hpP
  obtain ⟨sa, sc, sdead, ssame⟩ := epSp_cross α β p q a b c d d1 T hpT
  have ga := ep_cross_lift α β T {p, q} a p _ hpP noa ha
  have gb := ep_cross_lift α β T {p, q} b q _ hqP nob hb
  have gc := ep_cross_lift α β T {p, q} c p _ hpP noc hc
  have gd := ep_cross_lift α β T {p, q} d q _ hqP nod hd
  have gm : ¬epCross α β (T ∪ {p, q}) m := by
    rw [ep_cross_pq α β m p q hm]
    have h1 : p ∈ T ∪ {p, q} := Finset.mem_union_right _ hpP
    have h2 : q ∈ T ∪ {p, q} := Finset.mem_union_right _ hqP
    exact fun h' => h'.elim (fun h'' => h''.2 h2) (fun h'' => h''.1 h1)
  have tb : α b ∈ ({p, q} : Finset W) ∨ β b ∈ ({p, q} : Finset W) := by
    rcases hb with ⟨e, -⟩ | ⟨-, e⟩
    · exact Or.inl (by rw [e]; exact hqP)
    · exact Or.inr (by rw [e]; exact hqP)
  have td : α d ∈ ({p, q} : Finset W) ∨ β d ∈ ({p, q} : Finset W) := by
    rcases hd with ⟨e, -⟩ | ⟨-, e⟩
    · exact Or.inl (by rw [e]; exact hqP)
    · exact Or.inr (by rw [e]; exact hqP)
  have tm : α m ∈ ({p, q} : Finset W) ∨ β m ∈ ({p, q} : Finset W) := by
    rcases hm with ⟨e, -⟩ | ⟨e, -⟩
    · exact Or.inl (by rw [e]; exact hpP)
    · exact Or.inl (by rw [e]; exact hqP)
  have sb := sdead b d7.symm d9.symm tb
  have sd := sdead d d8.symm d10.symm td
  have sm := sdead m d2.symm d3.symm tm
  have grest : ∀ g, g ≠ a → g ≠ b → g ≠ c → g ≠ d → g ≠ m →
      (g ∈ epCut α β (T ∪ {p, q}) ↔ g ∈ epCut (epSpA α β p q a b c d) (epSpB α β p q a b c d) T) := by
    intro g h1 h2 h3 h4 h5
    obtain ⟨n1, n2⟩ := hother g h1 h2 h3 h4 h5
    rw [mem_epCut, mem_epCut, ep_cross_union_out α β T {p, q} g n1 n2,
      ssame g h1 h3 (fun h' => h'.elim n1 n2)]
  clear ha hb hc hd hm tb td tm
  have Fa : epOut α β {p, q} a ∈ T → epOut α β {p, q} b ∈ T → (a ∈ epCut α β (T ∪ {p, q}) ↔ a ∈ epCut (epSpA α β p q a b c d) (epSpB α β p q a b c d) T) := by
    intro ia ib
    rw [mem_epCut, mem_epCut, ga, sa]
    exact ⟨fun h' => absurd ia h', fun h' => h'.elim (fun h'' => absurd ib h''.2)
      (fun h'' => absurd ia h''.1)⟩
  have Fb : epOut α β {p, q} b ∈ T → (b ∈ epCut α β (T ∪ {p, q}) ↔ b ∈ epCut (epSpA α β p q a b c d) (epSpB α β p q a b c d) T) := by
    intro ib
    rw [mem_epCut, mem_epCut, gb]
    exact ⟨fun h' => absurd ib h', fun h' => absurd h' sb⟩
  have Fc : epOut α β {p, q} c ∈ T → epOut α β {p, q} d ∈ T → (c ∈ epCut α β (T ∪ {p, q}) ↔ c ∈ epCut (epSpA α β p q a b c d) (epSpB α β p q a b c d) T) := by
    intro ic id
    rw [mem_epCut, mem_epCut, gc, sc]
    exact ⟨fun h' => absurd ic h', fun h' => h'.elim (fun h'' => absurd id h''.2)
      (fun h'' => absurd ic h''.1)⟩
  have Fd : epOut α β {p, q} d ∈ T → (d ∈ epCut α β (T ∪ {p, q}) ↔ d ∈ epCut (epSpA α β p q a b c d) (epSpB α β p q a b c d) T) := by
    intro id
    rw [mem_epCut, mem_epCut, gd]
    exact ⟨fun h' => absurd id h', fun h' => absurd h' sd⟩
  have Fm : m ∈ epCut α β (T ∪ {p, q}) ↔ m ∈ epCut (epSpA α β p q a b c d) (epSpB α β p q a b c d) T := by
    rw [mem_epCut, mem_epCut]
    exact ⟨fun h' => absurd h' gm, fun h' => absurd h' sm⟩
  refine ⟨fun ia ib ic id => ?_, fun ic id ia ib => ?_, fun ia ib ic id => ?_⟩
  · refine ep_card_two_more _ _ c d d10 ((mem_epCut _ _ _ _).mpr (gc.mpr ic))
      ((mem_epCut _ _ _ _).mpr (gd.mpr id)) ?_ ?_ ?_
    · rw [mem_epCut, sc]
      exact fun h' => h'.elim (fun h'' => ic h''.1) (fun h'' => id h''.2)
    · rw [mem_epCut]; exact sd
    · intro g hgc hgd
      by_cases hga : g = a
      · rw [hga]; exact Fa ia ib
      · by_cases hgb : g = b
        · rw [hgb]; exact Fb ib
        · by_cases hgm : g = m
          · rw [hgm]; exact Fm
          · exact grest g hga hgb hgc hgd hgm
  · refine ep_card_two_more _ _ a b d7 ((mem_epCut _ _ _ _).mpr (ga.mpr ia))
      ((mem_epCut _ _ _ _).mpr (gb.mpr ib)) ?_ ?_ ?_
    · rw [mem_epCut, sa]
      exact fun h' => h'.elim (fun h'' => ia h''.1) (fun h'' => ib h''.2)
    · rw [mem_epCut]; exact sb
    · intro g hga hgb
      by_cases hgc : g = c
      · rw [hgc]; exact Fc ic id
      · by_cases hgd : g = d
        · rw [hgd]; exact Fd id
        · by_cases hgm : g = m
          · rw [hgm]; exact Fm
          · exact grest g hga hgb hgc hgd hgm
  · ext g
    by_cases hga : g = a
    · rw [hga]; exact Fa ia ib
    · by_cases hgb : g = b
      · rw [hgb]; exact Fb ib
      · by_cases hgc : g = c
        · rw [hgc]; exact Fc ic id
        · by_cases hgd : g = d
          · rw [hgd]; exact Fd id
          · by_cases hgm : g = m
            · rw [hgm]; exact Fm
            · exact grest g hga hgb hgc hgd hgm

open Classical in
/-- **S1.** The lift of a 3-twig of the split multigraph with the new edge `a` inside and the
ends of the new edge `c` outside has a cut of size five in `G`. -/
theorem epSp_lift_cut5 {W E : Type*} [Fintype E] (α β : E → W) (L : Finset W) (p q : W)
    (a b c d m : E) (h : EpCubicD α β L) (h4 : EpCyc4 α β L) (h12 : 12 ≤ L.card)
    (hp : EpPath4 α β L p q a b c d m) (X : Finset W) (hXL : X ⊆ L \ {p, q})
    (haX : epOut α β {p, q} a ∈ X) (hbX : epOut α β {p, q} b ∈ X)
    (hcX : epOut α β {p, q} c ∉ X) (hdX : epOut α β {p, q} d ∉ X)
    (h3 : (epCut (epSpA α β p q a b c d) (epSpB α β p q a b c d) X).card = 3) :
    (epCut α β (X ∪ {p, q})).card = 5 := by
  rw [(epSp_lift_cut α β L p q a b c d m h hp X hXL).1 haX hbX hcX hdX, h3]

open Classical in
/-- **C2 (an edge between the twigs).** For disjoint 3-twigs `X`, `Y` of the split multigraph
with the new edges inside: if some edge of `G` joins `X` and `Y`, the merge is a burl.
(`|δ(Z)| = 6 − 2k`; `k = 1`: P2′; `k = 2`: against `EpCyc4`; `k = 3`: `Z = L`, `ep_twig3_burl`
and monotonicity.) -/
theorem epSp_merge_burl_of_edge {W E : Type*} [Fintype E] (α β : E → W) (L : Finset W)
    (p q : W) (a b c d m : E) (h : EpCubicD α β L) (h4 : EpCyc4 α β L) (h12 : 12 ≤ L.card)
    (hp : EpPath4 α β L p q a b c d m) (X Y : Finset W) (hXL : X ⊆ L \ {p, q})
    (hYL : Y ⊆ L \ {p, q}) (hXY : Disjoint X Y)
    (haX : epOut α β {p, q} a ∈ X) (hbX : epOut α β {p, q} b ∈ X)
    (hcY : epOut α β {p, q} c ∈ Y) (hdY : epOut α β {p, q} d ∈ Y)
    (hX3 : (epCut (epSpA α β p q a b c d) (epSpB α β p q a b c d) X).card = 3)
    (hY3 : (epCut (epSpA α β p q a b c d) (epSpB α β p q a b c d) Y).card = 3)
    (hX5 : 5 ≤ X.card) (hY5 : 5 ≤ Y.card)
    (hedge : ∃ x ∈ X, ∃ y ∈ Y, EpAdj α β x y) : EpBurl α β (X ∪ Y ∪ {p, q}) := by
  have hT : X ∪ Y ⊆ L \ {p, q} := Finset.union_subset hXL hYL
  have hcutZ := (epSp_lift_cut α β L p q a b c d m h hp (X ∪ Y) hT).2.2
    (Finset.mem_union_left _ haX) (Finset.mem_union_left _ hbX)
    (Finset.mem_union_right _ hcY) (Finset.mem_union_right _ hdY)
  have eu := ep_cut_union (epSpA α β p q a b c d) (epSpB α β p q a b c d) X Y hXY
  rw [hX3, hY3, ← hcutZ] at eu
  obtain ⟨-, ha, -, hc, -, -, -⟩ := epSp_facts α β L p q a b c d m h hp
  obtain ⟨hpL, hqL, hpq, -⟩ := hp
  have hmemP : ∀ w, w ∈ ({p, q} : Finset W) ↔ w = p ∨ w = q := by
    intro w; simp only [Finset.mem_insert, Finset.mem_singleton]
  -- an edge of `G` between `X` and `Y` is an edge of the split multigraph
  obtain ⟨x, hx, y, hy, g, hg⟩ := hedge
  have hxP : x ∉ ({p, q} : Finset W) := (Finset.mem_sdiff.mp (hXL hx)).2
  have hyP : y ∉ ({p, q} : Finset W) := (Finset.mem_sdiff.mp (hYL hy)).2
  have ht : ¬(α g ∈ ({p, q} : Finset W) ∨ β g ∈ ({p, q} : Finset W)) := by
    rcases hg with ⟨b1, b2⟩ | ⟨b1, b2⟩ <;> rw [b1, b2] <;> tauto
  have hga : g ≠ a := by
    intro e
    rw [e] at ht
    rcases ha with ⟨b1, -⟩ | ⟨-, b2⟩
    · exact ht (Or.inl ((hmemP _).mpr (Or.inl b1)))
    · exact ht (Or.inr ((hmemP _).mpr (Or.inl b2)))
  have hgc : g ≠ c := by
    intro e
    rw [e] at ht
    rcases hc with ⟨b1, -⟩ | ⟨-, b2⟩
    · exact ht (Or.inl ((hmemP _).mpr (Or.inl b1)))
    · exact ht (Or.inr ((hmemP _).mpr (Or.inl b2)))
  have k1 : epSpA α β p q a b c d g = α g := by
    unfold epSpA; rw [if_neg hga, if_neg hgc, if_neg ht]
  have k2 : epSpB α β p q a b c d g = β g := by
    unfold epSpB; rw [if_neg hga, if_neg hgc, if_neg ht]
  have hpos : 0 < (epBtw (epSpA α β p q a b c d) (epSpB α β p q a b c d) X Y).card := by
    refine Finset.card_pos.mpr ⟨g, ?_⟩
    rw [mem_epBtw, k1, k2]
    rcases hg with ⟨b1, b2⟩ | ⟨b1, b2⟩
    · left; rw [b1, b2]; exact ⟨hx, hy⟩
    · right; rw [b1, b2]; exact ⟨hy, hx⟩
  clear ha hc hg
  have hZL : X ∪ Y ∪ {p, q} ⊆ L := by
    intro w hw
    rcases Finset.mem_union.mp hw with h' | h'
    · exact (Finset.mem_sdiff.mp (hT h')).1
    · rcases Finset.mem_insert.mp h' with e | e
      · rw [e]; exact hpL
      · rw [Finset.mem_singleton.mp e]; exact hqL
  have hZcard : 5 ≤ (X ∪ Y ∪ {p, q}).card := hX5.trans (Finset.card_le_card
    (Finset.subset_union_left.trans Finset.subset_union_left))
  have hnlL : ∀ g, α g ∈ L → α g ≠ β g := by
    intro g hg
    rcases h.1 g with h' | h'
    · exact h'.2.2
    · exact absurd hg h'.1
  have hcL : (epCut α β L).card = 0 := by rw [ep_cut_univ α β L h]; rfl
  by_cases h4c : (epCut α β (X ∪ Y ∪ {p, q})).card = 4
  · exact ep_cut4_burl_cyc4 α β L _ h h4 hZL h4c (by omega)
  · by_cases hZ : X ∪ Y ∪ {p, q} = L
    · rw [hZ]
      have e1 := ep_cut_erase α β L L h (Finset.Subset.refl L) p hpL
      have hin : (epCut α β {p} ∩ epCut α β L).card = 0 := by
        rw [ep_cut_univ α β L h, Finset.inter_empty]; rfl
      have hcard := Finset.card_sdiff_add_card_eq_card (Finset.singleton_subset_iff.mpr hpL)
      rw [Finset.card_singleton] at hcard
      obtain ⟨hb, hconn⟩ := EpCyc4.bridgelessD h h4
      exact ep_burl_mono α β (L \ {p}) L Finset.sdiff_subset hnlL
        (ep_twig3_burl α β L (L \ {p}) h hb hconn Finset.sdiff_subset (by omega) (by omega))
    · exfalso
      have := h4.1 _ hZL (Finset.card_pos.mp (by omega)) hZ
      omega

/-- `src` (index of the glued model `(N, J)` ↦ index in the disjoint union: `i < n₁` is the
vertex `i` of the first model, `n₁ + j` the vertex `j` of the second, never `jp`, `jq`)
identifies `(N, J)` with the two models glued along `(ip, iq) = (jp, jq)`. Decidable; the
adjacency condition is split by the sides of the two vertices to keep instance search small. -/
def lvGlueOK (n₁ n₂ N : ℕ) (I₁ I₂ J : List (ℕ × ℕ)) (ip iq jp jq : ℕ) (src : List ℕ) : Prop :=
  (∀ k, k < N → src.getD k 0 < n₁ + n₂ ∧ src.getD k 0 ≠ n₁ + jp ∧ src.getD k 0 ≠ n₁ + jq) ∧
  (∀ s, s < n₁ + n₂ → s ≠ n₁ + jp → s ≠ n₁ + jq →
    s ∈ (List.range N).map (fun k => src.getD k 0)) ∧
  (∀ k l : Fin N, src.getD k.1 0 = src.getD l.1 0 → k = l) ∧
  (∀ k l : Fin N, src.getD k.1 0 < n₁ → src.getD l.1 0 < n₁ →
    (((k.1, l.1) ∈ J ∨ (l.1, k.1) ∈ J) ↔
      ((src.getD k.1 0, src.getD l.1 0) ∈ I₁ ∨ (src.getD l.1 0, src.getD k.1 0) ∈ I₁))) ∧
  (∀ k l : Fin N, n₁ ≤ src.getD k.1 0 → n₁ ≤ src.getD l.1 0 →
    (((k.1, l.1) ∈ J ∨ (l.1, k.1) ∈ J) ↔
      ((src.getD k.1 0 - n₁, src.getD l.1 0 - n₁) ∈ I₂ ∨
        (src.getD l.1 0 - n₁, src.getD k.1 0 - n₁) ∈ I₂))) ∧
  (∀ k l : Fin N, src.getD k.1 0 < n₁ → n₁ ≤ src.getD l.1 0 →
    (((k.1, l.1) ∈ J ∨ (l.1, k.1) ∈ J) ↔
      ((src.getD k.1 0 = ip ∧ ((jp, src.getD l.1 0 - n₁) ∈ I₂ ∨
          (src.getD l.1 0 - n₁, jp) ∈ I₂)) ∨
        (src.getD k.1 0 = iq ∧ ((jq, src.getD l.1 0 - n₁) ∈ I₂ ∨
          (src.getD l.1 0 - n₁, jq) ∈ I₂)))))

set_option maxHeartbeats 1600000 in
open Classical in
/-- **Gluing two layouts.** `X ∪ {p, q}` and `Y ∪ {p, q}` laid out along two models, `X`, `Y`
disjoint with no edge between: `X ∪ Y ∪ {p, q}` is laid out along the glued model. -/
theorem ep_isoI_glue {W E : Type*} (α β : E → W) (X Y : Finset W) (p q : W)
    (hpq : p ≠ q) (hpX : p ∉ X) (hqX : q ∉ X) (hpY : p ∉ Y) (hqY : q ∉ Y)
    (hXY : Disjoint X Y) (hno : ∀ x ∈ X, ∀ y ∈ Y, ¬EpAdj α β x y)
    (n₁ n₂ N : ℕ) (I₁ I₂ J : List (ℕ × ℕ)) (φ ψ : ℕ → W)
    (h₁ : EpIsoI α β (X ∪ {p, q}) n₁ I₁ φ) (h₂ : EpIsoI α β (Y ∪ {p, q}) n₂ I₂ ψ)
    (ip iq jp jq : ℕ) (hip : ip < n₁) (hiq : iq < n₁) (hjp : jp < n₂) (hjq : jq < n₂)
    (eip : φ ip = p) (eiq : φ iq = q) (ejp : ψ jp = p) (ejq : ψ jq = q)
    (src : List ℕ) (hOK : lvGlueOK n₁ n₂ N I₁ I₂ J ip iq jp jq src) :
    ∃ χ, EpIsoI α β (X ∪ Y ∪ {p, q}) N J χ := by
  obtain ⟨hφX, hφinj, hφsurj, hA1⟩ := h₁
  obtain ⟨hψY, hψinj, hψsurj, hA2⟩ := h₂
  obtain ⟨G1, G2, G3, G4a, G4b, G4c⟩ := hOK
  have hmemP : ∀ w, w ∈ ({p, q} : Finset W) ↔ w = p ∨ w = q := by
    intro w; simp only [Finset.mem_insert, Finset.mem_singleton]
  have hipq : ip ≠ iq := fun e => hpq (by rw [← eip, ← eiq, e])
  have hφ : ∀ i, i < n₁ → φ i ∈ X ∨ φ i = p ∨ φ i = q := by
    intro i hi
    rcases Finset.mem_union.mp (hφX i hi) with h' | h'
    · exact Or.inl h'
    · exact Or.inr ((hmemP _).mp h')
  have hψ : ∀ j, j < n₂ → j ≠ jp → j ≠ jq → ψ j ∈ Y ∧ ψ j ≠ p ∧ ψ j ≠ q := by
    intro j hj h1 h2
    have np : ψ j ≠ p := fun e => h1 (hψinj j jp hj hjp (e.trans ejp.symm))
    have nq : ψ j ≠ q := fun e => h2 (hψinj j jq hj hjq (e.trans ejq.symm))
    rcases Finset.mem_union.mp (hψY j hj) with h' | h'
    · exact ⟨h', np, nq⟩
    · rcases (hmemP _).mp h' with e | e
      · exact absurd e np
      · exact absurd e nq
  have hne : ∀ i j, i < n₁ → j < n₂ → j ≠ jp → j ≠ jq → φ i ≠ ψ j := by
    intro i j hi hj h1 h2 e
    obtain ⟨y1, y2, y3⟩ := hψ j hj h1 h2
    rcases hφ i hi with h' | h' | h'
    · exact Finset.disjoint_left.mp hXY h' (by rw [e]; exact y1)
    · exact y2 (e.symm.trans h')
    · exact y3 (e.symm.trans h')
  have hA3 : ∀ i j, i < n₁ → j < n₂ → j ≠ jp → j ≠ jq →
      (EpAdj α β (φ i) (ψ j) ↔ ((i = ip ∧ ((jp, j) ∈ I₂ ∨ (j, jp) ∈ I₂)) ∨
        (i = iq ∧ ((jq, j) ∈ I₂ ∨ (j, jq) ∈ I₂)))) := by
    intro i j hi hj h1 h2
    obtain ⟨y1, y2, y3⟩ := hψ j hj h1 h2
    rcases hφ i hi with h' | h' | h'
    · constructor
      · intro hh; exact absurd hh (hno _ h' _ y1)
      · rintro (⟨e, -⟩ | ⟨e, -⟩)
        · rw [e, eip] at h'; exact absurd h' hpX
        · rw [e, eiq] at h'; exact absurd h' hqX
    · have e : i = ip := hφinj i ip hi hip (h'.trans eip.symm)
      rw [e, eip, ← ejp, hA2 jp j hjp hj]
      constructor
      · intro hh; exact Or.inl ⟨rfl, hh⟩
      · rintro (⟨-, hh⟩ | ⟨e', -⟩)
        · exact hh
        · exact absurd e' hipq
    · have e : i = iq := hφinj i iq hi hiq (h'.trans eiq.symm)
      rw [e, eiq, ← ejq, hA2 jq j hjq hj]
      constructor
      · intro hh; exact Or.inr ⟨rfl, hh⟩
      · rintro (⟨e', -⟩ | ⟨-, hh⟩)
        · exact absurd e'.symm hipq
        · exact hh
  obtain ⟨v, hvlt, hvge⟩ : ∃ v : ℕ → W, (∀ s, s < n₁ → v s = φ s) ∧
      (∀ s, n₁ ≤ s → v s = ψ (s - n₁)) :=
    ⟨fun s => if s < n₁ then φ s else ψ (s - n₁), fun s hs => if_pos hs,
      fun s hs => if_neg (by omega)⟩
  have V1 : ∀ s, (s < n₁ + n₂ ∧ s ≠ n₁ + jp ∧ s ≠ n₁ + jq) → v s ∈ X ∪ Y ∪ {p, q} := by
    intro s hs
    by_cases hlt : s < n₁
    · rw [hvlt s hlt]
      rcases hφ s hlt with h' | h' | h'
      · exact Finset.mem_union_left _ (Finset.mem_union_left _ h')
      · exact Finset.mem_union_right _ ((hmemP _).mpr (Or.inl h'))
      · exact Finset.mem_union_right _ ((hmemP _).mpr (Or.inr h'))
    · rw [hvge s (by omega)]
      exact Finset.mem_union_left _ (Finset.mem_union_right _
        (hψ (s - n₁) (by omega) (by omega) (by omega)).1)
  have V2 : ∀ s t, (s < n₁ + n₂ ∧ s ≠ n₁ + jp ∧ s ≠ n₁ + jq) →
      (t < n₁ + n₂ ∧ t ≠ n₁ + jp ∧ t ≠ n₁ + jq) → v s = v t → s = t := by
    intro s t hs ht e
    by_cases hlt : s < n₁ <;> by_cases hlt' : t < n₁
    · rw [hvlt s hlt, hvlt t hlt'] at e
      exact hφinj s t hlt hlt' e
    · rw [hvlt s hlt, hvge t (by omega)] at e
      exact absurd e (hne s (t - n₁) hlt (by omega) (by omega) (by omega))
    · rw [hvge s (by omega), hvlt t hlt'] at e
      exact absurd e.symm (hne t (s - n₁) hlt' (by omega) (by omega) (by omega))
    · rw [hvge s (by omega), hvge t (by omega)] at e
      have := hψinj (s - n₁) (t - n₁) (by omega) (by omega) e
      omega
  have V4 : ∀ z ∈ X ∪ Y ∪ {p, q}, ∃ s, (s < n₁ + n₂ ∧ s ≠ n₁ + jp ∧ s ≠ n₁ + jq) ∧
      v s = z := by
    intro z hz
    have hcase : z ∈ X ∪ {p, q} ∨ z ∈ Y := by
      rcases Finset.mem_union.mp hz with h' | h'
      · rcases Finset.mem_union.mp h' with h'' | h''
        · exact Or.inl (Finset.mem_union_left _ h'')
        · exact Or.inr h''
      · exact Or.inl (Finset.mem_union_right _ h')
    rcases hcase with h' | h'
    · obtain ⟨i, hi, e⟩ := hφsurj z h'
      exact ⟨i, ⟨by omega, by omega, by omega⟩, by rw [hvlt i hi]; exact e⟩
    · obtain ⟨j, hj, e⟩ := hψsurj z (Finset.mem_union_left _ h')
      have h1 : j ≠ jp := fun e' => hpY (by rw [← ejp, ← e', e]; exact h')
      have h2 : j ≠ jq := fun e' => hqY (by rw [← ejq, ← e', e]; exact h')
      refine ⟨n₁ + j, ⟨by omega, by omega, by omega⟩, ?_⟩
      rw [hvge (n₁ + j) (by omega), Nat.add_sub_cancel_left]
      exact e
  refine ⟨fun k => v (src.getD k 0), fun k hk => V1 _ (G1 k hk), fun k l hk hl e =>
    congrArg Fin.val (G3 ⟨k, hk⟩ ⟨l, hl⟩ (V2 _ _ (G1 k hk) (G1 l hl) e)), fun z hz => ?_,
    fun k l hk hl => ?_⟩
  · obtain ⟨s, hs, e⟩ := V4 z hz
    obtain ⟨k, hk, hks⟩ := List.mem_map.mp (G2 s hs.1 hs.2.1 hs.2.2)
    exact ⟨k, List.mem_range.mp hk, (congrArg v hks).trans e⟩
  · obtain ⟨g1k, g2k, g3k⟩ := G1 k hk
    obtain ⟨g1l, g2l, g3l⟩ := G1 l hl
    show EpAdj α β (v (src.getD k 0)) (v (src.getD l 0)) ↔ _
    by_cases hlt : src.getD k 0 < n₁ <;> by_cases hlt' : src.getD l 0 < n₁
    · rw [hvlt _ hlt, hvlt _ hlt', hA1 _ _ hlt hlt']
      exact (G4a ⟨k, hk⟩ ⟨l, hl⟩ hlt hlt').symm
    · have hge' : n₁ ≤ src.getD l 0 := by omega
      rw [hvlt _ hlt, hvge (src.getD l 0) hge',
        hA3 (src.getD k 0) (src.getD l 0 - n₁) hlt (by omega) (by omega) (by omega)]
      exact (G4c ⟨k, hk⟩ ⟨l, hl⟩ hlt hge').symm
    · have hge : n₁ ≤ src.getD k 0 := by omega
      rw [hvge (src.getD k 0) hge, hvlt _ hlt',
        ep_adj_comm α β (ψ (src.getD k 0 - n₁)) (φ (src.getD l 0)),
        hA3 (src.getD l 0) (src.getD k 0 - n₁) hlt' (by omega) (by omega) (by omega)]
      exact ((G4c ⟨l, hl⟩ ⟨k, hk⟩ hlt' hge).symm).trans Or.comm
    · have hge : n₁ ≤ src.getD k 0 := by omega
      have hge' : n₁ ≤ src.getD l 0 := by omega
      rw [hvge (src.getD k 0) hge, hvge (src.getD l 0) hge',
        hA2 (src.getD k 0 - n₁) (src.getD l 0 - n₁) (by omega) (by omega)]
      exact (G4b ⟨k, hk⟩ ⟨l, hl⟩ hge hge').symm

theorem lvGlue_HS : lvGlueOK 7 9 14 lvX7 lvX9 lvC_mergeHS.internal 3 4 7 8
    [0, 2, 1, 5, 6, 10, 13, 7, 11, 12, 9, 8, 3, 4] := by
  unfold lvGlueOK
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_⟩ <;> decide +kernel

theorem lvGlue_SH : lvGlueOK 9 7 14 lvX9 lvX7 lvC_mergeSH.internal 7 8 3 4
