        · obtain ⟨-, -, -, -, -, -, ⟨-, d2, -⟩, -⟩ := hP m' (by omega)
          exact absurd (a1.symm.trans (hk m' (by omega))) d2
        · obtain ⟨-, -, -, -, -, -, ⟨-, -, d3, -⟩, -⟩ := hP m' (by omega)
          exact absurd (a1.symm.trans (hk m' (by omega))) d3
