theorem ep_cut5_classify {W E : Type*} [Fintype E] (α β : E → W) (L X : Finset W)
    (h : EpCubicD α β L) (h4 : EpCyc4 α β L) (h6 : 6 ≤ L.card) (hXL : X ⊆ L)
    (h5 : (epCut α β X).card = 5) (h7 : 7 ≤ X.card) (hnb : ¬EpBurl α β X) :
    (X.card = 7 ∧ ∃ φ, EpIsoI α β X 7 lvX7 φ) ∨ (X.card = 9 ∧ ∃ φ, EpIsoI α β X 9 lvX9 φ) := by
  by_cases h11 : 11 ≤ X.card
