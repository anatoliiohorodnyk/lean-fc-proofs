/-- The pattern of a labelled chain is valid. -/
lemma ep_lab_ext {W E : Type*} [Fintype E] (α β : E → W) (n : ℕ) (N : ℕ → Finset W)
    (code : ℕ → ℕ) (v : ℕ → ℕ → W) (cut : ℕ → ℕ → E) (rg : ℕ → E)
    (hlab : EpLab α β n N code v cut rg) : ∀ (d a : ℕ), a + d = n →
    lpExt (if a = 0 then none else some (code (a - 1))) (lpSeg code a n) := by
  obtain ⟨-, -, -, hnode⟩ := hlab
  intro d
  induction d with
  | zero =>
    intro a ha
    have : lpSeg code a n = [] := by simp [lpSeg, show n - a = 0 by omega]
    rw [this]
    trivial
  | succ d ih =>
    intro a ha
    rw [lpSeg_cons code a n (by omega)]
    refine ⟨?_, ?_⟩
    · by_cases ha0 : a = 0
      · rw [if_pos ha0]
        have hc : code a < 8 := by
          rcases hnode a (by omega) with ⟨c1, -⟩ | ⟨c1, -⟩ | ⟨c1, c2, -⟩ <;> omega
        simp only [lpNext, List.mem_cons, List.not_mem_nil, or_false]
        omega
      · rw [if_neg ha0]
        have he : a = a - 1 + 1 := by omega
        simp only [lpNext]
        by_cases hk : code (a - 1) / 3 = 1
        · rw [if_pos hk]
          have hs : (epCut α β (N a)).card = 2 := by
            rcases hnode (a - 1) (by omega) with ⟨c1, -⟩ | ⟨-, -, c3, -⟩ | ⟨c1, -⟩
            · omega
            · rw [he]; exact c3
            · omega
          rcases hnode a (by omega) with ⟨-, c2, -⟩ | ⟨-, c2, -⟩ | ⟨c1, c2, -⟩
          · omega
          · omega
          · simp only [List.mem_cons, List.not_mem_nil, or_false]; omega
        · rw [if_neg hk]
          have hs : (epCut α β (N a)).card = 3 := by
            rcases hnode (a - 1) (by omega) with ⟨-, -, c3, -⟩ | ⟨c1, -⟩ | ⟨-, -, -, c3, -⟩
            · rw [he]; exact c3
            · omega
            · rw [he]; exact c3
          rcases hnode a (by omega) with ⟨c1, -⟩ | ⟨c1, -⟩ | ⟨-, -, c2, -⟩
          · simp only [List.mem_cons, List.not_mem_nil, or_false]; omega
          · simp only [List.mem_cons, List.not_mem_nil, or_false]; omega
          · omega
    · have := ih (a + 1) (by omega)
      rw [if_neg (by omega), show a + 1 - 1 = a by omega] at this
      exact this

/-- The facts about the model graphs of all patterns of a tree of certificates. -/
def LpTree.allTok : LpTree → Bool
  | .leaf => true
  | .node l _ c r => l.allTok && (lpTokOK c.pat && !c.pat.isEmpty) && r.allTok

lemma LpTree.allTok_mem : ∀ t : LpTree, t.allTok = true → ∀ c ∈ t.certs,
    lpTokOK c.pat = true ∧ c.pat ≠ [] := by
  intro t
  induction t with
  | leaf => intro _ c hc; simp [LpTree.certs] at hc
  | node l k c₀ r ihl ihr =>
    intro h c hc
    simp only [LpTree.allTok, Bool.and_eq_true] at h
    simp only [LpTree.certs, List.mem_append, List.mem_cons] at hc
    rcases hc with hc | rfl | hc
    · exact ihl h.1.1 c hc
    · refine ⟨h.1.2.1, ?_⟩
      intro hnil
      have := h.1.2.2
      rw [hnil] at this
      simp at this
    · exact ihr h.2 c hc

lemma LpTree.allTok_node (l r : LpTree) (k : ℕ) (c : LpCertP) (hl : l.allTok = true)
    (hc : (lpTokOK c.pat && !c.pat.isEmpty) = true) (hr : r.allTok = true) :
    (LpTree.node l k c r).allTok = true := by
  simp only [LpTree.allTok, Bool.and_eq_true]
  exact ⟨⟨hl, Bool.and_eq_true _ _ ▸ hc⟩, hr⟩

