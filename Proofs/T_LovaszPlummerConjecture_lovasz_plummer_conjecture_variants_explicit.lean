open Classical in
/-- **The house.** `T ∪ {p, q}` laid out along `X7` with `p`, `q` at `3`, `4`: the five
vertices of `T`, the neighbourhoods of the two marks `φ 0`, `φ 2`, and the attachment of
`p`, `q`. -/
theorem ep_house_data {W E : Type*} [Fintype E] (α β : E → W) (L T : Finset W) (p q : W)
    (h : EpCubicD α β L) (h4 : EpCyc4 α β L) (h6 : 6 ≤ L.card) (hSL : T ∪ {p, q} ⊆ L)
    (hpT : p ∉ T) (hqT : q ∉ T) (φ : ℕ → W) (hiso : EpIsoI α β (T ∪ {p, q}) 7 lvX7 φ)
    (e3 : φ 3 = p) (e4 : φ 4 = q) :
    (∀ k, k < 7 → k ≠ 3 → k ≠ 4 → φ k ∈ T) ∧
    (∀ z, EpAdj α β (φ 0) z ↔ z = p ∨ z = φ 1 ∨ z = φ 5) ∧
    (∀ z, EpAdj α β (φ 2) z ↔ z = q ∨ z = φ 1 ∨ z = φ 6) ∧
    EpAdj α β (φ 5) (φ 6) ∧
    (∀ z ∈ T, EpAdj α β p z → z = φ 0) ∧ (∀ z ∈ T, EpAdj α β q z → z = φ 2) := by
  have hiso' := hiso
  obtain ⟨hφS, hφinj, hφsurj, hadj⟩ := hiso'
  have hP : ∀ w, w ∈ ({p, q} : Finset W) ↔ w = p ∨ w = q := by
    intro w; simp only [Finset.mem_insert, Finset.mem_singleton]
  have hT : ∀ k, k < 7 → k ≠ 3 → k ≠ 4 → φ k ∈ T := by
    intro k hk h3 h4'
    rcases Finset.mem_union.mp (hφS k hk) with h' | h'
    · exact h'
    · rcases (hP _).mp h' with e | e
      · exact absurd (hφinj k 3 hk (by omega) (e.trans e3.symm)) h3
      · exact absurd (hφinj k 4 hk (by omega) (e.trans e4.symm)) h4'
  refine ⟨hT, fun z => ⟨fun hz => ?_, ?_⟩, fun z => ⟨fun hz => ?_, ?_⟩,
    (hadj 5 6 (by omega) (by omega)).mpr (by decide), fun z hz hadjz => ?_,
    fun z hz hadjz => ?_⟩
  · obtain ⟨j, hj, e, hs⟩ := ep_nbrs_model α β L _ h h4 h6 hSL 7 lvX7 φ hiso 0 (by omega)
      lvDeg7.1 z hz
    rcases lvNb7_0 ⟨j, hj⟩ hs with e' | e' | e'
    · have e'' : j = 3 := e'
      exact Or.inl (by rw [e, e'', e3])
    · have e'' : j = 1 := e'
      exact Or.inr (Or.inl (by rw [e, e'']))
    · have e'' : j = 5 := e'
      exact Or.inr (Or.inr (by rw [e, e'']))
  · rintro (e | e | e)
    · rw [e, ← e3]; exact (hadj 0 3 (by omega) (by omega)).mpr (by decide)
    · rw [e]; exact (hadj 0 1 (by omega) (by omega)).mpr (by decide)
    · rw [e]; exact (hadj 0 5 (by omega) (by omega)).mpr (by decide)
  · obtain ⟨j, hj, e, hs⟩ := ep_nbrs_model α β L _ h h4 h6 hSL 7 lvX7 φ hiso 2 (by omega)
      lvDeg7.2 z hz
    rcases lvNb7_2 ⟨j, hj⟩ hs with e' | e' | e'
    · have e'' : j = 4 := e'
      exact Or.inl (by rw [e, e'', e4])
    · have e'' : j = 1 := e'
      exact Or.inr (Or.inl (by rw [e, e'']))
    · have e'' : j = 6 := e'
      exact Or.inr (Or.inr (by rw [e, e'']))
  · rintro (e | e | e)
    · rw [e, ← e4]; exact (hadj 2 4 (by omega) (by omega)).mpr (by decide)
    · rw [e]; exact (hadj 2 1 (by omega) (by omega)).mpr (by decide)
    · rw [e]; exact (hadj 2 6 (by omega) (by omega)).mpr (by decide)
  · obtain ⟨j, hj, e⟩ := hφsurj z (Finset.mem_union_left _ hz)
    have hs := (hadj 3 j (by omega) hj).mp (by rw [e3, e]; exact hadjz)
    rcases lvNb7_3 ⟨j, hj⟩ hs with e' | e'
    · have e'' : j = 0 := e'
      rw [← e, e'']
    · have e'' : j = 4 := e'
      exfalso
      rw [e'', e4] at e
      exact hqT (by rw [e]; exact hz)
  · obtain ⟨j, hj, e⟩ := hφsurj z (Finset.mem_union_left _ hz)
    have hs := (hadj 4 j (by omega) hj).mp (by rw [e4, e]; exact hadjz)
    rcases lvNb7_4 ⟨j, hj⟩ hs with e' | e'
    · have e'' : j = 2 := e'
      rw [← e, e'']
    · have e'' : j = 3 := e'
      exfalso
      rw [e'', e3] at e
      exact hpT (by rw [e]; exact hz)

