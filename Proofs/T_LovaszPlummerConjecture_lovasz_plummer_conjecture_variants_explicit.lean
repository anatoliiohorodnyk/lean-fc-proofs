/-- **Theorem D, the induction step.** If every non-burl with a cut of size five and two
vertices fewer is laid out along `(n, I)`, then a non-burl `X` with a cut of size five is laid
out along `lvExt I n p r` for two non-adjacent vertices `p < r` of the model, each with at most
two neighbours in the model. (`ep_cut5_reduce`, `ep_isoI_ext`; `p < r` by the symmetry
`u ↔ a`.) -/
theorem ep_cut5_step {W E : Type*} [Fintype E] (α β : E → W) (L X : Finset W)
    (h : EpCubicD α β L) (h4 : EpCyc4 α β L) (h6 : 6 ≤ L.card) (hXL : X ⊆ L)
    (h5 : (epCut α β X).card = 5) (hX5 : 5 ≤ X.card) (hnb : ¬EpBurl α β X)
    (n : ℕ) (I : List (ℕ × ℕ)) (hI : ∀ e ∈ I, e.1 < n ∧ e.2 < n)
    (hprev : ∀ X' : Finset W, X' ⊆ L → (epCut α β X').card = 5 → X'.card + 2 = X.card →
      ¬EpBurl α β X' → ∃ φ, EpIsoI α β X' n I φ) :
    ∃ (p r : ℕ) (φ : ℕ → W), p < r ∧ r < n ∧ (p, r) ∉ I ∧ (r, p) ∉ I ∧
      (lvNbrs I n p).card ≤ 2 ∧ (lvNbrs I n r).card ≤ 2 ∧
      EpIsoI α β X (n + 2) (lvExt I n p r) φ := by
  obtain ⟨u, a, y, q, hu, ha, hua, hy, hq, hyq, hadj, huy, haq, hnyq, hNu, hNa, hcut', hnb'⟩ :=
    ep_cut5_reduce α β L X h h4 hXL h5 hX5 hnb
  have hsub : X \ {u, a} ⊆ X := Finset.sdiff_subset
  have hcard := ep_card_sdiff_pair X u a hu ha hua
  obtain ⟨φ, hiso⟩ := hprev _ (hsub.trans hXL) hcut' hcard hnb'
  have hiso' := hiso
  obtain ⟨hφX, hφinj, hφsurj, hA⟩ := hiso
  obtain ⟨p, hp, hpy⟩ := hφsurj y hy
  obtain ⟨r, hr, hrq⟩ := hφsurj q hq
  have hpr : p ≠ r := fun e => hyq (by rw [← hpy, ← hrq, e])
  have hnI : (p, r) ∉ I ∧ (r, p) ∉ I := by
    have hn : ¬((p, r) ∈ I ∨ (r, p) ∈ I) := fun hh =>
      hnyq (by rw [← hpy, ← hrq]; exact (hA p r hp hr).mpr hh)
    exact ⟨fun h' => hn (Or.inl h'), fun h' => hn (Or.inr h')⟩
  have hdeg : ∀ (v w : W) (k : ℕ), k < n → φ k = w → v ∉ X \ {u, a} → EpAdj α β v w →
      (lvNbrs I n k).card ≤ 2 := by
    intro v w k hk hkw hv ⟨g, hg⟩
    have hc := ep_model_bdry_card α β L (X \ {u, a}) h h4 h6 (hsub.trans hXL) n I φ hiso' k hk
    have hwX' : φ k ∈ X \ {u, a} := hφX k hk
    have hne : v ≠ φ k := fun e => hv (by rw [e]; exact hwX')
    rw [← hkw] at hg
    have hg' : (α g = φ k ∧ β g = v) ∨ (α g = v ∧ β g = φ k) := hg.symm
    have hcr := (ep_cross_both_of_ends α β (φ k) v g hne hg').1
    have hcx := (ep_cross_set_of_ends α β _ (φ k) v g hwX' hg').mpr hv
    have hpos : 0 < ((epCut α β {φ k}).filter (epCross α β (X \ {u, a}))).card :=
      Finset.card_pos.mpr ⟨g, Finset.mem_filter.mpr ⟨(mem_epCut _ _ _ _).mpr hcr, hcx⟩⟩
    omega
  have hu0 : u ∉ X \ {u, a} := by simp
  have ha0 : a ∉ X \ {u, a} := by simp
  have hdp := hdeg u y p hp hpy hu0 huy
  have hdr := hdeg a q r hr hrq ha0 haq
  rcases lt_or_gt_of_ne hpr with hlt | hlt
  · refine ⟨p, r, fun k => if k = n then u else if k = n + 1 then a else φ k, hlt, hr,
      hnI.1, hnI.2, hdp, hdr, ?_⟩
    refine ep_isoI_ext α β X n I φ _ u a p r hu ha hua hp hr hI hiso' hadj
      (by rw [hpy]; exact huy) (by rw [hrq]; exact haq) (by rw [hpy]; exact hNu)
      (by rw [hrq]; exact hNa) (fun k hk => ?_) ?_ ?_
    · show (if k = n then u else if k = n + 1 then a else φ k) = φ k
      rw [if_neg (by omega), if_neg (by omega)]
    · show (if n = n then u else if n = n + 1 then a else φ n) = u
      rw [if_pos rfl]
    · show (if n + 1 = n then u else if n + 1 = n + 1 then a else φ (n + 1)) = a
      rw [if_neg (by omega), if_pos rfl]
  · have hiso'' : EpIsoI α β (X \ {a, u}) n I φ := by
      rw [Finset.pair_comm]; exact hiso'
    refine ⟨r, p, fun k => if k = n then a else if k = n + 1 then u else φ k, hlt, hp,
      hnI.2, hnI.1, hdr, hdp, ?_⟩
    refine ep_isoI_ext α β X n I φ _ a u r p ha hu (Ne.symm hua) hr hp hI hiso''
      ((ep_adj_comm α β u a).mp hadj) (by rw [hrq]; exact haq) (by rw [hpy]; exact huy)
      (by rw [hrq]; exact hNa) (by rw [hpy]; exact hNu) (fun k hk => ?_) ?_ ?_
    · show (if k = n then a else if k = n + 1 then u else φ k) = φ k
      rw [if_neg (by omega), if_neg (by omega)]
    · show (if n = n then a else if n = n + 1 then u else φ n) = a
      rw [if_pos rfl]
    · show (if n + 1 = n then a else if n + 1 = n + 1 then u else φ (n + 1)) = u
      rw [if_neg (by omega), if_pos rfl]

