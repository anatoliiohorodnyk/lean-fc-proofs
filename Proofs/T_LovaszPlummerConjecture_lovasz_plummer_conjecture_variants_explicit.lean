    have hd := hdisj Z hZ Z' hZ' hne
    by_cases hZe : Z.Nonempty
    · obtain ⟨w, hw⟩ := hZe
      exact Finset.disjoint_left.mp hd (hsubf Z hw) (hff ▸ hsubf Z hw)
