/-- **Edge count.** For `t` pairwise disjoint 3-sets with cuts of size three in a cubic
multigraph on `N` vertices, `12 t ≤ 2 |TT| + 3 N`. -/
theorem ep_pack_edges {W E : Type*} [Fintype E] (α β : E → W) (L : Finset W)
    (h : EpCubicD α β L) (𝒯 : Finset (Finset W)) (hTL : ∀ T ∈ 𝒯, T ⊆ L)
    (hdisj : ∀ T ∈ 𝒯, ∀ T' ∈ 𝒯, T ≠ T' → Disjoint T T')
    (hT3 : ∀ T ∈ 𝒯, T.card = 3) (hcut3 : ∀ T ∈ 𝒯, (epCut α β T).card = 3) :
    12 * 𝒯.card ≤ 2 * (epTT α β 𝒯).card + 3 * L.card := by
  have hsame : ∀ T ∈ 𝒯, ∀ T' ∈ 𝒯, ∀ w, w ∈ T → w ∈ T' → T = T' := by
    intro T hT T' hT' w hw hw'
    by_contra hne
    exact Finset.disjoint_left.mp (hdisj T hT T' hT' hne) hw hw'
  obtain ⟨U, hU⟩ : ∃ U : Finset W, U = 𝒯.biUnion (fun T => T) := ⟨_, rfl⟩
  have hUmem : ∀ w, w ∈ U ↔ ∃ T ∈ 𝒯, w ∈ T := by
    intro w; rw [hU]; exact Finset.mem_biUnion
  have hUL : U ⊆ L := by
    intro w hw
    obtain ⟨T, hT, hwT⟩ := (hUmem w).mp hw
    exact hTL T hT hwT
  have hUcard : U.card = 3 * 𝒯.card := by
    have hc := Finset.card_biUnion (s := 𝒯) (t := fun T => T)
      (fun T hT T' hT' hne => hdisj T hT T' hT' hne)
    rw [hU, hc, Finset.sum_congr rfl (fun T hT => hT3 T hT), Finset.sum_const, smul_eq_mul,
      mul_comm]
  obtain ⟨P, hP⟩ : ∃ P : Finset E, P = (L \ U).biUnion (fun c => epCut α β {c}) := ⟨_, rfl⟩
  have hPcard : P.card ≤ 3 * (L \ U).card := by
    rw [hP]
    refine le_trans Finset.card_biUnion_le ?_
    rw [Finset.sum_congr rfl (fun c hc => h.2 c (Finset.mem_sdiff.mp hc).1), Finset.sum_const,
      smul_eq_mul, mul_comm]
  have hLU : (L \ U).card + U.card = L.card := Finset.card_sdiff_add_card_eq_card hUL
  -- double counting of the pairs (member, leaving edge)
  have hsum : ∑ T ∈ 𝒯, (epCut α β T).card =
      ∑ e : E, (𝒯.filter (fun T => epCross α β T e)).card := by
    have h1 : ∀ T ∈ 𝒯, (epCut α β T).card =
        ∑ e : E, (if epCross α β T e then 1 else 0) := by
      intro T _
      unfold epCut
      rw [Finset.card_filter]
    have h2 : ∀ e : E, (𝒯.filter (fun T => epCross α β T e)).card =
        ∑ T ∈ 𝒯, (if epCross α β T e then 1 else 0) := by
      intro e
      rw [Finset.card_filter]
    rw [Finset.sum_congr rfl h1, Finset.sum_comm]
    exact Finset.sum_congr rfl (fun e _ => (h2 e).symm)
  have hper : ∀ e : E, (𝒯.filter (fun T => epCross α β T e)).card ≤
      2 * (if e ∈ epTT α β 𝒯 then 1 else 0) + (if e ∈ P then 1 else 0) := by
    intro e
    by_cases heTT : e ∈ epTT α β 𝒯
    · rw [if_pos heTT]
      have hsub : 𝒯.filter (fun T => epCross α β T e) ⊆
          𝒯.filter (fun T => α e ∈ T) ∪ 𝒯.filter (fun T => β e ∈ T) := by
        intro T hT
        obtain ⟨hT1, hT2⟩ := Finset.mem_filter.mp hT
        rw [Finset.mem_union, Finset.mem_filter, Finset.mem_filter]
        rcases hT2 with ⟨h1, -⟩ | ⟨-, h2⟩
        · exact Or.inl ⟨hT1, h1⟩
        · exact Or.inr ⟨hT1, h2⟩
      have ha : (𝒯.filter (fun T => α e ∈ T)).card ≤ 1 := by
        rw [Finset.card_le_one]
        intro T hT T' hT'
        obtain ⟨a1, a2⟩ := Finset.mem_filter.mp hT
        obtain ⟨b1, b2⟩ := Finset.mem_filter.mp hT'
        exact hsame T a1 T' b1 _ a2 b2
      have hb : (𝒯.filter (fun T => β e ∈ T)).card ≤ 1 := by
        rw [Finset.card_le_one]
        intro T hT T' hT'
        obtain ⟨a1, a2⟩ := Finset.mem_filter.mp hT
        obtain ⟨b1, b2⟩ := Finset.mem_filter.mp hT'
        exact hsame T a1 T' b1 _ a2 b2
      have := Finset.card_le_card hsub
      have := Finset.card_union_le (𝒯.filter (fun T => α e ∈ T)) (𝒯.filter (fun T => β e ∈ T))
      omega
    · rw [if_neg heTT]
      have hnoTT : ∀ T ∈ 𝒯, ∀ T' ∈ 𝒯, α e ∈ T → β e ∈ T' → T = T' := by
        intro T hT T' hT' ha hb
        by_contra hne
        exact heTT ((mem_epTT α β 𝒯 e).mpr ⟨T, hT, T', hT', hne, ha, hb⟩)
      by_cases hem : 𝒯.filter (fun T => epCross α β T e) = ∅
      · rw [hem]; simp
      · obtain ⟨T, hT⟩ := Finset.nonempty_iff_ne_empty.mpr hem
        obtain ⟨hT1, hT2⟩ := Finset.mem_filter.mp hT
        have hlive := epD_live_of_cross h T e hT2
