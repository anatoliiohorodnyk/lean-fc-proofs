        have ⟨_, _, _, _, _, _, c1, c2, c3⟩ := ht
        rcases htri x y z e1 e2 e3 ht with h' | h' | h'
        · exact ⟨e1, h', x, hxT, (c1 x).mpr (Or.inl rfl)⟩
        · exact ⟨e2, h', y, hyT, (c2 y).mpr (Or.inl rfl)⟩
        · exact ⟨e3, h', z, hzT, (c3 z).mpr (Or.inl rfl)⟩
