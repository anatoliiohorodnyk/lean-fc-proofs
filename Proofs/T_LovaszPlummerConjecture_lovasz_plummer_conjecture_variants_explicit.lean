open Classical in
/-- **A node between a cut of size two and a cut of size three.** Its vertex `u` has one edge
in the upper cut and two in the lower cut, and one edge lies in both cuts. -/
theorem ep_b23_node {W E : Type*} [Fintype E] (α β : E → W) (L : Finset W)
    (h : EpCubicD α β L) (N C : Finset W) (u : W) (hu : u ∈ L) (hCN : C ⊆ N)
    (hNC : N \ C = {u}) (hN : (epCut α β N).card = 2) (hC : (epCut α β C).card = 3) :
    ∃ up d1 d2 ps : E, d1 ≠ d2 ∧ up ≠ d1 ∧ up ≠ d2 ∧ ps ≠ up ∧ ps ≠ d1 ∧ ps ≠ d2 ∧
      (∀ g, epCross α β {u} g ↔ g = up ∨ g = d1 ∨ g = d2) ∧
      (∀ g, epCross α β N g ↔ g = up ∨ g = ps) ∧
      (∀ g, epCross α β C g ↔ g = d1 ∨ g = d2 ∨ g = ps) := by
  obtain ⟨hcr, hcard⟩ := ep_split_vertex α β L h N C u hu hCN hNC
  have hI : (epCut α β {u} ∩ epCut α β C).card = 2 := by omega
  obtain ⟨d1, d2, hd12, hd⟩ := Finset.card_eq_two.mp hI
  have hIm : ∀ g, (g ∈ epCut α β {u} ∧ g ∈ epCut α β C) ↔ g = d1 ∨ g = d2 := by
    intro g
    rw [← Finset.mem_inter, hd, Finset.mem_insert, Finset.mem_singleton]
  have hd1 := (hIm d1).mpr (Or.inl rfl)
  have hd2 := (hIm d2).mpr (Or.inr rfl)
  have hsubu : ({d1, d2} : Finset E) ⊆ epCut α β {u} := by
    intro g hg
    rcases Finset.mem_insert.mp hg with rfl | hg
    · exact hd1.1
    · rw [Finset.mem_singleton.mp hg]; exact hd2.1
  have hsubC : ({d1, d2} : Finset E) ⊆ epCut α β C := by
    intro g hg
    rcases Finset.mem_insert.mp hg with rfl | hg
    · exact hd1.2
    · rw [Finset.mem_singleton.mp hg]; exact hd2.2
  obtain ⟨up, hup⟩ := Finset.card_eq_one.mp (by
    rw [Finset.card_sdiff_of_subset hsubu, h.2 u hu, Finset.card_pair hd12] :
      (epCut α β {u} \ {d1, d2}).card = 1)
  obtain ⟨ps, hps⟩ := Finset.card_eq_one.mp (by
    rw [Finset.card_sdiff_of_subset hsubC, hC, Finset.card_pair hd12] :
      (epCut α β C \ {d1, d2}).card = 1)
  have hum : ∀ g, g ∈ epCut α β {u} ↔ g = up ∨ g = d1 ∨ g = d2 := by
    intro g
    constructor
    · intro hg
      by_cases hgd : g ∈ ({d1, d2} : Finset E)
      · rw [Finset.mem_insert, Finset.mem_singleton] at hgd
        exact Or.inr hgd
      · have : g ∈ epCut α β {u} \ {d1, d2} := Finset.mem_sdiff.mpr ⟨hg, hgd⟩
        rw [hup] at this
        exact Or.inl (Finset.mem_singleton.mp this)
    · rintro (rfl | rfl | rfl)
      · have : g ∈ epCut α β {u} \ {d1, d2} := by rw [hup]; exact Finset.mem_singleton_self _
        exact (Finset.mem_sdiff.mp this).1
      · exact hd1.1
      · exact hd2.1
  have hCm : ∀ g, g ∈ epCut α β C ↔ g = d1 ∨ g = d2 ∨ g = ps := by
    intro g
    constructor
    · intro hg
      by_cases hgd : g ∈ ({d1, d2} : Finset E)
      · rw [Finset.mem_insert, Finset.mem_singleton] at hgd
        rcases hgd with h' | h'
        · exact Or.inl h'
        · exact Or.inr (Or.inl h')
      · have : g ∈ epCut α β C \ {d1, d2} := Finset.mem_sdiff.mpr ⟨hg, hgd⟩
        rw [hps] at this
        exact Or.inr (Or.inr (Finset.mem_singleton.mp this))
    · rintro (rfl | rfl | rfl)
      · exact hd1.2
      · exact hd2.2
      · have : g ∈ epCut α β C \ {d1, d2} := by rw [hps]; exact Finset.mem_singleton_self _
        exact (Finset.mem_sdiff.mp this).1
  have hupn : up ∉ ({d1, d2} : Finset E) := by
    have : up ∈ epCut α β {u} \ {d1, d2} := by rw [hup]; exact Finset.mem_singleton_self _
    exact (Finset.mem_sdiff.mp this).2
  have hpsn : ps ∉ ({d1, d2} : Finset E) := by
    have : ps ∈ epCut α β C \ {d1, d2} := by rw [hps]; exact Finset.mem_singleton_self _
    exact (Finset.mem_sdiff.mp this).2
  rw [Finset.mem_insert, Finset.mem_singleton] at hupn hpsn
  have hupd1 : up ≠ d1 := fun h' => hupn (Or.inl h')
  have hupd2 : up ≠ d2 := fun h' => hupn (Or.inr h')
  have hpsd1 : ps ≠ d1 := fun h' => hpsn (Or.inl h')
  have hpsd2 : ps ≠ d2 := fun h' => hpsn (Or.inr h')
  have hupC : up ∉ epCut α β C := fun h' =>
    hupn ((hIm up).mp ⟨(hum up).mpr (Or.inl rfl), h'⟩)
  have hpsu : ps ∉ epCut α β {u} := fun h' =>
    hpsn ((hIm ps).mp ⟨h', (hCm ps).mpr (Or.inr (Or.inr rfl))⟩)
  have hpsup : ps ≠ up := fun h' => hpsu (h' ▸ (hum up).mpr (Or.inl rfl))
  refine ⟨up, d1, d2, ps, hd12, hupd1, hupd2, hpsup, hpsd1, hpsd2, ?_, ?_, ?_⟩
  · intro g; rw [← mem_epCut]; exact hum g
  · intro g
    rw [hcr g, ← mem_epCut, ← mem_epCut]
    constructor
    · intro hne
      by_cases hgu : g ∈ epCut α β {u}
      · by_cases hgC : g ∈ epCut α β C
        · exact absurd ⟨fun _ => hgC, fun _ => hgu⟩ hne
        · rcases (hum g).mp hgu with rfl | rfl | rfl
          · exact Or.inl rfl
          · exact absurd hd1.2 hgC
          · exact absurd hd2.2 hgC
      · by_cases hgC : g ∈ epCut α β C
        · rcases (hCm g).mp hgC with rfl | rfl | rfl
          · exact absurd hd1.1 hgu
          · exact absurd hd2.1 hgu
          · exact Or.inr rfl
        · exact absurd ⟨fun h' => absurd h' hgu, fun h' => absurd h' hgC⟩ hne
    · rintro (rfl | rfl) hiff
      · exact hupC (hiff.mp ((hum g).mpr (Or.inl rfl)))
      · exact hpsu (hiff.mpr ((hCm g).mpr (Or.inr (Or.inr rfl))))
  · intro g; rw [← mem_epCut]; exact hCm g

open Classical in
/-- No node lies between two cuts of size two. -/
lemma ep_no_22_node {W E : Type*} [Fintype E] (α β : E → W) (L : Finset W)
    (h : EpCubicD α β L) (N C : Finset W) (u : W) (hu : u ∈ L) (hCN : C ⊆ N)
    (hNC : N \ C = {u}) (hN : (epCut α β N).card = 2) (hC : (epCut α β C).card = 2) : False := by
  obtain ⟨-, hcard⟩ := ep_split_vertex α β L h N C u hu hCN hNC
  omega

/-! ### Labelled chains and their token layouts -/

lemma lpOther_facts : ∀ p, p < 3 → lpOther p 0 < 3 ∧ lpOther p 1 < 3 ∧ lpOther p 0 ≠ p ∧
    lpOther p 1 ≠ p ∧ lpOther p 0 ≠ lpOther p 1 ∧
    ∀ j, j < 3 → j ≠ p → j = lpOther p 0 ∨ j = lpOther p 1 := by
  intro p hp
  interval_cases p <;> refine ⟨by decide, by decide, by decide, by decide, by decide, ?_⟩ <;>
    intro j hj hjp <;> interval_cases j <;> first | exact absurd rfl hjp | decide

open Classical in
/-- A chain `N 0 ⊇ N 1 ⊇ … ⊇ N n` with labelled cuts: `cut m j` (`j` below the size of the cut
of `N m`) enumerates the cut of `N m`; the node `m` has the shape given by its code. -/
def EpLab {W E : Type*} [Fintype E] (α β : E → W) (n : ℕ) (N : ℕ → Finset W) (code : ℕ → ℕ)
    (v : ℕ → ℕ → W) (cut : ℕ → ℕ → E) (rg : ℕ → E) : Prop :=
  (∀ m, m ≤ n →
    (∀ j j', j < (epCut α β (N m)).card → j' < (epCut α β (N m)).card → cut m j = cut m j' →
      j = j') ∧
    ∀ g, epCross α β (N m) g ↔ ∃ j, j < (epCut α β (N m)).card ∧ cut m j = g) ∧
  (∀ m, m < n → N (m + 1) ⊆ N m) ∧
  (∀ g, α g ∈ N 0 → α g ≠ β g) ∧
  (∀ m, m < n →
    (code m / 3 = 0 ∧ (epCut α β (N m)).card = 3 ∧ (epCut α β (N (m + 1))).card = 3 ∧
      N m \ N (m + 1) = {v m 0, v m 1} ∧ v m 0 ≠ v m 1 ∧
      cut (m + 1) (code m % 3) = cut m (code m % 3) ∧
      (∀ i, i < 2 → ∀ g, epCross α β {v m i} g ↔ g = cut m (lpOther (code m % 3) i) ∨
        g = cut (m + 1) (lpOther (code m % 3) i) ∨ g = rg m) ∧
      (∀ i, i < 2 → ∀ j, j < 3 → cut (m + 1) (lpOther (code m % 3) i) ≠ cut m j) ∧
      (α (rg m) ∈ N m \ N (m + 1) ∧ β (rg m) ∈ N m \ N (m + 1))) ∨
    (code m / 3 = 1 ∧ (epCut α β (N m)).card = 3 ∧ (epCut α β (N (m + 1))).card = 2 ∧
      N m \ N (m + 1) = {v m 0} ∧ cut (m + 1) 0 = cut m (code m % 3) ∧
      (∀ g, epCross α β {v m 0} g ↔ g = cut m (lpOther (code m % 3) 0) ∨
        g = cut m (lpOther (code m % 3) 1) ∨ g = cut (m + 1) 1) ∧
      (∀ j, j < 3 → cut (m + 1) 1 ≠ cut m j)) ∨
    (code m / 3 = 2 ∧ code m % 3 < 2 ∧ (epCut α β (N m)).card = 2 ∧
      (epCut α β (N (m + 1))).card = 3 ∧ N m \ N (m + 1) = {v m 0} ∧
      cut (m + 1) 0 = cut m (code m % 3) ∧
      (∀ g, epCross α β {v m 0} g ↔ g = cut m (1 - code m % 3) ∨ g = cut (m + 1) 1 ∨
        g = cut (m + 1) 2) ∧
      (∀ j, j < 2 → cut (m + 1) 1 ≠ cut m j ∧ cut (m + 1) 2 ≠ cut m j)))

/-- The pattern of the segment `[a, b)` of a labelled chain. -/
def lpSeg (code : ℕ → ℕ) (a b : ℕ) : List ℕ := (List.range (b - a)).map (fun m => code (a + m))

lemma lpSeg_length (code : ℕ → ℕ) (a b : ℕ) : (lpSeg code a b).length = b - a := by
  simp [lpSeg]

lemma lpSeg_getD (code : ℕ → ℕ) (a b m : ℕ) (hm : m < b - a) :
    (lpSeg code a b).getD m 0 = code (a + m) := by
  have h1 : m < (lpSeg code a b).length := by rw [lpSeg_length]; exact hm
  rw [List.getD_eq_getElem _ _ h1]
  simp [lpSeg]

lemma lpSeg_headD (code : ℕ → ℕ) (a b : ℕ) (hab : a < b) :
    (lpSeg code a b).headD 0 = code a := by
  obtain ⟨k, hk⟩ : ∃ k, b - a = k + 1 := ⟨b - a - 1, by omega⟩
  simp [lpSeg, hk, List.range_succ_eq_map]


set_option maxHeartbeats 6400000 in
open Classical in
/-- **Every segment of a labelled chain is laid out along its pattern.** -/
theorem ep_lab_tok {W E : Type*} [Fintype E] (α β : E → W) (n : ℕ) (N : ℕ → Finset W)
    (code : ℕ → ℕ) (v : ℕ → ℕ → W) (cut : ℕ → ℕ → E) (rg : ℕ → E)
    (hlab : EpLab α β n N code v cut rg) (a b : ℕ) (hab : a < b) (hbn : b ≤ n) :
    EpTok α β (N a \ N b) (lpSeg code a b) (fun m i => v (a + m) i)
      (fun m j => if j = 3 then rg (a + m) else cut (a + m) j) := by
  obtain ⟨hInv, hnest, hloop, hnode⟩ := hlab
  have hlen := lpSeg_length code a b
  have hget := lpSeg_getD code a b
  -- nestedness
  have hmono : ∀ d i, i + d ≤ n → N (i + d) ⊆ N i := by
    intro d
    induction d with
    | zero => intro i _; exact Finset.Subset.refl _
    | succ d ih =>
      intro i hi
      have h1 := hnest (i + d) (by omega)
      exact h1.trans (ih i (by omega))
  have hmono' : ∀ i k, i ≤ k → k ≤ n → N k ⊆ N i := by
    intro i k hik hk
    have := hmono (k - i) i (by omega)
    rwa [show i + (k - i) = k by omega] at this
  -- an edge in two cuts is in every cut between
  have hX : ∀ p l q e, p ≤ l → l ≤ q → q ≤ n → epCross α β (N p) e → epCross α β (N q) e →
      epCross α β (N l) e := by
    intro p l q e hpl hlq hq hp hq'
    have s1 := hmono' p l hpl (by omega)
    have s2 := hmono' l q hlq hq
    have s3 := hmono' p q (by omega) hq
    unfold epCross at hp hq' ⊢
    rcases hp with ⟨x1, x2⟩ | ⟨x1, x2⟩ <;> rcases hq' with ⟨y1, y2⟩ | ⟨y1, y2⟩
    · exact Or.inl ⟨s2 y1, fun h' => x2 (s1 h')⟩
    · exact absurd (s3 y2) x2
    · exact absurd (s3 y1) x1
    · exact Or.inr ⟨fun h' => x1 (s1 h'), s2 y2⟩
  -- sizes of the cuts along the segment
  have hW : ∀ m, m ≤ b - a → lpWid (lpSeg code a b) m = (epCut α β (N (a + m))).card := by
    intro m hm
    unfold lpWid
    by_cases hm0 : m = 0
    · subst hm0
      rw [if_pos rfl]
      unfold lpW0
      rw [lpSeg_headD code a b hab]
      rcases hnode a (by omega) with ⟨c1, c2, -⟩ | ⟨c1, c2, -⟩ | ⟨c1, -, c2, -⟩
      · rw [if_neg (by omega)]; exact c2.symm
      · rw [if_neg (by omega)]; exact c2.symm
      · rw [if_pos c1]; exact c2.symm
    · rw [if_neg hm0, hget (m - 1) (by omega)]
      have he : a + m = a + (m - 1) + 1 := by omega
      rw [he]
      rcases hnode (a + (m - 1)) (by omega) with ⟨c1, -, c2, -⟩ | ⟨c1, -, c2, -⟩ |
        ⟨c1, -, -, c2, -⟩
      · rw [if_neg (by omega)]; exact c2.symm
      · rw [if_pos c1]; exact c2.symm
      · rw [if_neg (by omega)]; exact c2.symm
  have hSl : ∀ m, m < b - a → lpSlots (lpSeg code a b) m = if code (a + m) / 3 = 0 then 2 else 1 := by
    intro m hm
    unfold lpSlots
    rw [hget m hm]
  -- the atoms
  have hatom : ∀ m, m < b - a → ∀ w, (w ∈ N (a + m) \ N (a + m + 1) ↔
      ∃ i, i < lpSlots (lpSeg code a b) m ∧ w = v (a + m) i) := by
    intro m hm w
    rw [hSl m hm]
    rcases hnode (a + m) (by omega) with ⟨c1, -, -, c2, -⟩ | ⟨c1, -, -, c2, -⟩ |
      ⟨c1, -, -, -, c2, -⟩
    · rw [if_pos c1, c2, Finset.mem_insert, Finset.mem_singleton]
      constructor
      · rintro (h' | h')
        · exact ⟨0, by omega, h'⟩
        · exact ⟨1, by omega, h'⟩
      · rintro ⟨i, hi, rfl⟩
        have : i = 0 ∨ i = 1 := by omega
        rcases this with rfl | rfl
        · exact Or.inl rfl
        · exact Or.inr rfl
    · rw [if_neg (by omega), c2, Finset.mem_singleton]
      constructor
      · intro h'; exact ⟨0, by omega, h'⟩
      · rintro ⟨i, hi, rfl⟩
        have : i = 0 := by omega
        rw [this]
    · rw [if_neg (by omega), c2, Finset.mem_singleton]
      constructor
      · intro h'; exact ⟨0, by omega, h'⟩
      · rintro ⟨i, hi, rfl⟩
        have : i = 0 := by omega
        rw [this]
  have htel : ∀ d, a + d ≤ n → ∀ w, (w ∈ N a \ N (a + d) ↔
      ∃ m, m < d ∧ w ∈ N (a + m) \ N (a + m + 1)) := by
    intro d
    induction d with
    | zero =>
      intro _ w
      simp
    | succ d ih =>
      intro hd w
      have s1 := hnest (a + d) (by omega)
      have s2 := hmono d a (by omega)
      constructor
      · intro hw
        obtain ⟨w1, w2⟩ := Finset.mem_sdiff.mp hw
        by_cases hwd : w ∈ N (a + d)
        · exact ⟨d, by omega, Finset.mem_sdiff.mpr ⟨hwd, w2⟩⟩
        · obtain ⟨m, hm, hmw⟩ := (ih (by omega) w).mp (Finset.mem_sdiff.mpr ⟨w1, hwd⟩)
          exact ⟨m, by omega, hmw⟩
      · rintro ⟨m, hm, hmw⟩
        by_cases hmd : m = d
        · subst hmd
          obtain ⟨w1, w2⟩ := Finset.mem_sdiff.mp hmw
          exact Finset.mem_sdiff.mpr ⟨s2 w1, w2⟩
        · obtain ⟨w1, w2⟩ := Finset.mem_sdiff.mp ((ih (by omega) w).mpr ⟨m, by omega, hmw⟩)
          exact Finset.mem_sdiff.mpr ⟨w1, fun h' => w2 (s1 h')⟩
  have hvatom : ∀ m i, m < b - a → i < lpSlots (lpSeg code a b) m →
      v (a + m) i ∈ N (a + m) \ N (a + m + 1) := fun m i hm hi =>
    (hatom m hm _).mpr ⟨i, hi, rfl⟩
  have hsep : ∀ p q w, p < q → q < n → w ∈ N p \ N (p + 1) → w ∈ N q \ N (q + 1) → False := by
    intro p q w hpq hq h1 h2
    exact (Finset.mem_sdiff.mp h1).2 (hmono' (p + 1) q (by omega) (by omega)
      (Finset.mem_sdiff.mp h2).1)
  -- origins
  have hO : ∀ m, m ≤ b - a → ∀ j, j < (epCut α β (N (a + m))).card →
      (lpOrig (lpSeg code a b) m j).1 ≤ m ∧
      (lpOrig (lpSeg code a b) m j).2 < (epCut α β (N (a + (lpOrig (lpSeg code a b) m j).1))).card ∧
      cut (a + (lpOrig (lpSeg code a b) m j).1) (lpOrig (lpSeg code a b) m j).2 = cut (a + m) j ∧
      ((lpOrig (lpSeg code a b) m j).1 = 0 ∨
        ∀ j', j' < (epCut α β (N (a + (lpOrig (lpSeg code a b) m j).1 - 1))).card →
          cut (a + (lpOrig (lpSeg code a b) m j).1) (lpOrig (lpSeg code a b) m j).2 ≠
            cut (a + (lpOrig (lpSeg code a b) m j).1 - 1) j') := by
    intro m
    induction m with
    | zero =>
      intro _ j hj
      have h0 : lpOrig (lpSeg code a b) 0 j = (0, j) := rfl
      rw [h0]
      exact ⟨le_refl _, hj, rfl, Or.inl rfl⟩
    | succ m ih =>
      intro hm j hj
      have ihm := ih (by omega)
      have hnew : ∀ j, j < (epCut α β (N (a + (m + 1)))).card →
          (∀ j', j' < (epCut α β (N (a + m))).card → cut (a + (m + 1)) j ≠ cut (a + m) j') →
          lpOrig (lpSeg code a b) (m + 1) j = (m + 1, j) →
          (lpOrig (lpSeg code a b) (m + 1) j).1 ≤ m + 1 ∧
          (lpOrig (lpSeg code a b) (m + 1) j).2 <
            (epCut α β (N (a + (lpOrig (lpSeg code a b) (m + 1) j).1))).card ∧
          cut (a + (lpOrig (lpSeg code a b) (m + 1) j).1) (lpOrig (lpSeg code a b) (m + 1) j).2 =
            cut (a + (m + 1)) j ∧
          ((lpOrig (lpSeg code a b) (m + 1) j).1 = 0 ∨
            ∀ j', j' < (epCut α β (N (a + (lpOrig (lpSeg code a b) (m + 1) j).1 - 1))).card →
              cut (a + (lpOrig (lpSeg code a b) (m + 1) j).1)
                (lpOrig (lpSeg code a b) (m + 1) j).2 ≠
                cut (a + (lpOrig (lpSeg code a b) (m + 1) j).1 - 1) j') := by
        intro j hj hcr heq
        rw [heq]
        exact ⟨le_refl _, hj, rfl, Or.inr (fun j' hj' => hcr j' hj')⟩
      have hold : ∀ j p, p < (epCut α β (N (a + m))).card → cut (a + (m + 1)) j = cut (a + m) p →
          lpOrig (lpSeg code a b) (m + 1) j = lpOrig (lpSeg code a b) m p →
          (lpOrig (lpSeg code a b) (m + 1) j).1 ≤ m + 1 ∧
          (lpOrig (lpSeg code a b) (m + 1) j).2 <
            (epCut α β (N (a + (lpOrig (lpSeg code a b) (m + 1) j).1))).card ∧
          cut (a + (lpOrig (lpSeg code a b) (m + 1) j).1) (lpOrig (lpSeg code a b) (m + 1) j).2 =
            cut (a + (m + 1)) j ∧
          ((lpOrig (lpSeg code a b) (m + 1) j).1 = 0 ∨
            ∀ j', j' < (epCut α β (N (a + (lpOrig (lpSeg code a b) (m + 1) j).1 - 1))).card →
              cut (a + (lpOrig (lpSeg code a b) (m + 1) j).1)
                (lpOrig (lpSeg code a b) (m + 1) j).2 ≠
                cut (a + (lpOrig (lpSeg code a b) (m + 1) j).1 - 1) j') := by
        intro j p hp hcut heq
        obtain ⟨i1, i2, i3, i4⟩ := ihm p hp
        rw [heq, hcut]
        exact ⟨by omega, i2, i3, i4⟩
      have hj3 : j ≠ 3 := by
        rcases hnode (a + m) (by omega) with ⟨-, -, c2, -⟩ | ⟨-, -, c2, -⟩ | ⟨-, -, -, c2, -⟩ <;>
        · have : a + (m + 1) = a + m + 1 := rfl
          rw [this, c2] at hj
          omega
      have horig : lpOrig (lpSeg code a b) (m + 1) j =
          if code (a + m) / 3 = 0 then
            (if j = code (a + m) % 3 then lpOrig (lpSeg code a b) m j else (m + 1, j))
          else (if j = 0 then lpOrig (lpSeg code a b) m (code (a + m) % 3) else (m + 1, j)) := by
        simp only [lpOrig]
        rw [if_neg hj3, hget m (by omega)]
      rcases hnode (a + m) (by omega) with ⟨c1, c2, c3, -, -, c6, -, c8, -⟩ |
        ⟨c1, c2, c3, -, c5, -, c7⟩ | ⟨c1, c1', c2, c3, -, c5, -, c7⟩
      · -- rung node
        have hp3 : code (a + m) % 3 < 3 := Nat.mod_lt _ (by norm_num)
        rw [if_pos c1] at horig
        have hj' : j < 3 := by
          have : a + (m + 1) = a + m + 1 := rfl
          rw [this, c3] at hj; exact hj
        by_cases hjp : j = code (a + m) % 3
        · rw [if_pos hjp] at horig
          refine hold j j (by rw [c2]; exact hj') ?_ horig
          rw [hjp]; exact c6
        · rw [if_neg hjp] at horig
          refine hnew j hj ?_ horig
          intro j' hj''
          rw [c2] at hj''
          rcases (lpOther_facts _ hp3).2.2.2.2.2 j hj' hjp with h' | h'
          · rw [h']; exact c8 0 (by omega) j' hj''
          · rw [h']; exact c8 1 (by omega) j' hj''
      · -- node between cuts of sizes three and two
        have hp3 : code (a + m) % 3 < 3 := Nat.mod_lt _ (by norm_num)
        rw [if_neg (by omega)] at horig
        have hj' : j < 2 := by
          have : a + (m + 1) = a + m + 1 := rfl
          rw [this, c3] at hj; exact hj
        by_cases hj0 : j = 0
        · rw [if_pos hj0] at horig
          refine hold j (code (a + m) % 3) (by rw [c2]; exact hp3) ?_ horig
          rw [hj0]; exact c5
        · rw [if_neg hj0] at horig
          have hj1 : j = 1 := by omega
          refine hnew j hj ?_ horig
          intro j' hj''
          rw [c2] at hj''
          rw [hj1]; exact c7 j' hj''
      · -- node between cuts of sizes two and three
        rw [if_neg (by omega)] at horig
        have hj' : j < 3 := by
          have : a + (m + 1) = a + m + 1 := rfl
          rw [this, c3] at hj; exact hj
        by_cases hj0 : j = 0
        · rw [if_pos hj0] at horig
          refine hold j (code (a + m) % 3) (by rw [c2]; exact c1') ?_ horig
          rw [hj0]; exact c5
        · rw [if_neg hj0] at horig
          refine hnew j hj ?_ horig
          intro j' hj''
          rw [c2] at hj''
          have : j = 1 ∨ j = 2 := by omega
          rcases this with rfl | rfl
          · exact (c7 j' hj'').1
          · exact (c7 j' hj'').2
  refine ⟨?_, ?_, ?_, ?_, ?_⟩
  · -- incidences
    intro m i hm hi g
    rw [hlen] at hm
    rw [hSl m hm] at hi
    unfold lpVTok
    rw [hget m hm]
    have hadd : a + (m + 1) = a + m + 1 := rfl
    rcases hnode (a + m) (by omega) with ⟨c1, -, -, -, -, -, c7, -⟩ | ⟨c1, -, -, -, -, c6, -⟩ |
      ⟨c1, c1', -, -, -, -, c7, -⟩
    · have hp3 : code (a + m) % 3 < 3 := Nat.mod_lt _ (by norm_num)
      rw [if_pos c1] at hi ⊢
      obtain ⟨o0, o1, -⟩ := lpOther_facts _ hp3
      have ho : lpOther (code (a + m) % 3) i ≠ 3 := by
        have : i = 0 ∨ i = 1 := by omega
        rcases this with rfl | rfl <;> omega
      rw [c7 i hi g]
      simp only [List.mem_cons, List.not_mem_nil, or_false, exists_eq_or_imp, exists_eq_left,
        if_neg ho, if_true, hadd]
    · rw [if_neg (by omega), if_pos c1]
      have hp3 : code (a + m) % 3 < 3 := Nat.mod_lt _ (by norm_num)
      obtain ⟨o0, o1, -⟩ := lpOther_facts _ hp3
      have hi0 : i = 0 := by rw [if_neg (by omega)] at hi; omega
      rw [hi0, c6 g]
      simp only [List.mem_cons, List.not_mem_nil, or_false, exists_eq_or_imp, exists_eq_left,
        if_neg (by omega : lpOther (code (a + m) % 3) 0 ≠ 3),
        if_neg (by omega : lpOther (code (a + m) % 3) 1 ≠ 3), if_neg (by omega : (1 : ℕ) ≠ 3),
        hadd]
    · rw [if_neg (by omega), if_neg (by omega)]
      have hi0 : i = 0 := by rw [if_neg (by omega)] at hi; omega
      rw [hi0, c7 g]
      simp only [List.mem_cons, List.not_mem_nil, or_false, exists_eq_or_imp, exists_eq_left,
        if_neg (by omega : 1 - code (a + m) % 3 ≠ 3), if_neg (by omega : (1 : ℕ) ≠ 3),
        if_neg (by omega : (2 : ℕ) ≠ 3), hadd]
  · -- the vertices
    intro w
    have hb : a + (b - a) = b := by omega
    have := htel (b - a) (by omega) w
    rw [hb] at this
    rw [this, hlen]
    constructor
    · rintro ⟨m, hm, hw⟩
      obtain ⟨i, hi, rfl⟩ := (hatom m hm w).mp hw
      exact ⟨m, i, hm, hi, rfl⟩
    · rintro ⟨m, i, hm, hi, rfl⟩
      exact ⟨m, hm, hvatom m i hm hi⟩
  · -- the vertices are different
    intro m i m' i' hm hi hm' hi' heq
    rw [hlen] at hm hm'
    have heq' : v (a + m) i = v (a + m') i' := heq
    have h1 := hvatom m i hm hi
    have h2 := hvatom m' i' hm' hi'
    rw [heq'] at h1
    have hmm : m = m' := by
      by_contra hne
      rcases lt_or_gt_of_ne hne with h' | h'
      · exact hsep (a + m) (a + m') _ (by omega) (by omega) h1 h2
      · exact hsep (a + m') (a + m) _ (by omega) (by omega) h2 h1
    subst hmm
    refine ⟨rfl, ?_⟩
    rw [hSl m hm] at hi hi'
    rcases hnode (a + m) (by omega) with ⟨c1, -, -, -, c5, -⟩ | ⟨c1, -⟩ | ⟨c1, -⟩
    · rw [if_pos c1] at hi hi'
      have e1 : i = 0 ∨ i = 1 := by omega
      have e2 : i' = 0 ∨ i' = 1 := by omega
      rcases e1 with rfl | rfl <;> rcases e2 with rfl | rfl
      · rfl
      · exact absurd heq' c5
      · exact absurd heq'.symm c5
      · rfl
    · rw [if_neg (by omega)] at hi hi'; omega
    · rw [if_neg (by omega)] at hi hi'; omega
  · -- equality of token edges
    intro m j m' j' hv hv'
    show ((if j = 3 then rg (a + m) else cut (a + m) j) =
      (if j' = 3 then rg (a + m') else cut (a + m') j')) ↔
      lpOrig (lpSeg code a b) m j = lpOrig (lpSeg code a b) m' j'
    have hval : ∀ m j, lpValidT (lpSeg code a b) m j = true →
        (j < (epCut α β (N (a + m))).card ∧ m ≤ b - a ∧ j < 3) ∨
        (j = 3 ∧ m < b - a ∧ code (a + m) / 3 = 0) := by
      intro m j h
      unfold lpValidT at h
      simp only [Bool.or_eq_true, Bool.and_eq_true, decide_eq_true_eq, beq_iff_eq, hlen] at h
      rcases h with ⟨h1, h2⟩ | ⟨⟨h1, h2⟩, h3⟩
      · left
        rw [hW m h2] at h1
        refine ⟨h1, h2, ?_⟩
        have hk := (hInv (a + m) (by omega))
        by_cases hm0 : m = 0
        · subst hm0
          rcases hnode a (by omega) with ⟨-, c2, -⟩ | ⟨-, c2, -⟩ | ⟨-, -, c2, -⟩ <;>
          · rw [show a + 0 = a from rfl, c2] at h1; omega
        · have he : a + m = a + (m - 1) + 1 := by omega
          rw [he] at h1
          rcases hnode (a + (m - 1)) (by omega) with ⟨-, -, c2, -⟩ | ⟨-, -, c2, -⟩ |
            ⟨-, -, -, c2, -⟩ <;>
          · rw [c2] at h1; omega
      · right
        rw [hget m h2] at h3
        exact ⟨h1, h2, h3⟩
    have hrgatom : ∀ m, m < b - a → code (a + m) / 3 = 0 →
        α (rg (a + m)) ∈ N (a + m) \ N (a + m + 1) ∧ β (rg (a + m)) ∈ N (a + m) \ N (a + m + 1) := by
      intro m hm hc
      rcases hnode (a + m) (by omega) with ⟨-, -, -, -, -, -, -, -, c9⟩ | ⟨c1, -⟩ | ⟨c1, -⟩
      · exact c9
      · omega
      · omega
    have hrgcut : ∀ m m' j', m < b - a → code (a + m) / 3 = 0 → m' ≤ b - a →
        j' < (epCut α β (N (a + m'))).card → rg (a + m) ≠ cut (a + m') j' := by
      intro m m' j' hm hc hm' hj' heq
      obtain ⟨r1, r2⟩ := hrgatom m hm hc
      have hcr : epCross α β (N (a + m')) (rg (a + m)) :=
        ((hInv (a + m') (by omega)).2 _).mpr ⟨j', hj', heq.symm⟩
      obtain ⟨p1, p2⟩ := Finset.mem_sdiff.mp r1
      obtain ⟨q1, q2⟩ := Finset.mem_sdiff.mp r2
      unfold epCross at hcr
      by_cases hle : m' ≤ m
      · have s := hmono' (a + m') (a + m) (by omega) (by omega)
        rcases hcr with ⟨-, x⟩ | ⟨x, -⟩
        · exact x (s q1)
        · exact x (s p1)
      · have s := hmono' (a + m + 1) (a + m') (by omega) (by omega)
        rcases hcr with ⟨x, -⟩ | ⟨-, x⟩
        · exact p2 (s x)
        · exact q2 (s x)
    have horg3 : ∀ m, lpOrig (lpSeg code a b) m 3 = (m, 3) := by
      intro m
      cases m with
      | zero => rfl
      | succ m => simp [lpOrig]
    rcases hval m j hv with ⟨h1, h2, h3⟩ | ⟨h1, h2, h3⟩ <;>
      rcases hval m' j' hv' with ⟨h1', h2', h3'⟩ | ⟨h1', h2', h3'⟩
    · -- two cut edges
      rw [if_neg (show ¬(j = 3) by omega), if_neg (show ¬(j' = 3) by omega)]
      obtain ⟨o1, o2, o3, o4⟩ := hO m h2 j h1
      obtain ⟨o1', o2', o3', o4'⟩ := hO m' h2' j' h1'
      constructor
      · intro heq
        have hsame : ∀ (p q : ℕ × ℕ), p.1 < q.1 → q.1 ≤ b - a →
            p.2 < (epCut α β (N (a + p.1))).card → q.2 < (epCut α β (N (a + q.1))).card →
            cut (a + p.1) p.2 = cut (a + q.1) q.2 →
            (q.1 = 0 ∨ ∀ j', j' < (epCut α β (N (a + q.1 - 1))).card →
              cut (a + q.1) q.2 ≠ cut (a + q.1 - 1) j') → False := by
          intro p q hpq hq hp2 hq2 hcut hcre
          rcases hcre with h0 | hcre
          · omega
          · have x1 : epCross α β (N (a + p.1)) (cut (a + p.1) p.2) :=
              ((hInv (a + p.1) (by omega)).2 _).mpr ⟨p.2, hp2, rfl⟩
            have x2 : epCross α β (N (a + q.1)) (cut (a + p.1) p.2) := by
              rw [hcut]
              exact ((hInv (a + q.1) (by omega)).2 _).mpr ⟨q.2, hq2, rfl⟩
            have x3 := hX (a + p.1) (a + q.1 - 1) (a + q.1) _ (by omega) (by omega) (by omega)
              x1 x2
            obtain ⟨j'', hj'', hc''⟩ := ((hInv (a + q.1 - 1) (by omega)).2 _).mp x3
            exact hcre j'' hj'' (hcut ▸ hc''.symm)
        have hcc : cut (a + (lpOrig (lpSeg code a b) m j).1) (lpOrig (lpSeg code a b) m j).2 =
            cut (a + (lpOrig (lpSeg code a b) m' j').1) (lpOrig (lpSeg code a b) m' j').2 := by
          rw [o3, o3', heq]
        rcases Nat.lt_trichotomy (lpOrig (lpSeg code a b) m j).1
          (lpOrig (lpSeg code a b) m' j').1 with hlt | heq1 | hgt
        · exact (hsame _ _ hlt (by omega) o2 o2' hcc o4').elim
        · have h2eq : (lpOrig (lpSeg code a b) m j).2 = (lpOrig (lpSeg code a b) m' j').2 := by
            refine (hInv (a + (lpOrig (lpSeg code a b) m j).1) (by omega)).1 _ _ o2 ?_ ?_
            · rw [heq1]; exact o2'
            · rw [hcc, heq1]
          exact Prod.ext heq1 h2eq
        · exact (hsame _ _ hgt (by omega) o2' o2 hcc.symm o4).elim
      · intro heq
        rw [← o3, ← o3', heq]
    · -- a cut edge and a rung
      rw [if_neg (show ¬(j = 3) by omega), if_pos h1']
      constructor
      · intro heq
        exact absurd heq.symm (hrgcut m' m j h2' h3' h2 h1)
      · intro heq
        rw [h1', horg3] at heq
        exfalso
        have this := (hO m h2 j h1).2.1
        have h4 : (lpOrig (lpSeg code a b) m j).2 = 3 := by rw [heq]
        have hm0 : (lpOrig (lpSeg code a b) m j).1 = m' := by rw [heq]
        rw [h4, hm0] at this
        rcases hnode (a + m') (by omega) with ⟨-, c2, -⟩ | ⟨c1, -⟩ | ⟨c1, -⟩
        · rw [c2] at this; omega
        · omega
        · omega
    · -- a rung and a cut edge
      rw [if_pos h1, if_neg (show ¬(j' = 3) by omega)]
      constructor
      · intro heq
        exact absurd heq (hrgcut m m' j' h2 h3 h2' h1')
      · intro heq
        rw [h1, horg3] at heq
        exfalso
        have this := (hO m' h2' j' h1').2.1
        have h4 : (lpOrig (lpSeg code a b) m' j').2 = 3 := by rw [← heq]
        have hm0 : (lpOrig (lpSeg code a b) m' j').1 = m := by rw [← heq]
        rw [h4, hm0] at this
        rcases hnode (a + m) (by omega) with ⟨-, c2, -⟩ | ⟨c1, -⟩ | ⟨c1, -⟩
        · rw [c2] at this; omega
        · omega
        · omega
    · -- two rungs
      rw [if_pos h1, if_pos h1', h1, h1', horg3, horg3]
      constructor
      · intro heq
        by_contra hne
        have hmm : m ≠ m' := fun h' => hne (by rw [h'])
        obtain ⟨r1, -⟩ := hrgatom m h2 h3
        obtain ⟨r1', -⟩ := hrgatom m' h2' h3'
        rw [heq] at r1
        rcases lt_or_gt_of_ne hmm with h' | h'
        · exact hsep (a + m) (a + m') _ (by omega) (by omega) r1 r1'
        · exact hsep (a + m') (a + m) _ (by omega) (by omega) r1' r1
      · intro heq
        rw [(Prod.mk.inj heq).1]
  · -- no loops
    intro g hg
    exact hloop g (hmono' 0 a (Nat.zero_le _) (by omega) (Finset.mem_sdiff.mp hg).1)


open Classical in
/-- The shape of one node of a labelled chain: `N` with the labelling `c` of its cut, its only
child `C` with the labelling `c'`, the node code, the vertices and the rung. -/
def EpLabNode {W E : Type*} [Fintype E] (α β : E → W) (N C : Finset W) (code : ℕ)
    (vt : ℕ → W) (c c' : ℕ → E) (rgm : E) : Prop :=
  (code / 3 = 0 ∧ (epCut α β N).card = 3 ∧ (epCut α β C).card = 3 ∧
    N \ C = {vt 0, vt 1} ∧ vt 0 ≠ vt 1 ∧ c' (code % 3) = c (code % 3) ∧
    (∀ i, i < 2 → ∀ g, epCross α β {vt i} g ↔ g = c (lpOther (code % 3) i) ∨
      g = c' (lpOther (code % 3) i) ∨ g = rgm) ∧
    (∀ i, i < 2 → ∀ j, j < 3 → c' (lpOther (code % 3) i) ≠ c j) ∧
    (α rgm ∈ N \ C ∧ β rgm ∈ N \ C)) ∨
  (code / 3 = 1 ∧ (epCut α β N).card = 3 ∧ (epCut α β C).card = 2 ∧
    N \ C = {vt 0} ∧ c' 0 = c (code % 3) ∧
    (∀ g, epCross α β {vt 0} g ↔ g = c (lpOther (code % 3) 0) ∨
      g = c (lpOther (code % 3) 1) ∨ g = c' 1) ∧
    (∀ j, j < 3 → c' 1 ≠ c j)) ∨
  (code / 3 = 2 ∧ code % 3 < 2 ∧ (epCut α β N).card = 2 ∧ (epCut α β C).card = 3 ∧
    N \ C = {vt 0} ∧ c' 0 = c (code % 3) ∧
    (∀ g, epCross α β {vt 0} g ↔ g = c (1 - code % 3) ∨ g = c' 1 ∨ g = c' 2) ∧
    (∀ j, j < 2 → c' 1 ≠ c j ∧ c' 2 ≠ c j))

set_option maxHeartbeats 6400000 in
open Classical in
/-- **One node of a chain.** In a `𝒴`-maximum decomposition of a multigraph without a core, let
`C` be the only child of the member `N`, and let `c` enumerate the cut of `N`. Then the node has
one of the three shapes, with a suitable enumeration `c'` of the cut of `C`. -/
theorem ep_lab_step {W E : Type*} [Fintype E] (α β : E → W) (L : Finset W) (r : W)
    (𝒮 𝒴 : Finset (Finset W)) (h : EpCubicD α β L) (hb : EpBridgeless α β L)
    (hconn : EpConnected α β L) (hr : r ∈ L) (hdec : EpDecomp α β L r 𝒮)
    (href : EpRefines L r 𝒮 𝒴)
    (hmax : ∀ 𝒮', EpDecomp α β L r 𝒮' → EpRefines L r 𝒮' 𝒴 → 𝒮'.card ≤ 𝒮.card)
    (hnc : ¬EpHasCore α β L) (N C : Finset W) (hN : N ∈ 𝒮) (hch : epChildren 𝒮 N = {C})
    (c : ℕ → E)
    (hinj : ∀ j j', j < (epCut α β N).card → j' < (epCut α β N).card → c j = c j' → j = j')
    (hrng : ∀ g, epCross α β N g ↔ ∃ j, j < (epCut α β N).card ∧ c j = g) :
    ∃ (code : ℕ) (vt : ℕ → W) (c' : ℕ → E) (rgm : E),
      ((∀ j j', j < (epCut α β C).card → j' < (epCut α β C).card → c' j = c' j' → j = j') ∧
        ∀ g, epCross α β C g ↔ ∃ j, j < (epCut α β C).card ∧ c' j = g) ∧
      EpLabNode α β N C code vt c c' rgm := by
  have hCch : C ∈ epChildren 𝒮 N := by rw [hch]; exact Finset.mem_singleton_self C
  obtain ⟨hCS, hCN, -⟩ := (mem_epChildren 𝒮 N C).mp hCch
  have hNL := (hdec.2.1 N hN).1
  have hsN := (hdec.2.1 N hN).2.2.2
  have hsC := (hdec.2.1 C hCS).2.2.2
  obtain ⟨hac1, hac2, hac3⟩ := ep_deg2_atom_card α β L r 𝒮 𝒴 h hb hconn hr hdec href hmax hnc
    N C hN hch
  -- the label of an edge of the cut of `N`
  have hlab : ∀ g, epCross α β N g → ∃ j, j < (epCut α β N).card ∧ c j = g :=
    fun g hg => (hrng g).mp hg
  by_cases h33 : (epCut α β N).card = 3 ∧ (epCut α β C).card = 3
  · -- rung node
    obtain ⟨hdN, hdC⟩ := h33
    obtain ⟨x, y, rg, ix, iy, ox, oy, ps, hxy, hat, hx, hy, hcN, hcC,
      ⟨d1, d2, d3, d4, d5, d6, d7, d8, d9, d10, d11, d12, d13, d14⟩, hrg⟩ :=
      ep_rung_node α β L r 𝒮 𝒴 h hb hconn hr hdec href hmax hnc N C hN hch hdN hdC
    obtain ⟨p, hp, hcp⟩ := hlab ps ((hcN ps).mpr (Or.inr (Or.inr rfl)))
    rw [hdN] at hp
    obtain ⟨o0, o1, n0, n1, n01, hcov⟩ := lpOther_facts p hp
    -- values of the labels
    have hval : ∀ j, j < 3 → c j = ix ∨ c j = iy ∨ c j = ps := by
      intro j hj
      exact (hcN (c j)).mp ((hrng _).mpr ⟨j, by rw [hdN]; exact hj, rfl⟩)
    have hnps : ∀ j, j < 3 → j ≠ p → c j ≠ ps := by
      intro j hj hjp heq
      exact hjp (hinj j p (by rw [hdN]; exact hj) (by rw [hdN]; exact hp) (heq.trans hcp.symm))
    obtain ⟨c', hc'⟩ : ∃ c' : ℕ → E, ∀ j, c' j =
        if c j = ix then ox else if c j = iy then oy else c j := ⟨_, fun _ => rfl⟩
    have hc'ps : c' p = ps := by
      rw [hc', hcp, if_neg (fun h' => d2 h'.symm), if_neg (fun h' => d3 h'.symm)]
    have hc'ix : ∀ j, c j = ix → c' j = ox := fun j hj => by rw [hc', if_pos hj]
    have hc'iy : ∀ j, c j = iy → c' j = oy := fun j hj => by
      rw [hc', if_neg (fun h' => d1 (h'.symm.trans hj)), if_pos hj]
    have hv3 : ∀ j, j < 3 → (c j = ix ∧ c' j = ox) ∨ (c j = iy ∧ c' j = oy) ∨
        (c j = ps ∧ c' j = ps) := by
      intro j hj
      rcases hval j hj with h' | h' | h'
      · exact Or.inl ⟨h', hc'ix j h'⟩
      · exact Or.inr (Or.inl ⟨h', hc'iy j h'⟩)
      · refine Or.inr (Or.inr ⟨h', ?_⟩)
        rw [hc', h', if_neg (fun h'' => d2 h''.symm), if_neg (fun h'' => d3 h''.symm)]
    -- the two touched rails
    have ho0 : c (lpOther p 0) = ix ∨ c (lpOther p 0) = iy := by
      rcases hval _ o0 with h' | h' | h'
      · exact Or.inl h'
      · exact Or.inr h'
      · exact absurd h' (hnps _ o0 n0)
    have ho1 : c (lpOther p 1) = ix ∨ c (lpOther p 1) = iy := by
      rcases hval _ o1 with h' | h' | h'
      · exact Or.inl h'
      · exact Or.inr h'
      · exact absurd h' (hnps _ o1 n1)
    have hdiff : c (lpOther p 0) ≠ c (lpOther p 1) := fun h' =>
      n01 (hinj _ _ (by rw [hdN]; exact o0) (by rw [hdN]; exact o1) h')
    have hatom : ∀ w, w ∈ N \ C ↔ w = x ∨ w = y := by
      intro w; rw [hat, Finset.mem_insert, Finset.mem_singleton]
    have hrgin : α rg ∈ N \ C ∧ β rg ∈ N \ C := by
      rcases hrg with ⟨e1, e2⟩ | ⟨e1, e2⟩
      · exact ⟨(hatom _).mpr (Or.inl e1), (hatom _).mpr (Or.inr e2)⟩
      · exact ⟨(hatom _).mpr (Or.inr e1), (hatom _).mpr (Or.inl e2)⟩
    have hInv' : (∀ j j', j < (epCut α β C).card → j' < (epCut α β C).card → c' j = c' j' →
        j = j') ∧ ∀ g, epCross α β C g ↔ ∃ j, j < (epCut α β C).card ∧ c' j = g := by
      rw [hdC]
      refine ⟨fun j j' hj hj' hjj' => ?_, fun g => ?_⟩
      · have hi := hinj j j' (by rw [hdN]; exact hj) (by rw [hdN]; exact hj')
        rcases hv3 j hj with ⟨a1, a2⟩ | ⟨a1, a2⟩ | ⟨a1, a2⟩ <;>
          rcases hv3 j' hj' with ⟨b1, b2⟩ | ⟨b1, b2⟩ | ⟨b1, b2⟩
        · exact hi (a1.trans b1.symm)
        · exact absurd (a2.symm.trans (hjj'.trans b2)) d4
        · exact absurd (a2.symm.trans (hjj'.trans b2)) d5
        · exact absurd (b2.symm.trans (hjj'.symm.trans a2)) d4
        · exact hi (a1.trans b1.symm)
        · exact absurd (a2.symm.trans (hjj'.trans b2)) d6
        · exact absurd (b2.symm.trans (hjj'.symm.trans a2)) d5
        · exact absurd (b2.symm.trans (hjj'.symm.trans a2)) d6
        · exact hi (a1.trans b1.symm)
      · rw [hcC]
        constructor
        · rintro (rfl | rfl | rfl)
          · obtain ⟨j, hj, hcj⟩ := hlab ix ((hcN _).mpr (Or.inl rfl))
            rw [hdN] at hj
            exact ⟨j, hj, hc'ix j hcj⟩
          · obtain ⟨j, hj, hcj⟩ := hlab iy ((hcN _).mpr (Or.inr (Or.inl rfl)))
            rw [hdN] at hj
            exact ⟨j, hj, hc'iy j hcj⟩
          · exact ⟨p, hp, hc'ps⟩
        · rintro ⟨j, hj, rfl⟩
          rcases hv3 j hj with ⟨-, a2⟩ | ⟨-, a2⟩ | ⟨-, a2⟩
          · exact Or.inl a2
          · exact Or.inr (Or.inl a2)
          · exact Or.inr (Or.inr a2)
    have hcode : p / 3 = 0 ∧ p % 3 = p := by omega
    rcases ho0 with q0 | q0
    · -- rail `lpOther p 0` goes through `x`
      have q1 : c (lpOther p 1) = iy := ho1.resolve_left (fun h' => hdiff (q0.trans h'.symm))
      obtain ⟨vt, hv0, hv1⟩ : ∃ vt : ℕ → W, vt 0 = x ∧ vt 1 = y :=
        ⟨fun i => if i = 0 then x else y, by simp, by simp⟩
      refine ⟨p, vt, c', rg, hInv', Or.inl ⟨hcode.1, hdN, hdC, ?_, ?_, ?_, ?_, ?_, hrgin⟩⟩
      · rw [hv0, hv1]; exact hat
      · rw [hv0, hv1]; exact hxy
      · rw [hcode.2, hc'ps, hcp]
      · rw [hcode.2]
        intro i hi g
        have : i = 0 ∨ i = 1 := by omega
        rcases this with rfl | rfl
        · rw [hv0, hx g, q0, hc'ix _ q0]
        · rw [hv1, hy g, q1, hc'iy _ q1]
      · rw [hcode.2]
        intro i hi j hj
        have : i = 0 ∨ i = 1 := by omega
        rcases this with rfl | rfl
        · rw [hc'ix _ q0]
          rcases hval j hj with h' | h' | h' <;> rw [h']
          · exact d7.symm
          · exact d10.symm
          · exact d5
        · rw [hc'iy _ q1]
          rcases hval j hj with h' | h' | h' <;> rw [h']
          · exact d9.symm
          · exact d8.symm
          · exact d6
    · -- rail `lpOther p 0` goes through `y`
      have q1 : c (lpOther p 1) = ix := ho1.resolve_right (fun h' => hdiff (q0.trans h'.symm))
      obtain ⟨vt, hv0, hv1⟩ : ∃ vt : ℕ → W, vt 0 = y ∧ vt 1 = x :=
        ⟨fun i => if i = 0 then y else x, by simp, by simp⟩
      refine ⟨p, vt, c', rg, hInv', Or.inl ⟨hcode.1, hdN, hdC, ?_, ?_, ?_, ?_, ?_, hrgin⟩⟩
      · rw [hv0, hv1, hat]; exact Finset.pair_comm x y
      · rw [hv0, hv1]; exact hxy.symm
      · rw [hcode.2, hc'ps, hcp]
      · rw [hcode.2]
        intro i hi g
        have : i = 0 ∨ i = 1 := by omega
        rcases this with rfl | rfl
        · rw [hv0, hy g, q0, hc'iy _ q0]
        · rw [hv1, hx g, q1, hc'ix _ q1]
      · rw [hcode.2]
        intro i hi j hj
        have : i = 0 ∨ i = 1 := by omega
        rcases this with rfl | rfl
        · rw [hc'iy _ q0]
          rcases hval j hj with h' | h' | h' <;> rw [h']
          · exact d9.symm
          · exact d8.symm
          · exact d6
        · rw [hc'ix _ q1]
          rcases hval j hj with h' | h' | h' <;> rw [h']
          · exact d7.symm
          · exact d10.symm
          · exact d5
  · -- one of the two cuts has size two: the atom is one vertex
    have hone : (N \ C).card = 1 := hac3 (by omega)
    obtain ⟨u, hu⟩ := Finset.card_eq_one.mp hone
    have huL : u ∈ L := by
      have : u ∈ N \ C := by rw [hu]; exact Finset.mem_singleton_self u
      exact hNL (Finset.mem_sdiff.mp this).1
    by_cases h32 : (epCut α β N).card = 3 ∧ (epCut α β C).card = 2
    · obtain ⟨hdN, hdC⟩ := h32
      obtain ⟨a1, a2, dn, ps, e1, e2, e3, e4, e5, e6, hcu, hcN, hcC⟩ :=
        ep_b32_node α β L h N C u huL hCN.1 hu hdN hdC
      obtain ⟨p, hp, hcp⟩ := hlab ps ((hcN ps).mpr (Or.inr (Or.inr rfl)))
      rw [hdN] at hp
      obtain ⟨o0, o1, n0, n1, n01, -⟩ := lpOther_facts p hp
      have hval : ∀ j, j < 3 → c j = a1 ∨ c j = a2 ∨ c j = ps := by
        intro j hj
        exact (hcN (c j)).mp ((hrng _).mpr ⟨j, by rw [hdN]; exact hj, rfl⟩)
      have hnps : ∀ j, j < 3 → j ≠ p → c j ≠ ps := by
        intro j hj hjp heq
        exact hjp (hinj j p (by rw [hdN]; exact hj) (by rw [hdN]; exact hp)
          (heq.trans hcp.symm))
      have hdiff : c (lpOther p 0) ≠ c (lpOther p 1) := fun h' =>
        n01 (hinj _ _ (by rw [hdN]; exact o0) (by rw [hdN]; exact o1) h')
      have hcode : (3 + p) / 3 = 1 ∧ (3 + p) % 3 = p := by omega
      obtain ⟨vt, hv0⟩ : ∃ vt : ℕ → W, vt 0 = u := ⟨fun _ => u, rfl⟩
      obtain ⟨c', hc0, hc1⟩ : ∃ c' : ℕ → E, c' 0 = ps ∧ c' 1 = dn :=
        ⟨fun j => if j = 0 then ps else dn, by simp, by simp⟩
      refine ⟨3 + p, vt, c', ps, ⟨?_, ?_⟩,
        Or.inr (Or.inl ⟨hcode.1, hdN, hdC, by rw [hv0]; exact hu, ?_, ?_, ?_⟩)⟩
      · rw [hdC]
        intro j j' hj hj' hjj'
        have a : j = 0 ∨ j = 1 := by omega
        have b : j' = 0 ∨ j' = 1 := by omega
        rcases a with rfl | rfl <;> rcases b with rfl | rfl
        · rfl
        · rw [hc0, hc1] at hjj'; exact absurd hjj' e6
        · rw [hc0, hc1] at hjj'; exact absurd hjj'.symm e6
        · rfl
      · intro g
        rw [hcC g, hdC]
        constructor
        · rintro (rfl | rfl)
          · exact ⟨1, by norm_num, hc1⟩
          · exact ⟨0, by norm_num, hc0⟩
        · rintro ⟨j, hj, rfl⟩
          have a : j = 0 ∨ j = 1 := by omega
          rcases a with rfl | rfl
          · rw [hc0]; exact Or.inr rfl
          · rw [hc1]; exact Or.inl rfl
      · rw [hcode.2, hc0, hcp]
      · rw [hcode.2]
        intro g
        rw [hv0, hcu g, hc1]
        rcases hval _ o0 with q0 | q0 | q0
        · have q1 : c (lpOther p 1) = a2 := by
            rcases hval _ o1 with h' | h' | h'
            · exact absurd (q0.trans h'.symm) hdiff
            · exact h'
            · exact absurd h' (hnps _ o1 n1)
          rw [q0, q1]
        · have q1 : c (lpOther p 1) = a1 := by
            rcases hval _ o1 with h' | h' | h'
            · exact h'
            · exact absurd (q0.trans h'.symm) hdiff
            · exact absurd h' (hnps _ o1 n1)
          rw [q0, q1]
          constructor
          · rintro (h' | h' | h')
            · exact Or.inr (Or.inl h')
            · exact Or.inl h'
            · exact Or.inr (Or.inr h')
          · rintro (h' | h' | h')
            · exact Or.inr (Or.inl h')
            · exact Or.inl h'
            · exact Or.inr (Or.inr h')
        · exact absurd q0 (hnps _ o0 n0)
      · intro j hj
        rw [hc1]
        rcases hval j hj with h' | h' | h' <;> rw [h']
        · exact e2.symm
        · exact e3.symm
        · exact e6.symm
    · -- cuts of sizes two and three
