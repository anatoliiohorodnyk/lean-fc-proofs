    exact ⟨hAX m hm _ (hrgA m hm).1, hAX m hm _ (hrgA m hm).2⟩
  · intro g hg
    have hgL : α g ∈ L := hNL 0 (Nat.zero_le _) (Finset.mem_sdiff.mp hg).1
    rcases h.1 g with h' | h'
    · exact h'.2.2
    · exact absurd hgL h'.1

