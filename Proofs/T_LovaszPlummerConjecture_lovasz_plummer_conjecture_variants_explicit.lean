  rw [ep_btw_comm α β {z} ({x} ∪ {y})] at c3
  have c4 := hb _ hTL
  have c5 := epD_cut_parity α β L h _ hTL
  rw [hcard] at c5
  omega

lemma ep_prop1 (m i z c : Prop) (h : c → ¬i) :
    (¬((m ∧ ¬i) ↔ z) ∧ c) ↔ ¬((m ∧ c) ↔ (z ∧ c)) := by
  by_cases m <;> by_cases i <;> by_cases z <;> by_cases c <;> simp_all

lemma ep_prop2 (m i z c j : Prop) (h0 : c ∨ j) (hx : c → ¬j) (h1 : c → ¬i) (h2 : c → ¬z)
    (h3 : j → i) : ((¬((m ∧ ¬i) ↔ z) ∧ c) ∨ (m ∧ j)) ↔ m := by
  by_cases m <;> by_cases i <;> by_cases z <;> by_cases c <;> by_cases j <;> simp_all

lemma ep_prop3 (m i z n : Prop) (hi : ¬i) (hz : ¬z) (hn : ¬n) :
    (¬((m ∧ ¬i) ↔ z) ∨ n) ↔ m := by
  by_cases m <;> simp_all

lemma ep_prop4 (m i z n : Prop) (hi : ¬i) (hn : ¬n) :
    (¬((m ∧ ¬i) ↔ z) ∨ n) ↔ ¬(m ↔ z) := by
  by_cases m <;> by_cases z <;> simp_all

open Classical in
/-- A perfect matching meets the cut of `T` in a number of edges of the parity of `|T|`. -/
lemma ep_pm_cut_parity {W E : Type*} [Fintype E] (α β : E → W) (L : Finset W)
    (M : Finset E) (hM : M ∈ epPM α β L) (T : Finset W) (hT : T ⊆ L) :
    (M ∩ epCut α β T).card % 2 = T.card % 2 := by
  have hd := ep_double_count α β M hM.1 T
  have h1 : ∀ c ∈ T, (M.filter (epCross α β {c})).card = 1 := by
    intro c hc
    obtain ⟨e, ⟨he, hce⟩, huniq⟩ := hM.2 c (hT hc)
    rw [Finset.card_eq_one]
    refine ⟨e, ?_⟩
    ext g
    rw [Finset.mem_filter, Finset.mem_singleton]
    exact ⟨fun hg => huniq g hg, fun hg => hg ▸ ⟨he, hce⟩⟩
  rw [Finset.sum_congr rfl h1, Finset.sum_const, smul_eq_mul, mul_one] at hd
  have h2 : M ∩ epCut α β T = M.filter (epCross α β T) := by
    ext g
    rw [Finset.mem_inter, mem_epCut, Finset.mem_filter]
  rw [h2]
  omega

open Classical in
/-- **Kernel count.** Among the subsets of `TT`, those meeting each of the sets `C T`
(`T ∈ 𝒯`) in an even number of elements and avoiding `B` are at least a `2 ^ (|𝒯| + |B|)`-th
of all. -/
lemma ep_pack_kernel {E ι : Type*} (TT : Finset E) (𝒯 : Finset ι) (C : ι → Finset E)
    (B : Finset E) :
    2 ^ TT.card ≤ 2 ^ (𝒯.card + B.card) *
      (TT.powerset.filter
        (fun z => (∀ T ∈ 𝒯, Even (z ∩ C T).card) ∧ Disjoint z B)).card := by
  obtain ⟨Z, hZ⟩ : ∃ Z : Finset (Finset E), Z = TT.powerset.filter
      (fun z => (∀ T ∈ 𝒯, Even (z ∩ C T).card) ∧ Disjoint z B) := ⟨_, rfl⟩
  rw [← hZ]
  obtain ⟨sig, hsig⟩ : ∃ sig : Finset E → Finset ι × Finset E,
      ∀ z, sig z = (𝒯.filter (fun T => Odd (z ∩ C T).card), z ∩ B) := ⟨_, fun _ => rfl⟩
  have hfib : ∀ a ∈ TT.powerset.image sig,
      (TT.powerset.filter (fun z => sig z = a)).card ≤ Z.card := by
    intro a ha
    obtain ⟨z₀, hz₀, rfl⟩ := Finset.mem_image.mp ha
    have hz₀' := Finset.mem_powerset.mp hz₀
    have hinj : Set.InjOn (fun z => symmDiff z z₀)
        (TT.powerset.filter (fun z => sig z = sig z₀) : Set (Finset E)) := by
      intro z _ z' _ h
      exact symmDiff_left_injective z₀ h
    rw [← Finset.card_image_of_injOn hinj]
    apply Finset.card_le_card
    intro w hw
    obtain ⟨z, hz, rfl⟩ := Finset.mem_image.mp hw
    obtain ⟨hz1, hz2⟩ := Finset.mem_filter.mp hz
    have hz1' := Finset.mem_powerset.mp hz1
    rw [hsig, hsig, Prod.mk.injEq] at hz2
    obtain ⟨hpar, hB⟩ := hz2
    rw [hZ, Finset.mem_filter, Finset.mem_powerset]
    refine ⟨?_, ?_, ?_⟩
    · intro e he
      rcases Finset.mem_symmDiff.mp he with h | h
      · exact hz1' h.1
      · exact hz₀' h.1
    · intro T hT
      have hx := ep_xor_card (z ∩ C T) (z₀ ∩ C T) (symmDiff z z₀ ∩ C T) (by
        intro e
        rw [Finset.mem_inter, Finset.mem_inter, Finset.mem_inter, Finset.mem_symmDiff]
        tauto)
      have hiff : Odd (z ∩ C T).card ↔ Odd (z₀ ∩ C T).card := by
        have h1 : T ∈ 𝒯.filter (fun T => Odd (z ∩ C T).card) ↔
            T ∈ 𝒯.filter (fun T => Odd (z₀ ∩ C T).card) := by rw [hpar]
        rw [Finset.mem_filter, Finset.mem_filter] at h1
        tauto
      rw [Nat.odd_iff, Nat.odd_iff] at hiff
      rw [Nat.even_iff]
      omega
    · rw [Finset.disjoint_left]
      intro e he heB
      have h1 : e ∈ z ∩ B ↔ e ∈ z₀ ∩ B := by rw [hB]
      rw [Finset.mem_inter, Finset.mem_inter] at h1
      rcases Finset.mem_symmDiff.mp he with h | h
      · exact h.2 (h1.mp ⟨h.1, heB⟩).1
      · exact h.2 (h1.mpr ⟨h.1, heB⟩).1
  have h1 := Finset.card_le_mul_card_image (f := sig) TT.powerset Z.card hfib
  rw [Finset.card_powerset] at h1
  have h2 : (TT.powerset.image sig).card ≤ 2 ^ (𝒯.card + B.card) := by
    have hsub : TT.powerset.image sig ⊆ 𝒯.powerset ×ˢ B.powerset := by
      intro a ha
      obtain ⟨z, -, rfl⟩ := Finset.mem_image.mp ha
      rw [hsig, Finset.mem_product, Finset.mem_powerset, Finset.mem_powerset]
      exact ⟨Finset.filter_subset _ _, Finset.inter_subset_right⟩
    have := Finset.card_le_card hsub
    rw [Finset.card_product, Finset.card_powerset, Finset.card_powerset, ← pow_add] at this
    exact this
  calc 2 ^ TT.card ≤ Z.card * (TT.powerset.image sig).card := h1
    _ ≤ Z.card * 2 ^ (𝒯.card + B.card) := Nat.mul_le_mul_left _ h2
    _ = 2 ^ (𝒯.card + B.card) * Z.card := Nat.mul_comm _ _

open Classical in
/-- The edges joining two different members of a family of vertex sets. -/
noncomputable def epTT {W E : Type*} [Fintype E] (α β : E → W) (𝒯 : Finset (Finset W)) :
    Finset E :=
  Finset.univ.filter (fun e => ∃ T ∈ 𝒯, ∃ T' ∈ 𝒯, T ≠ T' ∧ α e ∈ T ∧ β e ∈ T')

lemma mem_epTT {W E : Type*} [Fintype E] (α β : E → W) (𝒯 : Finset (Finset W)) (e : E) :
    e ∈ epTT α β 𝒯 ↔ ∃ T ∈ 𝒯, ∃ T' ∈ 𝒯, T ≠ T' ∧ α e ∈ T ∧ β e ∈ T' := by
  classical
  simp [epTT]

set_option maxHeartbeats 1600000 in
open Classical in
/-- **Matchings from the kernel.** Let `𝒯` be pairwise disjoint odd sets in each of which every
odd set of leaving edges extends to a cover by inner edges, `M` a perfect matching and `f ∈ M`.
Every set `z` of edges between different members of `𝒯` that is even at each member and avoids
`B` gives a perfect matching containing `f`, and different sets give different matchings. -/
theorem ep_pack_match {W E : Type*} [Fintype E] (α β : E → W) (L : Finset W)
    (𝒯 : Finset (Finset W)) (hTL : ∀ T ∈ 𝒯, T ⊆ L)
    (hdisj : ∀ T ∈ 𝒯, ∀ T' ∈ 𝒯, T ≠ T' → Disjoint T T')
    (hext : ∀ T ∈ 𝒯, ∀ A : Finset E, A ⊆ epCut α β T → Odd A.card →
      ∃ N : Finset E, (∀ g ∈ N, α g ∈ T ∧ β g ∈ T ∧ α g ≠ β g) ∧
        ∀ c ∈ T, ∃! g, g ∈ A ∪ N ∧ epCross α β {c} g)
    (hodd : ∀ T ∈ 𝒯, Odd T.card)
    (M : Finset E) (hM : M ∈ epPM α β L) (f : E) (hf : f ∈ M) (B : Finset E)
    (hB1 : ∀ T ∈ 𝒯, α f ∈ T → β f ∈ T → epCut α β T ⊆ B)
    (hB2 : (∀ T ∈ 𝒯, ¬(α f ∈ T ∧ β f ∈ T)) → f ∈ B) :
    ((epTT α β 𝒯).powerset.filter
      (fun z => (∀ T ∈ 𝒯, Even (z ∩ epCut α β T).card) ∧ Disjoint z B)).card ≤
      epMe α β L f := by
  have hsame : ∀ T ∈ 𝒯, ∀ T' ∈ 𝒯, ∀ w, w ∈ T → w ∈ T' → T = T' := by
    intro T hT T' hT' w hw hw'
    by_contra hne
    exact Finset.disjoint_left.mp (hdisj T hT T' hT' hne) hw hw'
  -- edges between different members are inside no member
  have hTTInn : ∀ e ∈ epTT α β 𝒯, ¬∃ T ∈ 𝒯, α e ∈ T ∧ β e ∈ T := by
    rintro e he ⟨T, hT, ha, hb⟩
    obtain ⟨T₁, hT₁, T₂, hT₂, hne, ha', hb'⟩ := (mem_epTT α β 𝒯 e).mp he
    exact hne ((hsame T₁ hT₁ T hT _ ha' ha).trans (hsame T₂ hT₂ T hT _ hb' hb).symm)
  have hTTne : ∀ e ∈ epTT α β 𝒯, α e ≠ β e := by
    intro e he heq
    obtain ⟨T₁, hT₁, T₂, hT₂, hne, ha', hb'⟩ := (mem_epTT α β 𝒯 e).mp he
    exact hne (hsame T₁ hT₁ T₂ hT₂ _ (heq ▸ ha') hb')
  -- edges leaving a member are inside no member
  have hcutInn : ∀ T ∈ 𝒯, ∀ e, epCross α β T e → ¬∃ T' ∈ 𝒯, α e ∈ T' ∧ β e ∈ T' := by
    rintro T hT e hc ⟨T', hT', ha, hb⟩
    rcases hc with ⟨h1, h2⟩ | ⟨h1, h2⟩
    · exact h2 (hsame T' hT' T hT _ ha h1 ▸ hb)
    · exact h1 (hsame T' hT' T hT _ hb h2 ▸ ha)
  -- an edge at a vertex of `T` leaves `T` or is inside `T`
  have hcr : ∀ (T : Finset W) (c : W), c ∈ T → ∀ g, epCross α β {c} g →
      epCross α β T g ∨ (α g ∈ T ∧ β g ∈ T) := by
    intro T c hc g hg
    unfold epCross at hg ⊢
    simp only [Finset.mem_singleton] at hg
    rcases hg with ⟨h1, -⟩ | ⟨-, h2⟩
    · by_cases hb : β g ∈ T
      · exact Or.inr ⟨h1 ▸ hc, hb⟩
      · exact Or.inl (Or.inl ⟨h1 ▸ hc, hb⟩)
    · by_cases ha : α g ∈ T
      · exact Or.inr ⟨ha, h2 ▸ hc⟩
      · exact Or.inl (Or.inr ⟨ha, h2 ▸ hc⟩)
  have hend : ∀ (c : W) g, epCross α β {c} g → α g = c ∨ β g = c := by
    intro c g hg
    unfold epCross at hg
    simp only [Finset.mem_singleton] at hg
    tauto
  have key : ∀ z : Finset E, ∃ M' : Finset E, z ⊆ epTT α β 𝒯 →
      (∀ T ∈ 𝒯, Even (z ∩ epCut α β T).card) → Disjoint z B →
      (M' ∈ epPM α β L ∧ f ∈ M' ∧ ∀ e ∈ epTT α β 𝒯, (e ∈ M' ↔ ¬(e ∈ M ↔ e ∈ z))) := by
    intro z
    by_cases hzall : z ⊆ epTT α β 𝒯 ∧ (∀ T ∈ 𝒯, Even (z ∩ epCut α β T).card) ∧ Disjoint z B
    swap
    · exact ⟨∅, fun h1 h2 h3 => absurd ⟨h1, h2, h3⟩ hzall⟩
    obtain ⟨hzTT, hzev, hzB⟩ := hzall
    have hzInn : ∀ e ∈ z, ¬∃ T ∈ 𝒯, α e ∈ T ∧ β e ∈ T := fun e he => hTTInn e (hzTT he)
    obtain ⟨F, hF⟩ : ∃ F : Finset E,
        ∀ e, e ∈ F ↔ ¬((e ∈ M ∧ ¬∃ T ∈ 𝒯, α e ∈ T ∧ β e ∈ T) ↔ e ∈ z) :=
      ⟨Finset.univ.filter (fun e => ¬((e ∈ M ∧ ¬∃ T ∈ 𝒯, α e ∈ T ∧ β e ∈ T) ↔ e ∈ z)),
        fun e => by rw [Finset.mem_filter]; exact ⟨fun h => h.2, fun h => ⟨Finset.mem_univ _, h⟩⟩⟩
    have hFodd : ∀ T ∈ 𝒯, Odd (F ∩ epCut α β T).card := by
      intro T hT
      have hx := ep_xor_card (M ∩ epCut α β T) (z ∩ epCut α β T) (F ∩ epCut α β T) (by
        intro e
        rw [Finset.mem_inter, Finset.mem_inter, Finset.mem_inter, hF, mem_epCut]
        exact ep_prop1 _ _ _ _ (hcutInn T hT e))
      have h1 := ep_pm_cut_parity α β L M hM T (hTL T hT)
      have h2 := Nat.odd_iff.mp (hodd T hT)
      have h3 := Nat.even_iff.mp (hzev T hT)
      rw [Nat.odd_iff]
      omega
    have hN : ∀ T, ∃ N : Finset E, T ∈ 𝒯 → ((∀ g ∈ N, α g ∈ T ∧ β g ∈ T ∧ α g ≠ β g) ∧
        (∀ c ∈ T, ∃! g, g ∈ (F ∩ epCut α β T) ∪ N ∧ epCross α β {c} g) ∧
        (α f ∈ T → β f ∈ T → f ∈ N)) := by
      intro T
      by_cases hT : T ∈ 𝒯
      swap
      · exact ⟨∅, fun h => absurd h hT⟩
      by_cases hfT : α f ∈ T ∧ β f ∈ T
      · refine ⟨M.filter (fun g => α g ∈ T ∧ β g ∈ T), fun _ => ⟨?_, ?_, ?_⟩⟩
        · intro g hg
          obtain ⟨hgM, hg1, hg2⟩ := Finset.mem_filter.mp hg
          exact ⟨hg1, hg2, hM.1 g hgM⟩
        · intro c hc
          have hzc : ∀ e, epCross α β T e → e ∉ z := fun e he hez =>
            Finset.disjoint_left.mp hzB hez
              (hB1 T hT hfT.1 hfT.2 ((mem_epCut _ _ _ _).mpr he))
          obtain ⟨e, ⟨he, hce⟩, huniq⟩ := hM.2 c (hTL T hT hc)
          have hmem : ∀ g, epCross α β {c} g →
              (g ∈ (F ∩ epCut α β T) ∪ M.filter (fun g => α g ∈ T ∧ β g ∈ T) ↔ g ∈ M) := by
            intro g hg
            rw [Finset.mem_union, Finset.mem_inter, hF, mem_epCut, Finset.mem_filter]
            have h0 := hcr T c hc g hg
            have hx : epCross α β T g → ¬(α g ∈ T ∧ β g ∈ T) := by unfold epCross; tauto
            have h1 := hcutInn T hT g
            have h2 := hzc g
            have h3 : (α g ∈ T ∧ β g ∈ T) → ∃ T' ∈ 𝒯, α g ∈ T' ∧ β g ∈ T' :=
              fun h => ⟨T, hT, h⟩
            exact ep_prop2 _ _ _ _ _ h0 hx h1 h2 h3
          exact ⟨e, ⟨(hmem e hce).mpr he, hce⟩,
            fun g hg => huniq g ⟨(hmem g hg.2).mp hg.1, hg.2⟩⟩
        · intro _ _
          exact Finset.mem_filter.mpr ⟨hf, hfT⟩
      · obtain ⟨N, hN1, hN2⟩ :=
          hext T hT (F ∩ epCut α β T) Finset.inter_subset_right (hFodd T hT)
        exact ⟨N, fun _ => ⟨hN1, hN2, fun ha hb => absurd ⟨ha, hb⟩ hfT⟩⟩
    choose N hN using hN
    have hM'mem : ∀ e, e ∈ F ∪ 𝒯.biUnion N ↔ e ∈ F ∨ ∃ T ∈ 𝒯, e ∈ N T := by
      intro e
      rw [Finset.mem_union, Finset.mem_biUnion]
    have hFsub : ∀ e, e ∈ F → e ∈ M ∨ e ∈ z := by
      intro e he
      have := (hF e).mp he
      tauto
    refine ⟨F ∪ 𝒯.biUnion N, fun _ _ _ => ⟨⟨?_, ?_⟩, ?_, ?_⟩⟩
    · -- no loops
      intro e he
      rcases (hM'mem e).mp he with h | ⟨T, hT, h⟩
      · rcases hFsub e h with h' | h'
        · exact hM.1 e h'
        · exact hTTne e (hzTT h')
      · exact ((hN T hT).1 e h).2.2
    · -- every vertex is covered once
      intro c hcL
      by_cases hcU : ∃ T ∈ 𝒯, c ∈ T
      · obtain ⟨T, hT, hc⟩ := hcU
        have hmem : ∀ g, epCross α β {c} g →
            (g ∈ F ∪ 𝒯.biUnion N ↔ g ∈ (F ∩ epCut α β T) ∪ N T) := by
          intro g hg
          rw [hM'mem, Finset.mem_union, Finset.mem_inter, mem_epCut]
          constructor
          · rintro (h | ⟨T', hT', h⟩)
            · have h0 := hcr T c hc g hg
              have hni : ¬(α g ∈ T ∧ β g ∈ T) := by
                intro hi
                have h1 := (hF g).mp h
                have h2 := hzInn g
                have h3 : ∃ T' ∈ 𝒯, α g ∈ T' ∧ β g ∈ T' := ⟨T, hT, hi⟩
                by_cases hgz : g ∈ z
                · exact h2 hgz h3
                · exact h1 ⟨fun hh => absurd h3 hh.2, fun hh => absurd hh hgz⟩
              exact Or.inl ⟨h, h0.resolve_right hni⟩
            · obtain ⟨ha, hb, -⟩ := (hN T' hT').1 g h
              have hcT' : c ∈ T' := by
                rcases hend c g hg with h' | h'
                · exact h' ▸ ha
                · exact h' ▸ hb
              rw [hsame T hT T' hT' c hc hcT']
              exact Or.inr h
          · rintro (h | h)
            · exact Or.inl h.1
            · exact Or.inr ⟨T, hT, h⟩
        obtain ⟨e, ⟨he, hce⟩, huniq⟩ := (hN T hT).2.1 c hc
        exact ⟨e, ⟨(hmem e hce).mpr he, hce⟩,
          fun g hg => huniq g ⟨(hmem g hg.2).mp hg.1, hg.2⟩⟩
      · have hmem : ∀ g, epCross α β {c} g → (g ∈ F ∪ 𝒯.biUnion N ↔ g ∈ M) := by
          intro g hg
          have hgc := hend c g hg
          have hnoInn : ¬∃ T ∈ 𝒯, α g ∈ T ∧ β g ∈ T := by
            rintro ⟨T, hT, ha, hb⟩
            rcases hgc with h' | h'
            · exact hcU ⟨T, hT, h' ▸ ha⟩
            · exact hcU ⟨T, hT, h' ▸ hb⟩
          have hnz : g ∉ z := by
            intro hgz
            obtain ⟨T₁, hT₁, T₂, hT₂, -, ha, hb⟩ := (mem_epTT α β 𝒯 g).mp (hzTT hgz)
            rcases hgc with h' | h'
            · exact hcU ⟨T₁, hT₁, h' ▸ ha⟩
            · exact hcU ⟨T₂, hT₂, h' ▸ hb⟩
          have hnN : ¬∃ T ∈ 𝒯, g ∈ N T := by
            rintro ⟨T, hT, h⟩
            obtain ⟨ha, hb, -⟩ := (hN T hT).1 g h
            exact hnoInn ⟨T, hT, ha, hb⟩
          rw [hM'mem, hF]
          exact ep_prop3 _ _ _ _ hnoInn hnz hnN
        obtain ⟨e, ⟨he, hce⟩, huniq⟩ := hM.2 c hcL
        exact ⟨e, ⟨(hmem e hce).mpr he, hce⟩,
          fun g hg => huniq g ⟨(hmem g hg.2).mp hg.1, hg.2⟩⟩
    · -- the target edge
      rw [hM'mem]
      by_cases hfi : ∃ T ∈ 𝒯, α f ∈ T ∧ β f ∈ T
      · obtain ⟨T, hT, ha, hb⟩ := hfi
        exact Or.inr ⟨T, hT, (hN T hT).2.2 ha hb⟩
      · have hfB : f ∈ B := hB2 (fun T hT h => hfi ⟨T, hT, h⟩)
        have hfz : f ∉ z := fun h => Finset.disjoint_left.mp hzB h hfB
        refine Or.inl ((hF f).mpr ?_)
        tauto
    · -- the trace on the edges between different members
      intro e he
      have h1 := hTTInn e he
      have hnN : ¬∃ T ∈ 𝒯, e ∈ N T := by
        rintro ⟨T, hT, h⟩
        obtain ⟨ha, hb, -⟩ := (hN T hT).1 e h
        exact h1 ⟨T, hT, ha, hb⟩
      rw [hM'mem, hF]
      exact ep_prop4 _ _ _ _ h1 hnN
  choose Φ hΦ using key
  obtain ⟨Z, hZ⟩ : ∃ Z : Finset (Finset E), Z = (epTT α β 𝒯).powerset.filter
      (fun z => (∀ T ∈ 𝒯, Even (z ∩ epCut α β T).card) ∧ Disjoint z B) := ⟨_, rfl⟩
  rw [← hZ]
  have hZmem : ∀ z, z ∈ Z → z ⊆ epTT α β 𝒯 ∧ (∀ T ∈ 𝒯, Even (z ∩ epCut α β T).card) ∧
      Disjoint z B := by
    intro z hz
    rw [hZ, Finset.mem_filter, Finset.mem_powerset] at hz
    exact hz
  have hinj : Set.InjOn Φ (Z : Set (Finset E)) := by
    intro z hz z' hz' heq
    obtain ⟨h1, h2, h3⟩ := hZmem z (Finset.mem_coe.mp hz)
    obtain ⟨h1', h2', h3'⟩ := hZmem z' (Finset.mem_coe.mp hz')
    have ht := (hΦ z h1 h2 h3).2.2
    have ht' := (hΦ z' h1' h2' h3').2.2
    ext e
    by_cases he : e ∈ epTT α β 𝒯
    · have a := ht e he
      have b := ht' e he
      have c : e ∈ Φ z ↔ e ∈ Φ z' := by
        have : Φ z = Φ z' := heq
        rw [this]
      tauto
    · exact ⟨fun h => absurd (h1 h) he, fun h => absurd (h1' h) he⟩
  rw [← Finset.card_image_of_injOn hinj]
  unfold epMe
  apply Finset.card_le_card
  intro M' hM'
  obtain ⟨z, hz, rfl⟩ := Finset.mem_image.mp hM'
  obtain ⟨h1, h2, h3⟩ := hZmem z hz
  rw [Finset.mem_filter, mem_epPMs]
  exact ⟨(hΦ z h1 h2 h3).1, (hΦ z h1 h2 h3).2.1⟩

