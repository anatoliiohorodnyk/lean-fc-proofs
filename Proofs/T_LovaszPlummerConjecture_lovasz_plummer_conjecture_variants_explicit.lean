/-! ## 2. Sets with a cut of size five (Theorem D) -/

open Classical in
/-- **P0 (parity).** A set with a cut of size five has an odd number of vertices and at least
three vertices outside. (`epD_cut_parity`, `epD_cross_compl`, and a single vertex has cut 3.) -/
theorem ep_cut5_parity {W E : Type*} [Fintype E] (α β : E → W) (L X : Finset W)
    (h : EpCubicD α β L) (hXL : X ⊆ L) (h5 : (epCut α β X).card = 5) :
    X.card % 2 = 1 ∧ 3 ≤ (L \ X).card := by
  have hp := epD_cut_parity α β L h X hXL
  have hc : epCut α β (L \ X) = epCut α β X := by
    ext g; rw [mem_epCut, mem_epCut]
    exact epD_cross_compl α β L X (L \ X) h (fun w => Finset.mem_sdiff) g
  have hp' := epD_cut_parity α β L h (L \ X) Finset.sdiff_subset
  rw [hc, h5] at hp'
  rw [h5] at hp
  refine ⟨by omega, ?_⟩
  by_contra hlt
  have h1 : (L \ X).card = 1 := by omega
  obtain ⟨r, hr⟩ := Finset.card_eq_one.mp h1
  have hrL : r ∈ L :=
    (Finset.mem_sdiff.mp (by rw [hr]; exact Finset.mem_singleton_self r)).1
  have h3 := h.2 r hrL
  rw [← hr, hc, h5] at h3
  omega

/-! ### Perfect matchings of the graph induced on a vertex set

`epInA`, `epInB`: the multigraph on `Y` in which every edge with both ends in `Y` keeps its ends
and every other edge becomes a loop at `w₀ ∈ Y`. Kotzig's theorem (`ep_kotzig`) is applied to
it. -/

open Classical in
/-- Ends in the multigraph induced on `Y`: other edges become loops at `w₀`. -/
noncomputable def epInA {W E : Type*} (α β : E → W) (Y : Finset W) (w₀ : W) : E → W :=
  fun g => if α g ∈ Y ∧ β g ∈ Y then α g else w₀

open Classical in
/-- See `epInA`. -/
noncomputable def epInB {W E : Type*} (α β : E → W) (Y : Finset W) (w₀ : W) : E → W :=
  fun g => if α g ∈ Y ∧ β g ∈ Y then β g else w₀

lemma epIn_cross {W E : Type*} (α β : E → W) (Y : Finset W) (w₀ : W) (T : Finset W) (g : E) :
    epCross (epInA α β Y w₀) (epInB α β Y w₀) T g ↔
      (α g ∈ Y ∧ β g ∈ Y) ∧ epCross α β T g := by
  classical
  unfold epCross epInA epInB
  by_cases hg : α g ∈ Y ∧ β g ∈ Y
  · simp only [hg, and_self, if_true, true_and]
  · simp only [hg, if_false, false_and]; tauto

open Classical in
/-- **Kotzig for an induced graph.** Let `M` be a perfect matching of `G|Y` (edges inside `Y`,
every vertex of `Y` covered exactly once). If no edge `e` of `M` is the only edge inside `Y`
crossing some `T ⊆ Y`, then `G|Y` has another perfect matching. -/
theorem ep_kotzig_in {W E : Type*} [Fintype E] (α β : E → W) (Y : Finset W) (w₀ : W)
    (hw₀ : w₀ ∈ Y) (M : Finset E)
    (hMin : ∀ e ∈ M, α e ∈ Y ∧ β e ∈ Y ∧ α e ≠ β e)
    (hMcov : ∀ c ∈ Y, ∃! e, e ∈ M ∧ epCross α β {c} e) (hMne : M.Nonempty)
    (hbr : ∀ e ∈ M, ∀ T ⊆ Y, ¬(∀ g, (α g ∈ Y ∧ β g ∈ Y ∧ epCross α β T g) ↔ g = e)) :
    ∃ M' : Finset E, M' ≠ M ∧ (∀ e ∈ M', α e ∈ Y ∧ β e ∈ Y ∧ α e ≠ β e) ∧
      ∀ c ∈ Y, ∃! e, e ∈ M' ∧ epCross α β {c} e := by
  have hmem : ∀ g, epInA α β Y w₀ g ∈ Y ∧ epInB α β Y w₀ g ∈ Y := by
    intro g
    unfold epInA epInB
    by_cases hg : α g ∈ Y ∧ β g ∈ Y
    · rw [if_pos hg, if_pos hg]; exact hg
    · rw [if_neg hg, if_neg hg]; exact ⟨hw₀, hw₀⟩
  have hnl : ∀ g, epInA α β Y w₀ g ≠ epInB α β Y w₀ g ↔ (α g ∈ Y ∧ β g ∈ Y) ∧ α g ≠ β g := by
    intro g
    unfold epInA epInB
    by_cases hg : α g ∈ Y ∧ β g ∈ Y
    · rw [if_pos hg, if_pos hg]; tauto
    · rw [if_neg hg, if_neg hg]; tauto
  have hM : M ∈ epPM (epInA α β Y w₀) (epInB α β Y w₀) Y := by
    refine ⟨fun e he => (hnl e).mpr ⟨⟨(hMin e he).1, (hMin e he).2.1⟩, (hMin e he).2.2⟩,
      fun c hc => ?_⟩
    obtain ⟨e₀, ⟨h1, h2⟩, huniq⟩ := hMcov c hc
    refine ⟨e₀, ⟨h1, (epIn_cross α β Y w₀ {c} e₀).mpr ⟨⟨(hMin e₀ h1).1, (hMin e₀ h1).2.1⟩, h2⟩⟩,
      fun e' he' => huniq e' ⟨he'.1, ((epIn_cross α β Y w₀ {c} e').mp he'.2).2⟩⟩
  have hbr' : ∀ e ∈ M, ∀ T ⊆ Y, epCut (epInA α β Y w₀) (epInB α β Y w₀) T ≠ {e} := by
    intro e he T hT hcut
    refine hbr e he T hT fun g => ?_
    have : g ∈ epCut (epInA α β Y w₀) (epInB α β Y w₀) T ↔ g = e := by
      rw [hcut, Finset.mem_singleton]
    rw [mem_epCut, epIn_cross] at this
    rw [← this]; tauto
  obtain ⟨M', hM', hne⟩ := ep_kotzig _ (epInA α β Y w₀) (epInB α β Y w₀) Y rfl hmem M hM hMne hbr'
  refine ⟨M', hne, fun e he => ?_, fun c hc => ?_⟩
  · obtain ⟨a1, a2⟩ := (hnl e).mp (hM'.1 e he)
    exact ⟨a1.1, a1.2, a2⟩
  · obtain ⟨e₀, ⟨h1, h2⟩, huniq⟩ := hM'.2 c hc
    refine ⟨e₀, ⟨h1, ((epIn_cross α β Y w₀ {c} e₀).mp h2).2⟩, fun e' he' => huniq e' ⟨he'.1, ?_⟩⟩
    exact (epIn_cross α β Y w₀ {c} e').mpr ⟨((hnl e').mp (hM'.1 e' he'.1)).1, he'.2⟩

set_option maxHeartbeats 800000 in
open Classical in
/-- A perfect matching avoiding a cut of size four: the number of cut edges in a perfect
matching is even with mean `4/3` under the uniform fractional matching. -/
theorem ep_pm_avoid_cut4 {W E : Type*} [Fintype E] (α β : E → W) (L X : Finset W)
    (h : EpCubicD α β L) (hb : EpBridgeless α β L) (hXL : X ⊆ L)
    (hcut : (epCut α β X).card = 4) :
    ∃ M₀, M₀ ∈ epPM α β L ∧ ∀ g ∈ M₀, ¬epCross α β X g := by
  have hc := epD_live_cubic α β L h
  have hb' := epD_live_bridgeless α β L h hb
  obtain ⟨hhull, -⟩ := ep_cubic_edge_in_pm _ _ L hc.1 hc.2.1 hc.2.2 (fun T hT _ => hb' T hT)
  obtain ⟨w, hw0, hwS, hw1, hwx⟩ := ep_hull_repr _ _ hhull
  have h4' : (epCut (fun e : {e : E // α e ∈ L} => α e.1) (fun e => β e.1) X).card = 4 := by
    rw [epD_cut_card α β L h X]; exact hcut
  have hXeven : X.card % 2 = 0 := by
    rw [← epD_cut_parity α β L h X hXL, hcut]
  have hpar : ∀ M, w M ≠ 0 →
      (M.filter (epCross (fun e : {e : E // α e ∈ L} => α e.1) (fun e => β e.1) X)).card % 2
        = 0 := by
    intro M hM
    have hMpm := hwS M hM
    have hd := ep_double_count (fun e : {e : E // α e ∈ L} => α e.1) (fun e => β e.1) M
      hMpm.1 X
    have h1 : ∀ c ∈ X, (M.filter (epCross (fun e : {e : E // α e ∈ L} => α e.1)
        (fun e => β e.1) {c})).card = 1 :=
      fun c hcX => (ep_unique_iff_card M _).mp (hMpm.2 c (hXL hcX))
    rw [Finset.sum_congr rfl h1, Finset.sum_const, smul_eq_mul, mul_one] at hd
    omega
  have hexp : ∑ M, w M * ((M.filter (epCross (fun e : {e : E // α e ∈ L} => α e.1)
      (fun e => β e.1) X)).card : ℝ) = 4 / 3 := by
    have : ∀ M, w M * ((M.filter (epCross (fun e : {e : E // α e ∈ L} => α e.1)
        (fun e => β e.1) X)).card : ℝ) =
        ∑ e ∈ epCut (fun e : {e : E // α e ∈ L} => α e.1) (fun e => β e.1) X,
          w M * epInd M e := by
      intro M; rw [← Finset.mul_sum, ep_sum_ind_cut]
    rw [Finset.sum_congr rfl (fun M _ => this M), Finset.sum_comm]
    have h3 : ∀ e ∈ epCut (fun e : {e : E // α e ∈ L} => α e.1) (fun e => β e.1) X,
        ∑ M, w M * epInd M e = 1 / 3 := fun e _ => (hwx e).symm
    rw [Finset.sum_congr rfl h3, Finset.sum_const, h4']; norm_num
  obtain ⟨M, hM, hM0⟩ : ∃ M, w M ≠ 0 ∧
      (M.filter (epCross (fun e : {e : E // α e ∈ L} => α e.1) (fun e => β e.1) X)).card
        = 0 := by
    by_contra hno
    push_neg at hno
    have hge : ∑ M, w M * (2 : ℝ) ≤ ∑ M, w M * ((M.filter (epCross
        (fun e : {e : E // α e ∈ L} => α e.1) (fun e => β e.1) X)).card : ℝ) := by
      refine Finset.sum_le_sum fun M _ => ?_
      by_cases hM : w M = 0
      · rw [hM, zero_mul, zero_mul]
      · refine mul_le_mul_of_nonneg_left ?_ (hw0 M)
        have h1 := hpar M hM
        have h2 := hno M hM
        have h3 : 2 ≤ (M.filter (epCross (fun e : {e : E // α e ∈ L} => α e.1)
            (fun e => β e.1) X)).card := by omega
        exact_mod_cast h3
    rw [← Finset.sum_mul, hw1, hexp] at hge
    norm_num at hge
  refine ⟨_, epD_pm_map α β L (hwS M hM), fun g hg hgc => ?_⟩
  obtain ⟨e', he', rfl⟩ := Finset.mem_map.mp hg
  have : e' ∈ M.filter (epCross (fun e : {e : E // α e ∈ L} => α e.1) (fun e => β e.1) X) :=
    Finset.mem_filter.mpr ⟨he', hgc⟩
  rw [Finset.card_eq_zero.mp hM0] at this
  exact absurd this (Finset.notMem_empty _)

